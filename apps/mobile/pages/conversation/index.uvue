<template>
  <view id="conversation-page" class="page" :style="{ paddingBottom: keyboardInset + 'px' }">
    <view class="status-spacer"></view>
    <view id="conversation-header" class="conversation-header" @click="dismissGoal">
      <view class="icon-button round-button action-frame"><app-icon name="back" :size="24" /><button class="action-hitbox" hover-class="action-pressed" aria-label="返回聊天列表" @click="goBack"></button></view>
      <view class="thread-capsule" @click="showConversationInfo">
        <!-- 状态紧跟标题，长标题省略时仍为状态保留完整宽度。 -->
        <view class="thread-heading"><text class="thread-title">{{ displayTitle }}</text><view v-if="connection.snapshot != null" class="title-status"><task-status :hide-running-label="true" :state="currentTaskState" :visible="pageVisible" /></view></view>
        <view class="thread-meta"><app-icon name="folder" :size="14" tone="muted" /><text class="meta-project">{{ projectName }}</text><template v-if="connection.computers.length > 1"><view :class="['connection-dot', connection.connected ? 'online' : 'offline']"></view><text class="meta-host">{{ hostName }}</text></template></view>
      </view>
      <view class="icon-button round-button action-frame"><app-icon name="more" :size="24" /><button class="action-hitbox" hover-class="action-pressed" aria-label="聊天菜单" @click="showActions"></button></view>
    </view>
    <view v-if="showingCachedContent && !cacheRefreshing" class="cache-notice"><text class="cache-note">{{ cacheSyncHint }}</text><button v-if="!connection.connected || detailError.length > 0" class="cache-retry button-secondary" @click="refresh" aria-label="重试同步">重试</button></view>
    <view v-if="readOnly" class="notice"><text class="notice-text">{{ conversationConnectionHint }}</text><button v-if="!autoConnectPending && !activating" class="continue-button button-secondary" :disabled="!connection.connected || connection.pendingCommandId.length > 0" @click="continueConversation">重新连接</button></view>
    <view v-if="!connection.connected" class="connection-notice"><view class="connection-dot offline"></view><text class="connection-note">{{ connection.status }}，草稿仍可编辑</text><button class="text-button" @click="refresh">重连</button></view>
    <view v-if="detailError.length > 0 && !showingCachedContent" class="notice"><text class="notice-text">{{ detailError }}</text></view>
    <view v-if="pendingRetryCommand.length > 0" class="notice pending-notice"><text class="notice-text">重试结果需要核对，请勿重复提交。</text><button class="check button-secondary" :disabled="!connection.connected || busy" @click="checkRetryOutcome">核对重试结果</button></view>
    <view v-if="pendingDeleteCommand.length > 0 && pendingAction != 'delete'" class="notice pending-notice"><text class="notice-text">删除结果尚未确认，请核对原操作，勿重复提交。</text><button class="check button-secondary" :disabled="!connection.connected || busy" @click="checkDeleteOutcome">核对删除结果</button></view>
    <view v-if="connection.desktopNavigationError.length > 0" class="notice pending-notice"><text class="notice-text">{{ connection.desktopNavigationError }}</text><button class="check button-secondary" :disabled="!connection.connected || activating || connection.pendingCommandId.length > 0" @click="retryDesktopOpen">重试切换电脑</button></view>
    <view class="timeline-region" @click="dismissGoal">
      <scroll-view id="conversation-timeline" direction="vertical" class="timeline" :scroll-into-view="scrollTarget" :scroll-top="historyScrollTop" :upper-threshold="60" @scrolltoupper="onHistoryTop" @scroll="onTimelineScroll" @touchstart="beginTimelineTouch" @touchend="endTimelineTouch" @touchcancel="endTimelineTouch">
        <!-- 历史提示预留固定高度，骨架出现和移除时不改变现有消息的位置。 -->
        <view v-if="connection.snapshot?.supportsHistoryPages == true" class="history-controls"><loading-skeleton v-if="loadingHistory" kind="history" :visible="pageVisible" /><text v-else-if="historyError.length > 0" class="history-note">暂时无法读取更早的聊天，请再次下拉重试</text><text v-else-if="historyPage?.hasMore == false" class="history-note">已显示全部聊天</text></view>
        <!-- 首次同步仅替换正文占位，导航、输入区和失败重试继续沿用真实状态。 -->
        <loading-skeleton v-if="displayConversation == null && connection.connected && detailError.length == 0" kind="conversation" :visible="pageVisible" />
        <view v-else-if="displayConversation == null" class="empty"><text class="empty-title">{{ openingTitle }}</text><text class="empty-detail">{{ detailError.length > 0 ? '未能取得聊天内容，可以重新同步；草稿已保留。' : '连接恢复后会重新同步聊天。' }}</text><button v-if="detailError.length > 0" class="retry-opening button-secondary" @click="refresh">重新同步</button></view>
        <view v-for="entry in timeline" :id="entryAnchor(entry)" :key="entry.id" :class="['message', entry.role == 'user' ? 'message-user' : entry.role == 'assistant' ? 'message-agent' : 'message-execution']" :style="{ maxWidth: (entry.role == 'user' ? userBubbleWidth : userBubbleWidth + 48) + 'px' }">
          <template v-if="entry.role == 'user' || entry.role == 'assistant'">
            <message-images v-if="entry.role == 'user' && (entry.imageCount ?? 0) > 0" :host-id="pageHostId" :thread-id="pageThreadId" :message-id="entry.id" :connected="connection.connected" :count="entry.imageCount ?? 0" :style="{ marginBottom: entry.text.trim().length > 0 || (entry.attachments?.length ?? 0) > 0 ? '8px' : '0px' }" />
            <view v-if="entry.role == 'user' && (entry.attachments?.length ?? 0) > 0" class="message-files" :style="{ marginBottom: entry.text.trim().length > 0 ? '8px' : '0px' }"><view v-for="(file, fileIndex) in entry.attachments ?? []" :key="fileIndex" class="message-file" :aria-label="file.name"><app-icon name="file" :size="18" tone="muted" /><text class="message-file-name" selectable>{{ file.name }}</text></view></view>
            <markdown-body v-if="entry.role == 'assistant' && entry.text.trim().length > 0" :source="entry.text" @beforelayout="beforeMarkdownLayout" @layout="afterMarkdownLayout" @reading="markdownReading" />
            <text v-else-if="entry.text.trim().length > 0" class="message-text" selectable>{{ entry.role == 'user' ? pluginMessageText(entry.text) : entry.text }}</text>
            <message-images v-if="entry.role == 'assistant' && (entry.imageCount ?? 0) > 0" :host-id="pageHostId" :thread-id="pageThreadId" :message-id="entry.id" :connected="connection.connected" :count="entry.imageCount ?? 0" :large="true" @layout="afterMarkdownLayout" />
            <view v-if="(entry.annotations?.length ?? 0) > 0" :class="['annotation-entry', 'action-frame', entry.text.trim().length > 0 ? 'annotation-after-text' : '']">
              <view class="annotation-icon"><view class="annotation-icon-line"></view><view class="annotation-icon-line annotation-icon-short"></view></view><text class="annotation-entry-label">{{ entry.annotations!.length }} 条注释</text><app-icon name="chevron-right" :size="14" tone="muted" />
              <button class="action-hitbox" hover-class="action-pressed" :aria-label="'查看 ' + entry.annotations!.length + ' 条注释'" @click="openAnnotations(entry.id)"></button>
            </view>
            <file-change-summary v-if="(entry.reportId ?? '').length > 0 && connection.snapshot?.supportsFileReports == true" :host-id="pageHostId" :thread-id="pageThreadId" :report-id="entry.reportId ?? ''" :connected="connection.connected" @open="openFileReport" @reading="pauseFollowing" @beforelayout="beforeMarkdownLayout" @layout="afterMarkdownLayout" />
          </template>
          <view v-else-if="entry.role == 'failure'" class="turn-failure-card" aria-label="任务失败">
            <app-icon class="turn-failure-icon" name="alert-circle" :size="16" tone="warning" />
            <view class="turn-failure-copy"><text class="turn-failure-text" selectable>{{ entry.text }}</text><text v-if="entry.turnId == displayFailureTurnId && connection.snapshot?.supportsTurnRetry != true && !showingCachedContent" class="turn-failure-hint">更新电脑连接服务后可重试</text></view>
            <button v-if="entry.turnId == displayFailureTurnId" class="turn-retry" :disabled="!canRetryTurn(entry.turnId)" aria-label="重试失败任务" @click="retryTurn(entry.turnId)">{{ retrySubmitting(entry.turnId) ? '重试中…' : '重试' }}</button>
          </view>
          <view v-else-if="entry.role == 'process'" class="process-toggle action-frame"><text class="process-label">{{ entry.label }}</text><app-icon :name="isProcessExpanded(entry) ? 'chevron-down' : 'chevron-right'" :size="16" tone="muted" /><button class="action-hitbox" hover-class="action-pressed" :aria-label="entry.label" :aria-expanded="isProcessExpanded(entry)" @click="toggleProcess(entry)"></button></view>
          <template v-else>
            <view class="execution-toggle action-frame"><app-icon name="edit" :size="19" tone="muted" /><text class="execution-summary">{{ entry.label }}</text><app-icon :name="isExecutionExpanded(entry) ? 'chevron-down' : 'chevron-right'" :size="16" tone="muted" /><button class="action-hitbox" hover-class="action-pressed" :aria-label="(isExecutionExpanded(entry) ? '收起' : '展开') + entry.label" @click="toggleExecutions(entry)"></button></view>
            <scroll-view v-if="isExecutionExpanded(entry)" direction="vertical" class="execution-list" :style="{ height: Math.min(240, entry.executions.length * 44) + 'px' }" @touchstart.stop="beginExecutionTouch" @touchend.stop="endExecutionTouch" @touchcancel.stop="endExecutionTouch">
              <view v-for="message in entry.executions" :key="message.id" class="execution-row action-frame"><app-icon :name="message.kind == 'fileChange' ? 'edit' : 'terminal'" :size="18" tone="muted" /><text class="execution-label">{{ executionTitle(message) }}</text><button class="action-hitbox" hover-class="action-pressed" :aria-label="'查看详情：' + executionTitle(message)" @click="toggleExecution(message.id)"></button></view>
            </scroll-view>
          </template>
        </view>
        <!-- 计划确认与聊天草稿独立，避免覆盖附件和未发送正文。 -->
        <view v-if="pendingPlan != null && hiddenPlanId != pendingPlan.id" id="notice-plan" class="plan-confirm">
          <text class="plan-confirm-title">实施此计划？</text>
          <button class="button-primary" :disabled="!canWrite || busy" @click="replyPlan('implement')">{{ pendingAction == 'plan' ? '提交中…' : '是，实施此计划' }}</button>
          <textarea class="plan-feedback" v-model="planFeedback" :disabled="busy" placeholder="否，告诉 Codex 应该如何调整" :maxlength="32000"></textarea>
          <view class="plan-confirm-actions"><button class="button-secondary" :disabled="busy" @click="hidePlan">跳过</button><button class="button-secondary" :disabled="!canWrite || busy || planFeedback.trim().length == 0" @click="replyPlan('feedback')">发送修改意见</button></view>
        </view>
        <view id="questions-anchor"></view>
        <!-- 问答在消息区内独立成卡，白底与边界突出当前需要处理的内容。 -->
        <view v-for="group in pendingQuestionGroups" :key="group.id" :id="questionNoticeAnchor(group.id)" class="question-section"><view class="question-entry action-frame"><text class="question-label">回答问题</text><text v-if="submittedGroupIds.indexOf(group.id) >= 0" class="question-state">已提交</text><text class="question-collapse-label">{{ expandedQuestionIds.indexOf(group.id) >= 0 ? '收起' : '展开' }}</text><button class="action-hitbox" hover-class="question-pressed" :aria-label="expandedQuestionIds.indexOf(group.id) >= 0 ? '收起问题' : '展开问题'" :aria-expanded="expandedQuestionIds.indexOf(group.id) >= 0" @click="toggleQuestion(group.id)"></button></view><question-card v-show="expandedQuestionIds.indexOf(group.id) >= 0" :group="group" :busy="busy" :disabled="!canWrite" :submitted="submittedGroupIds.indexOf(group.id) >= 0" @submit="submitAnswers" /></view>
        <view id="approvals-anchor"></view>
        <view v-for="approval in connection.snapshot?.approvals ?? []" :key="approval.id" :id="approvalNoticeAnchor(approval.id)" class="approval"><text class="approval-title">{{ approval.title }}</text><text class="approval-detail" selectable>{{ approval.detail }}</text><text class="approval-cwd">{{ approval.cwd }}</text><text v-if="handledApprovalIds.indexOf(approval.id) >= 0" class="approval-feedback">处理结果已提交</text><view v-else class="approval-actions"><button class="approval-button button-secondary" :disabled="!canWrite" @click="reply(approval.id, approval.turnId, 'decline')">拒绝</button><button class="approval-button button-primary" :disabled="!canWrite" @click="reply(approval.id, approval.turnId, 'accept')">{{ pendingAction == 'approval:' + approval.id ? '提交中…' : '本次允许' }}</button></view></view>
        <!-- 等待回答时由问答卡片和顶部状态提示，隐藏底部重复状态。 -->
        <view v-if="currentTaskState != 'question' && (activeTurnId.length > 0 || currentTaskState == 'running' || pendingQuestionCount > 0 || approvalCount > 0)" class="working"><task-status :state="currentTaskState" :visible="pageVisible" :detail="connection.snapshot?.activity ?? ''" /></view>
        <message-queue :messages="queuedMessages" :disabled="!canWrite" :running="activeTurnId.length > 0" @steer="steerQueuedMessage" :editable="connection.snapshot?.supportsQueueEditing == true" @cancel="cancelQueuedMessage" @edit="editQueuedMessage" />
        <!-- 同步骨架紧跟缓存消息末尾，与聊天内容一起滚动。 -->
        <view v-if="cacheRefreshing" class="cache-sync-indicator"><loading-skeleton kind="sync" :visible="pageVisible" /></view>
        <view id="timeline-bottom" class="bottom-space"></view>
      </scroll-view>
      <view v-if="!atTimelineBottom" class="jump-latest"><app-icon name="down" :size="20" /><button class="action-hitbox" hover-class="action-pressed" aria-label="回到最新消息" @click="resumeFollowing"></button></view>
    </view>
    <view v-if="composerMenu.length > 0" class="composer-dismiss" @click="closeComposerMenu"></view>
    <view id="composer-dock" class="composer-dock" :class="{ 'composer-menu-open': composerMenu.length > 0 }">
      <goal-card :goal="connection.snapshot?.goal ?? null" :revision="connection.snapshot?.goalRevision ?? 'none'" :disabled="!canWrite || !goalHostOnline || connection.snapshot?.supportsGoalControl != true" :busy="goalBusy" :unavailable-reason="goalUnavailableReason" :open-request="goalOpenRequest" :close-request="goalCloseRequest" :reset-key="pageHostId + ':' + pageThreadId" :content-height="goalContentHeight" @operate="operateGoal" @expanded="goalExpansion" @keyboard="goalKeyboard" />
      <view class="composer-panel" :class="{ 'composer-compact': !composerExpanded }" @click="dismissGoal">
        <scroll-view v-if="draftPlugins.length > 0" direction="vertical" class="draft-plugins" :style="{ height: Math.min(132, draftPlugins.length * 44) + 'px' }"><plugin-chips :plugins="draftPlugins" :disabled="!canWrite" @remove="removePlugin" /></scroll-view>
        <view v-if="draftImages.length > 0" class="draft-images"><view v-for="image in draftImages" :key="image.id" class="draft-image"><image :src="image.src" mode="aspectFill" class="draft-thumbnail" @click="previewImage(image.src)" /><view class="remove-image"><app-icon name="close" :size="14" tone="light" /><button class="action-hitbox" :disabled="busy || imageBusy || connection.pendingCommandId.length > 0" aria-label="移除图片" @click="removeImage(image.id)"></button></view></view></view>
        <view v-for="file in draftFiles" :key="file.id" class="draft-file"><app-icon name="file" :size="24" tone="muted" /><view class="file-copy"><text class="file-name">{{ file.name }}</text><text class="file-status">{{ file.error.length > 0 ? file.error : file.status == 'ready' ? sizeLabel(file.size) + ' · 已就绪' : file.status == 'paused' ? '上传已暂停，点击重试' : '正在上传 ' + file.progress + '%' }}</text></view><button v-if="file.status == 'error' || file.status == 'paused'" class="file-retry" :disabled="!canWrite" @click="retryFile(file.id)">重试</button><button class="file-remove" :disabled="busy || connection.pendingCommandId.length > 0" :aria-label="'移除附件 ' + file.name" @click="removeFile(file.id)">×</button></view>
        <text v-if="imageBusy" class="image-processing">正在处理附件…</text>
        <text v-if="composerExpanded && executionSettingsUnavailable" class="composer-caption">更新电脑连接服务后可选择模型和计划模式</text>
        <text v-if="composerExpanded && settingsError.length > 0 && composerMenu.length == 0" class="composer-caption">{{ settingsError }}</text>
        <view class="composer-stage" :style="{ height: composerStageHeight + 'px' }">
          <!-- 紧凑与展开共用同一编辑节点，布局切换不会重建原生输入框。 -->
          <view class="draft-editor" :class="{ 'draft-editor-compact': !composerExpanded }" :style="{ height: composerHeight + 'px' }">
            <textarea :focus="predictionFocus" :value="draft" @input="updateDraft" @keydown="onComposerKeydown" @confirm="onComposerConfirm" @focus="onComposerFocus" @click="onComposerFocus" @blur="onDraftBlur" @linechange="onDraftLineChange" @keyboardheightchange="onKeyboardChange" :adjust-position="false" :disabled="readOnly || queueEditing" class="draft" :style="{ height: composerHeight + 'px' }" :placeholder="readOnly ? (activating ? '正在连接聊天…' : '连接聊天后即可发送') : (visiblePrediction.length > 0 ? visiblePrediction : '问问 Codex')" :maxlength="32000"></textarea>
            <!-- 同宽文本只测量排版；零宽字符保留末尾换行，不写入草稿。 -->
            <view class="draft-measure-box" aria-hidden="true"><text id="draft-placeholder-measure" class="draft-placeholder-measure">{{ visiblePrediction + '\u200b' }}</text></view>
          </view>
          <!-- 两端操作始终使用同一节点，展开时只增加上方的编辑空间。 -->
          <view class="composer-add"><view class="add-image action-frame" :style="{ opacity: !canWrite ? 0.45 : 1 }"><composer-plus /><button class="action-hitbox" :disabled="!canWrite" aria-label="添加附件、插件、计划模式或追求目标" @click="openComposerMenu('add')"></button></view></view>
          <view v-show="composerExpanded" class="composer-actions"><permissions-control :thread-id="pageThreadId" :disabled="!canWrite || settingsBusy" @busy="onPermissionBusy" @visibility="onPermissionVisibility" /><view v-if="planEnabled" class="plan-chip action-frame" :style="{ opacity: activeTurnId.length > 0 || connection.snapshot?.status == 'active' ? 0.4 : 1 }"><app-icon name="plan" :size="20" tone="muted" /><view class="plan-close"><app-icon name="close" :size="12" tone="muted" /></view><button class="action-hitbox" :disabled="!canWrite || settingsBusy || activeTurnId.length > 0 || connection.snapshot?.status == 'active'" aria-label="关闭计划模式" @click="togglePlan"></button></view><view class="settings-trigger action-frame"><text class="settings-trigger-label">{{ modelLabel }}</text><app-icon name="chevron-down" :size="14" tone="muted" /><button class="action-hitbox" :disabled="!canWrite || connection.snapshot?.supportsExecutionSettings != true" aria-label="选择模型、推理强度和速度" @click="openComposerMenu('settings')"></button></view></view>
          <view class="composer-send"><view class="primary-action action-frame" :style="{ opacity: (!primaryAvailable) ? 0.4 : 1 }"><app-icon :name="activeTurnId.length > 0 && draft.trim().length == 0 && draftImages.length == 0 && draftFiles.length == 0 ? 'stop' : 'send'" :size="22" tone="light" /><button class="action-hitbox" :disabled="!primaryAvailable" :aria-label="activeTurnId.length > 0 && draft.trim().length == 0 && draftImages.length == 0 && draftFiles.length == 0 ? '停止任务' : '发送指令'" @click="primaryAction"></button></view></view>
        </view>
      </view>
    </view>
      <view v-if="composerMenu.length > 0" class="composer-options-anchor" :style="{ bottom: menuBottom + 'px' }"><composer-options :section="composerMenu" :settings="composerSettings" :models="models" :loading="settingsLoading" :busy="settingsBusy" :error="settingsError" :width="menuWidth" :height="menuHeight" :images-enabled="canWrite && !imageBusy && modelSupportsImages && connection.snapshot?.supportsImages == true && draftImages.length + draftFiles.length < 3" :files-enabled="canWrite && !imageBusy && connection.snapshot?.supportsAttachments == true && draftImages.length + draftFiles.length < 3" :settings-enabled="canWrite && settings != null && connection.snapshot?.supportsExecutionSettings == true" :plan-disabled="activeTurnId.length > 0 || connection.snapshot?.status == 'active'" :note="readOnly ? '历史浏览模式，请先继续此聊天' : '附件最多3个；不可用选项需更新或刷新电脑连接服务'" @section="changeComposerSection" @action="composerAction" @select="selectSetting" @dismiss="closeComposerMenu" @retry="loadSettings" /></view>
    <view v-if="keyboardInset == 0" class="bottom-safe-area"></view>
    <view v-if="selectedExecution != null" class="execution-overlay" @click="closeExecution"><view class="execution-sheet" @click.stop><view class="sheet-grip"></view><view class="sheet-header"><text class="sheet-title">{{ selectedExecution?.kind == 'fileChange' ? '文件更改' : '执行详情' }}</text><view class="icon-button action-frame"><app-icon name="close" :size="22" /><button class="action-hitbox" hover-class="action-pressed" aria-label="关闭执行详情" @click="closeExecution"></button></view></view><text class="sheet-caption">命令与输出</text><scroll-view direction="vertical" class="sheet-output"><text class="execution-text" selectable>{{ selectedExecution?.text ?? '' }}</text></scroll-view><text class="sheet-note">仅展示这条记录的详细内容</text><view class="sheet-actions"><view class="sheet-copy action-frame"><app-icon name="copy" :size="18" /><text class="sheet-copy-label">复制记录</text><button class="action-hitbox" hover-class="action-pressed" @click="copyText(selectedExecution?.text ?? '')" aria-label="复制记录"></button></view></view><view class="bottom-safe-area"></view></view></view>
    <view v-if="actionsVisible" class="menu-overlay" @click="closeActions"><view class="status-spacer"></view><view class="menu-top-space"></view><view class="menu-panel" @click.stop><text class="menu-caption">聊天操作</text><view class="menu-item action-frame"><app-icon name="refresh" :size="19" /><text class="menu-label">重新同步</text><button class="action-hitbox" hover-class="action-pressed" @click="refreshFromMenu" aria-label="重新同步"></button></view><view class="menu-item action-frame"><app-icon name="copy" :size="19" /><text class="menu-label">复制最新回复</text><button class="action-hitbox" hover-class="action-pressed" @click="copyLatestReply" aria-label="复制最新回复"></button></view><view v-if="pendingQuestionCount > 0" class="menu-item action-frame"><text class="menu-label">回答问题（{{ pendingQuestionCount }}）</text><button class="action-hitbox" hover-class="action-pressed" @click="showQuestions" aria-label="回答问题"></button></view><view v-if="approvalCount > 0" class="menu-item action-frame"><text class="menu-label">处理审批（{{ approvalCount }}）</text><button class="action-hitbox" hover-class="action-pressed" @click="showApprovals" aria-label="处理审批"></button></view><view class="menu-item action-frame"><app-icon name="folder" :size="19" /><text class="menu-label">聊天信息</text><button class="action-hitbox" hover-class="action-pressed" @click="showConversationInfo" aria-label="聊天信息"></button></view><view v-if="activeTurnId.length > 0" class="menu-item action-frame" :style="{ opacity: (!canWrite) ? 0.45 : 1 }"><app-icon name="stop" :size="19" /><text class="menu-label">停止任务</text><button class="action-hitbox" hover-class="action-pressed" :disabled="!canWrite" @click="stopFromMenu" aria-label="停止任务"></button></view><view class="menu-item action-frame" :style="{ opacity: (!canWrite) ? 0.45 : 1 }"><view class="archive-icon"><view class="archive-lid"></view><view class="archive-slot"></view></view><text class="menu-label archive-label">归档</text><button class="action-hitbox" hover-class="action-pressed" :disabled="!canWrite" @click="archiveFromMenu" aria-label="归档聊天"></button></view><view class="menu-item action-frame" :style="{ opacity: (!canWrite) ? 0.45 : 1 }"><view class="delete-icon"><view class="delete-handle"></view><view class="delete-lid"></view><view class="delete-bin"><view class="delete-line"></view><view class="delete-line"></view></view></view><text class="menu-label archive-label">永久删除</text><button class="action-hitbox" hover-class="action-pressed" :disabled="!canWrite" @click="deleteFromMenu" aria-label="永久删除聊天"></button></view><view class="menu-item action-frame"><app-icon name="close" :size="19" /><text class="menu-label">取消</text><button class="action-hitbox" hover-class="action-pressed" @click="closeActions" aria-label="取消"></button></view></view></view>
    <delete-confirmation v-if="deleteFinalVisible" :content="deleteFinalContent" @confirm="answerDeleteFinal(true)" @cancel="answerDeleteFinal(false)" />
    <file-change-sheet v-if="selectedFileReport != null" :host-id="pageHostId" :thread-id="pageThreadId" :report="selectedFileReport!" :file-id="selectedChangedFileId" :connected="connection.connected" @close="closeFileReport" />
    <annotation-sheet v-if="selectedAnnotationId.length > 0" :items="selectedAnnotations" @close="closeAnnotations" />
    <task-notice :active="pageVisible" header-id="conversation-header" :host-id="pageHostId" :thread-id="pageThreadId" />
    <plugin-picker v-if="pluginOpen && pageVisible" :host-id="pageHostId" :thread-id="pageThreadId" project-id="" :plugins="draftPlugins" @confirm="selectPlugins" @close="pluginOpen = false" />
  </view>
</template>


<script setup lang="uts">
import { computed, ref, watch, nextTick } from 'vue'
import PluginPicker from '../../components/plugin-picker/plugin-picker.uvue'
import PluginChips from '../../components/plugin-chips/plugin-chips.uvue'
import type { SelectedPlugin } from '../../services/plugins.uts'
import { pluginMessageText } from '../../services/plugins.uts'
import { readDraftPlugins, saveDraftPlugins } from '../../services/composer.uts'
import MessageQueue from '../../components/message-queue/message-queue.uvue'
import { QueuedMessage } from '../../services/message-queue.uts'
import { messageSendingPreferences } from '../../services/message-sending-preferences.uts'
import { QueueEditDraft, QueueEditPlugin, isQueueEditing, beginQueueEdit, finishQueueEdit, restoreQueuedDraft } from '../../services/queue-edit.uts'
import { readDraft, saveDraft, readDraftImages, saveDraftImages, DraftImage, readDraftFiles, saveDraftFiles, DraftFile, rememberSubmission, settleSubmission } from '../../services/composer.uts'
import { shouldExpandComposer, composerInputHeight } from '../../services/composer-layout.uts'
import { prepareImage, MAX_COMPOSER_IMAGES } from '../../services/images.uts'
import { bindImagePaste } from '../../services/image-paste.uts'
import { bridge, connection, ChatMessage, Computer, ThreadSummary, QuestionAnswer, QuestionGroup, Approval, conversationTaskState } from '../../services/bridge.uts'
import { removeArchivedThread, removeDeletedThreads } from '../../services/thread-list.uts'
import { queueArchiveSuccessNotice, consumeArchiveSuccessNotice, queueDeleteSuccessNotice, consumeDeleteSuccessNotice } from '../../services/page-notices.uts'
import { clearDeletedDrafts } from '../../services/composer.uts'
import type { PendingCommand } from '../../services/bridge.uts'
import { conversationOpeningTitle, conversationDisplayTitle, conversationProjectName } from '../../services/conversation-opening.uts'
import { TimelineEntry, executionTimeline, reportTimeline, executionTitle as executionRecordTitle, executionGroupExpanded, retainExpandedExecutions, toggleExecutionGroup } from '../../services/executions.uts'
import { failureTimeline, retryTarget, latestFailureTurnId } from '../../services/turn-failure.uts'
import { HistoryPage, conversationWithHistory } from '../../services/history.uts'
import type { Conversation } from '../../services/bridge.uts'
import { CachedConversation, readConversationCache, saveConversationCache, cachedConversationSnapshot, clearConversationCache } from '../../services/conversation-cache.uts'
import { MessageAnnotation, MessagePresentation, parseAnnotationReferences, annotationPresentationsForTimeline } from '../../services/annotations.uts'
import { presentConversationMessages } from '../../services/message-presentations.uts'
import { FileReport } from '../../services/file-reports.uts'
import FileChangeSummary from '../../components/file-change-summary/file-change-summary.uvue'
import FileChangeSheet from '../../components/file-change-sheet/file-change-sheet.uvue'
import DeleteConfirmation from '../../components/delete-confirmation/delete-confirmation.uvue'
import AnnotationSheet from '../../components/annotation-sheet/annotation-sheet.uvue'
import QuestionCard from '../../components/question-card/question-card.uvue'
import MarkdownBody from '../../components/markdown-body/markdown-body.uvue'
import MessageImages from '../../components/message-images/message-images.uvue'
import PermissionsControl from '../../components/permissions-control/permissions-control.uvue'
import TaskNotice from '../../components/task-notice/task-notice.uvue'
import { taskNotifications, pendingTaskNotice } from '../../services/task-notifications.uts'
import { taskNoticeAnchor } from '../../services/task-notification-state.uts'
import AppIcon from '../../components/app-icon/app-icon.uvue'
import ComposerPlus from '../../components/composer-plus/composer-plus.uvue'
import TaskStatus from '../../components/task-status/task-status.uvue'
import LoadingSkeleton from '../../components/loading-skeleton/loading-skeleton.uvue'
import GoalCard from '../../components/goal-card/goal-card.uvue'
import { ThreadGoal } from '../../services/goals.uts'
import ComposerOptions from '../../components/composer-options/composer-options.uvue'
import { ExecutionSettings, ModelOption, SettingsResponse, effortLabel, shortModelLabel, mergeSettingsSnapshot, mergeSettingsRead, resolveSettingsEffort } from '../../services/execution-settings.uts'
import { readFileBase64, validateFile, fileSizeLabel, FILE_CHUNK_BYTES } from '../../services/files.uts'
// 操作错误仅属于当前页面，公共连接和会话读取错误分别展示。
const operationError = ref('')
const detailError = computed((): string => operationError.value.length > 0 ? operationError.value : connection.conversationError.length > 0 ? connection.conversationError : connection.error)
const pageHostId = ref('')
const pageThreadId = ref('')
const listTitle = ref('')
const listProjectName = ref('')
const predictionText = ref('')
const predictionFocus = ref(false)
const inputFocused = ref(false)
const permissionMenuOpen = ref(false)
const predictionHeight = ref(24)
let composerBlurTimer = 0
let composerMeasureRevision = 0
let composerAnimationTimer = 0
let composerAnimationRevision = 0
let composerKeyboardVisible = false
let predictionTimer = 0
let predictionExpiryTimer = 0
let predictionRevision = 0
let predictionDeadline = 0
const draft = computed((): string => readDraft(pageHostId.value, pageThreadId.value))
const queueEditing = computed((): boolean => isQueueEditing(pageHostId.value, pageThreadId.value))
const draftImages = computed((): DraftImage[] => readDraftImages(pageHostId.value, pageThreadId.value))
const draftPlugins = computed((): SelectedPlugin[] => readDraftPlugins(pageHostId.value, pageThreadId.value))
const pluginOpen = ref(false)
const imageBusy = ref(false)
const draftFiles = computed((): DraftFile[] => readDraftFiles(pageHostId.value, pageThreadId.value))
const filesReady = computed((): boolean => draftFiles.value.every((file: DraftFile): boolean => file.status == 'ready'))
const composerMenu = ref('')
const settings = ref<ExecutionSettings | null>(null)
const models = ref<ModelOption[]>([])
const settingsLoading = ref(false)
const settingsBusy = ref(false)
const settingsError = ref('')
const menuHeight = ref(280)
const menuBottom = ref(134)
const menuWidth = ref(Math.min(330, uni.getWindowInfo().windowWidth - 28))
let settingsRequest = 0
let settingsRetryTimer = 0
let settingsRetryCount = 0
// 设置快照每次变化都推进代次，读写回执不能覆盖较新的桌面模式。
let settingsSnapshotRevision = 0
const hiddenPlanId = ref('')
const planFeedback = ref('')
const pendingPlan = computed(() => connection.snapshot?.threadId == pageThreadId.value && connection.snapshot?.readOnly != true ? connection.snapshot?.pendingPlan ?? null : null)
// 切换会话或计划时清空旧反馈。
watch((): string => pageHostId.value + ':' + pageThreadId.value + ':' + (pendingPlan.value?.id ?? ''), () => { planFeedback.value = ''; hiddenPlanId.value = '' })
function hidePlan() { hiddenPlanId.value = pendingPlan.value?.id ?? '' }
// 使用幂等写入通道；未知结果由命令状态核对，不自动重发。
function replyPlan(action: string) {
  if (!canWrite.value || busy.value || pendingPlan.value == null) return
  const planId = pendingPlan.value!.id
  const hostId = pageHostId.value
  const threadId = pageThreadId.value
  busy.value = true; pendingAction.value = 'plan'; operationError.value = ''
  bridge.request('turn.send', { threadId, planId, planAction: action, text: planFeedback.value.trim() }, true).then((_: UTSJSONObject) => {
    busy.value = false; pendingAction.value = ''
    if (isCurrentPage() && pageHostId.value == hostId && pageThreadId.value == threadId) { hiddenPlanId.value = planId; planFeedback.value = ''; notify(action == 'implement' ? '已提交实施计划' : '修改意见已发送'); refresh() }
  }, (error: Error) => { busy.value = false; pendingAction.value = ''; if (isCurrentPage() && pageHostId.value == hostId && pageThreadId.value == threadId) operationError.value = error.message })
}
const planEnabled = computed((): boolean => settings.value?.mode == 'plan')
const composerSettings = computed((): ExecutionSettings | null => settings.value == null ? null : { model: settings.value!.model, effort: settings.value!.effort, serviceTier: settings.value!.serviceTier, mode: planEnabled.value ? 'plan' : 'default' } as ExecutionSettings)
// 只有当前会话已同步后才能判断能力，初次加载或切换会话时不显示升级提示。
const executionSettingsUnavailable = computed((): boolean => connection.snapshot != null && connection.snapshot?.threadId == pageThreadId.value && connection.snapshot?.supportsExecutionSettings != true)
const modelLabel = computed((): string => {
  if (settingsBusy.value) return '正在同步…'
  if (!connection.connected) return '等待连接'
  if (connection.snapshot?.threadId != pageThreadId.value) return '正在加载…'
  if (connection.snapshot?.readOnly == true) return '历史浏览'
  if (settings.value == null) return '跟随电脑端'
  const model = models.value.find((item: ModelOption): boolean => item.id == settings.value?.model)
  return shortModelLabel(model?.label ?? settings.value!.model) + ' ' + effortLabel(settings.value!.effort)
})
const modelSupportsImages = computed((): boolean => models.value.find((item: ModelOption): boolean => item.id == settings.value?.model)?.supportsImages != false)
const busy = ref(false)
const goalBusy = ref(false)
const goalExpanded = ref(false)
const goalOpenRequest = ref(0)
const goalCloseRequest = ref(0)
const pageVisible = ref(false)
onShow(() => { pageVisible.value = true })
onHide(() => { pageVisible.value = false; pluginOpen.value = false })
watch((): string => [connection.hostId, pageHostId.value, pageThreadId.value, connection.activeThreadId].join(':'), () => { pluginOpen.value = false })
const pendingAction = ref('')
const activating = ref(false)
const autoConnectPending = ref(false)
let activationRequest = 0
const actionsVisible = ref(false)
const following = ref(true)
const atTimelineBottom = ref(true)
const scrollTarget = ref('')
const selectedFileReport = ref<FileReport | null>(null)
const selectedChangedFileId = ref('')
// 文件面板独立于聊天滚动；关闭后保持原报告阅读位置。
function openFileReport(report: FileReport, fileId: string) { pauseFollowing(); uni.hideKeyboard(); selectedFileReport.value = report; selectedChangedFileId.value = fileId }
function closeFileReport() { selectedFileReport.value = null; selectedChangedFileId.value = '' }
const selectedExecutionId = ref('')
const selectedAnnotationId = ref('')
const historyPage = ref<HistoryPage | null>(null)
const loadingHistory = ref(false)
const historyError = ref('')
const historyScrollTop = ref(0)
let initialHistoryChecked = false
let historyRequest = 0
let historyGesture = 0
let lastHistoryGesture = -1
let historyTopTimer = 0
let historyFollowRevision = 0
const cachedDetail = ref<CachedConversation | null>(null)
const pageCacheNamespace = ref('')
const liveConversation = computed((): Conversation | null => connection.hostId == pageHostId.value && connection.snapshot?.threadId == pageThreadId.value ? connection.snapshot : null)
const showingCachedContent = computed((): boolean => liveConversation.value == null && cachedDetail.value != null && pageCacheNamespace.value == connection.cacheNamespace)
// 骨架仅表示有缓存时的联网同步；失败、离线和同步完成立即收起。
const cacheRefreshing = computed((): boolean => showingCachedContent.value && connection.connected && detailError.value.length == 0)
const cacheSyncHint = computed((): string => detailError.value.length > 0 ? '同步失败，当前显示缓存' : !connection.connected ? '当前显示缓存，连接恢复后同步' : '')
const displayConversation = computed(() => conversationWithHistory(liveConversation.value ?? (showingCachedContent.value ? cachedConversationSnapshot(cachedDetail.value!) : null), historyPage.value))
const selectedExecution = computed((): ChatMessage | null => displayConversation.value?.messages.find((message: ChatMessage): boolean => message.id == selectedExecutionId.value && message.role != 'user' && message.role != 'assistant') ?? null)
const expandedReportIds = ref<string[]>([])
const messagePresentations = computed((): MessagePresentation[] => presentConversationMessages(displayConversation.value?.messages ?? [] as ChatMessage[]))
const selectedAnnotations = computed((): MessageAnnotation[] => timeline.value.find((entry: TimelineEntry): boolean => entry.id == selectedAnnotationId.value)?.annotations ?? [] as MessageAnnotation[])
// 只替换新建时间线条目的展示字段，原快照仍用于发送、历史合并和图片读取。
const timeline = computed((): TimelineEntry[] => {
  const entries = failureTimeline(displayConversation.value, reportTimeline(displayConversation.value, expandedReportIds.value))
  const presentations = annotationPresentationsForTimeline(messagePresentations.value, entries.map((entry: TimelineEntry): string => entry.id))
  entries.forEach((entry: TimelineEntry) => {
    const presentation = presentations.find((message: MessagePresentation): boolean => message.messageId == entry.id)
    if (presentation != null) { entry.text = presentation.text; entry.annotations = presentation.annotations; entry.attachments = presentation.attachments }
  })
  return entries
})
const expandedExecutionIds = ref<string[]>([])
const expandedQuestionIds = ref<string[]>([])
const handledApprovalIds = ref<string[]>([])
const submittedGroupIds = ref<string[]>([])
const draftHeight = ref(64)
const keyboardInset = ref(0)
const goalViewportHeight = ref(uni.getWindowInfo().windowHeight)
// 用户气泡保留左侧层级留白，正文使用两侧各 16px 以内的宽度。
const messageWindowWidth = ref(uni.getWindowInfo().windowWidth)
const userBubbleWidth = computed((): number => Math.max(120, messageWindowWidth.value - 80))
// 长文件名单行显示时也要及时约束气泡，适配横竖屏与浏览器视口切换。
onResize(() => { messageWindowWidth.value = uni.getWindowInfo().windowWidth })
let baseWindowHeight = 0
let lastScrollTop = 0
let layoutUntil = 0
let touchingTimeline = false
let pageAlive = true
const activeTurnId = computed((): string => connection.snapshot?.activeTurnId ?? '')
const queuedMessages = computed((): QueuedMessage[] => connection.hostId == pageHostId.value && connection.snapshot?.threadId == pageThreadId.value ? connection.snapshot?.queuedMessages ?? [] as QueuedMessage[] : [] as QueuedMessage[])
const approvalCount = computed((): number => connection.snapshot?.approvals.length ?? 0)
// 末尾只保留可回答题组；已回答记录沿原聊天时间线展示，不再追加重复卡片。
const pendingQuestionGroups = computed((): QuestionGroup[] => connection.snapshot?.questionGroups.filter((group: QuestionGroup): boolean => group.state == 'pending') ?? [])
const pendingQuestionCount = computed((): number => pendingQuestionGroups.value.length)
const currentTaskState = computed((): string => conversationTaskState(connection.snapshot, connection.connected && connection.computers.some((computer: Computer): boolean => computer.id == pageHostId.value && computer.online)))
const hostName = computed((): string => connection.computers.find((computer: Computer): boolean => computer.id == pageHostId.value)?.label ?? '电脑')
// 与标题共用当前电脑和会话的身份限制，加载期间不显示其他会话的项目。
const projectName = computed((): string => conversationProjectName(listProjectName.value, connection.hostId == pageHostId.value && connection.snapshot?.threadId == pageThreadId.value ? connection.snapshot?.cwd ?? '' : cachedDetail.value?.cwd ?? ''))
// 后台历史只用于浏览，写操作须有原桌面的实时所有者和快照。
const readOnly = computed((): boolean => connection.snapshot?.readOnly == true)
const goalHostOnline = computed((): boolean => connection.computers.some((computer: Computer): boolean => computer.id == pageHostId.value && computer.online))
const goalContentHeight = computed((): number => Math.max(60, Math.min(200, goalViewportHeight.value - keyboardInset.value - 360)))
const goalUnavailableReason = computed((): string => !connection.connected || !goalHostOnline.value ? '电脑连接已断开，恢复连接后可操作目标。' : readOnly.value ? '历史浏览期间只能查看目标。' : connection.snapshot?.supportsGoalControl != true ? '更新 Windows 电脑连接服务后可操作目标。' : connection.pendingCommandId.length > 0 && !goalBusy.value ? '操作正在提交，请稍候。' : '')
const conversationConnectionHint = computed((): string => {
  if (activating.value) return '正在连接聊天…'
  if (connection.pendingCommandId.length > 0) return autoConnectPending.value ? '操作提交结束后将自动连接此聊天。' : '操作正在提交，请稍后重新连接。'
  if (!connection.connected) return autoConnectPending.value ? '连接恢复后将自动连接此聊天。' : '连接恢复后可重新连接此聊天。'
  return autoConnectPending.value ? '正在等待电脑连接此聊天…' : '聊天连接未完成，历史内容和草稿已保留。'
})
const openingTitle = computed((): string => conversationOpeningTitle(connection.snapshot != null, detailError.value, connection.connected))
// 仅使用当前电脑和会话的快照名称；加载、断线或空名称均保留列表标题。
const displayTitle = computed((): string => conversationDisplayTitle(listTitle.value, connection.hostId == pageHostId.value && connection.snapshot?.threadId == pageThreadId.value ? connection.snapshot?.title ?? '' : cachedDetail.value?.title ?? '', openingTitle.value))
const submittedRetryKey = ref('')
const displayFailureTurnId = computed((): string => latestFailureTurnId(displayConversation.value))
const pendingRetryCommand = computed((): string => connection.pendingCommands.find((entry: PendingCommand): boolean => entry.hostId == pageHostId.value && entry.threadId == pageThreadId.value && entry.method == 'turn.retry')?.id ?? '')
const retryTurnId = computed((): string => retryTarget(liveConversation.value))
const primaryAvailable = computed((): boolean => canWrite.value && !imageBusy.value && filesReady.value && (draft.value.trim().length > 0 || draftImages.value.length > 0 || draftFiles.value.length > 0 || activeTurnId.value.length > 0 || canRetryTurn(retryTurnId.value)))
const canWrite = computed((): boolean => !readOnly.value && !activating.value && connection.connected && !busy.value && connection.pendingCommandId.length == 0 && connection.hostId == pageHostId.value && connection.activeThreadId == pageThreadId.value && connection.snapshot?.threadId == pageThreadId.value)

let cacheWriteTimer = 0
let cacheDirty = false
// 缓存写入受页面、配对和授权共同约束；旧页面不能在清理后重新写回内容。
function flushConversationCache() {
  clearTimeout(cacheWriteTimer); cacheWriteTimer = 0
  if (!cacheDirty) return
  cacheDirty = false
  const namespace = pageCacheNamespace.value
  if (namespace.length == 0 || namespace != connection.cacheNamespace || !pageAlive || !isCurrentPage() || liveConversation.value == null) return
  if (connection.connected && !connection.computers.some((computer: Computer): boolean => computer.id == pageHostId.value)) return
  saveConversationCache(namespace, pageHostId.value, liveConversation.value!, historyPage.value)
}
// 固定窗口节流，持续输出也会落盘；不因每个分片重新延后写入。
function scheduleConversationCache() {
  if (liveConversation.value == null || pageCacheNamespace.value.length == 0) return
  cacheDirty = true
  if (cacheWriteTimer == 0) cacheWriteTimer = setTimeout(() => { flushConversationCache() }, 500)
}
// 只恢复额外历史，不把缓存最近快照混入历史，且不恢复旧分页游标。
function restoreConversationCache() {
  pageCacheNamespace.value = connection.cacheNamespace ?? ''
  if (pageCacheNamespace.value.length == 0) return
  cachedDetail.value = readConversationCache(pageCacheNamespace.value, pageHostId.value, pageThreadId.value)
  const cached = cachedDetail.value
  if (cached != null && cached.olderMessages.length > 0) historyPage.value = { messages: cached.olderMessages, turns: cached.olderTurns, cursor: '', hasMore: true } as HistoryPage
}
watch(liveConversation, () => { beforeMarkdownLayout(); scheduleConversationCache(); nextTick(() => { afterMarkdownLayout() }) })
watch(historyPage, () => { scheduleConversationCache() })
// 配对切换和授权撤回立即撤掉展示缓存；普通掉线继续保留正文。
watch((): string => connection.cacheNamespace + ':' + connection.connected + ':' + connection.computers.map((computer: Computer): string => computer.id).join('|'), () => {
  if (pageCacheNamespace.value.length == 0) return
  if (pageCacheNamespace.value != connection.cacheNamespace || (connection.connected && !connection.computers.some((computer: Computer): boolean => computer.id == pageHostId.value))) {
    clearTimeout(cacheWriteTimer); cacheWriteTimer = 0; cacheDirty = false
    cachedDetail.value = null; historyPage.value = null; historyRequest++
  }
})
onHide(() => { flushConversationCache() })
onUnload(() => { flushConversationCache(); clearTimeout(cacheWriteTimer) })

onLoad((options: OnLoadOptions) => {
  // 已保存的配对在应用启动时恢复；未配置时先返回首页。
  // #ifdef WEB
  if (!connection.configured) { uni.reLaunch({ url: '/pages/index/index' }); return }
  // #endif
  baseWindowHeight = uni.getWindowInfo().windowHeight
  const notice = (options['noticeKey'] ?? '').length > 0 ? pendingTaskNotice(options['noticeKey'] ?? '') : null
  pageHostId.value = notice?.hostId ?? connection.hostId
  const id = options['threadId'] ?? ''; pageThreadId.value = id
  // 页面参数已由框架解码，直接保留百分号及形似转义序列的原始名称。
  listTitle.value = options['title'] ?? ''
  listProjectName.value = options['projectName'] ?? ''
  if (id.length > 0) restoreConversationCache()
  if (id.length > 0 && notice == null) bridge.watch(id)
  scheduleConversationCache()
})

// 预测只在当前实时会话的空草稿中展示，任何身份、轮次或连接变化立即失效。
const predictionAllowed = computed((): boolean => pageVisible.value && canWrite.value && goalHostOnline.value && connection.snapshot?.supportsComposerPrediction == true && (connection.snapshot?.predictionTurnId ?? '').length > 0 && activeTurnId.value.length == 0 && currentTaskState.value != 'running' && draft.value.length == 0 && draftImages.value.length == 0 && draftFiles.value.length == 0 && draftPlugins.value.length == 0 && pendingQuestionCount.value == 0 && approvalCount.value == 0)
const visiblePrediction = computed((): string => predictionAllowed.value ? predictionText.value : '')
function resetPrediction() { predictionRevision++; clearTimeout(predictionTimer); clearTimeout(predictionExpiryTimer); predictionText.value = ''; predictionDeadline = 0 }
// 按完成时间串行轮询；旧页面和旧轮次的迟到回执不会写回当前输入框。
function pollPrediction(revision: number) {
  if (!pageAlive || !predictionAllowed.value || revision != predictionRevision) return
  const threadId = pageThreadId.value
  const turnId = connection.snapshot?.predictionTurnId ?? ''
  bridge.request('thread.prediction.read', { threadId }).then((result: UTSJSONObject) => {
    if (!pageAlive || revision != predictionRevision || !predictionAllowed.value) return
    const prediction = result['prediction'] as UTSJSONObject | null
    predictionText.value = prediction?.getString('threadId') == threadId && prediction?.getString('sourceTurnId') == turnId ? prediction?.getString('text') ?? '' : ''
    predictionDeadline = Date.now() + 5000
    clearTimeout(predictionExpiryTimer)
    predictionExpiryTimer = setTimeout(() => { if (revision == predictionRevision) predictionText.value = '' }, 5000)
    predictionTimer = setTimeout(() => { if (revision == predictionRevision) pollPrediction(revision) }, 2500)
  }, (_: Error) => {
    if (!pageAlive || revision != predictionRevision) return
    predictionText.value = ''
    predictionTimer = setTimeout(() => { pollPrediction(revision) }, 5000)
  })
}
watch((): string => pageHostId.value + ':' + pageThreadId.value + ':' + connection.epoch + ':' + connection.subscriptionRevision + ':' + (connection.snapshot?.predictionTurnId ?? '') + ':' + predictionAllowed.value, () => { resetPrediction(); if (predictionAllowed.value) pollPrediction(predictionRevision) }, { flush: 'sync' })
// 预测只用作占位提示，首次回车才写入空草稿，始终沿用手动发送。
function acceptPrediction(focus: boolean = true) {
  if (!predictionAllowed.value || visiblePrediction.value.length == 0 || Date.now() > predictionDeadline) { resetPrediction(); return }
  const text = visiblePrediction.value
  resetPrediction()
  saveDraft(pageHostId.value, pageThreadId.value, text)
  if (focus) nextTick(() => { predictionFocus.value = true })
}
onUnload(() => { resetPrediction() })

// 回车先采纳占位预测；已有草稿才提交，空输入不会触发停止任务。
function applyComposerEnter() {
  if (!canWrite.value || imageBusy.value || !filesReady.value) return
  if (draft.value.length == 0 && visiblePrediction.value.length > 0) { acceptPrediction(false); return }
  if (draft.value.trim().length > 0 || draftImages.value.length > 0 || draftFiles.value.length > 0) send()
}
// 浏览器处理回车时保留 Shift 换行及中文输入法选词，长按不重复提交。
function onComposerKeydown(event: UniEvent) {
  // #ifdef WEB
  const key = event as KeyboardEvent
  if (key.key != 'Enter' || key.isComposing || key.keyCode == 229 || key.shiftKey || key.ctrlKey || key.altKey || key.metaKey) return
  key.preventDefault()
  if (key.repeat) return
  applyComposerEnter()
  // #endif
}
// Web 已由 keydown 处理，避免同一次回车又触发 confirm 而连续采纳、发送。
function onComposerConfirm() {
  // #ifndef WEB
  applyComposerEnter()
  // #endif
}

function notify(message: string) { uni.showToast({ title: message, icon: 'none' }) }
// 原页面卸载后仍结算提交记录，但异步回执不再修改首页提示或重新同步。
onUnload(() => { autoConnectPending.value = false; activationRequest++; pageAlive = false; settingsRequest++; clearTimeout(settingsRetryTimer); bridge.cancelOpen(pageThreadId.value); historyRequest++; clearTimeout(historyTopTimer) })
function isCurrentPage(): boolean { return pageAlive && connection.hostId == pageHostId.value && connection.activeThreadId == pageThreadId.value }
// 自定义返回入口先收起键盘，系统返回仍保留框架行为及按会话保存的草稿。
function closeComposerMenu() { composerMenu.value = '' }
function goBack() { if (selectedFileReport.value != null) { closeFileReport(); return }; if (selectedAnnotationId.value.length > 0) { closeAnnotations(); return }; if (composerMenu.value.length > 0) { closeComposerMenu(); return }; uni.hideKeyboard(); if (selectedExecutionId.value.length > 0) { selectedExecutionId.value = ''; return }; if (getCurrentPages().length > 1) uni.navigateBack(); else uni.reLaunch({ url: '/pages/index/index' }) }
function closeActions() { actionsVisible.value = false }
function showActions() { closeComposerMenu(); actionsVisible.value = !actionsVisible.value; uni.hideKeyboard() }
function refresh() { operationError.value = '';  if (!connection.connected) bridge.resume(); else if (connection.activeThreadId.length > 0) bridge.watch(connection.activeThreadId) }
// 重试仅恢复电脑导航，草稿不会被发送。
function retryDesktopOpen() { if (!isCurrentPage() || activating.value) return; activating.value = true; bridge.openThread(pageThreadId.value).then((_: UTSJSONObject) => { if (isCurrentPage()) activating.value = false }, (_: Error) => { if (isCurrentPage()) activating.value = false }) }
function refreshFromMenu() { closeActions(); refresh(); notify('正在同步聊天') }
// 打开只读会话即表示请求加载；仅取得真实快照，不发送草稿或其他任务指令。
function continueConversation() {
  if (!isCurrentPage() || !pageVisible.value || !readOnly.value || connection.snapshot?.threadId != pageThreadId.value || activating.value || !connection.connected || connection.pendingCommandId.length > 0) return
  if (!connection.computers.some((computer: Computer): boolean => computer.id == pageHostId.value && computer.online)) return
  autoConnectPending.value = false
  activating.value = true
  operationError.value = ''
  const request = ++activationRequest
  bridge.openThread(pageThreadId.value).then((_: UTSJSONObject) => {
    if (request != activationRequest || !isCurrentPage()) return
    activating.value = false
  }, (error: Error) => {
    if (request != activationRequest || !isCurrentPage()) return
    activating.value = false; operationError.value = error.message
  })
}
// 每次进入页面只自动尝试一次；实时会话取消意图，后台恢复和失败不循环导航电脑。
function tryAutoConnectConversation() {
  if (!autoConnectPending.value || !pageVisible.value || !isCurrentPage() || connection.snapshot?.threadId != pageThreadId.value) return
  if (bridge.syncingThread == pageThreadId.value) return
  if (!readOnly.value) { autoConnectPending.value = false; return }
  continueConversation()
}
// 在方法声明后注册监听，兼容 Android UTS；离线或提交中保留本次打开意图。
watch((): string => pageHostId.value + ':' + pageThreadId.value + ':' + connection.hostId + ':' + connection.activeThreadId + ':' + connection.epoch + ':' + connection.sequence + ':' + (connection.snapshot?.threadId ?? '') + ':' + readOnly.value + ':' + connection.connected + ':' + connection.pendingCommandId + ':' + pageVisible.value + ':' + connection.computers.some((computer: Computer): boolean => computer.id == pageHostId.value && computer.online), () => { tryAutoConnectConversation() }, { immediate: true })
function copyText(text: string) { uni.setClipboardData({ data: text, success: (_) => { notify('已复制') }, fail: (_) => { notify('复制失败，请长按选择文字') } }) }
function copyLatestReply() { closeActions(); const messages = displayConversation.value?.messages ?? []; for (let index = messages.length - 1; index >= 0; index--) { if (messages[index].role == 'assistant') { copyText(parseAnnotationReferences(messages[index].text).text); return } }; notify('还没有可复制的回复') }
function showConversationInfo() { closeActions(); uni.showModal({ title: '聊天信息', content: displayTitle.value + '\n\n电脑：' + hostName.value + '\n项目：' + (displayConversation.value?.cwd ?? '') + '\n连接：' + connection.status, showCancel: false, confirmText: '知道了' }) }

// 永久删除必须完成两次独立确认；页面变化后旧确认立即失效。
let deletePromptOpen = false
let deletePromptRevision = 0
let deleteLoading = false
const deleteFinalVisible = ref(false)
const deleteFinalContent = ref('')
let deleteFinalAnswer: ((confirmed: boolean) => void) | null = null
// 第二次确认使用明确的左右按钮，关闭或返回始终只执行取消。
function showDeleteFinalModal(content: string, answer: (confirmed: boolean) => void) {
  uni.hideKeyboard(); deleteFinalContent.value = content; deleteFinalAnswer = answer; deleteFinalVisible.value = true
}
function answerDeleteFinal(confirmed: boolean) {
  const answer = deleteFinalAnswer; deleteFinalAnswer = null; deleteFinalVisible.value = false; deleteFinalContent.value = ''
  if (answer != null) answer(confirmed)
}
const pendingDeleteCommand = computed((): string => connection.pendingCommands.find((entry: PendingCommand): boolean => entry.method == 'thread.delete' && entry.hostId == pageHostId.value && entry.threadId == pageThreadId.value)?.id ?? '')
function invalidateDeletePrompt() { deletePromptRevision++; deletePromptOpen = false; deleteFinalAnswer = null; deleteFinalVisible.value = false; deleteFinalContent.value = '' }
watch((): string => pageHostId.value + ':' + pageThreadId.value + ':' + connection.hostId + ':' + connection.activeThreadId + ':' + connection.connected, () => { invalidateDeletePrompt() }, { flush: 'sync' })
function hideDeleteLoading() { if (deleteLoading) { deleteLoading = false; uni.hideLoading() } }
onHide(() => { invalidateDeletePrompt() })
onUnload(() => { invalidateDeletePrompt(); hideDeleteLoading() })

// 成功回执按原电脑和编号清理；迟到回执不能导航其他页面或清理其他电脑的草稿。
function acceptDeleteReceipt(hostId: string, threadId: string, receipt: UTSJSONObject | null, commandId: string = ''): boolean {
  if (receipt?.getBoolean('deleted') != true || receipt?.getString('threadId') != threadId) return false
  let ids = [] as string[]
  try { ids = JSON.parse<string[]>(JSON.stringify(receipt!['deletedThreadIds'])) ?? [] as string[] } catch (_) { return false }
  if (ids.indexOf(threadId) < 0) return false
  const returnToList = isCurrentPage() && pageVisible.value && pageHostId.value == hostId && pageThreadId.value == threadId
  if (commandId.length > 0) bridge.clearCommand(commandId, hostId)
  clearConversationCache(pageCacheNamespace.value, hostId, ids)
  cachedDetail.value = null; cacheDirty = false; clearTimeout(cacheWriteTimer); cacheWriteTimer = 0
  removeDeletedThreads(hostId, ids); clearDeletedDrafts(hostId, ids)
  if (connection.hostId == hostId && ids.indexOf(connection.activeThreadId) >= 0) { connection.activeThreadId = ''; connection.snapshot = null; connection.epoch = ''; connection.sequence = 0 }
  if (pageHostId.value == hostId && ids.indexOf(pageThreadId.value) >= 0) { historyRequest++; historyPage.value = null; historyError.value = ''; operationError.value = '' }
  if (returnToList) {
    queueDeleteSuccessNotice()
    if (getCurrentPages().length > 1) uni.navigateBack({ fail: (_) => { consumeDeleteSuccessNotice(); notify('永久删除成功') } })
    else uni.reLaunch({ url: '/pages/index/index', fail: (_) => { consumeDeleteSuccessNotice(); notify('永久删除成功') } })
  }
  return true
}

function deleteFromMenu() {
  closeActions()
  if (!canWrite.value || deletePromptOpen || archivePromptOpen) return
  const hostId = pageHostId.value; const threadId = pageThreadId.value
  const revision = ++deletePromptRevision
  deletePromptOpen = true
  const current = (): boolean => revision == deletePromptRevision && pageVisible.value && isCurrentPage() && pageHostId.value == hostId && pageThreadId.value == threadId && connection.hostId == hostId && canWrite.value
  const finishPrompt = () => { if (revision == deletePromptRevision) deletePromptOpen = false }
  uni.showModal({ title: '永久删除聊天', content: '将永久删除该聊天及其子智能体聊天，无法恢复。', confirmText: '继续', confirmColor: '#bb3f44', cancelText: '取消', success: (first) => {
    if (!first.confirm || !current()) { finishPrompt(); return }
    showDeleteFinalModal('正在执行的任务会先停止。确认永久删除吗？', (confirmed: boolean) => {
      if (!confirmed || !current()) { finishPrompt(); return }
      finishPrompt(); busy.value = true; pendingAction.value = 'delete'; operationError.value = ''
      deleteLoading = true; uni.showLoading({ title: '正在永久删除…', mask: true })
      bridge.request('thread.delete', { threadId }, true).then((result: UTSJSONObject) => {
        hideDeleteLoading(); busy.value = false; pendingAction.value = ''
        if (!acceptDeleteReceipt(hostId, threadId, result) && isCurrentPage()) operationError.value = '永久删除回执需要核对，请勿重复提交'
      }, (error: Error) => { hideDeleteLoading(); busy.value = false; pendingAction.value = ''; if (isCurrentPage() && pageHostId.value == hostId && pageThreadId.value == threadId) { operationError.value = error.message; notify(error.message) } })
    })
  }, fail: (_) => { finishPrompt() } })
}

// 未知结果只查询原命令状态，不重新提交删除或停止任务。
function checkDeleteOutcome() {
  if (!connection.connected || busy.value || pendingDeleteCommand.value.length == 0 || connection.hostId != pageHostId.value) return
  const hostId = pageHostId.value; const threadId = pageThreadId.value; const commandId = pendingDeleteCommand.value
  busy.value = true
  bridge.request('command.status', { commandId }).then((status: UTSJSONObject) => {
    busy.value = false
    if (acceptDeleteReceipt(hostId, threadId, status['result'] as UTSJSONObject | null, commandId)) return
    const error = status['error'] as UTSJSONObject | null
    if (status.getString('state') == 'done' && error?.getBoolean('outcomeUnknown') != true) { bridge.clearCommand(commandId, hostId); if (isCurrentPage()) operationError.value = error?.getString('message') ?? '删除未完成，聊天已保留' }
    else if (isCurrentPage()) operationError.value = '永久删除结果仍待核对，请稍后再次核对或查看原桌面，勿重复提交'
  }, (error: Error) => { busy.value = false; if (isCurrentPage()) operationError.value = error.message })
}

// 归档只在原生回执确认后移除列表项；草稿继续按原会话编号保留。
function acceptArchiveReceipt(hostId: string, receipt: UTSJSONObject | null, commandId: string = ''): boolean {
  if (receipt?.getBoolean('archived') != true || receipt?.getString('threadId') != pageThreadId.value || connection.hostId != hostId) return false
  const threadId = pageThreadId.value
  const returnToList = isCurrentPage() && pageVisible.value
  if (commandId.length > 0) bridge.clearCommand(commandId, hostId)
  clearConversationCache(pageCacheNamespace.value, hostId, [threadId]); cachedDetail.value = null; cacheDirty = false; clearTimeout(cacheWriteTimer); cacheWriteTimer = 0; removeArchivedThread(hostId, threadId)
  connection.threads = connection.threads.filter((thread: ThreadSummary): boolean => thread.id != threadId)
  if (connection.activeThreadId == threadId) { connection.activeThreadId = ''; connection.snapshot = null; connection.epoch = ''; connection.sequence = 0 }
  operationError.value = ''
  // 列表页在显示时消费结果，详情页卸载及全局加载框清理不会移除列表页提示。
  if (returnToList) {
    queueArchiveSuccessNotice()
    if (getCurrentPages().length > 1) uni.navigateBack({ fail: (_) => { consumeArchiveSuccessNotice(); notify('归档成功') } })
    else uni.reLaunch({ url: '/pages/index/index', fail: (_) => { consumeArchiveSuccessNotice(); notify('归档成功') } })
  }
  return true
}
let archivePromptOpen = false
let archiveLoading = false
// 仅关闭本页发起的归档加载框，避免迟到回执关闭其他页面的提示。
function hideArchiveLoading() { if (!archiveLoading) return; archiveLoading = false; uni.hideLoading() }
// 确认框返回时重新核对页面和连接，避免切换会话后误归档。
function archiveFromMenu() {
  closeActions()
  if (!canWrite.value || archivePromptOpen) return
  if (connection.snapshot?.status != 'idle' || activeTurnId.value.length > 0 || approvalCount.value > 0) { notify('请先完成或停止当前任务，再归档聊天'); return }
  const hostId = pageHostId.value
  const threadId = pageThreadId.value
  archivePromptOpen = true
  uni.showModal({ title: '归档聊天', content: '归档后将从聊天列表移除，可在电脑端的归档记录中找回。', confirmText: '归档', confirmColor: '#bb3f44', cancelText: '取消', success: (choice) => {
    archivePromptOpen = false
    if (!choice.confirm || !isCurrentPage() || !pageVisible.value || connection.hostId != hostId || pageThreadId.value != threadId || !canWrite.value) return
    busy.value = true; pendingAction.value = 'archive'; operationError.value = ''
    archiveLoading = true; uni.showLoading({ title: '正在归档…', mask: true })
    bridge.request('thread.archive', { threadId }, true).then((result: UTSJSONObject) => {
      hideArchiveLoading(); busy.value = false; pendingAction.value = ''
      if (pageThreadId.value == threadId) acceptArchiveReceipt(hostId, result)
    }, (error: Error) => { hideArchiveLoading(); busy.value = false; pendingAction.value = ''; if (isCurrentPage()) { operationError.value = error.message; notify(error.message) } })
  }, fail: (_) => { archivePromptOpen = false } })
}
onUnload(() => { hideArchiveLoading() })

// 自动跟随只在靠近底部时保持；手指阅读期间不抢占滚动位置。
function scrollLatest() { if (touchingTimeline) return; scrollTarget.value = ''; nextTick(() => { if (following.value && !touchingTimeline) scrollTarget.value = 'timeline-bottom' }) }
function resumeFollowing() { historyFollowRevision++; following.value = true; scrollLatest() }
function pauseFollowing() { following.value = false; scrollTarget.value = '' }
// 面板不插入时间线，阅读期间暂停自动跟随；关闭时保持原来的消息位置和草稿。
function openAnnotations(messageId: string) {
  if (!messagePresentations.value.some((message: MessagePresentation): boolean => message.messageId == messageId && message.annotations.length > 0)) return
  closeActions(); closeComposerMenu(); dismissGoal(); uni.hideKeyboard()
  historyGesture++; pauseFollowing(); touchingTimeline = true; selectedAnnotationId.value = messageId
}
function closeAnnotations() { if (selectedAnnotationId.value.length == 0) return; selectedAnnotationId.value = ''; touchingTimeline = false }
onHide(() => { closeAnnotations() })
onUnload(() => { closeAnnotations() })
watch((): string => [connection.hostId, connection.activeThreadId].join(':'), () => { closeAnnotations() })
watch((): boolean => selectedAnnotationId.value.length > 0 && !messagePresentations.value.some((message: MessagePresentation): boolean => message.messageId == selectedAnnotationId.value), (missing: boolean) => { if (missing) closeAnnotations() })
function beginTimelineTouch() { historyGesture++; touchingTimeline = true; pauseFollowing() }
// 按底部锚点的实际位置控制按钮；触摸暂停跟随不代表离开底部。
function updateTimelinePosition() {
  const viewport = uni.getElementById('conversation-timeline')?.getBoundingClientRect()
  const bottom = uni.getElementById('timeline-bottom')?.getBoundingClientRect()
  if (viewport == null || bottom == null || viewport.height <= 0) return
  atTimelineBottom.value = bottom.bottom <= viewport.bottom + 36
  if (atTimelineBottom.value && !touchingTimeline && !loadingHistory.value && Date.now() > layoutUntil) following.value = true
}
function entryAnchor(entry: TimelineEntry): string { return 'message-' + entry.id.split(':').join('-') }
// 正文重排前记录首个可见消息；阅读历史时恢复锚点，不抢占用户的新手势。
let markdownAnchor = ''
let markdownAnchorTop = 0
let markdownGesture = 0
let markdownLayoutPending = false
function beforeMarkdownLayout() {
  if (following.value || touchingTimeline || loadingHistory.value || markdownLayoutPending) return
  const viewport = uni.getElementById('conversation-timeline')?.getBoundingClientRect()
  if (viewport == null) return
  const visible = timeline.value.find((entry: TimelineEntry): boolean => (uni.getElementById(entryAnchor(entry))?.getBoundingClientRect().bottom ?? 0) > viewport.top)
  if (visible == null) return
  markdownAnchor = entryAnchor(visible); markdownAnchorTop = uni.getElementById(markdownAnchor)?.getBoundingClientRect().top ?? viewport.top
  markdownGesture = historyGesture; markdownLayoutPending = true
}
function afterMarkdownLayout() {
  nextTick(() => {
    if (!isCurrentPage()) return
    if (following.value) { markdownLayoutPending = false; scrollLatest(); return }
    if (!markdownLayoutPending) { updateTimelinePosition(); return }
    markdownLayoutPending = false
    if (touchingTimeline || loadingHistory.value || markdownGesture != historyGesture) return
    const current = uni.getElementById(markdownAnchor)?.getBoundingClientRect()
    if (current == null) return
    const target = Math.max(0, lastScrollTop + current.top - markdownAnchorTop)
    if (Math.abs(target - lastScrollTop) < 1) return
    layoutUntil = Date.now() + 350; historyScrollTop.value = -1
    nextTick(() => { if (isCurrentPage() && !touchingTimeline && markdownGesture == historyGesture) historyScrollTop.value = target })
  })
}
// 代码和表格横向阅读期间暂停纵向跟随，结束后保留阅读位置。
function markdownReading(active: boolean) { if (active) { historyGesture++; pauseFollowing() }; touchingTimeline = active }
// 历史只补充正文；响应时合并最新内容，不把请求期间的实时消息覆盖回旧快照。
function readOlderPage(request: number, preserveFollowing: boolean, remaining: number) {
  const base = displayConversation.value
  if (base == null || !isCurrentPage()) { loadingHistory.value = false; return }
  const followRevision = historyFollowRevision
  const cursor = historyPage.value?.cursor ?? ''
  const firstId = base.messages.length > 0 ? base.messages[0].id : ''
  bridge.request('thread.history', { threadId: pageThreadId.value, page: true, before: cursor, beforeMessageId: cursor.length == 0 ? firstId : '' }).then((result: UTSJSONObject) => {
    if (request != historyRequest || !isCurrentPage()) return
    const page = JSON.parse<HistoryPage>(JSON.stringify(result))
    if (page == null || page.messages == null || page.turns == null || (page.hasMore && (page.cursor.length == 0 || page.cursor == cursor))) { historyError.value = '历史游标未推进'; loadingHistory.value = false; return }
    const current = displayConversation.value ?? base
    const added = page.messages.some((message: ChatMessage): boolean => !current.messages.some((item: ChatMessage): boolean => item.id == message.id))
    const viewport = uni.getElementById('conversation-timeline')?.getBoundingClientRect()
    let anchor = timeline.value.length > 0 ? entryAnchor(timeline.value[0]) : ''
    if (viewport != null) {
      const visible = timeline.value.find((entry: TimelineEntry): boolean => (uni.getElementById(entryAnchor(entry))?.getBoundingClientRect().bottom ?? 0) > viewport.top)
      if (visible != null) anchor = entryAnchor(visible)
    }
    const before = anchor.length > 0 ? uni.getElementById(anchor)?.getBoundingClientRect() : null
    const merged = conversationWithHistory(current, page)!
    historyPage.value = { messages: merged.messages, turns: merged.turns ?? [], cursor: page.cursor, hasMore: page.hasMore } as HistoryPage
    if (!added && page.hasMore) {
      if (remaining > 1) { readOlderPage(request, preserveFollowing, remaining - 1); return }
      historyError.value = '本次历史读取已达上限'; loadingHistory.value = false; return
    }
    loadingHistory.value = false; layoutUntil = Date.now() + 350
    nextTick(() => {
      if (request != historyRequest || !isCurrentPage()) return
      if ((preserveFollowing && following.value) || followRevision != historyFollowRevision) { scrollLatest(); return }
      if (!added || anchor.length == 0) return
      following.value = false; scrollTarget.value = ''
      const after = uni.getElementById(anchor)?.getBoundingClientRect()
      if (before != null && after != null) {
        const targetTop = Math.max(0, lastScrollTop + after.top - before.top)
        // 用户滚回顶部后，下一页可能需要相同偏移；先改变属性，确保原生和 Web 都执行恢复。
        historyScrollTop.value = -1
        nextTick(() => { if (request == historyRequest && isCurrentPage()) historyScrollTop.value = targetTop })
      }
      else scrollTarget.value = anchor
    })
  }, (error: Error) => { if (request == historyRequest && isCurrentPage()) { loadingHistory.value = false; historyError.value = error.message } })
}

// 一个触顶手势只发起一个读取链；空块最多连续推进八页，失败后等新手势重试。
function loadOlder(preserveFollowing: boolean = false) {
  if (loadingHistory.value || !isCurrentPage() || !connection.connected || connection.snapshot?.supportsHistoryPages != true || historyPage.value?.hasMore == false || displayConversation.value == null) return
  if (!preserveFollowing) pauseFollowing()
  loadingHistory.value = true; historyError.value = ''
  readOlderPage(++historyRequest, preserveFollowing, 8)
}
function onHistoryTop() {
  if (lastHistoryGesture == historyGesture || (!touchingTimeline && following.value)) return
  const delay = layoutUntil - Date.now()
  if (delay > 0) { clearTimeout(historyTopTimer); historyTopTimer = setTimeout(() => { if (isCurrentPage() && pageVisible.value) onHistoryTop() }, delay + 16); return }
  lastHistoryGesture = historyGesture; loadOlder()
}
// 短会话没有可滚动距离，首个稳定布局自动检查一次，不关闭跟随最新消息。
function checkShortHistory() {
  if (initialHistoryChecked || !isCurrentPage() || !pageVisible.value || !connection.connected || connection.snapshot?.supportsHistoryPages != true || (connection.snapshot?.messages.length ?? 0) == 0) return
  const viewport = uni.getElementById('conversation-timeline')?.getBoundingClientRect()
  const bottom = uni.getElementById('timeline-bottom')?.getBoundingClientRect()
  if (viewport == null || bottom == null || viewport.height <= 0) return
  initialHistoryChecked = true
  if (bottom.bottom <= viewport.bottom + 1) { lastHistoryGesture = historyGesture; loadOlder(true) }
}
function endTimelineTouch() { touchingTimeline = false; if (lastScrollTop <= 60 && !following.value) onHistoryTop(); updateTimelinePosition(); if (following.value) scrollLatest() }
// 内层列表结束触摸不恢复自动跟随，避免新输出打断阅读。
function beginExecutionTouch() { pauseFollowing(); touchingTimeline = true }
function endExecutionTouch() { touchingTimeline = false }
function onTimelineScroll(event: UniScrollEvent) {
  const top = event.detail.scrollTop
  const element = uni.getElementById('conversation-timeline')
  const height = element?.getBoundingClientRect().height ?? 0
  updateTimelinePosition()
  if (height > 0 && Date.now() > layoutUntil) {
    const nearBottom = event.detail.scrollHeight - top - height <= 36
    if (nearBottom && !touchingTimeline) { following.value = true }
    else if (top < lastScrollTop - 6 || touchingTimeline) pauseFollowing()
  }
  if (!touchingTimeline && lastScrollTop > 60 && top <= 60) historyGesture++
  lastScrollTop = top
  if (top <= 60 && !following.value) onHistoryTop()
}
// 新输出后重新测量，短会话无滚动事件时也能隐藏按钮。
watch((): string => (displayConversation.value?.messages ?? []).map((message: ChatMessage): string => message.id + ':' + message.text).join('\n'), (_current: string, _previous: string) => { if (following.value) scrollLatest(); nextTick(() => { updateTimelinePosition(); checkShortHistory() }) })
watch((): string => connection.activeThreadId, (_current: string, _previous: string) => { closeFileReport(); selectedExecutionId.value = ''; expandedReportIds.value = [] as string[]; expandedExecutionIds.value = [] as string[]; expandedQuestionIds.value = [] as string[]; handledApprovalIds.value = [] as string[]; submittedGroupIds.value = [] as string[] }, { flush: 'sync' })
// 快照替换与流式更新保持展开状态，滑动窗口移除记录时清理失效选择。
watch(timeline, (entries: TimelineEntry[]) => {
  if (following.value) scrollLatest()
  nextTick(() => { updateTimelinePosition() })
  if (connection.snapshot == null) return
  // 过程收起时仅隐藏显示，保留其中命令组的手动展开状态。
  expandedExecutionIds.value = retainExpandedExecutions(executionTimeline(displayConversation.value?.messages ?? []), expandedExecutionIds.value)
  const retainedReports = expandedReportIds.value.filter((id: string): boolean => entries.some((entry: TimelineEntry): boolean => entry.role == 'process' && entry.id == id))
  if (retainedReports.length != expandedReportIds.value.length) expandedReportIds.value = retainedReports
  if (selectedExecutionId.value.length > 0 && selectedExecution.value == null) selectedExecutionId.value = ''
})
// 新问题自动展开；同步已有问题时保留手动收起，回答或失效后清理对应状态。
watch(pendingQuestionGroups, (groups: QuestionGroup[], previousGroups: QuestionGroup[] = []) => {
  expandedQuestionIds.value = expandedQuestionIds.value.filter((id: string): boolean => groups.some((group: QuestionGroup): boolean => group.id == id))
  submittedGroupIds.value = submittedGroupIds.value.filter((id: string): boolean => groups.some((group: QuestionGroup): boolean => group.id == id))
  const added = groups.filter((group: QuestionGroup): boolean => !previousGroups.some((previous: QuestionGroup): boolean => previous.id == group.id))
  added.forEach((group: QuestionGroup) => { if (expandedQuestionIds.value.indexOf(group.id) < 0) expandedQuestionIds.value.push(group.id) })
  // 仅在跟随最新消息时随新问题滚动，阅读历史时由常驻入口提示。
  if (added.length > 0 && following.value && pageVisible.value) nextTick(() => { if (following.value && pageVisible.value) scrollLatest() })
}, { immediate: true })
// 模板通过页面方法调用模块，兼容 Android 对导入函数引用的编译限制。
function isExecutionExpanded(entry: TimelineEntry): boolean { return executionGroupExpanded(entry, expandedExecutionIds.value) }
function isProcessExpanded(entry: TimelineEntry): boolean { return expandedReportIds.value.indexOf(entry.id) >= 0 }
// 主动展开或收起时暂停跟随；后续同步不覆盖本轮的阅读选择。
function toggleProcess(entry: TimelineEntry) { pauseFollowing(); uni.hideKeyboard(); layoutUntil = Date.now() + 350; const index = expandedReportIds.value.indexOf(entry.id); if (index >= 0) expandedReportIds.value.splice(index, 1); else expandedReportIds.value.push(entry.id) }
function executionTitle(message: ChatMessage): string { return executionRecordTitle(message) }
// 展开列表前暂停跟随并收起键盘；布局变化不触发自动回到底部。
function toggleExecutions(entry: TimelineEntry) { pauseFollowing(); uni.hideKeyboard(); layoutUntil = Date.now() + 350; expandedExecutionIds.value = toggleExecutionGroup(entry, expandedExecutionIds.value) }
// 现有消息状态沿用所属轮次，不用于推断单条执行结果；辅助行仅说明详情入口。
// 详情独立于主时间线滚动，关闭面板不改变当前阅读位置。
function toggleExecution(id: string) { pauseFollowing(); uni.hideKeyboard(); selectedExecutionId.value = id }
function closeExecution() { selectedExecutionId.value = '' }
function toggleQuestion(id: string) { pauseFollowing(); layoutUntil = Date.now() + 350; const index = expandedQuestionIds.value.indexOf(id); if (index >= 0) expandedQuestionIds.value.splice(index, 1); else expandedQuestionIds.value.push(id) }
function jumpTo(anchor: string) { closeActions(); pauseFollowing(); layoutUntil = Date.now() + 350; scrollTarget.value = ''; nextTick(() => { scrollTarget.value = anchor }) }
// 点击通知后等待目标快照和布局就绪；后续流式更新不重复抢走阅读位置。
function questionNoticeAnchor(id: string): string { return taskNoticeAnchor('question', id) }
function approvalNoticeAnchor(id: string): string { return taskNoticeAnchor('approval', id) }
let focusedNoticeRevision = 0
watch((): string => taskNotifications.focusRevision + ':' + pageVisible.value + ':' + connection.hostId + ':' + (connection.snapshot?.threadId ?? '') + ':' + connection.sequence + ':' + connection.subscriptionRevision, () => {
  const notice = taskNotifications.focus
  if (notice == null || focusedNoticeRevision == taskNotifications.focusRevision || !pageVisible.value || !isCurrentPage() || pageHostId.value != notice.hostId || pageThreadId.value != notice.threadId || connection.snapshot?.threadId != notice.threadId) return
  focusedNoticeRevision = taskNotifications.focusRevision
  closeActions(); closeComposerMenu(); closeAnnotations(); selectedExecutionId.value = ''; goalExpanded.value = false; uni.hideKeyboard()
  nextTick(() => {
    if (!pageVisible.value || !isCurrentPage()) return
    if (notice.kind == 'question') {
      const group = pendingQuestionGroups.value.find((item: QuestionGroup): boolean => item.id == notice.targetId)
      if (group != null) { if (expandedQuestionIds.value.indexOf(group.id) < 0) expandedQuestionIds.value.push(group.id); jumpTo(questionNoticeAnchor(group.id)); return }
    } else if (notice.kind == 'approval') {
      if (connection.snapshot?.approvals.some((item: Approval): boolean => item.id == notice.targetId) == true) { jumpTo(approvalNoticeAnchor(notice.targetId)); return }
    } else if (notice.kind == 'plan' && pendingPlan.value?.id == notice.targetId) {
      hiddenPlanId.value = ''; jumpTo('notice-plan'); return
    }
    const results = timeline.value.filter((entry: TimelineEntry): boolean => entry.turnId == notice.turnId && entry.role == 'assistant')
    jumpTo(results.length > 0 ? entryAnchor(results[results.length - 1]) : 'timeline-bottom')
  })
})
function showApprovals() { jumpTo('approvals-anchor') }
function showQuestions() { const groups = pendingQuestionGroups.value; if (groups.length > 0 && expandedQuestionIds.value.indexOf(groups[0].id) < 0) expandedQuestionIds.value.push(groups[0].id); jumpTo('questions-anchor') }
function updateDraft(event: UniInputEvent) { saveDraft(pageHostId.value, pageThreadId.value, event.detail.value) }
// 选图完成后写回发起选择的会话，页面切换不会把图片放入其他会话。
function chooseImages(source: string = 'album') {
  if (!canWrite.value || imageBusy.value) return
  if (connection.snapshot?.supportsImages != true) { notify('请先更新电脑连接服务以发送图片'); return }
  const hostId = pageHostId.value; const threadId = pageThreadId.value
  const remaining = MAX_COMPOSER_IMAGES - readDraftImages(hostId, threadId).length - readDraftFiles(hostId, threadId).length
  if (remaining <= 0) { notify('每次最多发送3张图片'); return }
  imageBusy.value = true
  uni.chooseImage({ count: remaining, albumMode: 'system', sizeType: ['compressed'], sourceType: [source], success: (result) => {
    Promise.all(result.tempFilePaths.slice(0, remaining).map((path: string): Promise<string> => prepareImage(path))).then((sources: string[]) => {
      const images = readDraftImages(hostId, threadId).slice()
      sources.forEach((src: string, index: number) => { images.push({ id: Date.now().toString() + '-' + Math.random().toString(36).slice(2) + '-' + index, src } as DraftImage) })
      saveDraftImages(hostId, threadId, images.slice(0, MAX_COMPOSER_IMAGES - readDraftFiles(hostId, threadId).length)); imageBusy.value = false
    }, (error: Error) => { imageBusy.value = false; if (isCurrentPage()) notify(error.message) })
  }, fail: (error) => { imageBusy.value = false; if (error.errCode != 1101001 && !error.errMsg.toLowerCase().includes('cancel')) notify('未能选择图片，请重试') } })
}
// 粘贴仅添加附件，沿用选图压缩与发送流程，并始终写回发起粘贴的会话。
async function pasteImages(paths: string[]) {
  if (!pageVisible.value || !canWrite.value || imageBusy.value) return
  if (connection.snapshot?.supportsImages != true) { notify('请先更新电脑连接服务以发送图片'); return }
  if (!modelSupportsImages.value) { notify('当前模型不支持图片，请切换模型'); return }
  const hostId = pageHostId.value, threadId = pageThreadId.value
  const remaining = MAX_COMPOSER_IMAGES - readDraftImages(hostId, threadId).length - readDraftFiles(hostId, threadId).length
  if (remaining <= 0) { notify('每次最多添加3个附件'); return }
  if (paths.length > remaining) notify('每次最多添加3个附件，已保留可添加的图片')
  imageBusy.value = true
  try {
    const sources = await Promise.all(paths.slice(0, remaining).map((path: string): Promise<string> => prepareImage(path)))
    const images = readDraftImages(hostId, threadId).slice()
    sources.forEach((src: string, index: number) => { images.push({ id: Date.now().toString() + '-' + Math.random().toString(36).slice(2) + '-' + index, src } as DraftImage) })
    saveDraftImages(hostId, threadId, images.slice(0, MAX_COMPOSER_IMAGES - readDraftFiles(hostId, threadId).length))
  } catch (reason) { if (isCurrentPage()) notify((reason as Error).message) }
  finally { imageBusy.value = false }
}
// 文档级委托只匹配当前消息输入框，其他编辑框保留默认粘贴行为。
let unbindImagePaste: () => void = () => {}
onLoad(() => { unbindImagePaste = bindImagePaste('#conversation-page .draft', pasteImages) })
onUnload(() => { unbindImagePaste() })
function removeImage(id: string) { if (busy.value || imageBusy.value || connection.pendingCommandId.length > 0) return; saveDraftImages(pageHostId.value, pageThreadId.value, draftImages.value.filter((image: DraftImage): boolean => image.id != id)) }
function previewImage(src: string) { uni.previewImage({ urls: draftImages.value.map((image: DraftImage): string => image.src), current: src }) }
// 延后收起，让引起失焦的工具栏点击先完成，菜单或附件选择会继续保持展开。
function onDraftBlur() {
  predictionFocus.value = false
  clearTimeout(composerBlurTimer)
  composerBlurTimer = setTimeout(() => { if (pageAlive) inputFocused.value = false }, 160)
}
function onPermissionVisibility(value: boolean) { permissionMenuOpen.value = value }
function updateMenuHeight() {
  const windowHeight = uni.getWindowInfo().windowHeight
  const pageBottom = uni.getElementById('conversation-page')?.getBoundingClientRect().bottom ?? windowHeight
  menuWidth.value = Math.min(330, uni.getWindowInfo().windowWidth - 28)
  const measuredTop = uni.getElementById('composer-dock')?.getBoundingClientRect().top ?? windowHeight - keyboardInset.value - 134
  const dockTop = Math.max(210, measuredTop)
  menuBottom.value = Math.max(0, pageBottom - dockTop)
  const available = dockTop - 110
  const model = models.value.find((item: ModelOption): boolean => item.id == settings.value?.model)
  // 附件菜单按六行按钮与分隔线计算高度，避免计划模式下方留下额外空白；提示超出时仍可滚动。
  const desired = composerMenu.value == 'add' ? 6 * 46 + 17 : composerMenu.value == 'models' ? models.value.length * 48 : composerMenu.value == 'speeds' ? (model?.speeds.length ?? 1) * 66 : (model?.efforts.length ?? 0) * 46 + 145
  menuHeight.value = Math.max(100, Math.min(desired, 470, available))
}
function changeComposerSection(section: string) { composerMenu.value = section; nextTick(() => { updateMenuHeight() }) }
// 电脑快照是当前设置的来源；切换电脑、会话或断线后使迟到响应失效。
function loadSettings() {
  if (!isCurrentPage() || !connection.connected || readOnly.value || connection.snapshot?.supportsExecutionSettings != true || settingsBusy.value || settingsLoading.value) return
  clearTimeout(settingsRetryTimer)
  const request = ++settingsRequest
  const snapshotRevision = settingsSnapshotRevision
  settingsLoading.value = true; settingsError.value = ''
  bridge.request('thread.settings.read', { threadId: pageThreadId.value }).then((result: UTSJSONObject) => {
    if (request != settingsRequest || !isCurrentPage()) return
    const response = JSON.parse<SettingsResponse>(JSON.stringify(result))
    settingsLoading.value = false
    if (response == null || response.settings == null || response.models == null || response.models.length == 0) { settingsLoadFailed('电脑端设置暂不可用，请更新连接服务后重试'); return }
    const confirmed = resolveSettingsEffort(response.settings, response.models)
    if (confirmed.effort.length == 0) { settingsLoadFailed('尚未读取到电脑端的思考强度，请重新读取'); return }
    settings.value = mergeSettingsRead(settings.value, confirmed, connection.snapshot?.executionSettings ?? null, snapshotRevision != settingsSnapshotRevision)
    models.value = response.models
    settingsRetryCount = 0
    if (composerMenu.value.length > 0) updateMenuHeight()
  }, (error: Error) => { if (request == settingsRequest && isCurrentPage()) settingsLoadFailed(error.message) })
}

// 只重试读取两次；定时器绑定当前请求，断线、离页和设置写入后不能重放。
function settingsLoadFailed(message: string) {
  settingsLoading.value = false; settingsError.value = message
  if (settingsRetryCount >= 2) return
  const request = settingsRequest
  settingsRetryCount++
  settingsRetryTimer = setTimeout(() => {
    if (request == settingsRequest && isCurrentPage()) loadSettings()
  }, settingsRetryCount * 1000)
}

function openComposerMenu(section: string) {
  if (!canWrite.value) return
  actionsVisible.value = false
  if (composerMenu.value == section) { closeComposerMenu(); return }
  changeComposerSection(section)
  if ((settings.value == null || models.value.length == 0 || settingsError.value.length > 0) && connection.snapshot?.supportsExecutionSettings == true) { settingsRetryCount = 0; loadSettings() }
}

// 选中即同步电脑输入框设置，无需发送消息；失败和未知结果均保留最后确认值。
function selectSetting(key: string, value: string): boolean {
  if (!canWrite.value || settings.value == null || settingsBusy.value) return false
  // 运行中的轮次不能切换计划模式；回调执行时再次读取快照，防止菜单打开后任务才启动。
  if (key == 'mode' && ((connection.snapshot?.activeTurnId ?? '').length > 0 || connection.snapshot?.status == 'active')) return false
  const changes: UTSJSONObject = {}
  changes[key] = value
  const request = ++settingsRequest
  const snapshotRevision = settingsSnapshotRevision
  settingsBusy.value = true; busy.value = true; settingsLoading.value = false; settingsError.value = ''
  bridge.request('thread.settings.update', { threadId: pageThreadId.value, changes }, true).then((result: UTSJSONObject) => {
    busy.value = false; settingsBusy.value = false
    if (request != settingsRequest || !isCurrentPage()) return
    const response = JSON.parse<SettingsResponse>(JSON.stringify(result))
    if (response == null || response.settings == null) { settingsError.value = '请刷新并核对电脑端设置'; return }
    if (snapshotRevision == settingsSnapshotRevision) settings.value = response.settings
    models.value = response.models
    closeComposerMenu()
    refresh()
  }, (error: Error) => {
    busy.value = false; settingsBusy.value = false
    if (request != settingsRequest || !isCurrentPage()) return
    settingsError.value = error.message
    // 设置失败后由用户查看同步结果，重连不会自动再次提交。
    // 保留失败原因，用户点击重新读取后再核对桌面设置。
  })
  return true
}
// 权限写入期间沿用详情页操作锁，防止首条消息抢在设置确认之前发送。
// 原生组件事件显式声明布尔类型，避免模板把载荷推断为 Any。
function onPermissionBusy(value: boolean) { busy.value = value }
function togglePlan() { selectSetting('mode', planEnabled.value ? 'default' : 'plan') }
// 附件变更始终写回原电脑和会话，不将系统选择器的迟到结果放进其他草稿。
function updateFile(hostId: string, threadId: string, file: DraftFile) {
  const files = readDraftFiles(hostId, threadId).slice()
  const index = files.findIndex((item: DraftFile): boolean => item.id == file.id)
  if (index < 0) return
  files.splice(index, 1, file); saveDraftFiles(hostId, threadId, files)
}
function fileStillPresent(hostId: string, threadId: string, id: string): boolean {
  return readDraftFiles(hostId, threadId).some((file: DraftFile): boolean => file.id == id)
}
// 同一上传编号可恢复缺失分片；断线只暂停，不重放发送指令。
async function uploadFile(hostId: string, threadId: string, file: DraftFile) {
  try {
    if (file.data.length == 0) file.data = await readFileBase64(file.source)
    if (!fileStillPresent(hostId, threadId, file.id)) return
    file.status = 'uploading'; file.error = ''; updateFile(hostId, threadId, file)
    if (connection.hostId != hostId || connection.activeThreadId != threadId || !connection.connected) throw new Error('聊天或连接已变化，上传已暂停')
    const started = await bridge.request('attachment.begin', { threadId, uploadId: file.id, name: file.name, size: file.size })
    let index = started.getNumber('nextChunk') ?? 0
    const chunkLength = FILE_CHUNK_BYTES * 4 / 3
    while (index * chunkLength < file.data.length) {
      if (!fileStillPresent(hostId, threadId, file.id)) return
      if (connection.hostId != hostId || connection.activeThreadId != threadId || !connection.connected) throw new Error('聊天或连接已变化，上传已暂停')
      const result = await bridge.request('attachment.chunk', { threadId, uploadId: file.id, index, data: file.data.slice(index * chunkLength, (index + 1) * chunkLength) })
      index = result.getNumber('nextChunk') ?? index + 1
      file.progress = Math.min(99, Math.floor((result.getNumber('received') ?? 0) * 100 / file.size))
      updateFile(hostId, threadId, file)
    }
    if (!fileStillPresent(hostId, threadId, file.id)) return
    if (connection.hostId != hostId || connection.activeThreadId != threadId || !connection.connected) throw new Error('聊天或连接已变化，上传已暂停')
    await bridge.request('attachment.finish', { threadId, uploadId: file.id })
    file.status = 'ready'; file.progress = 100; updateFile(hostId, threadId, file)
  } catch (error) {
    file.status = connection.connected && connection.hostId == hostId && connection.activeThreadId == threadId ? 'error' : 'paused'
    file.error = (error as Error).message; updateFile(hostId, threadId, file)
  }
}
// 图片继续走压缩后的视觉输入，文档走独立的有界分片上传。
async function acceptFiles(hostId: string, threadId: string, selected: ChooseFileTempFile[]) {
  imageBusy.value = true
  for (const picked of selected) {
    if (readDraftImages(hostId, threadId).length + readDraftFiles(hostId, threadId).length >= 3) break
    try {
      const extension = picked.name.slice(picked.name.lastIndexOf('.') + 1).toLowerCase()
      if (extension == 'png' || extension == 'jpg' || extension == 'jpeg') {
        if (!modelSupportsImages.value) throw new Error('当前模型不支持图片，请切换模型')
        const src = await prepareImage(picked.path)
        const images = readDraftImages(hostId, threadId).slice()
        images.push({ id: Date.now().toString() + '-' + Math.random().toString(36).slice(2), src } as DraftImage)
        saveDraftImages(hostId, threadId, images)
      } else {
        validateFile(picked.name, picked.size)
        const file: DraftFile = { id: Date.now().toString() + '-' + Math.random().toString(36).slice(2) + '-' + Math.random().toString(36).slice(2), name: picked.name, size: picked.size, source: picked.path, data: '', status: 'uploading', progress: 0, error: '' }
        const files = readDraftFiles(hostId, threadId).slice(); files.push(file); saveDraftFiles(hostId, threadId, files)
        uploadFile(hostId, threadId, file)
      }
    } catch (error) { if (isCurrentPage()) notify((error as Error).message) }
  }
  imageBusy.value = false
}

function chooseFiles() {
  if (!canWrite.value || imageBusy.value || connection.snapshot?.supportsAttachments != true) return
  const remaining = 3 - draftImages.value.length - draftFiles.value.length
  if (remaining <= 0) { notify('每次最多发送3个附件'); return }
  const hostId = pageHostId.value; const threadId = pageThreadId.value
  uni.chooseFile({ count: remaining, type: 'all', success: (result) => { acceptFiles(hostId, threadId, result.tempFiles.slice(0, remaining)) }, fail: (error) => { if (error.errCode != 1101001 && !error.errMsg.toLowerCase().includes('cancel')) notify('未能选择文件，请重试') } })
}

function retryFile(id: string) {
  if (!canWrite.value) return
  const file = draftFiles.value.find((item: DraftFile): boolean => item.id == id)
  if (file == null || file.status == 'uploading') return
  file.status = 'uploading'; file.error = ''; updateFile(pageHostId.value, pageThreadId.value, file)
  uploadFile(pageHostId.value, pageThreadId.value, file)
}
function removeFile(id: string) {
  if (busy.value || connection.pendingCommandId.length > 0) return
  saveDraftFiles(pageHostId.value, pageThreadId.value, draftFiles.value.filter((file: DraftFile): boolean => file.id != id))
  if (isCurrentPage() && connection.connected) bridge.request('attachment.abort', { threadId: pageThreadId.value, uploadId: id }).then((_: UTSJSONObject) => {}, (_: Error) => {})
}
function composerAction(action: string) {
  if (!canWrite.value) return
  if (action == 'plugin') { closeComposerMenu(); predictionFocus.value = false; uni.hideKeyboard(); pluginOpen.value = true; return }
  if (action == 'goal') { showGoal(); return }
  if (action == 'plan') { if (selectSetting('mode', planEnabled.value ? 'default' : 'plan')) focusComposerInput(); return }
  closeComposerMenu()
  if (action == 'camera' || action == 'album') {
    if (modelSupportsImages.value) chooseImages(action); else notify('当前模型不支持图片，请切换模型')
  } else if (action == 'file') chooseFiles()
}
// 菜单选择后立即恢复编辑，焦点不等待电脑端回执；不会采纳预测或发送草稿。
function focusComposerInput() {
  const hostId = pageHostId.value, threadId = pageThreadId.value
  closeComposerMenu(); clearTimeout(composerBlurTimer)
  inputFocused.value = true; predictionFocus.value = false
  nextTick(() => {
    if (!isCurrentPage() || pageHostId.value != hostId || pageThreadId.value != threadId || readOnly.value) return
    predictionFocus.value = true
  })
}
// 面板挂载期间固定会话归属，关闭页面或切换电脑后不保留旧面板。
function selectPlugins(plugins: SelectedPlugin[]) { if (!canWrite.value) return; saveDraftPlugins(pageHostId.value, pageThreadId.value, plugins); pluginOpen.value = false; focusComposerInput() }
function removePlugin(id: string) { if (canWrite.value) saveDraftPlugins(pageHostId.value, pageThreadId.value, draftPlugins.value.filter((plugin: SelectedPlugin): boolean => plugin.id != id)) }
function sizeLabel(size: number): string { return fileSizeLabel(size) }


// 桥接重启后，即使模型能力字段相同，也要在新快照到达后重新读取设置，清除抢先请求的错误。
watch((): string => connection.hostId + ':' + connection.activeThreadId + ':' + connection.subscriptionRevision.toString() + ':' + connection.connected.toString() + ':' + (connection.snapshot?.supportsExecutionSettings == true).toString() + ':' + (connection.snapshot?.readOnly == true).toString(), (_current: string, _previous: string) => {
  settingsRequest++; settingsLoading.value = false; clearTimeout(settingsRetryTimer); settingsRetryCount = 0; closeComposerMenu()
  if (!isCurrentPage() || !connection.connected || readOnly.value) { settings.value = null; models.value = [] as ModelOption[]; return }
  if (connection.snapshot?.supportsExecutionSettings == true) loadSettings()
})
watch((): string => JSON.stringify(connection.snapshot?.executionSettings ?? null), (_current: string, _previous: string) => {
  if (!isCurrentPage() || connection.snapshot?.threadId != pageThreadId.value || connection.snapshot?.executionSettings == null) return
  const snapshot = connection.snapshot!.executionSettings!
  settingsSnapshotRevision++; settings.value = mergeSettingsSnapshot(settings.value, snapshot)
  if (snapshot.effort.length == 0 && !settingsLoading.value && !settingsBusy.value) loadSettings()
})


// 占位预测使用独立测量值，原生空输入行高事件不能覆盖预测的实际高度。
function onDraftLineChange(event: UniTextareaLineChangeEvent) {
  if (draft.value.length > 0) draftHeight.value = Math.max(64, Math.min(144, event.detail.height))
  updateComposerGeometry()
}
const composerExpanded = computed((): boolean => shouldExpandComposer({ focused: inputFocused.value, draft: draft.value, prediction: visiblePrediction.value, imageCount: draftImages.value.length, fileCount: draftFiles.value.length, menuOpen: composerMenu.value.length > 0 || permissionMenuOpen.value || pluginOpen.value || draftPlugins.value.length > 0, attachmentBusy: imageBusy.value }))
const composerHeight = computed((): number => composerInputHeight(composerExpanded.value, visiblePrediction.value, predictionHeight.value, draftHeight.value))
// 高度由一行工具栏及编辑空间组成，数值过渡期间两端按钮始终贴住底边。
const composerStageHeight = computed((): number => composerExpanded.value ? composerHeight.value + 58 : 44)
// 取消旧完成回调，200ms 过渡后额外留一帧，补测最后一次切换的几何位置。
function settleComposerAnimation() {
  clearTimeout(composerAnimationTimer)
  const revision = ++composerAnimationRevision
  composerAnimationTimer = setTimeout(() => {
    if (!pageAlive || revision != composerAnimationRevision) return
    updateComposerGeometry()
  }, 220)
}
// 布局稳定后更新菜单锚点；用户阅读历史时不强制滚到消息末尾。
function updateComposerGeometry() {
  nextTick(() => {
    if (!pageAlive) return
    if (composerMenu.value.length > 0) updateMenuHeight()
    if (following.value) scrollLatest()
    else updateTimelinePosition()
  })
}
// 按真实可用宽度测量自然折行，代次校验阻止旧会话或旧预测的测量写回。
function measureComposerPrediction() {
  const revision = ++composerMeasureRevision
  if (visiblePrediction.value.length == 0) { predictionHeight.value = 24; return }
  nextTick(() => {
    if (!pageAlive || revision != composerMeasureRevision) return
    const height = uni.getElementById('draft-placeholder-measure')?.getBoundingClientRect().height ?? 0
    if (height > 0) predictionHeight.value = height
  })
}
watch((): string => pageHostId.value + ':' + pageThreadId.value + ':' + visiblePrediction.value + ':' + composerExpanded.value, () => { measureComposerPrediction(); updateComposerGeometry() }, { flush: 'post' })
watch((): number => composerStageHeight.value, () => { updateComposerGeometry(); settleComposerAnimation() }, { flush: 'post' })
watch((): string => draft.value, (text: string) => { if (text.length == 0) draftHeight.value = 64 })
watch((): string => pageHostId.value + ':' + pageThreadId.value, () => { clearTimeout(composerBlurTimer); clearTimeout(composerAnimationTimer); composerAnimationRevision++; inputFocused.value = false; predictionFocus.value = false; permissionMenuOpen.value = false; draftHeight.value = 64; measureComposerPrediction() }, { flush: 'sync' })
onResize(() => { measureComposerPrediction(); updateComposerGeometry() })
onUnload(() => { clearTimeout(composerBlurTimer); clearTimeout(composerAnimationTimer); composerAnimationRevision++; composerMeasureRevision++ })
// 键盘由输入区处理，扣除系统已缩小的窗口高度，避免自定义顶栏被整体上推或重复留白。
function onKeyboardChange(event: UniInputKeyboardHeightChangeEvent) {
  const height = event.detail.height
  if (height > 0) composerKeyboardVisible = true
  else if (composerKeyboardVisible) { composerKeyboardVisible = false; onDraftBlur() }
  goalViewportHeight.value = uni.getWindowInfo().windowHeight
  const resized = Math.max(0, baseWindowHeight - uni.getWindowInfo().windowHeight)
  keyboardInset.value = height > 0 ? Math.max(0, height - resized) : 0
  if (composerMenu.value.length > 0) updateMenuHeight()
  if (following.value) scrollLatest()
}

// 成功响应先锁定本组，防止桌面状态尚未广播时再次点击；失败保留组件草稿。
function submitAnswers(questionGroupId: string, turnId: string, answers: QuestionAnswer[]) {
  if (!canWrite.value || submittedGroupIds.value.indexOf(questionGroupId) >= 0) return
  const threadId = pageThreadId.value
  busy.value = true
  bridge.request('question.reply', { threadId, questionGroupId, turnId, answers }, true).then((_: UTSJSONObject) => {
    busy.value = false
    if (isCurrentPage()) { submittedGroupIds.value.push(questionGroupId); refresh() }
  }, (error: Error) => { busy.value = false; if (isCurrentPage()) operationError.value = error.message })
}
// 两个重试入口共享轮次占位，成功回执到新轮次广播之间也不能重复点击。
function retrySubmitting(turnId: string): boolean { return submittedRetryKey.value == pageHostId.value + ':' + pageThreadId.value + ':' + turnId }
function canRetryTurn(turnId: string): boolean { return turnId.length > 0 && retryTurnId.value == turnId && canWrite.value && goalHostOnline.value && liveConversation.value?.supportsTurnRetry == true && !retrySubmitting(turnId) }
function retryTurn(turnId: string) {
  if (!canRetryTurn(turnId)) return
  const hostId = pageHostId.value, threadId = pageThreadId.value, key = hostId + ':' + threadId + ':' + turnId
  submittedRetryKey.value = key; operationError.value = ''; busy.value = true; pendingAction.value = 'retry'
  bridge.request('turn.retry', { threadId, expectedTurnId: turnId }, true).then((_: UTSJSONObject) => {
    busy.value = false; pendingAction.value = ''
    if (isCurrentPage() && pageHostId.value == hostId && pageThreadId.value == threadId) { resumeFollowing(); refresh() }
  }, (error: Error) => {
    if (bridge.pendingCommand(hostId, threadId).length == 0 && submittedRetryKey.value == key) submittedRetryKey.value = ''
    busy.value = false; pendingAction.value = ''
    if (isCurrentPage() && pageHostId.value == hostId && pageThreadId.value == threadId) { operationError.value = error.message; bridge.watch(threadId) }
  })
}
// 未知结果只核对原命令，不重新发送；接受后保留占位直到新状态到达。
function checkRetryOutcome() {
  if (!connection.connected || busy.value || pendingRetryCommand.value.length == 0) return
  const hostId = pageHostId.value, threadId = pageThreadId.value, commandId = pendingRetryCommand.value
  busy.value = true
  bridge.request('command.status', { commandId }).then((status: UTSJSONObject) => {
    busy.value = false
    const error = status['error'] as UTSJSONObject | null
    const done = status.getString('state') == 'done' && error?.getBoolean('outcomeUnknown') != true
    if (done) { bridge.clearCommand(commandId, hostId); if (error != null) submittedRetryKey.value = '' }
    if (isCurrentPage() && pageHostId.value == hostId && pageThreadId.value == threadId) { operationError.value = done ? error?.getString('message') ?? '' : '重试结果仍待核对，请勿重复提交'; bridge.watch(threadId) }
  }, (error: Error) => { busy.value = false; if (isCurrentPage() && pageHostId.value == hostId && pageThreadId.value == threadId) operationError.value = error.message })
}

// 仅在明确收到成功响应后清空草稿，未知结果保留并要求先核对。
function send() {
  const text = draft.value.trim()
  if ((text.length == 0 && draftImages.value.length == 0 && draftFiles.value.length == 0) || !canWrite.value || imageBusy.value || !filesReady.value) return
  if (draftImages.value.length > 0 && !modelSupportsImages.value) { notify('当前模型不支持图片，请切换模型'); return }
  if (draftImages.value.length > 0 && connection.snapshot?.supportsImages != true) { notify('请先更新电脑连接服务以发送图片'); return }
  operationError.value = ''
  busy.value = true; pendingAction.value = 'send'
  const hostId = pageHostId.value
  const threadId = pageThreadId.value
  // 偏好只作用于本次新消息；已排队消息继续使用原队列及手动追加入口。
  const running = activeTurnId.value.length > 0 || connection.snapshot?.status == 'active'
  const steer = messageSendingPreferences.behavior == 'steer' && running
  if (steer && activeTurnId.value.length == 0) { busy.value = false; pendingAction.value = ''; operationError.value = '当前任务状态正在同步，请稍后重新发送'; return }
  const method = steer ? 'turn.steer' : 'turn.send'
  const queue = messageSendingPreferences.behavior == 'queue' && connection.snapshot?.supportsMessageQueue == true
  if (!steer && !queue && running) { busy.value = false; pendingAction.value = ''; operationError.value = '请更新电脑连接服务后使用默认排队'; return }
  const params: UTSJSONObject = { threadId, text, images: draftImages.value.map((image: DraftImage): string => image.src), attachments: draftFiles.value.map((file: DraftFile): string => file.id) }
  if (draftPlugins.value.length > 0) params['pluginIds'] = draftPlugins.value.map((plugin: SelectedPlugin): string => plugin.id)
  if (queue) params['queueAction'] = 'enqueue'
  if (steer) params['expectedTurnId'] = activeTurnId.value
  const request = bridge.request(method, params, true)
  const commandId = connection.pendingCommandId
  rememberSubmission(hostId, threadId, commandId, text)
  request.then((result: UTSJSONObject) => { settleSubmission(hostId, commandId, true); busy.value = false; pendingAction.value = ''; if (isCurrentPage()) { resumeFollowing(); notify(steer ? '已追加到当前任务' : queue ? '已加入消息队列' : '指令已发送') } }, (error: Error) => { if (bridge.pendingCommand(hostId, pageThreadId.value) != commandId) settleSubmission(hostId, commandId, false); busy.value = false; pendingAction.value = ''; if (isCurrentPage()) operationError.value = error.message })
}
// 追加和取消都指向电脑保存的同一条消息，避免手机重传正文形成重复指令。
function operateQueuedMessage(id: string, action: string) {
  if (!canWrite.value || connection.snapshot?.supportsMessageQueue != true) return
  const hostId = pageHostId.value, threadId = pageThreadId.value
  busy.value = true; pendingAction.value = 'queue:' + id; operationError.value = ''
  bridge.request('turn.send', { threadId, queueAction: action, queueId: id, expectedTurnId: activeTurnId.value }, true).then((_: UTSJSONObject) => {
    busy.value = false; pendingAction.value = ''
    if (isCurrentPage() && pageHostId.value == hostId && pageThreadId.value == threadId) { notify(action == 'steer' ? '已追加到当前任务' : '已移除排队消息'); refresh() }
  }, (error: Error) => { busy.value = false; pendingAction.value = ''; if (isCurrentPage() && pageHostId.value == hostId && pageThreadId.value == threadId) operationError.value = error.message })
}
function steerQueuedMessage(id: string) { if (activeTurnId.value.length > 0) operateQueuedMessage(id, 'steer') }
function cancelQueuedMessage(id: string) { operateQueuedMessage(id, 'cancel') }
// 先撤回并恢复完整草稿，再确认清理撤回记录；失败时保留可继续读取的电脑端记录。
function editQueuedMessage(id: string) {
  if (!canWrite.value || imageBusy.value || connection.snapshot?.supportsQueueEditing != true) return
  const hostId = pageHostId.value, threadId = pageThreadId.value
  try { beginQueueEdit(hostId, threadId, draftPlugins.value.length > 0) } catch (error) { notify((error as Error).message); return }
  busy.value = true; pendingAction.value = 'queue-edit:' + id; operationError.value = ''
  bridge.request('turn.send', { threadId, queueAction: 'edit', queueId: id }, true).then((result: UTSJSONObject) => {
    try {
      const restored = JSON.parse<QueueEditDraft>(JSON.stringify(result['draft']))
      if (result.getBoolean('edited') != true || result.getString('queueId') != id || restored == null) throw new Error('撤回结果尚未确认，请重新同步后继续编辑')
      restoreQueuedDraft(hostId, threadId, id, restored, readDraftPlugins(hostId, threadId).length > 0, (plugins: QueueEditPlugin[]) => { saveDraftPlugins(hostId, threadId, plugins.map((plugin: QueueEditPlugin): SelectedPlugin => ({ id: plugin.id, displayName: plugin.displayName } as SelectedPlugin))) })
    } catch (error) {
      finishQueueEdit(hostId, threadId); busy.value = false; pendingAction.value = ''
      if (isCurrentPage() && pageHostId.value == hostId && pageThreadId.value == threadId) operationError.value = (error as Error).message
      return
    }
    // 草稿已恢复后才移除记录；清理回执丢失也不会重新发送或清空正在编辑的内容。
    const cleanup = connection.hostId == hostId ? bridge.request('turn.send', { threadId, queueAction: 'cancel', queueId: id }, true) : null
    finishQueueEdit(hostId, threadId); busy.value = false; pendingAction.value = ''
    if (pageVisible.value && isCurrentPage() && pageHostId.value == hostId && pageThreadId.value == threadId) { focusComposerInput(); notify('已撤回，编辑后可重新发送') }
    cleanup?.then((_: UTSJSONObject) => {}, (_: Error) => { if (isCurrentPage() && pageHostId.value == hostId && pageThreadId.value == threadId) operationError.value = '内容已恢复到输入框；撤回记录清理尚未确认，可同步后移除记录' })
  }, (error: Error) => {
    finishQueueEdit(hostId, threadId); busy.value = false; pendingAction.value = ''
    if (isCurrentPage() && pageHostId.value == hostId && pageThreadId.value == threadId) operationError.value = error.message
  })
}
let stopPromptOpen = false
// 所有停止入口共用确认框，确认时复核原会话及任务，避免误停后续任务。
function stop() {
  if (!canWrite.value || activeTurnId.value.length == 0 || stopPromptOpen) return
  const hostId = pageHostId.value
  const threadId = pageThreadId.value
  const turnId = activeTurnId.value
  stopPromptOpen = true
  uni.showModal({ title: '停止任务', content: '确定停止当前正在执行的任务吗？', confirmText: '停止', confirmColor: '#bb3f44', cancelText: '取消', success: (choice) => {
    stopPromptOpen = false
    if (!choice.confirm || !isCurrentPage() || !pageVisible.value || connection.hostId != hostId || pageThreadId.value != threadId || activeTurnId.value != turnId || !canWrite.value) return
    busy.value = true; pendingAction.value = 'stop'
    bridge.request('turn.stop', { threadId, expectedTurnId: turnId }, true).then((_: UTSJSONObject) => { busy.value = false; pendingAction.value = ''; if (isCurrentPage()) { notify('停止请求已提交'); refresh() } }, (error: Error) => { busy.value = false; pendingAction.value = ''; if (isCurrentPage()) operationError.value = error.message })
  }, fail: (_) => { stopPromptOpen = false } })
}
function reply(id: string, turnId: string, decision: string) {
  if (!canWrite.value || handledApprovalIds.value.indexOf(id) >= 0) return
  busy.value = true; pendingAction.value = 'approval:' + id
  bridge.request('approval.reply', { threadId: pageThreadId.value, approvalId: id, turnId, decision }, true).then((_: UTSJSONObject) => { handledApprovalIds.value.push(id); busy.value = false; pendingAction.value = ''; if (isCurrentPage()) { notify(decision == 'accept' ? '已允许本次操作' : '已拒绝本次操作'); refresh() } }, (error: Error) => { busy.value = false; pendingAction.value = ''; if (isCurrentPage()) operationError.value = error.message })
}
// 目标表单与聊天草稿独立，提交仅使用编辑开始时捕获的目标版本。
function goalExpansion(value: boolean) { goalExpanded.value = value; if (value) closeComposerMenu() }
function dismissGoal() { if (!goalBusy.value && goalExpanded.value) { goalCloseRequest.value++; goalExpanded.value = false } }
// 聚焦只展开编辑面板并收起目标表单，不采纳或发送预测。
function onComposerFocus() { clearTimeout(composerBlurTimer); inputFocused.value = true; dismissGoal() }
function goalKeyboard(height: number) { goalViewportHeight.value = uni.getWindowInfo().windowHeight; const resized = Math.max(0, baseWindowHeight - uni.getWindowInfo().windowHeight); keyboardInset.value = height > 0 ? Math.max(0, height - resized) : 0 }
function showGoal() {
  closeActions(); closeComposerMenu()
  if (connection.snapshot?.supportsGoals != true) { notify('请更新电脑端与连接服务以使用目标'); return }
  if (connection.snapshot?.goal == null && (!canWrite.value || !goalHostOnline.value || connection.snapshot?.supportsGoalControl != true)) { notify(goalUnavailableReason.value.length > 0 ? goalUnavailableReason.value : '当前暂不能新建目标'); return }
  uni.hideKeyboard(); goalOpenRequest.value++
}
function operateGoal(action: string, objective: string, revision: string) {
  if (!canWrite.value || !goalHostOnline.value || goalBusy.value || connection.snapshot?.supportsGoalControl != true) return
  busy.value = true; goalBusy.value = true; operationError.value = ''
  const hostId = pageHostId.value
  const threadId = pageThreadId.value
  const params: UTSJSONObject = { threadId, action, expectedRevision: revision }
  if (action == 'create' || action == 'edit') params['objective'] = objective
  bridge.request('thread.goal.update', params, true).then((result: UTSJSONObject) => {
    if (isCurrentPage() && pageHostId.value == hostId && pageThreadId.value == threadId && connection.snapshot != null) {
      connection.snapshot!.goal = result['goal'] == null ? null : JSON.parse<ThreadGoal>(JSON.stringify(result['goal']))
      connection.snapshot!.goalRevision = result.getString('goalRevision') ?? 'none'
    }
    busy.value = false; goalBusy.value = false
    if (isCurrentPage() && pageHostId.value == hostId && pageThreadId.value == threadId) { notify(action == 'clear' ? '目标已清除' : '目标已同步'); refresh() }
  }, (error: Error) => { busy.value = false; goalBusy.value = false; if (isCurrentPage() && pageHostId.value == hostId && pageThreadId.value == threadId) operationError.value = error.message })
}

// 主按钮随上下文切换：有草稿发送，空草稿运行中停止。
function primaryAction() { if (!canWrite.value || imageBusy.value || !filesReady.value) return; if (draft.value.trim().length > 0 || draftImages.value.length > 0 || draftFiles.value.length > 0) send(); else if (activeTurnId.value.length > 0) stop(); else retryTurn(retryTurnId.value) }
function stopFromMenu() { if (!canWrite.value) return; closeActions(); stop() }
// 原生返回优先关闭当前浮层，再交给页面导航；不会丢失会话草稿。
onBackPress((): boolean => { if (deleteFinalVisible.value) { answerDeleteFinal(false); return true }; if (selectedFileReport.value != null) { closeFileReport(); return true }; if (selectedAnnotationId.value.length > 0) { closeAnnotations(); return true }; if (goalExpanded.value) { dismissGoal(); uni.hideKeyboard(); return true }; if (composerMenu.value.length > 0) { closeComposerMenu(); return true }; if (selectedExecutionId.value.length > 0) { closeExecution(); return true }; if (actionsVisible.value) { closeActions(); return true }; return false })
</script>

<style>
.turn-failure-card { flex-direction: row; align-items: flex-start; border-width: 1px; border-style: solid; border-color: #e4d8d4; border-radius: 12px; padding: 10px 12px; background-color: #fffaf8; }
.turn-failure-icon { margin-top: 3px; flex-shrink: 0; }
.turn-failure-copy { flex: 1; min-width: 0; margin-left: 9px; }
.turn-failure-text { font-size: 13px; line-height: 22px; color: #795c57; }
.turn-failure-hint { font-size: 11px; line-height: 18px; color: #8c7972; margin-top: 4px; }
.turn-retry { flex-shrink: 0; margin-left: 8px; min-width: 48px; min-height: 44px; padding: 0 8px; font-size: 12px; line-height: 44px; color: #68534c; background-color: transparent; }
/* #ifdef WEB */
.turn-failure-text { white-space: pre-wrap; overflow-wrap: anywhere; }
/* #endif */
/* 缓存同步提示保持轻量，避免错误提示重复挤占聊天区域。 */
.cache-sync-indicator { flex-shrink: 0; padding: 8px 16px 6px; }
.cache-notice { flex-direction: row; align-items: center; padding: 8px 16px; background-color: #eef2eb; }
.cache-note { flex: 1; font-size: 12px; line-height: 20px; color: #68776c; }
.cache-retry { width: 56px; height: 28px; padding: 0; margin: 0 0 0 8px; font-size: 12px; border-radius: 8px; }
/* 松墨视觉：正文直接呈现，辅助记录和主操作统一使用松绿色系。 */
.annotation-entry { min-height: 44px; padding: 0 12px; border-radius: 22px; border-width: 1px; border-style: solid; border-color: #cdd6cc; background-color: #f8faf6; flex-direction: row; align-items: center; align-self: flex-start; }
.annotation-after-text { margin-top: 12px; }
.annotation-entry-label { font-size: 14px; line-height: 22px; color: #42564a; margin-left: 8px; margin-right: 8px; }
.annotation-icon { width: 17px; height: 15px; border-width: 1.5px; border-style: solid; border-color: #7b8f81; border-radius: 4px; padding: 3px; }
.annotation-icon-line { height: 1px; background-color: #7b8f81; margin-bottom: 2px; }
