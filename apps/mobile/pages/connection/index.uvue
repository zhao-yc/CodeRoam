<template>
  <view class="page connection-page">
    <view id="connection-header" class="header"><view class="back action-frame"><app-icon name="back" :size="23" /><button class="action-hitbox" hover-class="action-pressed" aria-label="返回上一页" @click="goBack"></button></view><text class="header-title">电脑连接</text></view>
    <scroll-view direction="vertical" class="content" :scroll-into-view="connectionAnchor">
      <view class="body">
        <text class="group-title">连接状态</text>
        <view id="connection-overview" class="section overview"><view class="overview-heading"><app-icon name="link" :size="25" /><text class="page-title">{{ connectionStatusLabel }}</text></view><text class="description">{{ connectionSummary }}</text><text v-if="!connection.connected && connection.configured && connection.error.length > 0" class="error-note">暂时无法连接，请检查网络及电脑端连接服务，或核对接入配置。</text><view v-if="connection.configured && !connection.connected" class="retry-button button-secondary inline-progress-button"><action-progress :busy="reconnecting" /><text class="inline-progress-caption" style="color: #1a2135; font-size: 14px;">重新连接</text><button class="inline-progress-hitbox" style="background-color: transparent;" :disabled="reconnecting" :aria-label="reconnecting ? '正在连接' : '重新连接'" @click="reconnect"></button></view></view>
        <view v-if="connection.configured" class="computer-section">
          <view class="computer-heading"><text class="group-title computer-group-title">已授权的电脑</text><button v-if="connection.computers.length > 1" class="sort-toggle button-secondary" :aria-label="sorting ? '完成电脑排序' : '调整电脑顺序'" @click="sorting = !sorting">{{ sorting ? '完成' : '排序' }}</button></view>
          <text class="description computer-description">{{ sorting ? '使用上移、下移调整顺序，自动保存到当前设备，首页电脑栏同步更新。' : '点击查看资料，编辑名称和图标。可通过排序调整首页电脑栏顺序。' }}</text>
          <view class="computer-list">
          <text v-if="connection.computers.length == 0" class="hint">{{ connection.connected ? '暂无可访问的电脑。' : '连接后更新电脑列表。' }}</text>
          <view v-for="(computer, index) in connection.computers" :key="computer.id" :class="['computer-option action-frame', index > 0 ? 'computer-separated' : '']">
            <app-icon :name="iconForComputer(computer)" :size="23" /><text class="option-name">{{ computer.label }}</text>
            <view v-if="sorting" class="sort-actions"><button class="sort-button button-secondary" :disabled="index == 0" :aria-label="'上移' + computer.label" @click="moveComputer(computer.id, -1)">上移</button><button class="sort-button button-secondary" :disabled="index == connection.computers.length - 1" :aria-label="'下移' + computer.label" @click="moveComputer(computer.id, 1)">下移</button></view>
            <template v-else><view :class="['dot', connection.connected && computer.online ? 'online' : 'offline']"></view><text class="state">{{ localComputerConnectionLabel(computer) }}</text><app-icon name="chevron-right" :size="18" tone="muted" /><button class="action-hitbox" hover-class="action-pressed" :aria-label="'查看并编辑' + computer.label" @click="editComputer(computer.id)"></button></template>
          </view>
        </view>
        </view>
        <text class="group-title">连接管理</text>
        <view id="connection-config" class="section">
          <view v-if="connection.configured" class="config-heading action-frame"><text class="section-title">更换接入配置</text><app-icon :name="configExpanded ? 'chevron-down' : 'chevron-right'" :size="18" tone="muted" /><button class="action-hitbox" hover-class="action-pressed" :disabled="hasPendingCommands || confirming" :aria-label="configExpanded ? '收起接入配置' : '展开更换接入配置'" :aria-expanded="configExpanded" @click="toggleConfig"></button></view><text v-else class="section-title">接入配置</text>
          <view v-if="!connection.configured || configExpanded"><text class="description">{{ connection.configured ? '导入会替换本设备保存的接入配置。' : '粘贴电脑生成的连接配置，接入后自动同步聊天。' }}</text><textarea v-model="configuration" class="config-input" placeholder="在这里粘贴连接配置" :maxlength="4096" :disabled="hasPendingCommands || confirming" /><text class="privacy-note">配置保存在当前设备，请勿分享给他人或在公共设备上保存。</text><button class="connect-button button-primary" :disabled="configuration.trim().length == 0 || hasPendingCommands || confirming" @click="importConfig">保存并连接</button></view>
        </view>
        <text v-if="hasPendingCommands" class="error-note">有操作正在提交或仍需核对结果，暂时不能更换或清除连接。</text>
        <view v-if="connection.configured" class="section maintenance"><text class="hint">清除只影响此设备保存的连接，电脑上的任务会继续运行。</text><button class="forget-button button-secondary" :disabled="hasPendingCommands || confirming" @click="forgetConfiguration">清除本地连接</button></view>
      </view>
    </scroll-view>
    <task-notice :active="pageVisible" header-id="connection-header" />
    <connection-editor v-if="editingComputer != null" :key="editingComputer!.id" :computer="editingComputer!" :anchor-left="0" :anchor-top="0" :release-at="1" :direct-edit="true" @dismiss="closeEditor" @busy="onEditorBusy" />
  </view>
</template>

<script setup lang="uts">
import { computed, ref, watch } from 'vue'
import { useManualReconnect } from '../../services/manual-reconnect.uts'
import { bridge, connection, Computer, computerIcon } from '../../services/bridge.uts'
import { connectionStatusLabel, connectionSummary, computerConnectionLabel } from '../../services/connection-presentation.uts'
import ConnectionEditor from '../../components/connection-editor/connection-editor.uvue'
import TaskNotice from '../../components/task-notice/task-notice.uvue'
import AppIcon from '../../components/app-icon/app-icon.uvue'
const pageVisible = ref(false)
const configuration = ref('')
const connectionAnchor = ref('')
const configExpanded = ref(false)
const sorting = ref(false)
const confirming = ref(false)
const editingComputer = ref<Computer | null>(null)
const editorBusy = ref(false)
// 原生事件载荷明确使用布尔类型。
function onEditorBusy(value: boolean) { editorBusy.value = value }
const hasPendingCommands = computed((): boolean => bridge.hasPendingCommands())
const reconnecting = ref(false)
const reconnect = useManualReconnect((pending: boolean) => { reconnecting.value = pending })
let alive = true
let pageRevision = 0
onShow(() => { pageVisible.value = true })
onHide(() => { pageVisible.value = false; configuration.value = ''; pageRevision++; confirming.value = false; editingComputer.value = null; editorBusy.value = false })
// 兼容原有添加入口：展开后定位输入区，普通入口从连接概览开始。
onLoad((options) => { if (options['add'] == 'true') { configExpanded.value = true; connectionAnchor.value = 'connection-config' } })
onUnload(() => { alive = false; pageRevision++; configuration.value = '' })

function notify(message: string) { uni.showToast({ title: message, icon: 'none' }) }
// 移动后同步共用列表；保存失败保持原顺序并提示。
function moveComputer(id: string, direction: number) {
  try { bridge.moveComputer(id, direction) }
  catch (_) { notify('无法保存电脑顺序，请检查存储权限') }
}
function iconForComputer(computer: Computer): string { return computerIcon(computer) }
// 返回只处理导航；不切换执行电脑，不取消正文订阅。
function goBack() { if (editorBusy.value) return; uni.hideKeyboard(); if (getCurrentPages().length > 1) uni.navigateBack(); else uni.reLaunch({ url: '/pages/index/index' }) }
function toggleConfig() { if (hasPendingCommands.value || confirming.value) return; configExpanded.value = !configExpanded.value; if (!configExpanded.value) { configuration.value = ''; uni.hideKeyboard() } }

// 固定资料快照；打开和取消编辑都不调用执行电脑切换。
function editComputer(id: string) {
  const computer = connection.computers.find((item: Computer): boolean => item.id == id)
  if (computer != null) editingComputer.value = { ...computer } as Computer
}
function closeEditor() { if (!editorBusy.value) editingComputer.value = null }
// 配对变化或目标撤销后卸载旧编辑器，让迟到回执失效。
watch((): string => connection.configurationRevision.toString() + ':' + connection.computers.map((computer: Computer): string => computer.id).join('|'), () => { editingComputer.value = null; editorBusy.value = false; pageRevision++; confirming.value = false })

// 确认框关闭后重新检查操作锁与配对版本，避免确认期间出现新的提交。
function confirmMaintenance(title: string, content: string, confirmText: string, action: () => void) {
  if (confirming.value || hasPendingCommands.value) { if (hasPendingCommands.value) notify('请先等待提交完成或核对原操作结果'); return }
  uni.hideKeyboard()
  const revision = pageRevision
  confirming.value = true
  uni.showModal({ title, content, confirmText, success: (result) => {
    if (!alive || revision != pageRevision) return
    confirming.value = false
    if (!result.confirm) return
    if (hasPendingCommands.value) { notify('请先等待提交完成或核对原操作结果'); return }
    action()
  }, fail: (_) => { if (alive && revision == pageRevision) confirming.value = false } })
}

// 保存不等于握手成功：留在本页显示真实连接进展，原始异常不进入提示。
function saveConfiguration() {
  if (hasPendingCommands.value) { notify('请先等待提交完成或核对原操作结果'); return }
  try { bridge.configure(configuration.value); configuration.value = ''; configExpanded.value = false; connectionAnchor.value = 'connection-overview'; uni.hideKeyboard(); notify('配置已保存，正在连接') }
  catch (error) { notify(error instanceof Error && (error.message == '无法保存连接配置，请检查浏览器存储权限' || error.message == '操作正在提交，请稍后再更换连接') ? error.message : '配置无效，请核对电脑生成的内容') }
}
function importConfig() {
  if (configuration.value.trim().length == 0 || confirming.value) return
  if (connection.configured) confirmMaintenance('更换接入配置', '将替换此设备保存的接入配置，电脑上的任务会继续运行。', '更换并连接', saveConfiguration)
  else saveConfiguration()
}
// 只删除连接配置，偏好及其他本地数据沿用现有服务的保存规则。
function forgetConfiguration() {
  confirmMaintenance('清除本地连接', '仅清除此设备保存的连接，电脑上的任务会继续运行。聊天与通知偏好会保留。', '清除连接', () => {
    try { bridge.forgetConfiguration(); configuration.value = ''; configExpanded.value = false; notify('已清除本地连接') }
    catch (_) { notify('无法清除本地连接，请检查本地存储权限') }
  })
}
// 原生返回键优先关闭资料面板，保存期间等待结果。
onBackPress((): boolean => { if (editingComputer.value == null) return false; closeEditor(); return true })
// 模板通过本地方法调用导入函数，兼容原生模板编译。
function localComputerConnectionLabel(computer: Computer): string { return computerConnectionLabel(computer) }
</script>

<style>
.connection-page { position: relative; flex: 1; height: 100%; overflow: hidden; padding-top: var(--status-bar-height); background-color: #f6f7fa; }
.header { background-color: #ffffff; border-bottom: 1px solid #e0e4ec; height: 64px; padding: 8px 14px; flex-direction: row; align-items: center; flex-shrink: 0; }
.back { width: 44px; height: 44px; align-items: center; justify-content: center; border-radius: 14px; }
.header-title { font-size: 17px; line-height: 26px; font-weight: bold; color: #1a2135; margin-left: 8px; }
.content { flex: 1; height: 0; min-height: 0; }
.body { width: 100%; max-width: 720px; align-self: center; padding: 0 16px 30px; margin-bottom: var(--uni-safe-area-inset-bottom); }
/* 与设置页共用视觉层级：灰底分区、白色底板和内缩分隔线，不改变原有操作流程。 */
.group-title { color: #687386; font-size: 13px; line-height: 22px; font-weight: bold; margin: 24px 8px 10px; }
.section { padding: 18px 16px; background-color: #ffffff; border: 1px solid #dfe3ec; border-radius: 14px; flex-shrink: 0; }
.computer-section { margin-top: 20px; flex-shrink: 0; }
.computer-group-title { margin: 0; }
.computer-description { margin: 4px 8px 12px; }
.computer-list { padding: 0 12px; background-color: #ffffff; border: 1px solid #dfe3ec; border-radius: 14px; overflow: hidden; }
.computer-list .hint { padding: 18px 4px; margin-top: 0; }
.computer-separated { border-top: 1px solid #e5e8f1; }
.overview-heading { flex-direction: row; align-items: center; }
.page-title { color: #1a2135; font-size: 20px; line-height: 30px; font-weight: bold; margin-left: 12px; }
.description { color: #687386; font-size: 13px; line-height: 22px; margin-top: 8px; }
.section-title { color: #1a2135; font-size: 16px; line-height: 24px; font-weight: bold; }
.retry-button { min-height: 44px; align-self: flex-start; padding: 0 18px; margin-top: 14px; border-radius: 12px; }
.computer-heading { padding: 0 8px; min-height: 44px; flex-direction: row; align-items: center; justify-content: space-between; }
.sort-toggle { margin: 0; padding: 0 14px; height: 44px; line-height: 44px; font-size: 14px; border-radius: 10px; }
.sort-actions { flex-direction: row; flex-shrink: 0; }
.sort-button { margin: 0 0 0 6px; padding: 0 10px; height: 44px; line-height: 44px; font-size: 13px; border-radius: 10px; }
.sort-button[disabled] { opacity: 0.35; }
.computer-option { min-height: 68px; padding: 12px 4px; flex-direction: row; align-items: center; }
.option-name { flex: 1; min-width: 0; color: #1a2135; font-size: 15px; line-height: 22px; margin-left: 14px; margin-right: 10px; lines: 1; text-overflow: ellipsis; }
.dot { width: 6px; height: 6px; border-radius: 3px; margin-right: 6px; flex-shrink: 0; }
.online { background-color: #18765d; }
.offline { background-color: #737d91; }
.state { color: #596479; font-size: 12px; line-height: 20px; margin-right: 10px; flex-shrink: 0; }
.config-heading { min-height: 44px; flex-direction: row; align-items: center; justify-content: space-between; }
.config-input { width: 100%; height: 130px; margin-top: 14px; border-style: solid; border-width: 1px; border-color: #e5e8f1; border-radius: 12px; padding: 14px; color: #1a2135; font-size: 13px; line-height: 22px; background-color: #f6f7fa; }
.privacy-note { color: #596479; font-size: 12px; line-height: 20px; margin-top: 8px; }
.connect-button { width: 100%; height: 46px; line-height: 46px; padding: 0 18px; margin: 14px 0 0; border-radius: 12px; font-size: 15px; }
.hint { color: #596479; font-size: 12px; line-height: 20px; margin-top: 10px; }
.error-note { color: #8d4d2b; font-size: 13px; line-height: 22px; margin-top: 16px; }
.maintenance { margin-top: 12px; }
.maintenance .hint { margin-top: 0; }
.forget-button { width: 100%; min-height: 44px; line-height: 44px; margin: 14px 0 0; font-size: 14px; border-radius: 12px; }
.action-frame { position: relative; overflow: hidden; flex-shrink: 0; }
.action-hitbox { position: absolute; left: 0; top: 0; width: 100%; height: 100%; margin: 0; padding: 0; border-width: 0; border-radius: 0; background-color: transparent; font-size: 1px; line-height: 1px; }
.action-pressed { background-color: rgba(69, 70, 189, 0.07); }
/* #ifdef WEB */
.body { margin-left: auto; margin-right: auto; }
.option-name { display: block; white-space: nowrap; overflow: hidden; }
/* #endif */
</style>
