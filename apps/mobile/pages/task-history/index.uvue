<template>
  <view class="page history-page">
    <view class="history-header"><view class="history-back action-frame"><app-icon name="back" :size="23" /><button class="action-hitbox" hover-class="action-pressed" aria-label="返回上一页" @click="goBack"></button></view><text class="history-heading">执行记录</text></view>
    <view class="history-categories" role="tablist" aria-label="记录分类">
      <view v-for="(label, index) in categoryLabels" :key="label" class="history-category action-frame" :class="category == categoryValues[index] ? 'history-category-selected' : ''"><text class="history-category-label" :class="category == categoryValues[index] ? 'history-category-label-selected' : ''">{{ label }}</text><button class="action-hitbox" hover-class="action-pressed" role="tab" :aria-selected="category == categoryValues[index]" :aria-label="label" @click="chooseCategory(categoryValues[index])"></button></view>
    </view>
    <view class="history-filters">
      <!-- 按文字和图标的整体宽度居中，避免按钮默认布局和字符箭头基线造成偏移。 -->
      <view class="history-filter history-host-filter" :class="hostId.length > 0 ? 'history-filter-active' : ''">
        <view class="history-filter-content history-host-content"><view v-if="hostId.length > 0" class="history-selected-icon"><app-icon :name="selectedHostIcon" tone="muted" :size="16" /></view><text class="history-filter-label" :class="hostId.length > 0 ? 'history-filter-label-active' : ''">{{ selectedHostLabel }}</text></view><view class="history-host-chevron"><app-icon name="chevron-down" tone="muted" :size="14" /></view>
        <button class="action-hitbox" hover-class="history-filter-pressed" aria-label="筛选实例" @click="chooseHost"></button>
      </view>
      <view class="history-filter history-state-filter" :class="state.length > 0 ? 'history-filter-active' : ''">
        <view class="history-filter-content"><text class="history-filter-label" :class="state.length > 0 ? 'history-filter-label-active' : ''">{{ selectedStateLabel }}</text><view class="history-filter-chevron"><app-icon name="chevron-down" tone="muted" :size="14" /></view></view>
        <button class="action-hitbox" hover-class="history-filter-pressed" aria-label="筛选执行状态" @click="chooseState"></button>
      </view>
    </view>
    <text v-if="error.length > 0" class="history-error">{{ error }}</text>
    <scroll-view direction="vertical" class="history-scroll" :show-scrollbar="false" :refresher-enabled="true" :refresher-triggered="refreshing" refresher-background="#ffffff" @refresherrefresh="refreshHistory" @scrolltolower="loadMore">
      <view v-if="rows.length == 0 && !loading" class="history-empty"><text>{{ !connection.connected ? '正在等待连接' : cursors.length == 0 ? '实例暂未在线' : error.length > 0 ? '记录读取失败' : '暂无执行记录' }}</text><text class="history-empty-note">{{ !connection.connected ? '连接恢复后会自动读取；尚未配对时请返回首页连接实例。' : cursors.length == 0 ? '请确认所选实例在线，上线后将自动读取。' : error.length > 0 ? '请稍后下拉刷新重试。' : '记录保存在原守护进程，可切换筛选条件查看。' }}</text></view>
      <view v-for="row in rows" :key="row.hostId + ':' + row.task.id" class="history-task">
        <view class="history-task-heading"><text class="history-task-title">{{ row.task.title.length > 0 ? row.task.title : row.task.kind == 'newConversation' ? '新建聊天' : '聊天操作' }}</text><submission-task-status class="history-state" :state="row.task.state" /></view>
        <template v-if="row.task.threadId.length > 0"><button v-if="row.task.method != 'thread.delete'" class="history-chat-title" hover-class="action-pressed" @click="openTask(row.hostId, row.task)">{{ chatTitle(row.hostId, row.task) }}</button><text v-else class="history-chat-title history-chat-unavailable">{{ chatTitle(row.hostId, row.task) }}</text></template>
        <text class="history-meta">{{ hostName(row.hostId) }} · #{{ row.task.position }} · {{ row.task.kind == 'operation' ? '操作时间' : '提交时间' }} {{ dateLabel(row.task.createdAt) }}</text>
        <text v-if="row.task.completedAt > 0" class="history-meta">{{ completionLabel(row.task) }}</text>
        <text v-if="stageDetail(row.task).length > 0" class="history-stage">{{ stageDetail(row.task) }}</text>
        <text v-if="row.task.error.length > 0" class="history-error">{{ row.task.error }}</text>
        <view v-if="row.task.steps.length > 0" class="history-steps"><view v-for="step in row.task.steps" :key="step.name" class="history-step"><submission-task-status :state="step.state" /><text class="history-step-name">{{ step.name }}</text></view></view>
        <view v-if="row.task.kind != 'operation' && (row.task.state == 'failed' && row.task.canRetry == true || row.task.state == 'unknown' || canResume(row))" class="history-actions"><button v-if="row.task.state == 'failed' && row.task.canRetry == true" class="history-action" :disabled="working.length > 0" @click="retry(row)">重试</button><button v-if="row.task.state == 'unknown'" class="history-action" :disabled="working.length > 0" @click="control(row, 'reconcile')">核对结果</button><button v-if="row.task.state == 'unknown'" class="history-action" :disabled="working.length > 0" @click="skip(row)">已核对并跳过</button><button v-if="canResume(row)" class="history-action" :disabled="working.length > 0" @click="control(row, 'resume')">继续队列</button></view>
      </view>
      <button v-if="hasMore" class="history-more" :disabled="loading" @click="loadMore">{{ loading ? '正在读取…' : '加载更多' }}</button>
      <text class="history-footnote">{{ category == 'operation' ? '状态操作独立执行，不影响提交队列；重复已读确认合并记录。每设备保留最近30天且最多1000条结果。' : '每实例保留最近30天且最多1000条已结束记录；待核对任务保留至处理。' }}</text>
    </scroll-view>
    <view v-if="hostPickerOpen" class="history-instance-overlay" @click="closeHostPicker">
      <view class="history-instance-sheet" @click.stop>
        <view class="history-instance-heading"><text class="history-instance-title">筛选实例</text><view class="history-instance-close action-frame"><app-icon name="close" :size="20" /><button class="action-hitbox" hover-class="action-pressed" aria-label="关闭实例筛选" @click="closeHostPicker"></button></view></view>
        <scroll-view direction="vertical" class="history-instance-list" :style="{ height: hostPickerHeight + 'px' }" :show-scrollbar="false">
          <view class="history-instance-row action-frame" :class="hostId.length == 0 ? 'history-instance-selected' : ''">
            <view class="history-instance-icon"><app-icon name="desktop" tone="muted" :size="22" /></view><text class="history-instance-name">全部实例</text><view class="history-instance-check"><app-icon v-if="hostId.length == 0" name="check" :size="20" /></view><button class="action-hitbox" hover-class="action-pressed" role="radio" :aria-checked="hostId.length == 0" aria-label="选择全部实例" @click="selectHost('')"></button>
          </view>
          <view v-for="computer in connection.computers" :key="computer.id" class="history-instance-row action-frame" :class="hostId == computer.id ? 'history-instance-selected' : ''">
            <view class="history-instance-icon"><app-icon :name="computerIcon(computer)" tone="muted" :size="22" /></view><text class="history-instance-name">{{ computer.label }}</text><text class="history-instance-state">{{ connection.connected && computer.online ? '在线' : '离线' }}</text><view class="history-instance-check"><app-icon v-if="hostId == computer.id" name="check" :size="20" /></view><button class="action-hitbox" hover-class="action-pressed" role="radio" :aria-checked="hostId == computer.id" :aria-label="'选择实例 ' + computer.label" @click="selectHost(computer.id)"></button>
          </view>
          <text v-if="connection.computers.length == 0" class="history-instance-empty">暂无可筛选的实例</text>
        </scroll-view>
        <view class="history-instance-safe-area"></view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed, nextTick, ref, watch } from 'vue'
import SubmissionTaskStatus from '../../components/submission-task-status/submission-task-status.uvue'
import AppIcon from '../../components/app-icon/app-icon.uvue'
import { bridge, connection, Computer, computerIcon as resolveComputerIcon } from '../../services/bridge.uts'
import { SubmissionTask, submissionStageDetail, submissionInstance } from '../../services/submission-task-state.uts'
import { readSubmissionTasks, controlSubmissionTask } from '../../services/submission-tasks.uts'
import { submissionHistoryOrder } from '../../services/submission-task-presentation.uts'
type HistoryRow = { hostId: string, task: SubmissionTask }
type HistoryCursor = { hostId: string, before: number, more: boolean }
const hostId = ref(''), state = ref(''), rows = ref<HistoryRow[]>([]), loading = ref(false), error = ref(''), working = ref('')
const category = ref('submission')
const categoryValues = ['submission', 'operation'], categoryLabels = ['提交任务', '状态操作']
const cursors = ref<HistoryCursor[]>([])
const refreshing = ref(false)
const hostPickerOpen = ref(false), hostPickerWindowHeight = ref(640)
const hostPickerHeight = computed((): number => Math.max(60, Math.min((connection.computers.length + 1) * 60 + (connection.computers.length == 0 ? 36 : 0), 380, hostPickerWindowHeight.value - 160)))
let request = 0
const pageVisible = ref(false)
const onlineHosts = computed((): string => connection.computers.filter((computer: Computer): boolean => computer.online).map((computer: Computer): string => computer.id).sort().join(','))
const stateValues = computed((): string[] => category.value == 'operation' ? ['', 'running', 'succeeded', 'failed', 'unknown'] : ['', 'succeeded', 'failed', 'unknown', 'waiting_resume', 'canceled', 'skipped'])
const stateLabels = computed((): string[] => category.value == 'operation' ? ['全部状态', '执行中', '已完成', '执行失败', '结果待核对'] : ['全部状态', '已完成', '执行失败', '结果待核对', '等待继续', '已取消', '已人工跳过'])
// 原生模板通过本地方法调用导入函数，避免 UTS 将其解析为函数对象。
function computerIcon(computer: Computer | null): string { return resolveComputerIcon(computer) }
function hostName(id: string): string { return connection.computers.find((computer: Computer): boolean => computer.id == id)?.label ?? '原实例' }
const selectedHostLabel = computed((): string => hostId.value.length == 0 ? '全部实例' : hostName(hostId.value))
// 与选择列表共用实例图标映射，连接设置更新图标时筛选框同步更新。
const selectedHostIcon = computed((): string => computerIcon(connection.computers.find((computer: Computer): boolean => computer.id == hostId.value) ?? null))
const selectedStateLabel = computed((): string => stateLabels.value[stateValues.value.indexOf(state.value)] ?? '全部状态')
const hasMore = computed((): boolean => cursors.value.some((cursor: HistoryCursor): boolean => cursor.more))
// 聊天标题随执行记录持久化，历史页不再额外查询普通或归档列表。
function chatTitle(id: string, task: SubmissionTask): string {
  const title = task.threadTitle ?? ''
  if (title.length > 0) return title
  return task.kind == 'newConversation' ? task.title : '历史记录未保存标题'
}
function stageDetail(task: SubmissionTask): string { return submissionStageDetail(task) }
function canResume(row: HistoryRow): boolean { const snapshot = submissionInstance(row.hostId)?.snapshot; return snapshot?.paused == true && snapshot.blockerId == row.task.id && ['failed', 'waiting_resume', 'succeeded', 'skipped', 'canceled', 'cancelled'].indexOf(row.task.state) >= 0 }
function dateLabel(value: number): string { const date = new Date(value); return date.getFullYear() + '-' + (date.getMonth() + 1) + '-' + date.getDate() + ' ' + date.getHours().toString().padStart(2, '0') + ':' + date.getMinutes().toString().padStart(2, '0') }
// 完成时间只取守护进程的实际结果时间，重试成功不能沿用最初提交或手机刷新时间。
function completionLabel(task: SubmissionTask): string {
  let label = '结束时间'
  if (task.state == 'succeeded') label = '成功时间'
  else if (task.state == 'failed') label = '失败时间'
  else if (task.state == 'canceled' || task.state == 'cancelled') label = '取消时间'
  else if (task.state == 'skipped') label = '跳过时间'
  const elapsed = Math.max(0, task.completedAt - task.startedAt)
  const duration = task.startedAt > 0 ? ' · 耗时 ' + (task.kind == 'operation' && elapsed < 1000 ? elapsed + ' 毫秒' : task.kind == 'operation' ? (elapsed / 1000).toFixed(2) + ' 秒' : Math.round(elapsed / 1000) + ' 秒') : ''
  return label + ' ' + dateLabel(task.completedAt) + duration
}
// 每实例独立游标，全部实例仅合并显示，不能把一个实例游标传给另一实例。
async function loadMore() {
  if (loading.value || !connection.connected) return
  const revision = request, namespace = connection.cacheNamespace
  loading.value = true; error.value = ''
  const failures: string[] = []
  try {
    for (const cursor of cursors.value) {
      if (!cursor.more) continue
      // 各实例分别结算；旧版或离线实例不能阻断其他记录及聊天标题的读取。
      try {
      const params: UTSJSONObject = { view: 'history', limit: 30 }
      if (category.value == 'operation') params['category'] = 'operation'
      if (cursor.before > 0) params['before'] = cursor.before
      if (state.value.length > 0) params['state'] = state.value
      const result = await readSubmissionTasks(cursor.hostId, params)
      if (revision != request || namespace != connection.cacheNamespace) return
      // 旧服务可能忽略新筛选字段，不能将提交任务误显示为状态操作。
      if (category.value == 'operation' && result.getBoolean('supportsOperationHistory') != true) throw new Error('请更新电脑连接服务后查看状态操作记录')
      const tasks = JSON.parse<SubmissionTask[]>(JSON.stringify(result['tasks'] ?? [] as SubmissionTask[])) ?? [] as SubmissionTask[]
      tasks.forEach((task: SubmissionTask) => { if (!rows.value.some((row: HistoryRow): boolean => row.hostId == cursor.hostId && row.task.id == task.id)) rows.value.push({ hostId: cursor.hostId, task } as HistoryRow) })
      const next = result.getNumber('nextCursor') ?? 0
      cursor.before = next; cursor.more = next > 0
      } catch (reason) {
        if (revision != request || namespace != connection.cacheNamespace) return
        cursor.more = false
        failures.push(hostName(cursor.hostId) + '：' + (reason as Error).message)
      }
    }
    rows.value = rows.value.sort((a: HistoryRow, b: HistoryRow): number => submissionHistoryOrder(a.task, b.task))
    if (revision == request) error.value = failures.join('；')
  } catch (reason) { if (revision == request) error.value = (reason as Error).message }
  finally { if (revision == request) { loading.value = false; refreshing.value = false } }
}
function reload() {
  request++; loading.value = false; error.value = ''; rows.value = [] as HistoryRow[]
  cursors.value = connection.computers.filter((computer: Computer): boolean => computer.online && (hostId.value.length == 0 || computer.id == hostId.value)).map((computer: Computer): HistoryCursor => ({ hostId: computer.id, before: 0, more: true } as HistoryCursor))
  if (!connection.connected) { refreshing.value = false; bridge.resume(); return }
  loadMore()
}
// 分类切换清空旧游标与状态筛选，迟到的另一类结果由请求代次丢弃。
function chooseCategory(value: string) { if (category.value == value) return; category.value = value; state.value = ''; reload() }
// 下拉刷新保留筛选条件并重置分页，重复手势不重复请求；结束状态由当前请求统一收起。
async function refreshHistory() {
  if (refreshing.value) return
  refreshing.value = true
  // 先让控件收到开始状态，避免离线或无在线实例时同帧结束而无法收起下拉动画。
  await nextTick()
  if (!refreshing.value) return
  reload()
}
// 使用自定义列表展示实例配置的图标，原生文字菜单无法显示图标和选中标记。
function chooseHost() { uni.hideKeyboard(); hostPickerWindowHeight.value = uni.getWindowInfo().windowHeight; hostPickerOpen.value = true }
function closeHostPicker() { hostPickerOpen.value = false }
// 这里只改变记录筛选，不切换当前聊天连接；实例在面板打开期间被移除时拒绝旧点击。
function selectHost(id: string) {
  if (id.length > 0 && !connection.computers.some((computer: Computer): boolean => computer.id == id)) return
  closeHostPicker()
  if (hostId.value == id) return
  hostId.value = id
  reload()
}
function chooseState() { uni.showActionSheet({ itemList: stateLabels.value, success: (answer) => { state.value = stateValues.value[answer.tapIndex]; reload() } }) }
function openTask(id: string, task: SubmissionTask) {
  if (task.threadId.length == 0 || task.method == 'thread.delete') return
  try { bridge.selectComputer(id); uni.navigateTo({ url: '/pages/conversation/index?hostId=' + encodeURIComponent(id) + '&threadId=' + encodeURIComponent(task.threadId) + '&title=' + encodeURIComponent(chatTitle(id, task)) }) } catch (reason) { error.value = (reason as Error).message }
}
async function control(row: HistoryRow, action: string, confirmed: boolean = false) { if (working.value.length > 0) return; working.value = row.task.id; try { await controlSubmissionTask(row.hostId, row.task.id, action, confirmed, row.task.attempt ?? 0); reload() } catch (reason) { error.value = (reason as Error).message } finally { working.value = '' } }
// 历史入口与首页使用同一原任务和尝试编号，删除仍须再次确认。
function retry(row: HistoryRow) { if (working.value.length > 0 || row.task.state != 'failed' || row.task.canRetry != true) return; if (row.task.method == 'thread.delete') { uni.showModal({ title: '重试永久删除聊天', content: '将再次删除原聊天及其附属聊天，删除后无法恢复。是否重试？', confirmText: '重试删除', cancelText: '取消', success: (answer) => { if (answer.confirm) control(row, 'retry', true) } }); return }; control(row, 'retry', true) }
function skip(row: HistoryRow) { uni.showModal({ title: '跳过待核对任务', content: '请先在电脑核对。确认后不会重发原任务，并继续该实例队列。', confirmText: '已核对，继续', success: (answer) => { if (answer.confirm) control(row, 'skip', true) } }) }
// 与设置页一致，返回前收起键盘；直接进入记录页时仍能返回聊天列表。
function goBack() { if (hostPickerOpen.value) { closeHostPicker(); return }; uni.hideKeyboard(); if (getCurrentPages().length > 1) uni.navigateBack(); else uni.reLaunch({ url: '/pages/index/index' }) }
// 浏览器刷新时连接晚于页面恢复，连接和在线电脑变化后自动重新读取。
watch((): string => connection.connected.toString() + ':' + connection.cacheNamespace + ':' + onlineHosts.value, () => { if (pageVisible.value) reload() })
onLoad((options: OnLoadOptions) => { hostId.value = options['hostId'] ?? '' })
onShow(() => { pageVisible.value = true; reload() })
onResize(() => { if (hostPickerOpen.value) hostPickerWindowHeight.value = uni.getWindowInfo().windowHeight })
onBackPress((): boolean => { if (!hostPickerOpen.value) return false; closeHostPicker(); return true })
onHide(() => { closeHostPicker(); pageVisible.value = false; request++; loading.value = false; refreshing.value = false })
onUnload(() => { closeHostPicker(); pageVisible.value = false; request++; refreshing.value = false })
</script>

<style>
.history-page { flex: 1; height: 100%; padding-top: var(--status-bar-height); }
.history-header { background-color: #ffffff; border-bottom-style: solid; border-bottom-width: 1px; border-bottom-color: #e0e4ec; height: 64px; padding: 8px 14px; flex-direction: row; align-items: center; flex-shrink: 0; }
.history-back { width: 44px; height: 44px; align-items: center; justify-content: center; border-radius: 14px; }
.history-heading { font-size: 17px; line-height: 26px; font-weight: bold; color: #1a2135; margin-left: 8px; }
.history-categories { margin: 12px 16px 0; padding: 4px; border-radius: 14px; background-color: #f1f2fa; flex-direction: row; flex-shrink: 0; }
.history-category { flex: 1; height: 38px; border-radius: 10px; align-items: center; justify-content: center; }
.history-category-selected { background-color: #ffffff; }
.history-category-label { font-size: 14px; line-height: 22px; color: #596479; }
.history-category-label-selected { color: #4546bd; font-weight: bold; }
.action-frame { position: relative; overflow: hidden; flex-shrink: 0; }
.action-hitbox { position: absolute; left: 0; top: 0; width: 100%; height: 100%; margin: 0; padding: 0; border-width: 0; border-radius: 0; background-color: transparent; font-size: 1px; line-height: 1px; }
.action-pressed { background-color: rgba(69, 70, 189, 0.07); }
.history-filters { flex-direction: row; align-items: center; padding: 12px 16px; flex-shrink: 0; }
.history-filter { position: relative; flex: 1; min-width: 0; height: 44px; margin: 0 8px 0 0; padding: 0 10px; flex-direction: row; align-items: center; justify-content: center; border-width: 1px; border-style: solid; border-color: #e4e7ef; border-radius: 12px; background-color: #f7f8fc; overflow: hidden; }
/* 左右对称预留箭头空间，图标和名称的组合独立居中，长名称只压缩文字。 */
.history-host-content { flex-shrink: 1; margin: 0 20px; }
.history-selected-icon { width: 16px; height: 20px; margin-right: 6px; flex-shrink: 0; align-items: center; justify-content: center; }
.history-host-chevron { position: absolute; right: 10px; top: 0; bottom: 0; width: 14px; align-items: center; justify-content: center; }
.history-filter-content { flex-direction: row; align-items: center; justify-content: center; max-width: 100%; min-width: 0; height: 20px; }
.history-filter-label { flex-shrink: 1; min-width: 0; height: 20px; font-size: 13px; line-height: 20px; text-align: center; color: #596479; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.history-filter-chevron { width: 14px; height: 20px; margin-left: 6px; flex-shrink: 0; align-items: center; justify-content: center; }
.history-filter-active { background-color: #eeefff; border-color: #c9cdf5; }
.history-filter-label-active { color: #4546bd; }
.history-state-filter { margin-right: 0; }
.history-filter-pressed { background-color: rgba(69, 70, 189, 0.08); }
.history-scroll { flex: 1; min-height: 0; }
.history-task { margin: 8px 16px; padding: 14px; border-radius: 14px; background-color: #f5f6fc; }
.history-task-heading { flex-direction: row; align-items: center; }
.history-task-title { flex: 1; font-weight: bold; font-size: 15px; color: #1a2135; }
.history-state { margin-left: 10px; }
.history-chat-title { margin: 7px 0 0; padding: 0; border-width: 0; border-radius: 4px; background-color: transparent; font-size: 13px; line-height: 20px; color: #4546bd; text-align: left; white-space: normal; overflow-wrap: anywhere; }
.history-chat-title::after { border-width: 0; }
.history-chat-title.action-pressed { background-color: rgba(69, 70, 189, 0.07); }
.history-chat-unavailable { color: #8590a4; }
.history-meta, .history-stage, .history-step { margin-top: 5px; font-size: 12px; line-height: 19px; color: #596479; }
.history-step { flex-direction: row; align-items: center; }
.history-step-name { margin-left: 6px; font-size: 12px; line-height: 19px; color: #596479; }
.history-error { margin: 4px 16px; font-size: 12px; line-height: 20px; color: #9b493a; }
.history-actions { margin-top: 8px; flex-direction: row; flex-wrap: wrap; }
