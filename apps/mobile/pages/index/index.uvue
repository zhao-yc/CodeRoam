<template>
  <view id="home-page" class="page">
    <view id="home-header" class="header">
      <template v-if="searchVisible && !editingNewConversation">
        <view class="search-field header-search"><app-icon name="search" :size="20" tone="muted" /><input v-model="search" class="search-input" :focus="searchFocused" placeholder="搜索聊天或项目" :maxlength="100" confirm-type="search" @blur="searchFocused = false" /></view>
        <view class="header-button action-frame"><app-icon name="close" :size="23" /><button class="action-hitbox" hover-class="action-pressed" aria-label="关闭搜索" @click="closeSearch"></button></view>
      </template>
      <template v-else>
        <view v-if="editingNewConversation" class="header-button action-frame"><app-icon name="back" :size="23" /><button class="action-hitbox" :disabled="creatingConversation" aria-label="返回聊天列表" @click="closeNewConversation"></button></view>
        <text v-if="editingNewConversation" class="page-title new-page-title">新聊天</text>
        <!-- 标题和箭头共用点击区域，新对话页保留独立标题。 -->
        <view v-else class="list-title"><view class="list-title-trigger action-frame"><text class="list-title-text">掌上Codex</text><app-icon name="chevron-down" :size="18" /><button class="action-hitbox" aria-label="掌上Codex列表菜单" :aria-expanded="menuVisible" hover-class="action-pressed" @click="menuVisible = !menuVisible"></button></view></view>
        <view class="header-actions"><view v-if="!editingNewConversation" class="header-button action-frame"><app-icon name="search" :size="23" /><button class="action-hitbox" hover-class="action-pressed" aria-label="搜索聊天" @click="openSearch"></button></view><view class="header-button action-frame"><app-icon name="settings" :size="23" /><button class="action-hitbox" :disabled="creatingConversation" hover-class="action-pressed" aria-label="电脑连接设置" @click="openConnection"></button></view></view>
      </template>
    </view>
    <view v-show="!editingNewConversation" class="list-shell">
    <view v-if="connection.computers.length > 1" class="computer-tabs">
      <view :class="['computer-tab', 'all-tab', selectedComputerId.length == 0 ? 'computer-tab-selected' : '']" @click="chooseComputerFilter('')"><text class="tab-label">全部</text></view>
      <scroll-view direction="horizontal" :show-scrollbar="false" class="computer-scroll"><view class="computer-tab-content"><view v-for="computer in connection.computers" :key="computer.id" :id="computerTabElementId(computer.id)" :class="['computer-tab', selectedComputerId == computer.id ? 'computer-tab-selected' : '']" :aria-label="computer.label + (computer.online && connection.connected ? '，在线' : '，离线')" @click="chooseComputerFilter(computer.id)" @longpress="openComputerMenu(computer.id)" @touchend="finishComputerPress"><view v-if="computerIndicator(computer.id) != 'idle'" class="computer-indicator" :aria-label="computerIndicator(computer.id) == 'running' ? '有任务执行中' : '有未读结果'"><loading v-if="computerIndicator(computer.id) == 'running'" class="computer-spinner" :paused="!pageVisible" /><view v-else class="computer-unread-dot"></view></view><view class="computer-connection-content" :style="{ opacity: computerSyncState(computer.id) == 'loading' ? computerPulseOpacity : 1 }" :aria-label="computerSyncLabel(computer.id)"><app-icon :name="iconForComputer(computer)" :size="17" tone="muted" /><text class="tab-label computer-name">{{ computer.label }}</text></view><view v-if="computerSyncState(computer.id) == 'offline' || computerSyncState(computer.id) == 'error'" class="computer-sync-badge" :aria-label="computerSyncLabel(computer.id)"><app-icon name="alert-triangle" :size="14" tone="warning" /></view></view></view></scroll-view>
    </view>
    <view v-if="connection.error.length > 0" class="notice"><text class="notice-text">{{ connection.error }}</text></view>
    <scroll-view direction="vertical" :show-scrollbar="false" :scroll-top="threadScrollTop" class="thread-list" @scroll="onThreadListScroll">
      <view class="list-content">
        <view v-if="!connection.configured" class="empty"><text class="empty-title">在手机上继续你的聊天</text><text class="description">首次使用时连接电脑，已有聊天就会显示在这里。</text><button class="empty-action button-primary" @click="openConnection">连接电脑</button></view>
        <loading-skeleton v-else-if="showThreadLoading" kind="list" :visible="pageVisible && !editingNewConversation" />
        <view v-else-if="allVisibleThreads.length == 0 && (connection.error.length > 0 || listUnavailable)" class="empty"><text class="empty-title">{{ listUnavailable && !selectedComputerOnline ? '电脑离线' : '聊天加载失败' }}</text><text class="description">请检查连接后重试。</text><button class="empty-action button-secondary" @click="refreshThreads">重新加载</button></view>
        <view v-else-if="groups.length == 0" class="empty">
          <text class="empty-title">{{ search.trim().length > 0 ? '没有找到相关聊天' : '暂无聊天' }}</text>
          <text class="description">{{ search.trim().length > 0 ? '试试其他标题或项目名称。' : selectedComputerOnline ? '电脑上的聊天会显示在这里。' : '电脑恢复连接后会自动同步。' }}</text>
          <button v-if="search.trim().length > 0" class="empty-action button-secondary" @click="search = ''">清除搜索</button>
          <button v-else class="empty-action button-secondary" @click="refreshThreads">重新同步</button>
        </view>
        <view v-for="group in groups" :key="group.key" class="thread-group">
          <text class="group-title">{{ group.title }}</text>
          <view v-for="thread in group.threads" :key="thread.key" :class="['thread', connection.hostId == thread.hostId && connection.activeThreadId == thread.id ? 'thread-selected' : '']" @click="openThread(thread)">
            <view class="thread-heading"><text class="thread-title">{{ thread.title }}</text><task-status v-if="threadState(thread) == 'failed'" class="thread-failure" state="failed" /><task-status v-if="threadState(thread) != 'failed' && (threadState(thread) != 'question' || (thread.unansweredQuestionCount ?? 0) == 0)" :hide-running-label="true" class="thread-status" :state="threadState(thread)" :visible="pageVisible" /></view>
            <!-- 状态放在标题右侧，时间放在项目右侧；保留待回答数量和原有显示条件。 -->
            <view class="thread-meta">
              <view v-if="selectedComputerId.length == 0 && connection.computers.length > 1" class="thread-computer-meta"><app-icon class="thread-meta-icon" :name="iconForThread(thread)" :size="16" tone="muted" /><text class="thread-computer">{{ thread.hostLabel }}</text></view>
              <app-icon class="thread-meta-icon" name="folder" :size="16" tone="muted" /><text class="thread-project">{{ thread.cwd.length > 0 ? projectName(thread.cwd) : '未指定项目' }}</text><text v-if="thread.online && (thread.unansweredQuestionCount ?? 0) > 0" class="thread-question">待回答 {{ thread.unansweredQuestionCount }}</text><text v-if="threadState(thread) != 'running'" class="thread-time">{{ updatedLabel(thread.updatedAt) }}</text>
            </view>
          </view>
        </view>
        <view class="list-bottom"></view>
      </view>
    </scroll-view>
    </view>
    <new-conversation :expanded="editingNewConversation" @expand="openNewConversation" @busy="onNewConversationBusy" @created="onConversationCreated" @dismiss="closeNewConversation" />
    <connection-editor v-if="editingComputer != null" :computer="editingComputer!" :anchor-left="connectionMenuLeft" :anchor-top="connectionMenuTop" :release-at="connectionReleaseAt" @release="finishComputerPress" @dismiss="closeComputerMenu" @busy="onConnectionEditorBusy" />
    <task-notice :active="pageVisible" header-id="home-header" />
    <home-menu v-if="menuVisible" :sort="listSort" :recent-first="recentFirst" :computer-id="selectedComputerId" @dismiss="menuVisible = false" @sort="selectSort" @recent="toggleRecent" @connection="openMenuConnection" />
  </view>
</template>

<script setup lang="uts">
import { computed, ref, nextTick, watch, onUnmounted } from 'vue'
import { bridge, connection, Computer, computerIcon, taskState, conversationTaskState, threadIndicator } from '../../services/bridge.uts'
import { threadList, ComputerThread, ComputerThreads, visibleComputerThreads, computerThreadsLoading, refreshComputerThreads } from '../../services/thread-list.uts'
import { consumeArchiveSuccessNotice, consumeDeleteSuccessNotice } from '../../services/page-notices.uts'
import TaskNotice from '../../components/task-notice/task-notice.uvue'
import AppIcon from '../../components/app-icon/app-icon.uvue'
import TaskStatus from '../../components/task-status/task-status.uvue'
import LoadingSkeleton from '../../components/loading-skeleton/loading-skeleton.uvue'
import ConnectionEditor from '../../components/connection-editor/connection-editor.uvue'
import NewConversation from '../../components/new-conversation/new-conversation.uvue'
import HomeMenu from '../../components/home-menu/home-menu.uvue'
import { groupThreads, normalizeListPreferences, rememberRecentThread, ThreadGroup, ListPreferences, RecentThread } from '../../services/thread-presentation.uts'

const menuVisible = ref(false)
const listSort = ref('project')
const recentFirst = ref(false)
const recentThreads = ref([] as RecentThread[])
// 偏好与最近访问独立存储；存储受限时仍保持当前页面可用。
function restoreListPreferences() {
  try {
    const raw = uni.getStorageSync('codex-mobile-list-preferences') as string
    const saved = normalizeListPreferences(raw.length > 0 ? JSON.parse<ListPreferences>(raw) : null)
    listSort.value = saved.sort; recentFirst.value = saved.recentFirst
    const recent = uni.getStorageSync('codex-mobile-list-recent') as string
    recentThreads.value = recent.length > 0 ? (JSON.parse<RecentThread[]>(recent) ?? [] as RecentThread[]).filter((entry: RecentThread): boolean => entry.key.length > 0 && entry.viewedAt > 0).slice(0, 30) : [] as RecentThread[]
  } catch (_) { listSort.value = 'project'; recentFirst.value = false; recentThreads.value = [] as RecentThread[] }
}
function saveListPreferences() { try { uni.setStorageSync('codex-mobile-list-preferences', JSON.stringify({ sort: listSort.value, recentFirst: recentFirst.value })) } catch (_) { uni.showToast({ title: '当前选择已生效，暂无法保存偏好', icon: 'none' }) } }
function selectSort(value: string) { if (['priority', 'project', 'time'].indexOf(value) < 0) return; listSort.value = value; saveListPreferences(); menuVisible.value = false; resetThreadScroll() }
function toggleRecent() { recentFirst.value = !recentFirst.value; saveListPreferences(); menuVisible.value = false; resetThreadScroll() }
// 添加连接直接定位接入配置，设置入口保留当前连接概览。
function openMenuConnection(adding: boolean) { menuVisible.value = false; uni.navigateTo({ url: '/pages/connection/index' + (adding ? '?add=true' : '') }) }
restoreListPreferences()
const search = ref('')
const searchVisible = ref(false)
const searchFocused = ref(false)
const selectedComputerId = ref('')
const editingNewConversation = ref(false)
const editingComputerId = ref('')
const connectionMenuLeft = ref(12)
const connectionMenuTop = ref(104)
const connectionEditorBusy = ref(false)
const connectionReleaseAt = ref(0)
let suppressComputerClickUntil = 0
const editingComputer = computed((): Computer | null => connection.computers.find((computer: Computer): boolean => computer.id == editingComputerId.value) ?? null)
// 原生元素查询在 Web 内部使用 CSS 选择器；逐字符编码避免实例编号中的特殊符号及替换碰撞。
function computerTabElementId(id: string): string {
  let result = 'computer-tab'
  for (let index = 0; index < id.length; index++) result += '-' + id.charCodeAt(index).toString(16)
  return result
}
// 长按只编辑目标标签，保留当前筛选、执行电脑和列表滚动位置。
function openComputerMenu(id: string) {
  if (editingNewConversation.value) return
  const tab = uni.getElementById(computerTabElementId(id))?.getBoundingClientRect()
  const page = uni.getElementById('home-page')?.getBoundingClientRect()
  connectionMenuLeft.value = tab?.left ?? 12
  connectionMenuTop.value = (tab?.bottom ?? 104) - (page?.top ?? 0) + 4
  suppressComputerClickUntil = Date.now() + 800
  connectionReleaseAt.value = 0
  editingComputerId.value = id
}
// 原始手势松手后短暂屏蔽遮罩点击，避免菜单被同一次触摸立即关闭。
function finishComputerPress() { if (connectionReleaseAt.value == 0) connectionReleaseAt.value = Date.now() }
function closeComputerMenu() { editingComputerId.value = ''; connectionEditorBusy.value = false; suppressComputerClickUntil = Date.now() + 350 }
function onConnectionEditorBusy(value: boolean) { connectionEditorBusy.value = value }
function iconForComputer(computer: Computer): string { return computerIcon(computer) }
// 会话使用所属客户端的配置图标，旧连接或缺失配置沿用笔记本兜底。
function iconForThread(thread: ComputerThread): string {
  const computer = connection.computers.find((entry: Computer): boolean => entry.id == thread.hostId) ?? null
  return computerIcon(computer)
}
const creatingConversation = ref(false)
const threadScrollTop = ref(0)
let savedThreadScrollTop = 0
let restoringThreadScroll = false
const dayStart = ref(0)
const currentTime = ref(Date.now())
let statusTimer = 0
const pageVisible = ref(false)
let archiveToastRequest = 0
// 筛选只影响列表；当前执行电脑在打开会话或新建编辑区时才切换。
const selectedComputers = computed((): ComputerThreads[] => threadList.computers.filter((entry: ComputerThreads): boolean => selectedComputerId.value.length == 0 || entry.hostId == selectedComputerId.value))
const allVisibleThreads = computed((): ComputerThread[] => visibleComputerThreads(selectedComputerId.value, ''))
type ComputerIndicator = { hostId: string, state: string }
// 汇总各电脑完整列表，与会话行共用状态判断；筛选和搜索不能隐藏其他电脑的提醒。
const computerIndicators = computed((): ComputerIndicator[] => {
  const threads = visibleComputerThreads('', '')
  return connection.computers.map((computer: Computer): ComputerIndicator => {
    const states = threads.filter((thread: ComputerThread): boolean => thread.hostId == computer.id).map((thread: ComputerThread): string => threadState(thread))
    return { hostId: computer.id, state: states.indexOf('running') >= 0 ? 'running' : states.indexOf('unread') >= 0 ? 'unread' : 'idle' } as ComputerIndicator
  })
})
// 运行优先于未读；空列表、已读、等待操作及离线均不生成常驻在线圆点。
function computerIndicator(hostId: string): string { return computerIndicators.value.find((entry: ComputerIndicator): boolean => entry.hostId == hostId)?.state ?? 'idle' }
const selectedComputerOnline = computed((): boolean => connection.connected && selectedComputers.value.some((entry: ComputerThreads): boolean => entry.online))
const showThreadLoading = computed((): boolean => computerThreadsLoading(selectedComputerId.value))
const listUnavailable = computed((): boolean => selectedComputers.value.length > 0 && selectedComputers.value.every((entry: ComputerThreads): boolean => !entry.online || entry.error.length > 0))
// 连接重试期间保持呼吸；明确离线或读取失败后才显示失败图标。
function computerSyncState(hostId: string): string {
  const computer = connection.computers.find((item: Computer): boolean => item.id == hostId)
  const entry = threadList.computers.find((item: ComputerThreads): boolean => item.hostId == hostId)
  if (computer == null) return ''
  if (!connection.connected) return connection.error.length == 0 && (connection.status == '正在连接' || connection.status == '正在重新连接') ? 'loading' : 'offline'
  if (!computer.online) return 'offline'
  if (entry != null && entry.error.length > 0) return 'error'
  return entry != null && entry.loading && !entry.loaded ? 'loading' : ''
}
// 图标保留无障碍说明，不再占用列表中的独立提示行。
function computerSyncLabel(hostId: string): string {
  const state = computerSyncState(hostId)
  return state == 'offline' ? '电脑离线' : state == 'error' ? '聊天读取失败' : state == 'loading' ? '正在同步聊天' : ''
}

const computerPulseOpacity = ref(1)
let computerPulseTimer = 0
const computerPulseActive = computed((): boolean => pageVisible.value && !editingNewConversation.value && connection.computers.length > 1 && connection.computers.some((computer: Computer): boolean => computerSyncState(computer.id) == 'loading'))
// 多台连接共用一个时钟；成功后恢复原深度，隐藏页面或卸载后停止呼吸。
function stopComputerPulse() { clearInterval(computerPulseTimer); computerPulseTimer = 0; computerPulseOpacity.value = 1 }
watch(computerPulseActive, (active: boolean) => {
  stopComputerPulse()
  if (!active) return
  computerPulseOpacity.value = 0.35
  computerPulseTimer = setInterval(() => { computerPulseOpacity.value = computerPulseOpacity.value == 1 ? 0.35 : 1 }, 800)
}, { immediate: true })

onUnmounted(() => { stopComputerPulse() })

// 默认按项目展示，切换排序和最近开关只影响当前筛选后的会话。
const groups = computed((): ThreadGroup[] => {
  const threads = visibleComputerThreads(selectedComputerId.value, search.value)
  return groupThreads(threads, listSort.value, recentFirst.value, recentThreads.value, dayStart.value)
})

// 返回首页和跨日时更新分组；隐藏页面后停止时钟与运行状态动画。
function updateClock() {
  currentTime.value = Date.now()
  const now = new Date(currentTime.value)
  dayStart.value = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime()
}
// 显隐期间原生滚动容器可能收紧最大偏移，恢复时显式回到用户离开的位置。
function restoreThreadScroll() { restoringThreadScroll = true; nextTick(() => { threadScrollTop.value = savedThreadScrollTop; nextTick(() => { restoringThreadScroll = false }) }) }

// 归档反馈由列表页显示；等列表渲染完成后调用原生接口，避免绑定到正在关闭的详情页。
function showDeleteSuccessNotice() {
  if (!consumeDeleteSuccessNotice()) return
  const request = ++archiveToastRequest
  nextTick(() => {
    if (pageVisible.value && request == archiveToastRequest) uni.showToast({ title: '永久删除成功', icon: 'success', duration: 3000 })
  })
}

function showArchiveSuccessNotice() {
  if (!consumeArchiveSuccessNotice()) return
  const request = ++archiveToastRequest
  nextTick(() => {
    if (pageVisible.value && request == archiveToastRequest) uni.showToast({ title: '归档成功', icon: 'success', duration: 3000 })
  })
}

onShow(() => {
  pageVisible.value = true
  showArchiveSuccessNotice()
  showDeleteSuccessNotice()
  if (!editingNewConversation.value) restoreThreadScroll()
  updateClock()
  clearInterval(statusTimer)
  statusTimer = setInterval(() => { updateClock() }, 60000)
})
onHide(() => { pageVisible.value = false; menuVisible.value = false; archiveToastRequest++; closeComputerMenu(); clearInterval(statusTimer); statusTimer = 0 })
onUnload(() => { pageVisible.value = false; menuVisible.value = false; archiveToastRequest++; closeComputerMenu(); clearInterval(statusTimer); statusTimer = 0 })

// 列表状态来自实际读取结果，当前订阅会话优先采用实时快照。
function threadState(thread: ComputerThread): string {
  const snapshot = connection.snapshot
  if (connection.hostId == thread.hostId && snapshot?.threadId == thread.id) return threadIndicator(conversationTaskState(snapshot, thread.online), snapshot?.hasUnreadTurn ?? null)
  return threadIndicator(taskState(thread.status ?? '', thread.activeTurnId ?? '', thread.approvalCount ?? 0, thread.pendingQuestionCount ?? 0, thread.online, thread.activeFlags ?? [], thread.latestTurn?.status ?? ''), thread.hasUnreadTurn ?? null)
}

// 更新时间使用真实时间戳，缺少时间时留空，不伪造最近活动。
function updatedLabel(value: number): string {
  if (value <= 0) return ''
  if (value <= currentTime.value && currentTime.value - value < 60000) return '刚刚'
  const date = new Date(value)
  const time = date.getHours().toString().padStart(2, '0') + ':' + date.getMinutes().toString().padStart(2, '0')
  return value >= dayStart.value ? time : (date.getMonth() + 1).toString().padStart(2, '0') + '-' + date.getDate().toString().padStart(2, '0')
}

// 低频接入与设备管理只在独立页面中提供。
function openConnection() { if (!creatingConversation.value) uni.navigateTo({ url: '/pages/connection/index' }) }
// 列表与新建编辑区共用页面，保留搜索、列表节点及其滚动位置。
function onThreadListScroll(event: UniScrollEvent) { if (!editingNewConversation.value && !restoringThreadScroll) savedThreadScrollTop = event.detail.scrollTop }
function openNewConversation() { try { if (selectedComputerId.value.length > 0) bridge.selectComputer(selectedComputerId.value); editingNewConversation.value = true; threadScrollTop.value = -1 } catch (reason) { uni.showToast({ title: (reason as Error).message, icon: 'none' }) } }
function closeNewConversation() { if (creatingConversation.value) return; uni.hideKeyboard(); editingNewConversation.value = false; restoreThreadScroll() }
function onNewConversationBusy(value: boolean) { creatingConversation.value = value }
// 只有首条消息确认发送成功后才进入现有会话页。
function onConversationCreated(id: string) { editingNewConversation.value = false; creatingConversation.value = false; uni.navigateTo({ url: '/pages/conversation/index?threadId=' + encodeURIComponent(id) }) }
// 刷新与重连只恢复读取，不自动提交任何会话指令。
function refreshThreads() { connection.error = ''; if (connection.connected) refreshComputerThreads(selectedComputerId.value); else bridge.resume() }
// 跨电脑打开时仍先通过已有的授权检查和待核对锁。
// 跳转时携带列表标题和项目名，让详情页在快照返回前即可显示相同名称。
function openThread(thread: ComputerThread) { if (!thread.online) { uni.showToast({ title: '电脑离线，恢复连接后可打开聊天', icon: 'none' }); return }; try { bridge.selectComputer(thread.hostId); bridge.openThread(thread.id).then((_: UTSJSONObject) => {}, (_reason: Error) => {}); uni.navigateTo({ url: '/pages/conversation/index?threadId=' + encodeURIComponent(thread.id) + '&title=' + encodeURIComponent(thread.title) + '&projectName=' + encodeURIComponent(thread.cwd.length > 0 ? projectName(thread.cwd) : '未指定项目'), success: () => { recentThreads.value = rememberRecentThread(recentThreads.value, thread.key, Date.now()); try { uni.setStorageSync('codex-mobile-list-recent', JSON.stringify(recentThreads.value)) } catch (_) {} } }) } catch (reason) { uni.showToast({ title: (reason as Error).message, icon: 'none' }) } }
function resetThreadScroll() { savedThreadScrollTop = 0; threadScrollTop.value = -1; nextTick(() => { threadScrollTop.value = 0 }) }
function openSearch() { searchVisible.value = true; nextTick(() => { searchFocused.value = true }) }
function closeSearch() { search.value = ''; searchFocused.value = false; searchVisible.value = false; uni.hideKeyboard() }
function chooseComputerFilter(id: string) { if (editingComputerId.value.length > 0 || Date.now() < suppressComputerClickUntil) return; if (id.length > 0 && !connection.computers.some((computer: Computer): boolean => computer.id == id)) return; selectedComputerId.value = id; resetThreadScroll(); refreshComputerThreads(id) }
// 全局订阅由应用维护；首页只清理已撤回的筛选选项。
watch((): string => connection.computers.map((computer: Computer): string => computer.id).join('|'), () => {
  if (selectedComputerId.value.length > 0 && !connection.computers.some((computer: Computer): boolean => computer.id == selectedComputerId.value)) selectedComputerId.value = ''
})
watch(search, () => { resetThreadScroll() })

// 列表仅展示末级项目名，完整路径仍可搜索并在详情中查看。
function projectName(cwd: string): string {
  let normalized = cwd.split('\\').join('/')
  while (normalized.endsWith('/') && normalized.length > 1) normalized = normalized.slice(0, -1)
  const parts = normalized.split('/')
  return parts[parts.length - 1].length > 0 ? parts[parts.length - 1] : normalized
}
onBackPress((): boolean => { if (menuVisible.value) { menuVisible.value = false; return true }; if (editingComputerId.value.length > 0) { if (!connectionEditorBusy.value) closeComputerMenu(); return true }; if (editingNewConversation.value) { closeNewConversation(); return true }; if (searchVisible.value) { closeSearch(); return true }; return false })
</script>

<style>
/* 原生按钮只作为透明点击层，图片和文字保持同级，避免原生嵌套渲染缺失。 */
.action-frame { position: relative; overflow: hidden; flex-shrink: 0; }
.action-hitbox { position: absolute; left: 0; top: 0; width: 100%; height: 100%; margin: 0; padding: 0; border-width: 0; border-radius: 0; background-color: transparent; font-size: 1px; line-height: 1px; }
.action-pressed { background-color: rgba(40, 92, 73, 0.07); }
.page { flex: 1; height: 100%; overflow: hidden; padding-top: var(--status-bar-height); background-color: #f8f8f3; }
.header { height: 48px; padding: 2px 12px 2px 20px; flex-direction: row; align-items: center; justify-content: space-between; flex-shrink: 0; }
.header-button { width: 44px; height: 44px; align-items: center; justify-content: center; border-radius: 14px; }
.header-actions { flex-direction: row; flex-shrink: 0; }
.header-search { flex: 1; min-width: 0; margin-right: 8px; }
.page-title { flex: 1; color: #202c28; font-size: 20px; line-height: 28px; font-weight: bold; }
.list-title { flex: 1; flex-direction: row; align-items: center; }
.list-title-trigger { flex-direction: row; align-items: center; min-height: 44px; padding-right: 8px; border-radius: 12px; }
.list-title-text { flex-shrink: 0; margin-right: 6px; color: #202c28; font-size: 20px; line-height: 28px; font-weight: bold; }
.new-page-title { flex: 1; text-align: center; }
.list-shell { flex: 1; height: 0; min-height: 0; }
/* 全部标签固定，电脑标签在剩余宽度内横向滚动。 */
.computer-tabs { height: 56px; padding: 4px 16px 8px; flex-direction: row; align-items: center; flex-shrink: 0; }
.computer-tab { position: relative; overflow: visible; height: 44px; padding: 0 12px; border-radius: 22px; flex-direction: row; align-items: center; flex-shrink: 0; margin-right: 8px; }
.all-tab { margin-right: 6px; }
.computer-tab-selected { background-color: #e8eee6; }
.computer-scroll { flex: 1; width: 0; min-width: 0; height: 44px; }
/* 实例容器按标签总宽度展开，避免裁掉溢出内容；“全部”独立保留在滚动区域外。 */
.computer-tab-content { flex-direction: row; align-self: flex-start; flex-shrink: 0; height: 44px; }
.tab-label { color: #202c28; font-size: 14px; line-height: 22px; }
.computer-name { max-width: 120px; margin-left: 6px; lines: 1; text-overflow: ellipsis; }
.computer-indicator { width: 16px; height: 16px; margin-right: 7px; flex-shrink: 0; align-items: center; justify-content: center; }
.computer-spinner { width: 16px; height: 16px; border-color: #285c49; }
.computer-unread-dot { width: 8px; height: 8px; border-radius: 4px; background-color: #285c49; }
/* 三角形标记保留方形留白并允许边角完整显示，避免默认溢出隐藏和圆角裁切。 */
.computer-sync-badge { position: absolute; right: 6px; top: 2px; width: 16px; height: 16px; align-items: center; justify-content: center; overflow: visible; }
.computer-connection-content { flex-direction: row; align-items: center; transition-property: opacity; transition-duration: 800ms; transition-timing-function: ease-in-out; }
.thread-computer-meta { flex-direction: row; align-items: center; flex-shrink: 0; margin-right: 8px; }
.thread-computer { max-width: 84px; margin-left: 6px; font-size: 13px; line-height: 20px; color: #7b827a; lines: 1; text-overflow: ellipsis; }
.search-field { height: 44px; padding: 0 12px; border-style: solid; border-width: 1px; border-color: #e3e5dc; border-radius: 12px; flex-direction: row; align-items: center; }
.search-input { flex: 1; min-width: 0; height: 44px; font-size: 15px; margin-left: 10px; color: #202c28; }
.clear-search { width: 44px; height: 44px; align-items: center; justify-content: center; }
.notice { margin: 8px 16px 0; padding: 12px; border-radius: 12px; background-color: #fff1e9; flex-shrink: 0; }
.notice-text { font-size: 12px; line-height: 18px; color: #8d4d2b; }
.thread-list { flex: 1; height: 0; min-height: 0; }
.list-content { padding: 0 16px; }
.thread-group { margin-top: 8px; }
.group-title { font-size: 12px; line-height: 18px; color: #7b827a; margin-bottom: 6px; }
.thread { padding: 9px 10px; border-style: solid; border-width: 0; border-bottom-width: 1px; border-bottom-color: #e3e5dc; }
.thread-selected { background-color: #e8eee6; border-radius: 6px; border-bottom-color: #e8eee6; }
.thread-failure { margin-left: 8px; }
.thread-heading { flex-direction: row; align-items: center; }
.thread-title { flex: 1; min-width: 0; font-size: 16px; line-height: 24px; font-weight: bold; color: #202c28; lines: 1; text-overflow: ellipsis; }
.thread-time { font-size: 12px; line-height: 18px; color: #7b827a; margin-left: 10px; flex-shrink: 0; }
.thread-meta { flex-direction: row; align-items: center; margin-top: 4px; }
.thread-meta-icon { flex-shrink: 0; }
.thread-project { flex: 1; min-width: 0; font-size: 13px; line-height: 20px; color: #7b827a; margin-left: 6px; lines: 1; text-overflow: ellipsis; }
.thread-status { margin-left: 8px; flex-shrink: 0; }
.list-bottom { height: 16px; }
.empty { padding: 50px 0 28px; align-items: center; }
.empty-title { color: #202c28; font-size: 18px; line-height: 28px; text-align: center; }
.description { color: #7b827a; font-size: 14px; line-height: 23px; margin-top: 12px; text-align: center; }
.empty-action { height: 44px; line-height: 44px; font-size: 14px; margin-top: 22px; padding: 0 22px; justify-content: center; }
/* #ifdef WEB */
.thread-title, .thread-project, .thread-computer, .computer-name { display: block; white-space: nowrap; overflow: hidden; }
/* #endif */
.thread-question { margin-left: 8px; padding: 2px 7px; border-radius: 10px; background-color: #e4edfb; color: #285c49; font-size: 11px; line-height: 18px; flex-shrink: 0; }
</style>
