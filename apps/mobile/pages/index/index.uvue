<template><chat-workspace ref="workspace" :initial-target="initialTarget" :active="active" :window-width="windowWidth" :window-height="windowHeight" :detail-route="false" /></template>
<script setup lang="uts">
import { ref } from 'vue'
import ChatWorkspace from '../../components/chat-workspace/chat-workspace.uvue'
import { workspaceTarget, WorkspaceTarget } from '../../services/workspace-layout.uts'
import { connection } from '../../services/bridge.uts'
import { pendingTaskNotice } from '../../services/task-notifications.uts'
const workspace = ref<ChatWorkspaceComponentPublicInstance | null>(null)
const initialTarget = ref<WorkspaceTarget | null>(null)
const active = ref(false)
const windowWidth = ref(uni.getWindowInfo().windowWidth)
const windowHeight = ref(uni.getWindowInfo().windowHeight)
// 路由参数由框架解码，原样保留标题中的中文和百分号。
onLoad((options: OnLoadOptions) => {
  const notice = pendingTaskNotice(options['noticeKey'] ?? '')
  const id = options['threadId'] ?? ''
  if (id.length > 0) initialTarget.value = workspaceTarget(notice?.hostId ?? options['hostId'] ?? connection.hostId, id, options['title'] ?? '', options['projectName'] ?? '', connection.cacheNamespace)
})
onShow(() => { active.value = true })
onHide(() => { active.value = false })
onUnload(() => { active.value = false })
onResize(() => { const info = uni.getWindowInfo(); windowWidth.value = info.windowWidth; windowHeight.value = info.windowHeight })
onBackPress((): boolean => workspace.value?.handleBack() ?? false)
</script>
