<template>
  <view class="connection-overlay" :style="{ backgroundColor: editing ? 'rgba(0,0,0,0.45)' : 'rgba(0,0,0,0.06)', paddingBottom: editing ? keyboardInset + 'px' : '0px' }" @click="dismiss" @touchend="finishOpeningPress">
    <view v-if="!editing" class="connection-menu" :style="{ left: menuLeft + 'px', top: menuTop + 'px', width: menuWidth + 'px' }" @click.stop>
      <text class="menu-name">{{ computer.label }}</text>
      <view class="menu-edit action-frame"><app-icon name="edit" :size="24" /><text class="menu-label">编辑</text><button class="action-hitbox" aria-label="编辑连接" hover-class="action-pressed" @click="beginEditing"></button></view>
    </view>
    <view v-else class="connection-sheet" :style="{ height: sheetHeight + 'px' }" @click.stop>
      <view class="sheet-grip"></view>
      <view class="sheet-heading"><text class="sheet-title">编辑连接</text><view class="close-action action-frame"><app-icon name="close" :size="24" /><button class="action-hitbox" :disabled="saving" aria-label="关闭编辑连接" @click="dismiss"></button></view></view>
      <scroll-view direction="vertical" class="sheet-scroll" :show-scrollbar="false">
        <view class="sheet-body">
          <view class="name-field"><text class="field-label">显示名称</text><input v-model="displayName" class="name-input" :disabled="saving" :maxlength="100" :adjust-position="false" confirm-type="done" @keyboardheightchange="onKeyboardChange" @confirm="hideInputKeyboard" /></view>
          <view class="icon-options"><view v-for="option in iconOptions" :key="option.id" :class="['icon-option', 'action-frame', icon == option.id ? 'icon-selected' : '']"><app-icon :name="option.id" :size="26" :tone="icon == option.id ? 'dark' : 'muted'" /><button class="action-hitbox" :disabled="saving" :aria-label="'选择' + option.label + '图标'" @click="chooseIcon(option.id)"></button></view></view>
          <view class="connection-facts"><view class="fact-row"><text class="fact-label">主机名</text><text class="fact-value">{{ (computer.hostname ?? '').length > 0 ? computer.hostname : '未提供' }}</text></view><view class="fact-divider"></view><view class="fact-row"><text class="fact-label">类型</text><text class="fact-value">{{ computer.connectionType == 'codex-desktop' ? 'Codex 桌面版' : '未提供' }}</text></view></view>
          <view class="last-connected"><app-icon name="clock" :size="17" tone="muted" /><text class="last-label">上次连接：{{ lastConnectedLabel }}</text></view>
          <text v-if="!connection.connected" class="editor-error">恢复连接后可以保存修改。</text>
          <text v-else-if="!connection.supportsHostProfiles" class="editor-error">请更新中转服务后再编辑连接。</text>
          <text v-if="error.length > 0" class="editor-error">{{ error }}</text>
          <view class="save-button inline-progress-button" :class="canSave || saving ? 'save-enabled' : 'save-disabled'"><action-progress :busy="saving" light /><text class="inline-progress-caption" :style="{ color: canSave || saving ? '#ffffff' : '#737d91' }" style="font-size: 16px;">保存</text><button class="inline-progress-hitbox" style="background-color: transparent;" :disabled="!canSave" @click="save" :aria-label="(saving) ? '正在保存' : '保存'"></button></view>
        </view>
      </scroll-view>
      <view v-if="keyboardInset == 0" class="bottom-safe-area"></view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed, ref, onUnmounted } from 'vue'
import { bridge, connection, Computer, computerIcon } from '../../services/bridge.uts'
import AppIcon from '../app-icon/app-icon.uvue'
const props = defineProps<{ computer: Computer, anchorLeft: number, anchorTop: number, releaseAt: number, directEdit?: boolean }>()
const emit = defineEmits<{ dismiss: [], release: [], busy: [value: boolean] }>()
const editing = ref(false)
const displayName = ref('')
const icon = ref('laptop')
const originalName = ref('')
const originalIcon = ref('laptop')
const revision = ref(0)
const saving = ref(false)
const error = ref('')
const keyboardInset = ref(0)
const windowInfo = uni.getWindowInfo()
type ConnectionIcon = { id: string, label: string }
const iconOptions: ConnectionIcon[] = [{ id: 'code', label: '代码' }, { id: 'terminal', label: '终端' }, { id: 'laptop', label: '笔记本' }, { id: 'desktop', label: '显示器' }]
const menuWidth = Math.min(230, windowInfo.windowWidth - 24)
const menuLeft = computed((): number => Math.max(12, Math.min(props.anchorLeft, windowInfo.windowWidth - menuWidth - 12)))
const menuTop = computed((): number => Math.max(12, Math.min(props.anchorTop, windowInfo.windowHeight - 124)))
const sheetHeight = computed((): number => Math.max(180, Math.min(490, windowInfo.windowHeight - keyboardInset.value - 28)))
const canSave = computed((): boolean => editorContextCurrent() && !saving.value && connection.connected && connection.supportsHostProfiles && displayName.value.trim().length > 0 && displayName.value.length <= 100 && !/[\u0000-\u001f\u007f]/.test(displayName.value) && (displayName.value.trim() != originalName.value || icon.value != originalIcon.value))
const lastConnectedLabel = computed((): string => {
  const timestamp = props.computer.lastConnectedAt ?? 0
  if (timestamp <= 0) return '未提供'
  const seconds = Math.max(0, Math.floor((Date.now() - timestamp) / 1000))
  if (seconds < 60) return seconds < 5 ? '刚刚' : seconds.toString() + '秒前'
  if (seconds < 3600) return Math.floor(seconds / 60).toString() + '分钟前'
  if (seconds < 86400) return Math.floor(seconds / 3600).toString() + '小时前'
  const date = new Date(timestamp)
  return date.getFullYear().toString() + '-' + (date.getMonth() + 1).toString().padStart(2, '0') + '-' + date.getDate().toString().padStart(2, '0')
})
let alive = true
let editTargetId = props.computer.id
let editConfigurationRevision = connection.configurationRevision
// 固定编辑目标与配对，旧请求的结果不能关闭或提示新的资料面板。
function editorContextCurrent(): boolean { return alive && props.computer.id == editTargetId && connection.configurationRevision == editConfigurationRevision }
// 打开时拍下原值与版本，远端推送更新信息时不覆盖正在输入的草稿。
function beginEditing() { editTargetId = props.computer.id; editConfigurationRevision = connection.configurationRevision; displayName.value = props.computer.label; originalName.value = props.computer.label; icon.value = computerIcon(props.computer); originalIcon.value = icon.value; revision.value = props.computer.profileRevision ?? 0; editing.value = true }
function chooseIcon(value: string) { if (!saving.value) icon.value = value }
function hideInputKeyboard() { uni.hideKeyboard(); keyboardInset.value = 0 }
function onKeyboardChange(event: UniInputKeyboardHeightChangeEvent) { keyboardInset.value = event.detail.height }
// 保存期间屏蔽重复提交与关闭，确定回执后再退出。
function finishOpeningPress() { if (props.releaseAt == 0) emit('release') }
function dismiss() { if (saving.value || (!editing.value && (props.releaseAt == 0 || Date.now() - props.releaseAt < 250))) return; hideInputKeyboard(); emit('dismiss') }
function save() {
  if (!canSave.value) return
  saving.value = true; emit('busy', true); error.value = ''; hideInputKeyboard()
  bridge.updateComputerProfile(props.computer.id, displayName.value.trim(), icon.value, revision.value).then((_: UTSJSONObject) => {
    if (!editorContextCurrent()) return
    saving.value = false; emit('busy', false); uni.showToast({ title: '连接已保存', icon: 'none' }); emit('dismiss')
  }, (reason: Error) => { if (editorContextCurrent()) { saving.value = false; emit('busy', false); error.value = reason.message } })
}
// 设置页直接显示资料编辑；首页长按仍先显示原有菜单。
if (props.directEdit == true) beginEditing()
onUnmounted(() => { alive = false; uni.hideKeyboard() })
</script>

<style>
.connection-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; z-index: 60; justify-content: flex-end; }
.connection-menu { position: absolute; background-color: #ffffff; border-radius: 24px; padding: 16px 20px 12px; box-shadow: 0 10px 32px rgba(0,0,0,0.12); }
.menu-name { font-size: 14px; line-height: 22px; color: #737d91; lines: 1; text-overflow: ellipsis; }
.menu-edit { flex-direction: row; align-items: center; height: 52px; margin-top: 5px; }
.menu-label { color: #1a2135; font-size: 17px; margin-left: 16px; }
.connection-sheet { width: 100%; max-width: 720px; align-self: center; border-top-left-radius: 24px; border-top-right-radius: 24px; background-color: #ffffff; overflow: hidden; }
.sheet-grip { width: 36px; height: 4px; margin-top: 8px; background-color: #e5e8f1; border-radius: 2px; align-self: center; flex-shrink: 0; }
.sheet-heading { flex-direction: row; align-items: center; padding: 10px 12px 14px 24px; flex-shrink: 0; }
.sheet-title { color: #1a2135; font-size: 22px; font-weight: bold; flex: 1; }
.close-action { width: 44px; height: 44px; align-items: center; justify-content: center; }
.sheet-scroll { flex: 1; height: 0; min-height: 0; }
.sheet-body { padding: 8px 24px 20px; }
.name-field { border-style: solid; border-width: 1px; border-color: #c7cede; border-radius: 4px; padding: 10px 15px 8px; }
.field-label { font-size: 12px; color: #596479; line-height: 18px; }
.name-input { width: 100%; height: 34px; font-size: 17px; color: #1a2135; }
.icon-options { flex-direction: row; justify-content: space-between; margin: 20px 8px; }
.icon-option { width: 56px; height: 56px; border-radius: 13px; justify-content: center; align-items: center; }
.icon-selected { background-color: #e7e9fd; }
.connection-facts { border-style: solid; border-width: 1px; border-color: #e5e8f1; border-radius: 16px; padding: 0 22px; }
.fact-row { min-height: 54px; flex-direction: row; align-items: center; }
.fact-label { color: #1a2135; font-size: 15px; flex-shrink: 0; margin-right: 14px; }
.fact-value { color: #596479; font-size: 14px; flex: 1; min-width: 0; text-align: right; lines: 2; text-overflow: ellipsis; }
.fact-divider { height: 1px; background-color: #e5e8f1; }
.last-connected { flex-direction: row; align-items: center; margin: 16px 6px; }
.last-label { margin-left: 10px; color: #596479; font-size: 13px; }
.editor-error { font-size: 13px; line-height: 20px; color: #8d4d2b; margin-bottom: 12px; }
.save-button { align-items: center; justify-content: center; text-align: center; height: 44px; line-height: 44px; width: 100%; border-radius: 24px; border-width: 0; font-size: 16px; margin: 0; padding: 0; }
.save-enabled { background-color: #4546bd; color: #ffffff; }
.save-disabled { background-color: #f6f7fb; color: #737d91; }
.bottom-safe-area { height: var(--uni-safe-area-inset-bottom); flex-shrink: 0; }
.action-frame { position: relative; overflow: hidden; flex-shrink: 0; }
.action-hitbox { position: absolute; left: 0; top: 0; width: 100%; height: 100%; margin: 0; padding: 0; border-width: 0; border-radius: 0; background-color: transparent; font-size: 1px; line-height: 1px; }
.action-pressed { background-color: rgba(69, 70, 189, 0.07); }
</style>
