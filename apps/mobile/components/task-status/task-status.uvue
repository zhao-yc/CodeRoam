<template>
  <view v-if="state != 'idle' && state != 'unknown'" :class="['task-status', showDetail ? 'with-detail' : '', waiting ? 'waiting-badge' : '']" :aria-label="label">
    <loading v-if="state == 'running'" class="spinner" :paused="!visible" />
    <view v-else-if="state == 'unread'" class="unread-dot"></view>
    <text v-if="state != 'unread' && !(state == 'running' && hideRunningLabel)" :class="['label', showDetail ? 'activity-label' : '', waiting ? 'waiting-label' : '']">{{ label }}</text>
  </view>
</template>
<script setup lang="uts">
import { computed } from 'vue'
const props = withDefaults(defineProps<{ state: string, visible?: boolean, hideRunningLabel?: boolean, detail?: string }>(), { visible: true, hideRunningLabel: false, detail: '' })
// 等待需要真实用户操作，进入会话本身不能将其清成空闲。
const waiting = computed((): boolean => props.state == 'question' || props.state == 'approval')
// 具体动作只用于运行态，等待、断线和结束状态不能显示上一次的动作。
const showDetail = computed((): boolean => props.state == 'running' && props.detail.trim().length > 0)
// 紧凑入口隐藏运行文字，仍通过无障碍标签提供状态。
// 原生 loading 在渲染线程旋转，任务结束或断连后直接移除，避免后台空转。
const label = computed((): string => props.state == 'running' ? (showDetail.value ? props.detail.trim() : '进行中') : props.state == 'question' ? '需要用户输入' : props.state == 'approval' ? '需要审批' : props.state == 'unread' ? '有未读结果' : props.state == 'offline' ? '状态未同步' : props.state == 'idle' ? '已空闲' : '状态未知')
</script>
<style>
.task-status { flex-direction: row; align-items: center; flex-shrink: 0; }
.with-detail { flex: 1; min-width: 0; }
.spinner { width: 16px; height: 16px; border-color: #285c49; }
.unread-dot { width: 8px; height: 8px; border-radius: 4px; background-color: #3b82f6; margin-left: 6px; }
.waiting-badge { background-color: #e4edfb; border-radius: 12px; padding: 2px 9px; }
.label { color: #7b827a; font-size: 11px; line-height: 18px; margin-left: 6px; }
.waiting-label { color: #3b82f6; margin-left: 0; }
.activity-label { flex: 1; min-width: 0; font-size: 13px; line-height: 20px; lines: 2; text-overflow: ellipsis; }
/* #ifdef WEB */
/* Web 显式限制两行，避免长动作名称占满消息区；原生继续使用 lines。 */
.activity-label { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; white-space: normal; overflow-wrap: anywhere; }
/* #endif */
</style>
