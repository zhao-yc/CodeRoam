<template>
  <view class="message-images">
    <view v-if="sources.length > 0" class="thumbnails"><image v-for="(source, index) in sources" :key="index" :src="source" mode="aspectFit" :class="['thumbnail', sources.length == 1 ? 'thumbnail-single' : '', props.large == true ? 'thumbnail-large' : '']" :aria-label="'预览第' + (index + 1) + '张图片'" @load="imageLoaded" @click="preview(source)" /></view>
    <loading-skeleton v-else-if="connected && error.length == 0 && !manualRetry" kind="image" :visible="ready != false" :count="props.count" :large="props.large" />
    <view v-else :class="['placeholder', (props.count ?? 1) == 1 ? 'placeholder-single' : '', props.large == true ? 'placeholder-large' : '']"><text class="hint">{{ error.length > 0 ? error : '等待连接后加载图片' }}</text><view v-if="(error.length > 0 || manualRetry) && connected && ready != false" class="retry inline-progress-button"><action-progress :busy="manualRetry" /><text class="inline-progress-caption" style="color: #285c49; font-size: 12px;">重新加载</text><button class="inline-progress-hitbox" @click="loadImages(true)" :disabled="manualRetry" :aria-label="(manualRetry) ? '正在重新加载图片' : '重新加载'"></button></view></view>
  </view>
</template>
<script setup lang="uts">
import { ref, watch, nextTick, onUnmounted } from 'vue'
import { bridge, connection } from '../../services/bridge.uts'
import LoadingSkeleton from '../loading-skeleton/loading-skeleton.uvue'
const props = defineProps<{ hostId: string, threadId: string, messageId: string, connected: boolean, ready?: boolean, subscriptionRevision?: number, scopeId?: string, count?: number, large?: boolean }>()
const emit = defineEmits<{ (event: 'beforelayout'): void, (event: 'layout'): void }>()
const sources = ref<string[]>([])
const error = ref('')
let loading = false
const manualRetry = ref(false)
let requestVersion = 0
let alive = true
let loadScheduled = false
// 配对、电脑、聊天和消息共同隔离回执；图片只保留在当前组件内，不写入持久缓存。
function imageIdentity(): string { return JSON.stringify([props.scopeId ?? '', props.hostId, props.threadId, props.messageId, props.count ?? 1, props.large == true]) }
function imageRequestReady(): boolean { return alive && props.connected && props.ready != false && connection.hostId == props.hostId && connection.activeThreadId == props.threadId && (props.scopeId == null || props.scopeId == connection.cacheNamespace) }
// 父页可能连续更新就绪标记与订阅代次；合并到下一次渲染后只发起一次读取。
function scheduleImages() {
  if (!alive || loadScheduled) return
  loadScheduled = true
  nextTick(() => { loadScheduled = false; if (alive && sources.value.length == 0) loadImages() })
}
// 占位、错误提示和缩略图替换均通知父页；图片解码完成沿用同一位置保持链。
function beforeImageLayout() { emit('beforelayout'); nextTick(() => { if (alive) emit('layout') }) }
// 大图按片读取，避免设计稿超过中转单条消息上限；离页或断线立即停止后续请求。
async function loadLargeImages(version: number): Promise<string[]> {
  const images: string[] = []
  for (let index = 0; index < Math.min(props.count ?? 1, 3); index++) {
    let source = ''
    let chunks = 1
    for (let chunk = 0; chunk < chunks; chunk++) {
      if (!imageRequestReady() || version != requestVersion) return [] as string[]
      const result = await bridge.request('thread.images', { threadId: props.threadId, messageId: props.messageId, imageIndex: index, chunkIndex: chunk })
      chunks = result['chunkCount'] as number
      if (chunks < 1 || chunks > 17) throw new Error('图片分片无效，请重新加载')
      source += result['data'] as string
    }
    images.push(source)
  }
  return images
}
// 每条消息独立保留图片，进入会话自动加载，不弹出大图或中断滚动。
function loadImages(manual: boolean = false) {
  if (!imageRequestReady() || loading || props.threadId.length == 0) return
  loading = true; manualRetry.value = manual; error.value = ''
  const version = ++requestVersion
  const identity = imageIdentity()
  if (props.large == true) {
    loadLargeImages(version).then((images: string[]) => {
      if (!imageRequestReady() || version != requestVersion || identity != imageIdentity()) return
      loading = false; manualRetry.value = false; sources.value = images
      if (images.length == 0) error.value = '这条记录未保留图片'
    }, (failure: Error) => {
      if (!imageRequestReady() || version != requestVersion || identity != imageIdentity()) return
      loading = false; manualRetry.value = false; error.value = failure.message.length > 0 ? failure.message : '图片加载失败，请稍后重试'
    })
    return
  }
  bridge.request('thread.images', { threadId: props.threadId, messageId: props.messageId }).then((result: UTSJSONObject) => {
    if (!imageRequestReady() || version != requestVersion || identity != imageIdentity()) return
    loading = false; manualRetry.value = false
    sources.value = JSON.parse<string[]>(JSON.stringify(result['images'])) ?? [] as string[]
    if (sources.value.length == 0) error.value = '这条记录未保留图片'
  }, (failure: Error) => {
    if (!imageRequestReady() || version != requestVersion || identity != imageIdentity()) return
    loading = false; manualRetry.value = false; error.value = failure.message.length > 0 ? failure.message : '图片加载失败，请稍后重试'
  })
}
// 仅点击缩略图时打开当前消息的图片组。
function preview(source: string) { uni.previewImage({ urls: sources.value, current: source }) }
// 异步图片出现后由会话页维护滚动位置。
function imageLoaded() { emit('layout') }
// 消息归属变化及卸载后使旧请求失效，避免图片串入其他会话。
watch((): string => imageIdentity(), () => {
  requestVersion++; loading = false; manualRetry.value = false; sources.value = [] as string[]; error.value = ''; scheduleImages()
}, { immediate: true, flush: 'sync' })
watch((): boolean => props.connected, (connected: boolean) => {
  requestVersion++; loading = false; manualRetry.value = false
  if (connected && sources.value.length == 0) scheduleImages()
})
// 等待订阅不算加载失败；重订阅后自动恢复未加载的图片，不要求用户再点重试。
watch((): string => (props.ready != false).toString() + ':' + (props.subscriptionRevision ?? 0).toString(), () => {
  requestVersion++; loading = false; manualRetry.value = false; error.value = ''
  if (sources.value.length == 0) scheduleImages()
}, { flush: 'sync' })
watch(sources, () => { beforeImageLayout() }, { flush: 'pre' })
watch(error, () => { beforeImageLayout() }, { flush: 'pre' })
onUnmounted(() => { alive = false; requestVersion++ })
</script>
<style>
.message-images { align-self: flex-start; max-width: 100%; }
.thumbnails { flex-direction: row; flex-wrap: wrap; gap: 8px; }
.thumbnail { width: 96px; height: 96px; border-radius: 8px; background-color: #e0e7df; }
.thumbnail-single { width: 128px; height: 128px; }
.thumbnail-large { width: 260px; max-width: 100%; height: 180px; }
.placeholder { min-width: 96px; min-height: 96px; padding: 8px; border-radius: 8px; background-color: #e0e7df; align-items: center; justify-content: center; }
.placeholder-single { min-width: 128px; min-height: 128px; }
.placeholder-large { width: 260px; max-width: 100%; min-height: 180px; }
.hint { font-size: 12px; color: #7b827a; }
.retry { margin-top: 6px; font-size: 12px; color: #285c49; background-color: transparent; }
</style>
