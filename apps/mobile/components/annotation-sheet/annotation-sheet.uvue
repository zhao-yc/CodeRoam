<template>
  <view class="annotation-overlay" @click="emit('close')">
    <view class="annotation-sheet" role="dialog" aria-modal="true" :aria-label="items.length + ' 条注释'" @click.stop>
      <view class="annotation-grip"></view>
      <view class="annotation-header">
        <view class="annotation-heading"><text class="annotation-title">{{ items.length }} 条注释</text><text class="annotation-subtitle">引用原文与用户评论</text></view>
        <view class="annotation-close action-frame"><app-icon name="close" :size="22" /><button class="action-hitbox" aria-label="关闭注释" hover-class="action-pressed" @click="emit('close')"></button></view>
      </view>
      <scroll-view direction="vertical" class="annotation-scroll">
        <view v-for="item in items" :key="item.index" class="annotation-item">
          <text class="annotation-number">注释 {{ item.index }}</text>
          <template v-if="item.available">
            <text class="annotation-label">所选文本</text>
            <view class="annotation-quote"><text class="annotation-text" selectable>{{ item.text }}</text></view>
            <template v-if="item.comment.trim().length > 0"><text class="annotation-label annotation-comment-label">用户评论</text><text class="annotation-text annotation-comment" selectable>{{ item.comment }}</text></template>
          </template>
          <text v-else class="annotation-missing">引用原文暂未载入，可向上查看更早的消息。</text>
        </view>
      </scroll-view>
      <view class="annotation-safe-area"></view>
    </view>
  </view>
</template>
<script setup lang="uts">
import { MessageAnnotation } from '../../services/annotations.uts'
import AppIcon from '../app-icon/app-icon.uvue'
defineProps<{ items: MessageAnnotation[] }>()
const emit = defineEmits<{ (event: 'close'): void }>()
</script>
