.annotation-header { flex-direction: row; align-items: center; padding: 14px 12px 18px 20px; flex-shrink: 0; }
.annotation-heading { flex: 1; min-width: 0; }
.annotation-title { font-size: 20px; line-height: 28px; color: #1a2135; font-weight: bold; }
.annotation-subtitle { margin-top: 3px; font-size: 13px; line-height: 20px; color: #596479; }
.annotation-close { width: 44px; height: 44px; align-items: center; justify-content: center; flex-shrink: 0; }
.action-frame { position: relative; overflow: hidden; }
.action-hitbox { position: absolute; left: 0; top: 0; width: 100%; height: 100%; margin: 0; padding: 0; border-width: 0; background-color: transparent; font-size: 1px; line-height: 1px; }
.action-pressed { background-color: rgba(69, 70, 189, 0.08); }
.annotation-scroll { flex: 1; height: 0; min-height: 0; }
.annotation-item { margin: 0 20px 22px; }
.annotation-number { font-size: 14px; line-height: 22px; font-weight: bold; color: #4546bd; margin-bottom: 12px; }
.annotation-label { color: #596479; font-size: 13px; line-height: 20px; margin-bottom: 7px; }
.annotation-quote { background-color: #f6f7fb; border-left-width: 3px; border-left-style: solid; border-left-color: #a6a8e5; padding: 12px 14px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; }
.annotation-text { font-size: 16px; line-height: 26px; color: #1a2135; }
.annotation-comment-label { margin-top: 16px; }
.annotation-comment { padding-left: 2px; }
.annotation-missing { color: #596479; font-size: 14px; line-height: 23px; }
.annotation-safe-area { height: 16px; flex-shrink: 0; }
