<template>
  <view v-if="goal != null || editing" class="goal-widget">
    <view v-if="expanded || editing" class="goal-panel" :class="{ 'goal-panel-editor': editing }">
      <view class="goal-heading"><view v-if="editing" class="goal-title-icon"><app-icon name="target" :size="19" /></view><text class="goal-title">{{ editing ? (creating ? '新建目标' : '编辑目标') : '目标' }}</text><text v-if="!editing && goal != null" class="goal-state">{{ statusLabel }}</text><button class="goal-close" aria-label="收起目标详情" :disabled="busy" @click="collapse">×</button></view>
      <template v-if="editing">
        <view class="goal-editor-field">
          <textarea class="goal-editor" :style="{ height: Math.max(72, Math.min(144, contentHeight)) + 'px' }" :value="objective" :maxlength="4000" :disabled="disabled || busy" :adjust-position="false" placeholder="描述你希望完成的目标…" placeholder-class="goal-placeholder" aria-label="目标正文" @input="updateObjective" @keyboardheightchange="keyboardChange"></textarea>
          <text class="goal-counter">{{ objective.length }} / 4000</text>
        </view>
        <text v-if="editorRevision != revision" class="goal-note">电脑端目标已变化，请取消后重新编辑。</text>
        <view class="goal-editor-actions"><button class="goal-action goal-cancel" :disabled="busy" @click="cancelEdit">取消</button><view class="goal-save" :class="{ 'goal-save-disabled': disabled && !busy || objective.trim().length == 0 || editorRevision != revision }"><text class="goal-save-label">保存目标</text><action-progress v-if="busy" :busy="true" light /><text v-else class="goal-save-arrow">→</text><button class="action-hitbox" :aria-label="busy ? '正在同步目标' : '保存目标'" :disabled="disabled || busy || objective.trim().length == 0 || editorRevision != revision" @click="save"></button></view></view>
      </template>
      <template v-else-if="goal != null">
        <scroll-view direction="vertical" class="goal-body" :style="{ maxHeight: contentHeight + 'px' }"><text class="goal-objective" selectable>{{ goal.objective }}</text></scroll-view>
        <text class="goal-usage">{{ usageLabel }}</text>
        <view class="goal-actions"><button class="goal-action" :disabled="disabled || busy" @click="edit">编辑</button><view v-if="goal.status == 'active'" class="goal-action inline-progress-button"><action-progress :busy="busy && pendingAction == 'pause'" /><text class="inline-progress-caption" style="color: #4546bd; font-size: 14px;">暂停</text><button class="inline-progress-hitbox" :disabled="disabled || busy" @click="operate('pause')" :aria-label="(busy && pendingAction == 'pause') ? '正在处理' : '暂停'"></button></view><view v-else-if="canResume" class="goal-action inline-progress-button"><action-progress :busy="busy && pendingAction == 'resume'" /><text class="inline-progress-caption" style="color: #4546bd; font-size: 14px;">继续</text><button class="inline-progress-hitbox" :disabled="disabled || busy" @click="operate('resume')" :aria-label="(busy && pendingAction == 'resume') ? '正在处理' : '继续'"></button></view><view class="goal-action inline-progress-button"><action-progress :busy="busy && pendingAction == 'clear'" /><text class="inline-progress-caption" style="color: #4546bd; font-size: 14px;">清除</text><button class="inline-progress-hitbox" :disabled="disabled || busy" @click="clear" :aria-label="(busy && pendingAction == 'clear') ? '正在处理' : '清除'"></button></view></view>
        <text v-if="unavailableReason.length > 0" class="goal-note">{{ unavailableReason }}</text>
        <text v-else-if="busy" class="goal-note">正在同步电脑端目标…</text>
      </template>
    </view>
    <view v-if="goal != null" class="goal-summary action-frame"><text class="goal-symbol">◎</text><text class="goal-summary-label">目标：{{ goal.objective.split('\n').join(' ') }}</text><text class="goal-summary-state">{{ statusLabel }}</text><button class="action-hitbox" aria-label="查看或收起目标详情" :aria-expanded="expanded || editing" @click="toggle"></button></view>
  </view>
</template>

<script setup lang="uts">
import { computed, ref, watch } from 'vue'
import AppIcon from '../app-icon/app-icon.uvue'
import { ThreadGoal, goalStatusLabel, goalUsageLabel, goalCanResume } from '../../services/goals.uts'
const props = defineProps<{ goal: ThreadGoal | null, revision: string, disabled: boolean, busy: boolean, pendingAction?: string, unavailableReason: string, openRequest: number, closeRequest: number, resetKey: string, contentHeight: number }>()
const emit = defineEmits<{ operate: [action: string, objective: string, revision: string], expanded: [value: boolean], keyboard: [height: number] }>()
const expanded = ref(false)
const editing = ref(false)
const creating = ref(false)
const objective = ref('')
const editorRevision = ref('none')
const statusLabel = computed((): string => goalStatusLabel(props.goal?.status ?? ''))
const usageLabel = computed((): string => props.goal != null ? goalUsageLabel(props.goal!) : '')
const canResume = computed((): boolean => goalCanResume(props.goal?.status ?? ''))

// 详情默认收起，打开或关闭不发起目标写请求。
// 外部收起时保留新输入框的键盘，明确关闭时才隐藏。
function closeDetails(hideKeyboard: boolean) { if (props.busy) return; expanded.value = false; editing.value = false; emit('expanded', false); if (hideKeyboard) uni.hideKeyboard() }
// 显式关闭目标详情并结束当前目标编辑。
function collapse() { closeDetails(true) }
function toggle() { if (props.busy) return; if (expanded.value || editing.value) collapse(); else { expanded.value = true; emit('expanded', true) } }
// 开始编辑时捕获正文和版本，后续同步不会覆盖未保存文字。
function edit() { if (props.disabled || props.busy) return; creating.value = props.goal == null; objective.value = props.goal?.objective ?? ''; editorRevision.value = props.revision; editing.value = true; expanded.value = true; emit('expanded', true) }
// 取消只影响目标表单，不改变聊天草稿或电脑目标。
function cancelEdit() { editing.value = false; objective.value = ''; expanded.value = props.goal != null; emit('expanded', expanded.value); uni.hideKeyboard() }
function updateObjective(event: UniInputEvent) { objective.value = event.detail.value }
function keyboardChange(event: UniInputKeyboardHeightChangeEvent) { emit('keyboard', event.detail.height) }
// 空正文、旧版本和待核对状态均不能提交。
function save() { if (props.disabled || props.busy || editorRevision.value != props.revision || objective.value.trim().length == 0) return; emit('operate', creating.value ? 'create' : 'edit', objective.value.trim(), editorRevision.value) }
function operate(action: string) { if (!props.disabled && !props.busy) emit('operate', action, '', props.revision) }
// 清除确认绑定打开确认框时的目标版本。
function clear() {
  if (props.disabled || props.busy) return
  const revision = props.revision
  uni.showModal({ title: '清除目标', content: '确定清除此聊天的目标吗？', confirmText: '清除', cancelText: '取消', success: (result) => { if (result.confirm && !props.disabled && !props.busy) emit('operate', 'clear', '', revision) } })
}
watch((): number => props.openRequest, (_value: number, _previous: number) => { if (props.goal == null) edit(); else { expanded.value = true; emit('expanded', true) } })
watch((): number => props.closeRequest, (_value: number, _previous: number) => closeDetails(false))
watch((): string => props.resetKey, (_value: string, _previous: string) => { expanded.value = false; editing.value = false; objective.value = ''; emit('expanded', false) })
watch((): string => props.revision, (_value: string, _previous: string) => { if (!props.busy && props.goal == null && !creating.value) collapse() })
// 已确认成功后退出编辑；失败或未知结果时保留目标正文供核对。
watch((): boolean => props.busy, (value: boolean, previous: boolean) => { if (!value && previous) { if (editing.value && props.goal?.objective == objective.value.trim()) { editing.value = false; creating.value = false }; if (props.goal == null && !editing.value) collapse() } })
</script>

<style>
.goal-widget { flex-shrink: 0; margin-bottom: 5px; }
.goal-panel { background-color: #f6f7fb; border-radius: 16px; margin-bottom: 5px; padding: 8px 12px; }
.goal-heading { flex-direction: row; align-items: center; }
.goal-title { font-size: 14px; font-weight: bold; color: #1a2135; }
.goal-state { font-size: 11px; color: #596479; margin-left: 8px; flex: 1; }
.goal-close { width: 36px; height: 32px; padding: 0; margin: 0 0 0 auto; background-color: transparent; color: #596479; font-size: 22px; line-height: 30px; border-width: 0; align-items: center; justify-content: center; }
.goal-body { flex-shrink: 1; }
.goal-objective { font-size: 14px; line-height: 22px; color: #1a2135; }
.goal-usage { font-size: 10px; color: #596479; line-height: 18px; margin-top: 4px; }
.goal-actions { flex-direction: row; align-items: center; margin-top: 2px; }
.goal-action { min-width: 58px; height: 42px; margin: 0 8px 0 0; padding: 0 12px; border-width: 0; background-color: transparent; color: #4546bd; font-size: 14px; line-height: 42px; }
.goal-primary { background-color: #4546bd; color: #ffffff; border-radius: 12px; min-width: 110px; }
/* 编辑态采用独立输入区与整行操作区，窄屏和键盘弹起时仍保留可用空间。 */
.goal-panel-editor { background-color: #ffffff; border-style: solid; border-width: 1px; border-color: #e5e8f1; border-radius: 24px; padding: 16px; }
.goal-panel-editor .goal-heading { margin-bottom: 16px; }
.goal-title-icon { width: 34px; height: 34px; border-radius: 11px; background-color: #f6f7fb; align-items: center; justify-content: center; margin-right: 10px; flex-shrink: 0; }
.goal-panel-editor .goal-title { font-size: 18px; }
.goal-panel-editor .goal-close { width: 36px; height: 36px; }
.goal-editor-field { border-style: solid; border-width: 1px; border-color: #e5e8f1; border-radius: 16px; background-color: #f6f7fb; padding: 12px 14px 10px; }
.goal-editor-actions { flex-direction: row; align-items: center; margin-top: 16px; }
.goal-cancel { flex: 1; min-width: 0; height: 46px; margin: 0 10px 0 0; padding: 0 12px; border-style: solid; border-width: 1px; border-color: #e5e8f1; border-radius: 13px; background-color: #ffffff; color: #1a2135; line-height: 44px; font-size: 15px; align-items: center; justify-content: center; }
.goal-save { position: relative; flex: 1.8; min-width: 0; height: 46px; padding: 0 12px; background-color: #4546bd; border-radius: 13px; flex-direction: row; align-items: center; justify-content: center; }
.goal-save-label { color: #ffffff; font-size: 15px; line-height: 24px; }
.goal-save-arrow { color: #ffffff; font-size: 18px; line-height: 24px; margin-left: 8px; }
.goal-save-disabled { background-color: #e5e8f1; color: #737d91; }
.goal-save-disabled .goal-save-label { color: #737d91; }
.goal-save-disabled .goal-save-arrow { color: #737d91; }
.goal-summary { position: relative; flex-direction: row; align-items: center; height: 36px; max-height: 36px; overflow: hidden; padding: 0 10px; border-radius: 18px; background-color: #f6f7fb; }
.goal-symbol { font-size: 19px; color: #4546bd; margin-right: 5px; flex-shrink: 0; }
.goal-summary-label { flex: 1; flex-shrink: 1; min-width: 0; height: 20px; line-height: 20px; overflow: hidden; lines: 1; text-overflow: ellipsis; font-size: 12px; color: #1a2135; }
/* #ifdef WEB */
.goal-summary-label { white-space: nowrap; }
/* #endif */
.goal-summary-state { font-size: 10px; color: #596479; margin-left: 8px; flex-shrink: 0; }
.action-hitbox { position: absolute; left: 0; top: 0; width: 100%; height: 100%; margin: 0; padding: 0; border-width: 0; background-color: transparent; font-size: 1px; }
.goal-editor { width: 100%; font-size: 15px; line-height: 26px; padding: 0; color: #1a2135; }
.goal-placeholder { color: #596479; }
.goal-counter { font-size: 11px; line-height: 20px; text-align: right; color: #596479; margin-top: 8px; }
.goal-note { font-size: 11px; line-height: 17px; color: #596479; margin-top: 2px; }
</style>
