<template>
  <view class="new-conversation" :class="{ 'new-conversation-compact': !props.expanded }" :style="{ paddingBottom: keyboardInset + 'px' }">
    <view v-show="props.expanded" class="new-space" @click="dismissEditor"></view>
    <!-- 多台已授权电脑时才显示切换入口，单台时直接使用当前电脑。 -->
    <view v-if="props.expanded && connection.computers.length > 1" class="destination-row action-frame"><view class="destination-icon"><app-icon :class="currentComputerIcon == 'laptop' ? 'destination-laptop' : ''" :name="currentComputerIcon" :size="currentComputerIcon == 'laptop' ? 22 : 20" tone="muted" /></view><text class="destination-label">{{ computerLabel }}</text><view class="destination-chevron"><app-icon name="chevron-down" :size="16" tone="muted" /></view><button class="action-hitbox" :disabled="busy" aria-label="选择执行电脑" @click="openPicker('computers')"></button></view>
    <view v-show="props.expanded" class="destination-row action-frame"><view class="destination-icon"><app-icon class="destination-folder" name="folder" :size="20" tone="muted" /></view><text class="destination-label">{{ projectLabel }}</text><view class="destination-chevron"><app-icon name="chevron-down" :size="16" tone="muted" /></view><button class="action-hitbox" :disabled="busy" aria-label="选择执行项目" @click="openPicker('projects')"></button></view>
    <view class="new-dock">
      <!-- 提示放在面板上方，连接、发送和错误状态均不挤动底部图标。 -->
      <view v-if="props.expanded && (busy || native.busy || error.length > 0 || native.error.length > 0 || connection.error.length > 0)" class="editor-feedback"><text v-if="busy || native.busy" class="editor-note">{{ busy ? progress : '正在同步电脑草稿…' }}</text><text v-else class="editor-error">{{ native.error.length > 0 ? native.error : error.length > 0 ? error : connection.error }}</text></view>
      <button v-if="props.expanded && !busy && !native.busy && (error.length > 0 || native.error.length > 0) && !native.outcomeUnknown && !projectsLoading" class="retry-button" @click="reloadOptions">{{ native.snapshot == null && native.draftId.length == 0 && projects.length > 0 ? '重新连接电脑草稿' : '重新读取' }}</button>
      <text v-if="props.expanded && native.snapshot?.hasDesktopText && native.snapshot?.status == 'ready'" class="editor-note">电脑草稿已有内容，请先在电脑处理；手机输入会保留。</text>
      <text v-if="props.expanded && draft.plugins.length > 0" class="editor-note">原生草稿暂不支持插件，请先移除插件后发送；已选插件会保留。</text>
      <button v-if="props.expanded && !busy && !native.busy && native.snapshot?.status == 'detached' && !native.outcomeUnknown" class="retry-button" @click="reconnectDraft">重新连接电脑草稿</button>
      <button v-if="props.expanded && !busy && native.outcomeUnknown" class="retry-button" :disabled="native.busy" @click="checkDraftOutcome">核对原操作结果</button>
      <button v-if="props.expanded && !busy && native.snapshot?.status == 'promoted' && !native.outcomeUnknown" class="retry-button" @click="followPromotion">打开电脑已发送的聊天</button>
      <message-composer :instance-id="composerInstanceId" :reset-key="connection.hostId + ':' + projectId" :cursor="mentionCursor" :model-label="modelLabel" :layout-width="props.paneWidth"
        :active="props.expanded" :text="draft.text" :expanded="props.expanded" :input-height="visibleInputHeight" :focus="focused"
        :images="draft.images" :files="draft.files" :plugins="draft.plugins" :mentions="draft.threadMentions"
        :disabled="busy || !props.expanded" :chips-disabled="busy" :images-disabled="busy" :files-disabled="busy"
        :add-disabled="busy || imageBusy || !props.expanded" :primary-disabled="!canSend" primary-label="发送并开启新聊天"
        :settings-disabled="busy || !nativeReady || models.length == 0" :plan-enabled="settings?.mode == 'plan'" :plan-disabled="busy || !nativeReady || creationPendingId.length > 0"
        :content-height="visibleContentHeight" :content-target="contentTarget" :entry-only="true"
        @input="updateText" @focus="onDraftFocus" @blur="focused = false" @linechange="onLineChange" @keyboardheightchange="onKeyboardChange"
        @syncinput="syncComposerText" @submit="send" @primary="send" @add="openOptions('add')" @settings="openOptions('settings')" @toggleplan="composerAction('plan')"
        @expand="expandEditor" @layout="showDraftInput"
        @removeimage="removeImage" @previewimage="previewImage" @removefile="removeFile" @removeplugin="removePlugin" @removemention="removeThreadMention">
        <template #permissions><permissions-control :pane-left="props.paneLeft" :pane-width="props.paneWidth" :active="props.expanded" :project-id="projectId" :native-draft="true" :draft-id="native.draftId" :native-state="native.snapshot?.permissions ?? null" :native-status="native.snapshot?.status ?? ''" :native-busy="native.busy" :disabled="busy || creationPendingId.length > 0 || !nativeReady" @select="selectPermission" @refresh="loadSettings" /></template>
      </message-composer>
    </view>
    <view v-if="keyboardInset == 0" class="bottom-safe-area"></view>
    <view v-if="picker.length > 0 || menu.length > 0" class="new-overlay" @click="closeMenus">
      <view v-if="picker.length > 0" class="destination-sheet" @click.stop>
        <view class="sheet-heading"><text class="sheet-title">{{ picker == 'computers' ? '选择电脑' : '选择项目' }}</text><view class="sheet-close action-frame"><app-icon name="close" :size="20" /><button class="action-hitbox" aria-label="关闭选择" @click="closeMenus"></button></view></view>
        <scroll-view direction="vertical" class="picker-scroll" :style="{ height: pickerHeight + 'px' }">
          <template v-if="picker == 'computers'"><view v-for="computer in connection.computers" :key="computer.id" class="picker-row action-frame"><app-icon :name="iconForComputer(computer)" :size="20" /><text class="picker-label">{{ computer.label }}</text><text class="picker-caption">{{ computer.online ? '在线' : '离线' }}</text><app-icon v-if="computer.id == connection.hostId" name="check" :size="20" /><button class="action-hitbox" :aria-label="'选择电脑 ' + computer.label" @click="chooseComputer(computer.id)"></button></view><button v-if="!connection.configured || connection.computers.length == 0" class="connect-action" @click="openConnection">连接电脑</button></template>
          <template v-else><text v-if="projectsLoading" class="picker-note">正在读取项目…</text><text v-else-if="projects.length == 0" class="picker-note">{{ !connection.configured ? '请先连接电脑' : '请在电脑端添加项目，或重新读取' }}</text><view v-for="project in projects" :key="project.id" class="picker-row action-frame"><app-icon name="folder" :size="20" /><view class="project-copy"><text class="picker-label">{{ project.label }}</text><text class="project-path">{{ project.cwd }}</text></view><app-icon v-if="project.id == projectId" name="check" :size="20" /><button class="action-hitbox" :aria-label="'选择项目 ' + project.label" @click="chooseProject(project.id)"></button></view></template>
        </scroll-view>
      </view>
      <view v-else class="new-options" @click.stop><composer-options :section="menu" :settings="settings" :models="models" :loading="settingsLoading" :busy="busy || native.busy" :error="settingsError" :width="menuWidth" :height="pickerHeight" :images-enabled="!imageBusy && draft.images.length + draft.files.length < 3 && modelSupportsImages" :files-enabled="!imageBusy && draft.images.length + draft.files.length < 3" :settings-enabled="nativeReady && settings != null && models.length > 0" :plan-disabled="!nativeReady" note="附件最多3个，首次发送时上传到所选电脑" @section="changeSection" @action="composerAction" @select="selectSetting" @dismiss="closeMenus" @retry="loadSettings" /></view>
    </view>
    <thread-mention-picker v-if="mentionOpen && props.expanded && native.snapshot?.supportsThreadMentions == true" :host-id="connection.hostId" thread-id="" :scope-id="projectId" :initial-query="mentionTrigger?.query ?? ''" :mentions="draft.threadMentions" @confirm="selectThreadMentions" @close="closeThreadMentions" />
    <plugin-picker v-if="pluginOpen && props.expanded" :host-id="connection.hostId" thread-id="" :project-id="projectId" :plugins="draft.plugins" @confirm="selectPlugins" @close="pluginOpen = false" />
  </view>
</template>

<script setup lang="uts">
import { computed, ref, watch, nextTick, onMounted, onUnmounted } from 'vue'
import PermissionsControl from '../permissions-control/permissions-control.uvue'
import AppIcon from '../app-icon/app-icon.uvue'
import MessageComposer from '../message-composer/message-composer.uvue'
import ComposerOptions from '../composer-options/composer-options.uvue'
import ThreadMentionPicker from '../thread-mention-picker/thread-mention-picker.uvue'
import { SelectedThreadMention, ThreadMentionTrigger, findThreadMentionTrigger, replaceThreadMentionTrigger } from '../../services/thread-mentions.uts'
import { setNewDraftThreadMentions } from '../../services/new-conversation.uts'
import PluginPicker from '../plugin-picker/plugin-picker.uvue'
import type { SelectedPlugin } from '../../services/plugins.uts'
import { bridge, connection, computerIcon, Computer } from '../../services/bridge.uts'
import { NewProject, NewDraft, newDraft, beginNewConversation, assignUnselectedDraft, sendNewConversation, finishNewDraft } from '../../services/new-conversation.uts'
import { DraftImage, DraftFile } from '../../services/composer.uts'
import { ModelOption, effortLabel, shortModelLabel } from '../../services/execution-settings.uts'
import { nativeDraftState, watchNativeDraft, closeNativeDraft, updateNativeDraft, checkNativeDraftCommand } from '../../services/native-draft.uts'
import { openPromotedConversation } from '../../services/new-conversation.uts'
import { prepareImage } from '../../services/images.uts'
import { bindImagePaste } from '../../services/image-paste.uts'
import { validateFile } from '../../services/files.uts'

// 展开只恢复原生草稿订阅，手机输入和插件选择始终按电脑、项目隔离。
beginNewConversation()

const props = withDefaults(defineProps<{ expanded?: boolean, paneWidth?: number, paneLeft?: number }>(), { expanded: false, paneWidth: 0, paneLeft: 0 })
const emit = defineEmits<{ expand: [], busy: [value: boolean], created: [threadId: string], dismiss: [] }>()
// 输入测量和粘贴按面板实例隔离，标识不包含电脑或聊天信息。
const composerInstanceId = 'composer-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2)
const projectId = ref(''), projects = ref<NewProject[]>([])
const projectsLoading = ref(false), settingsLoading = ref(false)
const error = ref(''), settingsError = ref(''), busy = ref(false), imageBusy = ref(false), progress = ref('')
const focused = ref(false), draftHeight = ref(64), keyboardInset = ref(0), picker = ref(''), menu = ref('')
const menuWidth = computed((): number => Math.min(330, (props.paneWidth > 0 ? props.paneWidth : uni.getWindowInfo().windowWidth) - 28))
let baseWindowHeight = uni.getWindowInfo().windowHeight
const currentWindowHeight = ref(baseWindowHeight)
const contentTarget = ref('')
const pluginOpen = ref(false)
const mentionOpen = ref(false), mentionCursor = ref(-1), mentionTrigger = ref<ThreadMentionTrigger | null>(null)
let mentionDraftRevision = 0, mentionSourceRevision = 0, mentionContext = '', mentionSelectionRevision = 0
let projectRequest = 0, settingsRequest = 0
let nativeOpenRequested = false
let alive = true
let editorRevision = 0, editorLayoutTimer = 0
const draft = computed((): NewDraft => newDraft(connection.hostId, projectId.value))
const native = computed(() => nativeDraftState(connection.hostId, projectId.value))
const models = computed((): ModelOption[] => native.value.snapshot?.models ?? [] as ModelOption[])
const settings = computed(() => native.value.snapshot?.settings ?? null)
const creationPendingId = computed((): string => native.value.pendingCommandId)
const nativeReady = computed((): boolean => native.value.watching && native.value.snapshot?.status == 'ready' && !native.value.busy && !native.value.outcomeUnknown && !native.value.needsReadback)
const computerOnline = computed((): boolean => connection.computers.some((computer: Computer): boolean => computer.id == connection.hostId && computer.online))
const currentComputerIcon = computed((): string => computerIcon(connection.computers.find((computer: Computer): boolean => computer.id == connection.hostId) ?? null))
function iconForComputer(computer: Computer): string { return computerIcon(computer) }
const computerLabel = computed((): string => connection.computers.find((computer: Computer): boolean => computer.id == connection.hostId)?.label ?? '选择电脑')
const projectLabel = computed((): string => projectsLoading.value ? '正在读取项目…' : projects.value.find((project: NewProject): boolean => project.id == projectId.value)?.label ?? '选择项目')
const modelSupportsImages = computed((): boolean => models.value.find((model: ModelOption): boolean => model.id == settings.value?.model)?.supportsImages == true)
const modelLabel = computed((): string => settingsLoading.value ? '正在读取设置…' : settings.value == null ? '等待电脑草稿' : shortModelLabel(models.value.find((model: ModelOption): boolean => model.id == settings.value?.model)?.label ?? settings.value!.model) + ' ' + effortLabel(settings.value!.effort))
const canSend = computed((): boolean => props.expanded && nativeReady.value && native.value.snapshot?.hasDesktopText != true && !busy.value && !imageBusy.value && !projectsLoading.value && !settingsLoading.value && connection.connected && computerOnline.value && creationPendingId.value.length == 0 && projectId.value.length > 0 && (draft.value.text.trim().length > 0 || draft.value.images.length > 0 || draft.value.files.length > 0) && (draft.value.images.length == 0 || modelSupportsImages.value))
const pickerHeight = computed((): number => Math.max(100, Math.min(340, currentWindowHeight.value - keyboardInset.value - 270)))
const editorContentHeight = computed((): number => Math.min(draftHeight.value + (draft.value.images.length > 0 ? 70 : 0) + draft.value.files.length * 56 + (draft.value.plugins.length > 0 ? Math.ceil(draft.value.plugins.length / 2) * 44 : 0) + (draft.value.threadMentions.length > 0 ? draft.value.threadMentions.length * 44 : 0), Math.max(64, currentWindowHeight.value - keyboardInset.value - 300)))
// 常驻编辑节点在收起时只占一行，工具栏始终预留相同的底部高度。
const visibleInputHeight = computed((): number => props.expanded ? draftHeight.value : 24)
const visibleContentHeight = computed((): number => props.expanded ? editorContentHeight.value : 24)
// 单行时整块胶囊都是新对话入口，不提前打开附件菜单或创建会话。
function expandEditor() { if (!props.expanded) emit('expand') }
function notify(message: string) { uni.showToast({ title: message, icon: 'none' }) }
function closeMenus() { picker.value = ''; menu.value = ''; pluginOpen.value = false; closeThreadMentions(false) }
// 点击空白区沿用首页返回逻辑，保留草稿；提交期间保持编辑区可见。
function dismissEditor() { if (busy.value) return; closeMenus(); focused.value = false; uni.hideKeyboard(); emit('dismiss') }
function openConnection() { closeMenus(); uni.navigateTo({ url: '/pages/connection/index' }) }
function openPicker(section: string) { if (busy.value) return; focused.value = false; uni.hideKeyboard(); menu.value = ''; picker.value = section }
function openOptions(section: string) { if (!props.expanded || busy.value || imageBusy.value) return; picker.value = ''; menu.value = menu.value == section ? '' : section }
function changeSection(section: string) { menu.value = section }

// 显式展开或选择新项目才触发原生新聊天；网络恢复只读原绑定，不自动重放新建。
function loadSettings(focusAfter: boolean = false) { if (!props.expanded) return; const open = nativeOpenRequested; nativeOpenRequested = false; connectDraft(open, focusAfter) }
function reconnectDraft() { connectDraft(true) }
// 仅展开并确定合法项目后打开原生新聊天；回读和重连入口明确分开。
async function connectDraft(reconnect: boolean, focusAfter: boolean = false) {
  if (!props.expanded || projectId.value.length == 0 || !connection.connected || !computerOnline.value || busy.value) return
  const hostId = connection.hostId, id = projectId.value, request = ++settingsRequest
  settingsLoading.value = true; settingsError.value = ''
  try {
    await watchNativeDraft(hostId, id, reconnect)
    // 仅用户选择项目后的当前成功回执恢复焦点，自动刷新和迟到响应不抢输入。
    if (focusAfter && alive && props.expanded && hostId == connection.hostId && id == projectId.value && request == settingsRequest && nativeReady.value) focusDraftInput()
  }
  catch (reason) { if (alive && props.expanded && hostId == connection.hostId && id == projectId.value && request == settingsRequest) { settingsError.value = (reason as Error).message; error.value = (reason as Error).message } }
  finally { if (alive && hostId == connection.hostId && id == projectId.value && request == settingsRequest) settingsLoading.value = false }
}

// 项目来自电脑的完整保存清单，默认选择在当前电脑中重新验证。
function loadProjects() {
  if (!props.expanded || !connection.configured || !connection.connected || !computerOnline.value || busy.value) return
  const hostId = connection.hostId, request = ++projectRequest
  projectsLoading.value = true; error.value = ''
  bridge.request('projects.list', {}).then((result: UTSJSONObject) => {
    if (!alive || hostId != connection.hostId || request != projectRequest) return
    projectsLoading.value = false
    if (result.getBoolean('supportsNativeNewDraft') != true) { closeNativeDraft(hostId, projectId.value); error.value = '请更新电脑连接服务后使用原生新聊天'; return }
    projects.value = JSON.parse<NewProject[]>(JSON.stringify(result['projects'])) ?? [] as NewProject[]
    let remembered = ''
    try { const value = uni.getStorageSync('codex-mobile-new-project-' + hostId); if (typeof value == 'string') remembered = value } catch (_) {}
    const candidate = projectId.value.length > 0 ? projectId.value : remembered.length > 0 ? remembered : result.getString('selectedProjectId') ?? ''
    projectId.value = projects.value.some((project: NewProject): boolean => project.id == candidate) ? candidate : ''
    if (projectId.value.length > 0) { assignUnselectedDraft(hostId, projectId.value); loadSettings() }
    else if (projects.value.length == 0) error.value = '请先在电脑端添加项目'
  }, (reason: Error) => { if (alive && hostId == connection.hostId && request == projectRequest) { projectsLoading.value = false; error.value = reason.message + '，请确认电脑连接服务已更新' } })
}
function chooseComputer(id: string) { if (busy.value) return; try { if (id != connection.hostId) closeNativeDraft(connection.hostId, projectId.value); bridge.selectComputer(id); closeMenus() } catch (reason) { notify((reason as Error).message) } }
function chooseProject(id: string) {
  if (busy.value || !projects.value.some((project: NewProject): boolean => project.id == id)) return
  if (projectId.value.length == 0) assignUnselectedDraft(connection.hostId, id)
  if (id != projectId.value) { closeNativeDraft(connection.hostId, projectId.value); nativeOpenRequested = true }
  projectId.value = id; settingsRequest++; settingsLoading.value = false; closeMenus(); error.value = ''
  try { uni.setStorageSync('codex-mobile-new-project-' + connection.hostId, id) } catch (_) {}
  loadSettings(true)
}
function reloadOptions() { if (projects.value.length == 0) loadProjects(); else loadSettings() }
// 不修改本地显示设置，等待 UPDATE 和只读确认后由原生快照驱动界面。
async function selectSetting(key: string, value: string) {
  if (busy.value || !nativeReady.value || ['model', 'effort', 'serviceTier'].indexOf(key) < 0) return
  const changes: UTSJSONObject = {}; changes[key] = value
  // 模型、强度和速度共用确认后的焦点恢复，仍等待电脑草稿同步成功。
  await changeNativeSettings(changes, false, true)
}
async function changeNativeSettings(changes: UTSJSONObject, confirmed: boolean = false, focusAfter: boolean = false) {
  const state = native.value, hostId = connection.hostId, id = projectId.value
  // 只在原草稿确认成功且仍展开时恢复焦点，失败继续保留错误提示。
  try { settingsError.value = ''; await updateNativeDraft(state, changes, confirmed); if (alive && hostId == connection.hostId && id == projectId.value) { error.value = ''; closeMenus(); if (focusAfter && props.expanded) focusDraftInput() } }
  catch (reason) { if (alive && hostId == connection.hostId && id == projectId.value) { settingsError.value = (reason as Error).message; error.value = (reason as Error).message } }
}
function imageId(): string { return Date.now().toString() + '-' + Math.random().toString(36).slice(2) + '-' + Math.random().toString(36).slice(2) }
// 完整访问的确认来自权限组件，权限与模型使用同一个原生草稿版本。
function selectPermission(mode: string, confirmed: boolean) { if (nativeReady.value && !busy.value) changeNativeSettings({ permissionMode: mode }, confirmed, true) }
function remaining(): number { return Math.max(0, 3 - draft.value.images.length - draft.value.files.length) }
async function acceptImages(target: NewDraft, paths: string[]) {
  imageBusy.value = true
  try { for (const source of paths) { if (target.images.length + target.files.length >= 3) break; target.images.push({ id: imageId(), src: await prepareImage(source) } as DraftImage) } }
  catch (reason) { if (alive) notify((reason as Error).message) }
  imageBusy.value = false
}
function chooseImages(source: string) {
  if (imageBusy.value || !modelSupportsImages.value || remaining() == 0) return
  const target = draft.value
  uni.chooseImage({ count: remaining(), sourceType: source == 'camera' ? ['camera'] : ['album'], sizeType: ['compressed'], success: (result) => { acceptImages(target, result.tempFilePaths) } })
}
// 固定粘贴时的电脑与项目草稿，处理期间切换目标也不会串入其他草稿。
async function pasteImages(paths: string[]) {
  if (!alive || !props.expanded || busy.value || imageBusy.value) return
  if (!modelSupportsImages.value) { notify('当前模型不支持图片，请切换模型'); return }
  const count = remaining()
  if (count == 0) { notify('每次最多添加3个附件'); return }
  if (paths.length > count) notify('每次最多添加3个附件，已保留可添加的图片')
  await acceptImages(draft.value, paths.slice(0, count))
}
async function acceptFiles(target: NewDraft, selected: ChooseFileTempFile[]) {
  imageBusy.value = true
  try { for (const picked of selected) {
    if (target.images.length + target.files.length >= 3) break
    const extension = picked.name.slice(picked.name.lastIndexOf('.') + 1).toLowerCase()
    if (extension == 'jpg' || extension == 'jpeg' || extension == 'png') { if (!modelSupportsImages.value) throw new Error('当前模型不支持图片，请切换模型'); target.images.push({ id: imageId(), src: await prepareImage(picked.path) } as DraftImage) }
    else { validateFile(picked.name, picked.size); target.files.push({ id: imageId(), name: picked.name, size: picked.size, source: picked.path, data: '', status: 'local', progress: 0, error: '' } as DraftFile) }
  } } catch (reason) { if (alive) notify((reason as Error).message) }
  imageBusy.value = false
}
function chooseFiles() { if (imageBusy.value || remaining() == 0) return; const target = draft.value; uni.chooseFile({ count: remaining(), type: 'all', success: (result) => { acceptFiles(target, result.tempFiles) } }) }
function composerAction(action: string) {
  if (busy.value) return
  if (action == 'plugin') { closeMenus(); focused.value = false; uni.hideKeyboard(); pluginOpen.value = true; return }
  // 目标属于真实会话，首次发送前只说明入口，保留尚未发送的草稿。
  if (action == 'goal') { closeMenus(); uni.showModal({ title: '追求目标', content: '请先发送消息创建聊天，再从加号菜单设置目标。', showCancel: false, confirmText: '知道了' }); return }
  if (action == 'plan') {
    if (!nativeReady.value || settings.value == null) return
    // 开启和关闭都等待电脑确认，失败或目标切换时不抢回输入焦点。
    changeNativeSettings({ mode: settings.value!.mode == 'plan' ? 'default' : 'plan' }, false, true)
    return
  }
  closeMenus(); if (action == 'camera' || action == 'album') chooseImages(action); else if (action == 'file') chooseFiles()
}

// 强制产生新的聚焦变化，菜单收起后继续编辑同一电脑与项目的草稿。
function focusDraftInput() {
  const hostId = connection.hostId, selectedProjectId = projectId.value
  focused.value = false
  nextTick(() => { if (alive && props.expanded && hostId == connection.hostId && selectedProjectId == projectId.value && !busy.value) focused.value = true })
}
// 插件标签只修改当前电脑与项目草稿，确认面板后恢复输入焦点。
function selectPlugins(plugins: SelectedPlugin[]) { if (busy.value) return; draft.value.plugins = plugins; pluginOpen.value = false; focusDraftInput() }
function removePlugin(id: string) { if (!busy.value) draft.value.plugins = draft.value.plugins.filter((plugin: SelectedPlugin): boolean => plugin.id != id) }
function removeImage(id: string) { if (!busy.value) draft.value.images = draft.value.images.filter((image: DraftImage): boolean => image.id != id) }
function removeFile(id: string) { if (!busy.value) draft.value.files = draft.value.files.filter((file: DraftFile): boolean => file.id != id) }
function previewImage(src: string) { uni.previewImage({ urls: draft.value.images.map((image: DraftImage): string => image.src), current: src }) }
// 首条消息同样只消费独立 @ 片段，保留光标后的正文。
// 回车先同步原生输入框的最新值，避免节流回调尚未到达时发送旧正文。
function syncComposerText(text: string) { if (props.expanded && !busy.value) { draft.value.text = text; mentionCursor.value = -1 } }
function updateText(event: UniInputEvent) {
  if (!props.expanded) return
  draft.value.text = event.detail.value; mentionCursor.value = -1
  if (busy.value || native.value.snapshot?.supportsThreadMentions != true || mentionOpen.value) return
  const trigger = findThreadMentionTrigger(event.detail.value, event.detail.cursor ?? -1)
  if (trigger == null) return
  closeMenus(); mentionTrigger.value = trigger; mentionSourceRevision = mentionDraftRevision
  mentionContext = threadMentionContext(); mentionSelectionRevision = draft.value.threadMentionRevision
  focused.value = false; uni.hideKeyboard(); mentionOpen.value = true
}
function threadMentionContext(): string { return [connection.hostId, projectId.value, connection.configurationRevision.toString()].join(':') }
function closeThreadMentions(restoreFocus: boolean = true) {
  const wasOpen = mentionOpen.value, trigger = mentionTrigger.value
  if (restoreFocus && trigger != null && draft.value.text == trigger.text && mentionSourceRevision == mentionDraftRevision) mentionCursor.value = trigger.end
  mentionOpen.value = false; mentionTrigger.value = null
  if (wasOpen && restoreFocus && props.expanded && mentionContext == threadMentionContext()) focusDraftInput()
}
// 不接管迟到选择；电脑、项目、草稿正文及标签版本必须仍与打开时一致。
function selectThreadMentions(mentions: SelectedThreadMention[]) {
  const trigger = mentionTrigger.value
  if (busy.value || native.value.snapshot?.supportsThreadMentions != true || trigger == null || mentionContext != threadMentionContext() || mentionSourceRevision != mentionDraftRevision || mentionSelectionRevision != draft.value.threadMentionRevision) { closeThreadMentions(false); notify('草稿已变化，请在当前位置重新引用聊天'); return }
  const replacement = replaceThreadMentionTrigger(draft.value.text, trigger)
  if (replacement == null) { closeThreadMentions(false); notify('草稿已变化，正文已保留'); return }
  setNewDraftThreadMentions(draft.value, mentions); draft.value.text = replacement.text
  mentionCursor.value = replacement.cursor; closeThreadMentions()
}
function removeThreadMention(id: string) { if (!busy.value) setNewDraftThreadMentions(draft.value, draft.value.threadMentions.filter((mention: SelectedThreadMention): boolean => mention.id != id)) }
watch((): string => draft.value.text, () => { mentionDraftRevision++ }, { flush: 'sync' })
watch((): string => threadMentionContext(), () => { closeThreadMentions(false); mentionCursor.value = -1 }, { flush: 'sync' })
// 附件和长文本在面板内滚动，键盘弹出后仍为电脑、项目和发送按钮保留位置。
function showDraftInput() { contentTarget.value = ''; nextTick(() => { if (alive && props.expanded) contentTarget.value = composerInstanceId + '-input' }) }
function onDraftFocus() { if (!props.expanded) return; focused.value = true; showDraftInput() }
function onLineChange(event: UniTextareaLineChangeEvent) { if (!props.expanded) return; draftHeight.value = Math.max(64, Math.min(144, event.detail.height)); showDraftInput() }
function onKeyboardChange(event: UniInputKeyboardHeightChangeEvent) { if (!props.expanded) { keyboardInset.value = 0; return }; currentWindowHeight.value = uni.getWindowInfo().windowHeight; const resized = Math.max(0, baseWindowHeight - currentWindowHeight.value); keyboardInset.value = event.detail.height > 0 ? Math.max(0, event.detail.height - resized) : 0 }
async function send() {
  if (!canSend.value) return
  busy.value = true; emit('busy', true); closeMenus(); error.value = ''
  try { const id = await sendNewConversation(draft.value, (message: string) => { progress.value = message }); if (alive) { uni.hideKeyboard(); emit('created', id) } }
  catch (reason) { if (alive) error.value = (reason as Error).message }
  finally { busy.value = false; emit('busy', false) }
}
// 收起只取消原生订阅；旧聚焦、读取和动画回调失效，电脑草稿和手机输入保留。
function syncEditorVisibility(expanded: boolean) {
  const revision = ++editorRevision
  clearTimeout(editorLayoutTimer); focused.value = false; closeMenus()
  if (!expanded) { nativeOpenRequested = false; closeNativeDraft(connection.hostId, projectId.value); projectRequest++; settingsRequest++; projectsLoading.value = false; settingsLoading.value = false; keyboardInset.value = 0; return }
  nativeOpenRequested = true; beginNewConversation(); error.value = ''; settingsError.value = ''
  baseWindowHeight = uni.getWindowInfo().windowHeight; currentWindowHeight.value = baseWindowHeight
  loadProjects()
  nextTick(() => { if (alive && props.expanded && revision == editorRevision) focused.value = true })
  settleEditorLayout()
}
// 为 200ms 过渡额外留一帧，长文本及附件只在最新展开状态下补测滚动位置。
function settleEditorLayout() {
  clearTimeout(editorLayoutTimer)
  if (!props.expanded) return
  const revision = editorRevision
  editorLayoutTimer = setTimeout(() => { if (alive && props.expanded && revision == editorRevision) showDraftInput() }, 220)
}
watch((): boolean => props.expanded, syncEditorVisibility, { immediate: true, flush: 'post' })
watch((): number => visibleContentHeight.value, () => { settleEditorLayout() }, { flush: 'post' })
onUnmounted(() => { closeNativeDraft(connection.hostId, projectId.value); alive = false; editorRevision++; clearTimeout(editorLayoutTimer); projectRequest++; settingsRequest++ })

let unbindImagePaste: () => void = () => {}
onMounted(() => { unbindImagePaste = bindImagePaste('#' + composerInstanceId + ' .message-input', pasteImages, (): boolean => props.expanded) })
onUnmounted(() => { unbindImagePaste() })

// 连接变化使旧电脑的读取失效，未配置时输入的内容留给首次连接的电脑。
watch((): string => connection.hostId, (hostId: string, previous: string) => {
  closeNativeDraft(previous, projectId.value)
  if (previous.length == 0 && hostId.length > 0) { const source = newDraft('', ''), target = newDraft(hostId, ''); if (target.text.length == 0 && target.images.length == 0 && target.files.length == 0 && target.plugins.length == 0 && target.threadMentions.length == 0) { target.text = source.text; target.images = source.images; target.files = source.files; target.plugins = source.plugins; target.threadMentions = source.threadMentions; target.threadMentionRevision++; source.threadMentions = [] as SelectedThreadMention[]; source.threadMentionRevision++; source.text = ''; source.images = [] as DraftImage[]; source.files = [] as DraftFile[]; source.plugins = [] as SelectedPlugin[] } }
  projectId.value = ''; projects.value = [] as NewProject[]
  projectRequest++; settingsRequest++; settingsLoading.value = false; projectsLoading.value = false; closeMenus(); loadProjects()
})
watch((): string => connection.connected.toString() + ':' + computerOnline.value.toString(), (_current: string, _previous: string) => { if (connection.connected && computerOnline.value) loadProjects(); else closeNativeDraft(connection.hostId, projectId.value) })
watch((): string => draft.value.images.length.toString() + ':' + draft.value.files.length.toString() + ':' + draft.value.threadMentions.length.toString() + ':' + (settings.value?.mode ?? ''), (_current: string, _previous: string) => { showDraftInput() })

// 电脑先发送时只打开已提升的聊天，手机输入转为正式聊天的本地草稿。
async function followPromotion() {
  if (!alive || !props.expanded || busy.value || draft.value.pendingAction == 'send' || native.value.busy || native.value.outcomeUnknown || native.value.snapshot?.status != 'promoted') return
  const target = draft.value
  busy.value = true; emit('busy', true)
  try { const id = await openPromotedConversation(target); if (alive && connection.hostId == target.hostId && projectId.value == target.projectId && props.expanded) { uni.hideKeyboard(); emit('created', id) } }
  catch (reason) { if (alive && connection.hostId == target.hostId && projectId.value == target.projectId) error.value = (reason as Error).message }
  finally { busy.value = false; emit('busy', false) }
}
async function checkDraftOutcome() {
  if (busy.value || native.value.busy) return
  const target = draft.value, state = native.value
  busy.value = true; emit('busy', true)
  try { const id = await checkNativeDraftCommand(state); if (id.length > 0) finishNewDraft(target); if (alive && connection.hostId == target.hostId && projectId.value == target.projectId) { error.value = ''; followPromotion() } }
  catch (reason) { if (alive && connection.hostId == target.hostId && projectId.value == target.projectId) error.value = (reason as Error).message }
  finally { busy.value = false; emit('busy', false) }
  if (alive && connection.hostId == target.hostId && projectId.value == target.projectId) followPromotion()
}
watch((): string => (native.value.snapshot?.status ?? '') + ':' + native.value.busy.toString() + ':' + native.value.outcomeUnknown.toString(), () => { followPromotion() })

</script>

<style>
.new-conversation { flex-grow: 1; flex-shrink: 1; height: 0; min-height: 0; position: relative; }
.new-conversation-compact { flex-grow: 0; flex-shrink: 0; height: auto; }
.new-space { flex: 1; min-height: 8px; }
.action-frame { position: relative; overflow: hidden; flex-shrink: 0; }
.action-hitbox { position: absolute; left: 0; top: 0; width: 100%; height: 100%; margin: 0; padding: 0; border-width: 0; border-radius: 0; background-color: transparent; font-size: 1px; line-height: 1px; }
/* 用随屏宽缩放的 rpx 保留原 92% 宽度，兼容安卓原生 max-width。 */
.destination-row { align-self: flex-start; max-width: 690rpx; height: 44px; margin-left: 22px; margin-bottom: 4px; flex-direction: row; align-items: center; border-radius: 12px; padding: 0 8px; }
/* 图标槽与文字共用 24px 中心轴；按素材可见边界补偿笔记本与文件夹的留白差异。 */
.destination-icon { width: 24px; height: 24px; flex-shrink: 0; align-items: center; justify-content: center; }
.destination-laptop { transform: translateY(-0.5px); }
.destination-folder { transform: translateY(0.5px); }
.destination-chevron { width: 16px; height: 24px; flex-shrink: 0; align-items: center; justify-content: center; }
/* 固定文字行高，轻微上移以补偿系统字体的基线留白。 */
.destination-label { height: 24px; line-height: 24px; color: #657269; font-size: 16px; margin: 0 8px; flex-shrink: 1; lines: 1; text-overflow: ellipsis; transform: translateY(-1px); }
.new-dock { flex-shrink: 0; padding: 4px 16px 12px; }
.bottom-safe-area { height: var(--uni-safe-area-inset-bottom); flex-shrink: 0; }
.editor-feedback { flex-shrink: 0; padding: 4px 6px 8px; }
.editor-note, .editor-error { font-size: 12px; line-height: 18px; }
.editor-note { color: #7b827a; }
.editor-error { color: #8d4d2b; }
.retry-button { height: 36px; line-height: 36px; font-size: 13px; color: #285c49; background-color: transparent; margin: 0; padding: 0 8px; }
.retry-button { align-self: flex-start; }
.new-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; z-index: 40; background-color: rgba(32,44,40,0.12); justify-content: flex-end; padding: 12px; }
.destination-sheet { border-radius: 22px; padding: 10px; background-color: #f8f8f3; }
.sheet-heading { flex-direction: row; align-items: center; padding-left: 12px; height: 40px; }
.sheet-title { flex: 1; font-size: 15px; color: #202c28; }
.sheet-close { width: 40px; height: 40px; align-items: center; justify-content: center; }
.picker-scroll { flex-shrink: 1; }
.picker-row { min-height: 52px; flex-direction: row; align-items: center; padding: 8px 12px; border-radius: 12px; }
.picker-label { flex: 1; min-width: 0; color: #202c28; font-size: 15px; margin-left: 10px; lines: 1; text-overflow: ellipsis; }
.picker-caption { color: #7b827a; font-size: 12px; margin: 0 8px; }
.project-copy { flex: 1; min-width: 0; margin-right: 8px; }
.project-path { color: #7b827a; font-size: 11px; margin: 4px 0 0 10px; lines: 1; text-overflow: ellipsis; }
.picker-note { font-size: 13px; color: #7b827a; margin: 12px; line-height: 22px; }
.connect-action { height: 44px; line-height: 44px; margin: 10px; color: #285c49; background-color: #e8eee6; font-size: 15px; }
.new-options { align-self: flex-end; margin-bottom: 130px; }
/* #ifdef WEB */
.destination-label, .model-label, .file-name, .picker-label, .project-path { display: block; white-space: nowrap; overflow: hidden; }
/* #endif */
</style>
