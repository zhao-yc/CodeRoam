<template>
  <view class="progress-space" aria-hidden="true">
    <loading v-if="busy" class="progress-spinner" :style="{ borderColor: light ? '#ffffff' : '#4546bd' }" />
  </view>
</template>

<script setup lang="uts">
// 固定预留位置，让同一个按钮在等待回执时保持宽度和文字位置。
withDefaults(defineProps<{ busy: boolean, light?: boolean }>(), { light: false })
</script>

<style scoped>
.progress-space { width: 16px; height: 14px; flex-shrink: 0; align-items: flex-start; justify-content: center; }
.progress-spinner { width: 12px; height: 12px; }
