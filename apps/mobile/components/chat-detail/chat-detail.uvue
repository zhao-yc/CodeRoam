<template>
  <view id="conversation-page" class="page" :style="{ paddingBottom: keyboardInset + 'px' }">
    <view class="status-spacer"></view>
    <view id="conversation-header" class="conversation-header" @click="dismissGoal">
      <view v-if="liquidGlass" class="icon-button glass-header-action"><liquid-glass-control :symbol="props.embedded ? 'xmark' : 'chevron.backward'" :label="props.embedded ? '关闭聊天详情' : '返回聊天列表'" @activate="goBack" /></view>
      <view v-else class="icon-button round-button action-frame"><app-icon :name="props.embedded ? 'close' : 'back'" :size="24" /><button class="action-hitbox" hover-class="action-pressed" :aria-label="props.embedded ? '关闭聊天详情' : '返回聊天列表'" @click="goBack"></button></view>
      <view class="thread-capsule" @click="showConversationInfo">
        <!-- 状态紧跟标题，长标题省略时仍为状态保留完整宽度。 -->
        <view class="thread-heading">
          <text class="thread-title">{{ displayTitle }}</text>
          <view v-if="detailSyncing && displayConversation != null" class="detail-sync-indicator" role="img" :aria-label="syncHint"><cache-activity-icon :spinning="pageVisible && detailSyncing" /></view>
          <view v-if="connection.snapshot != null" class="title-status"><task-status :hide-running-label="true" :state="currentTaskState" :visible="pageVisible" /></view>
        </view>
        <view class="thread-meta"><view v-if="connection.computers.length > 1" class="meta-computer"><app-icon class="meta-icon" :name="hostIcon" :size="14" tone="muted" /><text class="meta-host">{{ hostName }}</text></view><app-icon class="meta-icon" name="folder" :size="14" tone="muted" /><text class="meta-project">{{ projectName }}</text></view>
      </view>
      <view v-if="liquidGlass" class="icon-button glass-header-action"><liquid-glass-control symbol="ellipsis" label="聊天菜单" @activate="showActions" /></view>
      <view v-else class="icon-button round-button action-frame"><app-icon name="more" :size="24" /><button class="action-hitbox" hover-class="action-pressed" aria-label="聊天菜单" @click="showActions"></button></view>
    </view>
    <view v-if="readOnly" class="notice"><text class="notice-text">{{ conversationConnectionHint }}</text></view>
    <view v-if="!connection.connected" class="connection-notice"><view class="connection-dot offline"></view><text class="connection-note">{{ connection.status }}，草稿仍可编辑</text><view class="text-button inline-progress-button"><action-progress :busy="refreshSource == 'connection' && reconnecting" /><text class="inline-progress-caption" style="color: #4546bd; font-size: 12px;">重连</text><button class="inline-progress-hitbox" @click="refreshButton('connection')" :disabled="refreshSource == 'connection' && reconnecting" :aria-label="(refreshSource == 'connection' && reconnecting) ? '正在重新连接' : '重连'"></button></view></view>
    <view v-if="detailError.length > 0" class="notice"><text class="notice-text">{{ detailError }}</text></view>
    <view v-if="pendingRetryCommand.length > 0" class="notice pending-notice"><text class="notice-text">重试结果需要核对，请勿重复提交。</text><view class="check button-secondary inline-progress-button"><action-progress :busy="pendingAction == 'check-retry'" /><text class="inline-progress-caption" style="color: #1a2135; font-size: 12px;">核对重试结果</text><button class="inline-progress-hitbox" :disabled="!connection.connected || busy || (pendingAction == 'check-retry')" @click="checkRetryOutcome" :aria-label="(pendingAction == 'check-retry') ? '正在核对重试结果' : '核对重试结果'"></button></view></view>
    <view v-if="pageDeleteTask != null" class="notice pending-notice"><text class="notice-text">{{ pageDeleteTask!.state == 'running' ? '正在删除，可以返回' : pageDeleteTask!.error }}</text><view v-if="pageDeleteTask!.state != 'running' && pageDeleteTask!.state != 'failed'" class="check button-secondary inline-progress-button"><action-progress :busy="pageDeleteTask?.checking == true" /><text class="inline-progress-caption" style="color: #1a2135; font-size: 12px;">核对删除结果</text><button class="inline-progress-hitbox" :disabled="!connection.connected || pageDeleteTask!.checking" @click="checkDeleteOutcome" :aria-label="(pageDeleteTask?.checking == true) ? '正在核对删除结果' : '核对删除结果'"></button></view></view>
    <view v-if="connection.desktopNavigationError.length > 0 || activationSource == 'desktop'" class="notice pending-notice"><text class="notice-text">{{ connection.desktopNavigationError }}</text><view class="check button-secondary inline-progress-button"><action-progress :busy="activationSource == 'desktop'" /><text class="inline-progress-caption" style="color: #1a2135; font-size: 12px;">重试打开聊天</text><button class="inline-progress-hitbox" :disabled="!connection.connected || activating || connection.pendingCommandId.length > 0 || (activationSource == 'desktop')" @click="retryDesktopOpen" :aria-label="(activationSource == 'desktop') ? '正在打开聊天' : '重试打开聊天'"></button></view></view>
    <view class="timeline-region" @click="dismissGoal">
      <scroll-view id="conversation-timeline" direction="vertical" class="timeline" :scroll-into-view="scrollTarget" :scroll-top="historyScrollTop" :upper-threshold="60" @scrolltoupper="onHistoryTop" @scroll="onTimelineScroll" @touchstart="beginTimelineTouch" @touchend="endTimelineTouch" @touchcancel="endTimelineTouch" @wheel="onTimelineWheel">
        <view id="timeline-content" class="timeline-content" :style="{ minHeight: readingFloor + 'px' }">
        <!-- 历史提示预留固定高度，骨架出现和移除时不改变现有消息的位置。 -->
        <view v-if="connection.snapshot?.supportsHistoryPages == true" class="history-controls"><loading-skeleton v-if="loadingHistory" kind="history" :visible="pageVisible" /><button v-else-if="historyError.length > 0" class="history-more" @click="loadOlder()">加载未完成，点此重试</button><text v-else-if="historyPage?.hasMore == false" class="history-note">已显示全部聊天</text><button v-else class="history-more" @click="loadOlder()">加载更早消息</button></view>
        <!-- 首次同步仅替换正文占位，导航、输入区和失败重试继续沿用真实状态。 -->
        <loading-skeleton v-if="displayConversation == null && connection.connected && detailError.length == 0" kind="conversation" :visible="pageVisible" />
        <view v-else-if="displayConversation == null" class="empty"><text class="empty-title">{{ openingTitle }}</text><text class="empty-detail">{{ detailError.length > 0 ? '未能取得聊天内容，可以重新同步；草稿已保留。' : '连接恢复后会重新同步聊天。' }}</text><button v-if="detailError.length > 0" class="retry-opening button-secondary" @click="refresh">重新同步</button></view>
        <view v-for="entry in renderedTimeline" :id="entryAnchor(entry)" :key="entry.id" :class="['message', entry.role == 'user' ? 'message-user' : entry.role == 'assistant' ? 'message-agent' : 'message-execution']" :style="{ maxWidth: (entry.role == 'user' ? userBubbleWidth : userBubbleWidth + 48) + 'px' }">
          <template v-if="entry.role == 'user' || entry.role == 'assistant'">
            <message-images v-if="entry.role == 'user' && (entry.imageCount ?? 0) > 0" :host-id="pageHostId" :thread-id="pageThreadId" :message-id="entry.id" :connected="connection.connected" :ready="imagesReady" :subscription-revision="connection.subscriptionRevision" :scope-id="connection.cacheNamespace" :count="entry.imageCount ?? 0" :style="{ marginBottom: entry.text.trim().length > 0 || (entry.attachments?.length ?? 0) > 0 ? '8px' : '0px' }" @beforelayout="beforeMarkdownLayout()" @layout="afterMarkdownLayout" />
            <view v-if="entry.role == 'user' && (entry.attachments?.length ?? 0) > 0" class="message-files" :style="{ marginBottom: entry.text.trim().length > 0 ? '8px' : '0px' }"><view v-for="(file, fileIndex) in entry.attachments ?? []" :key="fileIndex" class="message-file" :aria-label="file.name"><app-icon name="file" :size="18" tone="muted" /><text class="message-file-name" selectable>{{ file.name }}</text></view></view>
            <!-- 注释入口先于正文显示，方便先查看引用再阅读补充文字。 -->
            <view v-if="(entry.annotations?.length ?? 0) > 0" :class="['annotation-entry', 'action-frame', entry.text.trim().length > 0 ? 'annotation-before-text' : '']">
              <view class="annotation-icon"><view class="annotation-icon-line"></view><view class="annotation-icon-line annotation-icon-short"></view></view><text class="annotation-entry-label">{{ entry.annotations!.length }} 条注释</text><app-icon name="chevron-right" :size="14" tone="muted" />
              <button class="action-hitbox" hover-class="action-pressed" :aria-label="'查看 ' + entry.annotations!.length + ' 条注释'" @click="openAnnotations(entry.id)"></button>
            </view>
            <plan-preview v-if="entry.role == 'assistant' && entry.kind == 'planImplementation'" :source="planSource(entry.id, entry.text)" @open="openPlan(entry.id, entry.text)" />
            <markdown-body v-else-if="entry.role == 'assistant' && entry.text.trim().length > 0" :source="entry.text" @beforelayout="beforeMarkdownLayout()" @layout="afterMarkdownLayout" @reading="markdownReading" />
            <text v-else-if="entry.text.trim().length > 0" class="message-text" selectable>{{ entry.role == 'user' ? userMessageText(entry.text) : entry.text }}</text>
            <message-images v-if="entry.role == 'assistant' && (entry.imageCount ?? 0) > 0" :host-id="pageHostId" :thread-id="pageThreadId" :message-id="entry.id" :connected="connection.connected" :ready="imagesReady" :subscription-revision="connection.subscriptionRevision" :scope-id="connection.cacheNamespace" :count="entry.imageCount ?? 0" :large="true" @beforelayout="beforeMarkdownLayout()" @layout="afterMarkdownLayout" />
            <template v-if="entry.kind == 'submittedMessage'">
              <text v-if="(entry.summary ?? '').length > 0" class="message-submission-note">{{ entry.summary }}</text>
              <text class="message-submission-note" role="status" aria-live="polite">{{ submittedMessageStatus(entry.label) }}</text>
            </template>
            <file-change-summary v-if="(entry.reportId ?? '').length > 0 && ((connection.snapshot?.supportsFileReports == true) || showingPreview)" :host-id="pageHostId" :thread-id="pageThreadId" :report-id="entry.reportId ?? ''" :connected="connection.connected && !showingPreview" @open="openFileReport" @reading="pauseFollowing" @beforelayout="beforeMarkdownLayout()" @layout="afterMarkdownLayout" />
          </template>
          <view v-else-if="entry.role == 'failure' || entry.role == 'interruption'" class="turn-failure-card" :aria-label="entry.label">
            <app-icon class="turn-failure-icon" name="alert-circle" :size="16" tone="warning" />
            <view class="turn-failure-copy"><text class="turn-failure-text" selectable>{{ entry.text }}</text><text v-if="entry.turnId == displayFailureTurnId && connection.snapshot?.supportsTurnRetry != true && !showingPreview" class="turn-failure-hint">更新电脑连接服务后可重试</text></view>
            <view v-if="entry.turnId == displayFailureTurnId" class="turn-retry inline-progress-button"><action-progress :busy="pendingAction == 'retry:timeline' && retrySubmitting(entry.turnId)" /><text class="inline-progress-caption" style="color: #68534c; font-size: 12px;">重试</text><button class="inline-progress-hitbox" :disabled="!canRetryTurn(entry.turnId) || (pendingAction == 'retry:timeline' && retrySubmitting(entry.turnId))" aria-label="重试失败任务" @click="retryTurn(entry.turnId)"></button></view>
          </view>
          <view v-else-if="entry.role == 'process'" class="process-toggle action-frame">
            <text v-if="!showProcessDurationOnly || (entry.durationLabel ?? '').length > 0" class="process-label">{{ showProcessDurationOnly ? entry.durationLabel : entry.label }}</text>
            <app-icon :name="isProcessExpanded(entry) ? 'chevron-down' : 'chevron-right'" :size="16" tone="muted" />
            <button class="action-hitbox" hover-class="action-pressed" :aria-label="entry.label" :aria-expanded="isProcessExpanded(entry)" @click="toggleProcess(entry)"></button>
          </view>
          <template v-else>
            <view class="execution-toggle action-frame"><app-icon name="edit" :size="19" tone="muted" /><text class="execution-summary">{{ entry.label }}</text><app-icon :name="isExecutionExpanded(entry) ? 'chevron-down' : 'chevron-right'" :size="16" tone="muted" /><button class="action-hitbox" hover-class="action-pressed" :aria-label="(isExecutionExpanded(entry) ? '收起' : '展开') + entry.label" @click="toggleExecutions(entry)"></button></view>
            <scroll-view v-if="isExecutionExpanded(entry)" direction="vertical" class="execution-list" :style="{ height: Math.min(240, entry.executions.length * 44) + 'px' }" @touchstart.stop="beginExecutionTouch" @touchend.stop="endExecutionTouch" @touchcancel.stop="endExecutionTouch">
              <view v-for="message in entry.executions" :key="message.id" class="execution-row action-frame"><app-icon :name="message.kind == 'fileChange' ? 'edit' : 'terminal'" :size="18" tone="muted" /><text class="execution-label">{{ executionTitle(message) }}</text><button class="action-hitbox" hover-class="action-pressed" :aria-label="'查看详情：' + executionTitle(message)" @click="toggleExecution(message.id)"></button></view>
            </scroll-view>
          </template>
        </view>
            <!-- 方案可能不在当前消息窗口，仍使用桌面提供的原文显示独立预览。 -->
        <view v-if="pendingPlanOutsideTimeline && pendingPlan != null" class="plan-fallback"><plan-preview :source="pendingPlan!.text" @open="openPlan(pendingPlan!.id, pendingPlan!.text)" /></view>
        <!-- 确认操作与方案预览分成两张卡；修改意见不使用聊天草稿。 -->
        <view v-if="pendingPlan != null && hiddenPlanId != pendingPlan.id" id="notice-plan" class="plan-confirm">
          <view class="plan-confirm-header"><text class="plan-confirm-title">{{ planEditing ? '修改方案' : '确认方案' }}</text><button v-if="planEditing" class="plan-cancel" :disabled="busy" @click="cancelPlanFeedback">取消</button></view>
          <view class="plan-confirm-body">
            <template v-if="!planEditing">
              <text class="plan-confirm-note">同意后开始实施，也可以先提出修改。</text>
              <view class="plan-confirm-actions"><button class="plan-action button-secondary" :disabled="!canWrite || busy" @click="editPlan">修改方案</button><view class="plan-action plan-implement button-primary inline-progress-button"><action-progress :busy="pendingAction == 'plan:implement'" light /><text class="inline-progress-caption" style="color: #ffffff; font-size: 15px;">同意并实施</text><button class="inline-progress-hitbox" :disabled="!canWrite || busy" @click="replyPlan('implement')" :aria-label="(pendingAction == 'plan:implement') ? '正在处理' : '同意并实施'"></button></view></view>
              <button class="plan-defer" :disabled="busy" @click="hidePlan">稍后处理</button>
            </template>
            <template v-else>
              <text class="plan-confirm-note">补充调整意见，我会据此更新方案。</text>
              <textarea class="plan-feedback" v-model="planFeedback" :disabled="!canWrite || busy" placeholder="告诉我你希望如何调整…" aria-label="方案修改意见" :maxlength="32000"></textarea>
              <view class="plan-send button-primary inline-progress-button"><action-progress :busy="pendingAction == 'plan:feedback'" light /><text class="inline-progress-caption" style="color: #ffffff; font-size: 15px;">发送修改意见</text><button class="inline-progress-hitbox" :disabled="!canWrite || busy || planFeedback.trim().length == 0" @click="replyPlan('feedback')" :aria-label="(pendingAction == 'plan:feedback') ? '正在处理' : '发送修改意见'"></button></view>
              <text class="plan-feedback-note">更新方案后，仍需你确认实施。</text>
            </template>
          </view>
        </view>
        <view id="questions-anchor"></view>
        <!-- 问答在消息区内独立成卡，白底与边界突出当前需要处理的内容。 -->
        <view v-for="group in pendingQuestionGroups" :key="group.id" :id="questionNoticeAnchor(group.id)" class="question-section"><view class="question-entry action-frame"><text class="question-label">回答问题</text><text v-if="submittedGroupIds.indexOf(group.id) >= 0" class="question-state">已提交</text><text class="question-collapse-label">{{ expandedQuestionIds.indexOf(group.id) >= 0 ? '收起' : '展开' }}</text><button class="action-hitbox" hover-class="question-pressed" :aria-label="expandedQuestionIds.indexOf(group.id) >= 0 ? '收起问题' : '展开问题'" :aria-expanded="expandedQuestionIds.indexOf(group.id) >= 0" @click="toggleQuestion(group.id)"></button></view><question-card v-show="expandedQuestionIds.indexOf(group.id) >= 0" :group="group" :busy="pendingAction == 'question:' + group.id" :disabled="!canWrite || group.kind == 'preview'" :submitted="submittedGroupIds.indexOf(group.id) >= 0" @submit="submitAnswers" /></view>
        <view id="approvals-anchor"></view>
        <view v-for="approval in connection.snapshot?.approvals ?? []" :key="approval.id" :id="approvalNoticeAnchor(approval.id)" class="approval"><text class="approval-title">{{ approval.title }}</text><text class="approval-detail" selectable>{{ approval.detail }}</text><text class="approval-cwd">{{ approval.cwd }}</text><text v-if="handledApprovalIds.indexOf(approval.id) >= 0" class="approval-feedback">处理结果已提交</text><view v-else class="approval-actions"><view class="approval-button button-secondary inline-progress-button"><action-progress :busy="pendingAction == 'approval:decline:' + approval.id" /><text class="inline-progress-caption" style="color: #1a2135; font-size: 14px;">拒绝</text><button class="inline-progress-hitbox" :disabled="!canWrite" @click="reply(approval.id, approval.turnId, 'decline')" :aria-label="(pendingAction == 'approval:decline:' + approval.id) ? '正在提交拒绝' : '拒绝'"></button></view><view class="approval-button button-primary inline-progress-button"><action-progress :busy="pendingAction == 'approval:accept:' + approval.id" light /><text class="inline-progress-caption" style="color: #ffffff; font-size: 14px;">本次允许</text><button class="inline-progress-hitbox" :disabled="!canWrite" @click="reply(approval.id, approval.turnId, 'accept')" :aria-label="(pendingAction == 'approval:accept:' + approval.id) ? '正在提交本次允许' : '本次允许'"></button></view></view></view>
        <!-- 等待回答时由问答卡片和顶部状态提示，隐藏底部重复状态。 -->
        <view v-if="currentTaskState != 'question' && (activeTurnId.length > 0 || currentTaskState == 'running' || pendingQuestionCount > 0 || approvalCount > 0)" class="working"><task-status :state="currentTaskState" :visible="pageVisible" :detail="connection.snapshot?.activity ?? ''" /></view>
        <message-queue :messages="queuedMessages" :pending-action="pendingAction" :disabled="!canWrite" :running="activeTurnId.length > 0" @steer="steerQueuedMessage" :editable="connection.snapshot?.supportsQueueEditing == true" @cancel="cancelQueuedMessage" @edit="editQueuedMessage" />
            <view id="timeline-message-end" class="content-end"></view>
        <view id="timeline-bottom" class="bottom-space"></view>
        </view>
      </scroll-view>
      <view v-if="!atTimelineBottom || hasUnseenBelow" class="jump-latest" :class="{ 'jump-latest-glass': liquidGlass }">
        <liquid-glass-control v-if="liquidGlass" symbol="arrow.down" label="回到最新消息" @activate="resumeFollowing(true)" />
        <template v-else><app-icon name="down" :size="20" /><button class="action-hitbox" hover-class="action-pressed" aria-label="回到最新消息" @click="resumeFollowing(true)"></button></template>
      </view>
    </view>
    <view v-if="composerMenu.length > 0" class="composer-dismiss" @click="closeComposerMenu"></view>
    <view id="composer-dock" class="composer-dock" :class="{ 'composer-menu-open': composerMenu.length > 0 }">
      <goal-card :goal="connection.snapshot?.goal ?? null" :revision="connection.snapshot?.goalRevision ?? 'none'" :disabled="!canWrite || !goalHostOnline || connection.snapshot?.supportsGoalControl != true" :busy="goalBusy" :pending-action="pendingAction" :unavailable-reason="goalUnavailableReason" :open-request="goalOpenRequest" :close-request="goalCloseRequest" :reset-key="pageHostId + ':' + pageThreadId" :content-height="goalContentHeight" @operate="operateGoal" @expanded="goalExpansion" @keyboard="goalKeyboard" />
      <message-composer :instance-id="composerInstanceId" :reset-key="pageHostId + ':' + pageThreadId" :cursor="mentionCursor" :model-label="modelLabel" :service-tier="composerSettings?.serviceTier ?? ''" :layout-width="props.paneWidth"
        :active="pageVisible" :text="draft" :expanded="composerExpanded" :input-height="composerHeight" :focus="predictionFocus"
        :images="draftImages" :files="draftFiles" :plugins="draftPlugins" :mentions="draftMentions"
        :disabled="readOnly || queueEditing" :chips-disabled="!canWrite" :images-disabled="busy || imageBusy || connection.pendingCommandId.length > 0" :files-disabled="busy || connection.pendingCommandId.length > 0"
        :add-disabled="!canWrite" :primary-disabled="!primaryAvailable" :primary-pending-label="pendingAction == 'send' ? '正在发送' : pendingAction == 'stop' ? '正在停止任务' : pendingAction == 'retry:composer' ? '正在提交重试' : ''"
        :primary-icon="activeTurnId.length > 0 && draft.trim().length == 0 && draftImages.length == 0 && draftFiles.length == 0 && draftMentions.length == 0 ? 'stop' : 'send'"
        :primary-label="activeTurnId.length > 0 && draft.trim().length == 0 && draftImages.length == 0 && draftFiles.length == 0 && draftMentions.length == 0 ? '停止任务' : '发送指令'"
        :settings-disabled="!canWrite || connection.snapshot?.supportsExecutionSettings != true" :plan-enabled="planEnabled" :plan-disabled="!canWrite || settingsBusy || activeTurnId.length > 0 || connection.snapshot?.status == 'active'"
        :prediction="visiblePrediction" :placeholder="readOnly ? (activating ? '正在连接聊天…' : '连接聊天后即可发送') : '问问 Codex'"
        :max-content-height="Math.max(144, props.paneHeight - keyboardInset - 300)" :retry-files="true" :retrying-file-ids="retryingFileIds" :retry-disabled="!canWrite"
        @input="updateDraft" @focus="onComposerFocus" @blur="onDraftBlur" @linechange="onDraftLineChange" @keyboardheightchange="onKeyboardChange"
        @syncinput="syncComposerText" @submit="applyComposerEnter" @acceptprediction="acceptPrediction(false)" @primary="primaryAction" @add="openComposerMenu('add')" @settings="openComposerMenu('settings')" @toggleplan="togglePlan"
        @retryfile="retryFile" @interact="dismissGoal" @layout="updateComposerGeometry"
        @removeimage="removeImage" @previewimage="previewImage" @removefile="removeFile" @removeplugin="removePlugin" @removemention="removeThreadMention">
        <template #permissions><permissions-control :pane-left="props.paneLeft" :pane-width="props.paneWidth" :thread-id="pageThreadId" :defer-changes="!settingsRunning" :selected-mode="settingsRunning ? '' : messageChoices.permissionMode ?? ''" :disabled="!canWrite || settingsBusy" @select="selectDraftPermission" @busy="onPermissionBusy" @visibility="onPermissionVisibility" @applied="onPermissionApplied" /></template>
        <template #feedback>
          <text v-if="imageBusy" class="image-processing">正在处理附件…</text>
          <text v-if="composerExpanded && executionSettingsUnavailable" class="composer-caption">更新电脑连接服务后可选择模型和计划模式</text>
          <text v-if="composerExpanded && pendingSetting.length > 0 && composerMenu.length == 0" class="composer-caption">{{ pendingSetting }}</text>
          <text v-if="composerExpanded && settingsError.length > 0 && composerMenu.length == 0" class="composer-caption">{{ settingsError }}</text>
        </template>
      </message-composer>
    </view>
      <view v-if="composerMenu.length > 0" class="composer-options-anchor" :style="{ left: menuLeft + 'px', bottom: menuBottom + 'px' }"><composer-options :section="composerMenu" :settings="composerSettings" :models="models" :loading="settingsLoading" :busy="settingsBusy" :pending-choice="settingsBusy ? settingChoice : ''" :error="settingsError" :width="menuWidth" :height="menuHeight" :images-enabled="canWrite && !imageBusy && modelSupportsImages && connection.snapshot?.supportsImages == true && draftImages.length + draftFiles.length < 3" :files-enabled="canWrite && !imageBusy && connection.snapshot?.supportsAttachments == true && draftImages.length + draftFiles.length < 3" :settings-enabled="canWrite && settings != null && connection.snapshot?.supportsExecutionSettings == true" :plan-disabled="activeTurnId.length > 0 || connection.snapshot?.status == 'active'" :note="readOnly ? '历史浏览模式，请先继续此聊天' : '附件最多3个；不可用选项需更新或刷新电脑连接服务'" @section="changeComposerSection" @action="composerAction" @select="selectSetting" @dismiss="closeComposerMenu" @retry="loadSettings" /></view>
    <view v-if="keyboardInset == 0" class="bottom-safe-area"></view>
    <view v-if="selectedExecution != null" class="execution-overlay" @click="closeExecution"><view class="execution-sheet" @click.stop><view class="sheet-grip"></view><view class="sheet-header"><text class="sheet-title">{{ selectedExecution?.kind == 'fileChange' ? '文件更改' : '执行详情' }}</text><view class="icon-button action-frame"><app-icon name="close" :size="22" /><button class="action-hitbox" hover-class="action-pressed" aria-label="关闭执行详情" @click="closeExecution"></button></view></view><text class="sheet-caption">命令与输出</text><scroll-view direction="vertical" class="sheet-output"><text class="execution-text" selectable>{{ selectedExecution?.text ?? '' }}</text></scroll-view><text class="sheet-note">仅展示这条记录的详细内容</text><view class="sheet-actions"><view class="sheet-copy action-frame"><app-icon name="copy" :size="18" /><text class="sheet-copy-label">复制记录</text><button class="action-hitbox" hover-class="action-pressed" @click="copyText(selectedExecution?.text ?? '')" aria-label="复制记录"></button></view></view><view class="bottom-safe-area"></view></view></view>
    <view v-if="actionsVisible" class="menu-overlay" @click="closeActions"><view class="status-spacer"></view><view class="menu-top-space"></view><view class="menu-panel" @click.stop><text class="menu-caption">聊天操作</text><view class="menu-item action-frame"><app-icon name="refresh" :size="19" /><text class="menu-label">重新同步</text><button class="action-hitbox" hover-class="action-pressed" @click="refreshFromMenu" aria-label="重新同步"></button></view>
        <view class="menu-item action-frame"><app-icon name="copy" :size="19" /><text class="menu-label">复制最新回复</text><button class="action-hitbox" hover-class="action-pressed" @click="copyLatestReply" aria-label="复制最新回复"></button></view><view v-if="pendingQuestionCount > 0" class="menu-item action-frame"><text class="menu-label">回答问题（{{ pendingQuestionCount }}）</text><button class="action-hitbox" hover-class="action-pressed" @click="showQuestions" aria-label="回答问题"></button></view><view v-if="approvalCount > 0" class="menu-item action-frame"><text class="menu-label">处理审批（{{ approvalCount }}）</text><button class="action-hitbox" hover-class="action-pressed" @click="showApprovals" aria-label="处理审批"></button></view><view class="menu-item action-frame"><app-icon name="folder" :size="19" /><text class="menu-label">聊天信息</text><button class="action-hitbox" hover-class="action-pressed" @click="showConversationInfo" aria-label="聊天信息"></button></view><view v-if="activeTurnId.length > 0" class="menu-item action-frame" :style="{ opacity: (!canWrite) ? 0.45 : 1 }"><app-icon name="stop" :size="19" /><text class="menu-label">停止任务</text><button class="action-hitbox" hover-class="action-pressed" :disabled="!canWrite" @click="stopFromMenu" aria-label="停止任务"></button></view><view class="menu-item action-frame" :style="{ opacity: (!canWrite) ? 0.45 : 1 }"><view class="archive-icon"><view class="archive-lid"></view><view class="archive-slot"></view></view><text class="menu-label archive-label">归档</text><button class="action-hitbox" hover-class="action-pressed" :disabled="!canWrite" @click="archiveFromMenu" aria-label="归档聊天"></button></view><view class="menu-item action-frame" :style="{ opacity: (!canWrite) ? 0.45 : 1 }"><view class="delete-icon"><view class="delete-handle"></view><view class="delete-lid"></view><view class="delete-bin"><view class="delete-line"></view><view class="delete-line"></view></view></view><text class="menu-label archive-label">永久删除</text><button class="action-hitbox" hover-class="action-pressed" :disabled="!canWrite" @click="deleteFromMenu" aria-label="永久删除聊天"></button></view><view class="menu-item action-frame"><app-icon name="close" :size="19" /><text class="menu-label">取消</text><button class="action-hitbox" hover-class="action-pressed" @click="closeActions" aria-label="取消"></button></view></view></view>
    <delete-confirmation v-if="deleteFinalVisible" :content="deleteFinalContent" @confirm="answerDeleteFinal(true)" @cancel="answerDeleteFinal(false)" />
    <file-change-sheet v-if="selectedFileReport != null" :host-id="pageHostId" :thread-id="pageThreadId" :report="selectedFileReport!" :file-id="selectedChangedFileId" :connected="connection.connected && !showingPreview" @close="closeFileReport" />
    <annotation-sheet v-if="selectedAnnotationId.length > 0" :items="selectedAnnotations" @close="closeAnnotations" />
    <plan-sheet v-if="selectedPlanId.length > 0" :source="selectedPlanSource" @close="closePlan" />
    <thread-mention-picker v-if="mentionOpen && pageVisible && connection.snapshot?.supportsThreadMentions == true" :host-id="pageHostId" :thread-id="pageThreadId" :scope-id="pageThreadId" :initial-query="mentionTrigger?.query ?? ''" :mentions="draftMentions" @confirm="selectThreadMentions" @close="closeThreadMentions()" />
    <plugin-picker v-if="pluginOpen && pageVisible" :host-id="pageHostId" :thread-id="pageThreadId" project-id="" :plugins="draftPlugins" @confirm="selectPlugins" @close="pluginOpen = false" />
  </view>
</template>


<script setup lang="uts">
import { computed, ref, watch, nextTick, onMounted, onUnmounted } from 'vue'
import ThreadMentionPicker from '../../components/thread-mention-picker/thread-mention-picker.uvue'
import { SelectedThreadMention, ThreadMentionTrigger, findThreadMentionTrigger, replaceThreadMentionTrigger, threadMentionMessageText } from '../../services/thread-mentions.uts'
import { readDraftThreadMentions, saveDraftThreadMentions } from '../../services/composer.uts'
import PluginPicker from '../../components/plugin-picker/plugin-picker.uvue'
import type { SelectedPlugin } from '../../services/plugins.uts'
import { pluginMessageText } from '../../services/plugins.uts'
import { readDraftPlugins, saveDraftPlugins } from '../../services/composer.uts'
import MessageQueue from '../../components/message-queue/message-queue.uvue'
import { QueuedMessage } from '../../services/message-queue.uts'
import { useManualReconnect } from '../../services/manual-reconnect.uts'
import { messageSendingPreferences } from '../../services/message-sending-preferences.uts'
import { QueueEditDraft, QueueEditPlugin, isQueueEditing, beginQueueEdit, finishQueueEdit, restoreQueuedDraft } from '../../services/queue-edit.uts'
import { readDraft, saveDraft, readDraftImages, saveDraftImages, DraftImage, readDraftFiles, saveDraftFiles, DraftFile, rememberSubmission, settleSubmission } from '../../services/composer.uts'
import { shouldExpandComposer, composerInputHeight } from '../../services/composer-layout.uts'
import { prepareImage, MAX_COMPOSER_IMAGES } from '../../services/images.uts'
import { bindImagePaste } from '../../services/image-paste.uts'
import { bridge, connection, ChatMessage, Computer, ThreadSummary, Question, QuestionPreview, QuestionPreviewItem, QuestionAnswer, QuestionGroup, Approval, PendingPlan, conversationTaskState, computerIcon } from '../../services/bridge.uts'
import { removeArchivedThread } from '../../services/thread-list.uts'
import { clearFileReportCache } from '../../services/file-report-cache.uts'
import { submissionTasks, supportsSubmissionTasks } from '../../services/submission-task-state.uts'
import { newSubmissionId, submitTask, awaitSubmissionResult } from '../../services/submission-tasks.uts'
import { queueArchiveSuccessNotice, consumeArchiveSuccessNotice } from '../../services/page-notices.uts'
import { deletionTasks, deletionTask, deletedThread, startDeletion, checkDeletion } from '../../services/delete-tasks.uts'
import type { PendingCommand } from '../../services/bridge.uts'
import { conversationOpeningTitle, conversationDisplayTitle, conversationProjectName } from '../../services/conversation-opening.uts'
import { TimelineEntry, executionTimeline, reportTimeline, executionTitle as executionRecordTitle, executionGroupExpanded, retainExpandedExecutions, toggleExecutionGroup } from '../../services/executions.uts'
import { failureTimeline, retryTarget, latestFailureTurnId } from '../../services/turn-failure.uts'
import { HistoryPage, conversationWithHistory, retainHistoryWindow } from '../../services/history.uts'
import type { Conversation } from '../../services/bridge.uts'
import { MessageAnnotation, MessagePresentation, annotationPresentationsForTimeline } from '../../services/annotations.uts'
import { presentConversationMessages } from '../../services/message-presentations.uts'
import { FileReport } from '../../services/file-reports.uts'
import FileChangeSummary from '../../components/file-change-summary/file-change-summary.uvue'
import FileChangeSheet from '../../components/file-change-sheet/file-change-sheet.uvue'
import DeleteConfirmation from '../../components/delete-confirmation/delete-confirmation.uvue'
import AnnotationSheet from '../../components/annotation-sheet/annotation-sheet.uvue'
import QuestionCard from '../../components/question-card/question-card.uvue'
import MarkdownBody from '../../components/markdown-body/markdown-body.uvue'
import PlanPreview from '../../components/plan-preview/plan-preview.uvue'
import PlanSheet from '../../components/plan-sheet/plan-sheet.uvue'
import MessageImages from '../../components/message-images/message-images.uvue'
import PermissionsControl from '../../components/permissions-control/permissions-control.uvue'
import { taskNotifications, pendingTaskNotice, showTaskNoticeThread, hideTaskNoticeThread } from '../../services/task-notifications.uts'
import { taskNoticeAnchor } from '../../services/task-notification-state.uts'
import AppIcon from '../../components/app-icon/app-icon.uvue'
import CacheActivityIcon from '../cache-activity-icon/cache-activity-icon.uvue'
import MessageComposer from '../message-composer/message-composer.uvue'
import LiquidGlassControl from '../liquid-glass-control/liquid-glass-control.uvue'
import { useLiquidGlass } from '../../services/liquid-glass.uts'
import TaskStatus from '../../components/task-status/task-status.uvue'
import LoadingSkeleton from '../../components/loading-skeleton/loading-skeleton.uvue'
import GoalCard from '../../components/goal-card/goal-card.uvue'
import { ThreadGoal } from '../../services/goals.uts'
import ComposerOptions from '../../components/composer-options/composer-options.uvue'
import { composerMenuPosition } from '../../services/composer-menu-position.uts'
import { readMessageChoices, messageChoicesParams, saveMessageChoices, hasMessageChoices, messageChoicesRevision, chooseMessageSetting, settingsWithMessageChoices, consumeRealtimeChoice, MessageChoices } from '../../services/message-choices.uts'
import { submissionHasMessageChoices } from '../../services/composer.uts'
import { ExecutionSettings, ModelOption, SettingsResponse, effortLabel, shortModelLabel, mergeSettingsSnapshot, mergeSettingsRead, resolveSettingsEffort } from '../../services/execution-settings.uts'
import { readFileBase64, validateFile, fileSizeLabel, FILE_CHUNK_BYTES } from '../../services/files.uts'
import type { WorkspaceTarget } from '../../services/workspace-layout.uts'
const liquidGlass = useLiquidGlass()
const props = withDefaults(defineProps<{ target: WorkspaceTarget, active: boolean, paneWidth: number, paneHeight: number, embedded?: boolean, paneLeft?: number }>(), { embedded: false, paneLeft: 0 })
// 仅宽屏网页采用桌面样式，无耗时的过程仍保留可展开箭头。
const showProcessDurationOnly = computed((): boolean => {
  // #ifdef WEB
  return props.embedded == true
  // #endif
  // #ifndef WEB
  return false
  // #endif
})
const emit = defineEmits<{ close: [], removed: [kind: string] }>()
// 输入测量和粘贴按面板实例隔离，标识不包含电脑或聊天信息。
const composerInstanceId = 'composer-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2)
const paneShowCallbacks = [] as (() => void)[]
const paneHideCallbacks = [] as (() => void)[]
const paneResizeCallbacks = [] as (() => void)[]
function onPaneShow(callback: () => void) { paneShowCallbacks.push(callback) }
function onPaneHide(callback: () => void) { paneHideCallbacks.push(callback) }
function onPaneResize(callback: () => void) { paneResizeCallbacks.push(callback) }
// 操作错误仅属于当前页面，公共连接和会话读取错误分别展示。
const operationError = ref('')
const detailError = computed((): string => operationError.value.length > 0 ? operationError.value : connection.conversationError.length > 0 ? connection.conversationError : connection.error)
const pageHostId = ref(props.target.hostId)
const pageThreadId = ref(props.target.threadId)
const listTitle = ref(props.target.title)
const listProjectName = ref(props.target.projectName)
const predictionText = ref('')
const predictionFocus = ref(false)
const inputFocused = ref(false)
const permissionMenuOpen = ref(false)
const predictionHeight = ref(24)
let composerBlurTimer = 0
let composerMeasureRevision = 0
let composerAnimationTimer = 0
let composerAnimationRevision = 0
let composerKeyboardVisible = false
let predictionTimer = 0
let predictionExpiryTimer = 0
let predictionRevision = 0
let predictionDeadline = 0
const draft = computed((): string => readDraft(pageHostId.value, pageThreadId.value))
const queueEditing = computed((): boolean => isQueueEditing(pageHostId.value, pageThreadId.value))
const draftImages = computed((): DraftImage[] => readDraftImages(pageHostId.value, pageThreadId.value))
const draftPlugins = computed((): SelectedPlugin[] => readDraftPlugins(pageHostId.value, pageThreadId.value))
const pluginOpen = ref(false)
const draftMentions = computed((): SelectedThreadMention[] => readDraftThreadMentions(pageHostId.value, pageThreadId.value))
const mentionOpen = ref(false), mentionCursor = ref(-1), mentionTrigger = ref<ThreadMentionTrigger | null>(null)
let mentionDraftRevision = 0, mentionSourceRevision = 0, mentionContext = '', mentionSelection = ''
// 草稿变更即使最后恢复相同正文，也不能应用旧面板的触发位置。
watch((): string => draft.value, () => { mentionDraftRevision++ }, { flush: 'sync' })
const imageBusy = ref(false)
const draftFiles = computed((): DraftFile[] => readDraftFiles(pageHostId.value, pageThreadId.value))
const filesReady = computed((): boolean => draftFiles.value.every((file: DraftFile): boolean => file.status == 'ready'))
const composerMenu = ref('')
const settings = ref<ExecutionSettings | null>(null)
const models = ref<ModelOption[]>([])
const settingsLoading = ref(false)
const settingsBusy = ref(false)
const settingChoice = ref('')
const settingsError = ref('')
const pendingSetting = ref('')
const menuHeight = ref(280)
const menuLeft = ref(14), menuBottom = ref(60)
const menuWidth = ref(Math.min(330, props.paneWidth - 28))
let settingsRequest = 0
let settingsRetryTimer = 0
let settingsRetryCount = 0
// 设置快照每次变化都推进代次，读写回执不能覆盖较新的桌面模式。
let settingsSnapshotRevision = 0
const hiddenPlanId = ref('')
const planFeedback = ref('')
const planEditing = ref(false)
const pendingPlan = computed((): PendingPlan | null => connection.hostId == pageHostId.value && connection.snapshot?.threadId == pageThreadId.value && connection.snapshot?.readOnly != true ? connection.snapshot?.pendingPlan ?? null : null)
// 切换会话或计划时清空旧反馈。
watch((): string => pageHostId.value + ':' + pageThreadId.value + ':' + (pendingPlan.value?.id ?? ''), () => { planFeedback.value = ''; hiddenPlanId.value = ''; planEditing.value = false })
// 运行中显示电脑确认值；空闲显示本条消息的本地选择，状态变化不触发写入。
const settingsRunning = computed((): boolean => connection.snapshot?.threadId == pageThreadId.value && ((connection.snapshot?.activeTurnId ?? '').length > 0 || connection.snapshot?.status == 'active'))
const messageChoices = computed((): MessageChoices => readMessageChoices(pageHostId.value, pageThreadId.value))
const composerSettings = computed((): ExecutionSettings | null => settingsRunning.value ? settings.value : settingsWithMessageChoices(settings.value, messageChoices.value))
const planEnabled = computed((): boolean => composerSettings.value?.mode == 'plan')
// 只有当前会话已同步后才能判断能力，初次加载或切换会话时不显示升级提示。
const executionSettingsUnavailable = computed((): boolean => connection.snapshot != null && connection.snapshot?.threadId == pageThreadId.value && connection.snapshot?.supportsExecutionSettings != true)
const modelLabel = computed((): string => {
  if (settingsBusy.value) return '正在同步…'
  if (!connection.connected) return '等待连接'
  if (connection.snapshot?.threadId != pageThreadId.value) return '正在加载…'
  if (connection.snapshot?.readOnly == true) return '历史浏览'
  if (settings.value == null) return '跟随电脑端'
  const selected = composerSettings.value ?? settings.value!
  const model = models.value.find((item: ModelOption): boolean => item.id == selected.model)
  return shortModelLabel(model?.label ?? selected.model) + ' ' + effortLabel(selected.effort)
})
const modelSupportsImages = computed((): boolean => models.value.find((item: ModelOption): boolean => item.id == composerSettings.value?.model)?.supportsImages != false)
const busy = ref(false)
const goalBusy = ref(false)
// 删除和归档的页面归属在监听安装前固定。
const removalSubmissionId = ref('')
const removalReturnStarted = ref(false)
const goalExpanded = ref(false)
const goalOpenRequest = ref(0)
const goalCloseRequest = ref(0)
const pageVisible = ref(false)
// 清理引用选择时不恢复输入焦点，适用于离页和切换会话。
function resetThreadMention() { mentionOpen.value = false; mentionTrigger.value = null }
// 只在会话页可见时抑制本聊天通知，页面栈中隐藏的旧窗口不参与判断。
let noticeViewRevision = 0
onPaneShow(() => { pageVisible.value = true; noticeViewRevision = showTaskNoticeThread(pageHostId.value, pageThreadId.value) })
onPaneHide(() => { pageVisible.value = false; hideTaskNoticeThread(noticeViewRevision); pluginOpen.value = false; resetThreadMention() })
onUnmounted(() => { hideTaskNoticeThread(noticeViewRevision) })
watch((): string => [connection.hostId, pageHostId.value, pageThreadId.value, connection.activeThreadId].join(':'), () => { pluginOpen.value = false; resetThreadMention() })
const pendingAction = ref('')
const reconnecting = ref(false)
const reconnect = useManualReconnect((pending: boolean) => { reconnecting.value = pending })
const refreshSource = ref('')
let refreshRevision = 0
const activating = ref(false)
const activationSource = ref('')
const retryingFileIds = ref<string[]>([])
let activationRequest = 0
const actionsVisible = ref(false)
const following = ref(true)
const atTimelineBottom = ref(true)
// 几何位置、跟随意图和未读增量分别维护；只有向下箭头能恢复跟随。
const hasUnseenBelow = ref(false)
const readingFloor = ref(0)
const scrollTarget = ref('')
const selectedFileReport = ref<FileReport | null>(null)
const selectedChangedFileId = ref('')
// 文件面板独立于聊天滚动；关闭后保持原报告阅读位置。
// 用户消息去除插件和聊天引用的协议标记后再展示。
function userMessageText(text: string): string { return threadMentionMessageText(pluginMessageText(text)) }
let timelineUserScrolling = false

function pauseFollowing() { following.value = false; timelineUserScrolling = false; scrollTarget.value = '' }

function openFileReport(report: FileReport, fileId: string) { pauseFollowing(); uni.hideKeyboard(); selectedFileReport.value = report; selectedChangedFileId.value = fileId }
function closeFileReport() { selectedFileReport.value = null; selectedChangedFileId.value = '' }
const selectedExecutionId = ref('')
const selectedAnnotationId = ref('')
const historyPage = ref<HistoryPage | null>(null)
const loadingHistory = ref(false)
const historyError = ref('')
const historyScrollTop = ref(0)
let historyRequest = 0
let historyGesture = 0
let lastHistoryGesture = -1
let historyTopTimer = 0
let historyFollowRevision = 0
// 当前面板只显示本次订阅的数据，配对和会话变化立即隔离旧正文。
const liveConversation = computed((): Conversation | null => props.target.cacheNamespace == (connection.cacheNamespace ?? '') && connection.hostId == pageHostId.value && connection.snapshot?.threadId == pageThreadId.value ? connection.snapshot : null)
const previewConversation = computed((): Conversation | null => props.target.cacheNamespace == (connection.cacheNamespace ?? '') && connection.hostId == pageHostId.value && connection.preview?.threadId == pageThreadId.value ? connection.preview : null)
const goalHostOnline = computed((): boolean => connection.computers.some((computer: Computer): boolean => computer.id == pageHostId.value && computer.online))
// 守护进程预览只供展示，图片和写操作等待当前聊天的实时订阅确认。
const subscriptionReady = computed((): boolean => connection.connected && connection.hostId == pageHostId.value && connection.activeThreadId == pageThreadId.value && connection.subscribedHostId == pageHostId.value && connection.subscribedThreadId == pageThreadId.value && liveConversation.value != null)
const imagesReady = computed((): boolean => pageVisible.value && subscriptionReady.value)
const showingPreview = computed((): boolean => liveConversation.value == null && previewConversation.value != null)
const detailSyncing = computed((): boolean => connection.connected && goalHostOnline.value && !subscriptionReady.value && detailError.value.length == 0)
const syncHint = computed((): string => detailError.value.length > 0 ? '聊天同步失败，可重新同步' : !connection.connected || !goalHostOnline.value ? '连接恢复后同步聊天' : '正在同步聊天')
const displayConversation = computed(() => conversationWithHistory(liveConversation.value ?? previewConversation.value, historyPage.value))
const selectedExecution = computed((): ChatMessage | null => displayConversation.value?.messages.find((message: ChatMessage): boolean => message.id == selectedExecutionId.value && message.role != 'user' && message.role != 'assistant') ?? null)
const expandedReportIds = ref<string[]>([])
const timeline = computed((): TimelineEntry[] => failureTimeline(displayConversation.value, reportTimeline(displayConversation.value, expandedReportIds.value)))
const timelineBoundary = ref('')
const timelineFilled = ref(false)
let timelineFillTimer = 0
let timelineFillStarted = false
let timelinePainted = false
let timelinePaintFrame = 0
let timelinePaintRevision = 0

// 用视口和正文体量估算尾部首批。长 Markdown 优先少挂载，短消息仍能填满首屏。
function firstScreenTimelineStart(entries: TimelineEntry[], width: number, height: number): number {
  const viewport = Math.max(220, height - 145)
  const charsPerLine = Math.max(16, Math.floor((width - 64) / 11))
  let estimated = 0
  let index = entries.length
  const minimum = Math.max(0, entries.length - 8)
  while (index > minimum && estimated < viewport) {
    const entry = entries[--index]
    const lines = entry.text.split('\n').length + Math.floor(entry.text.length / charsPerLine)
    estimated += Math.max(44, 20 * lines + 12) + ((entry.imageCount ?? 0) > 0 ? 160 : 0)
  }
  return index
}

const timelineStart = computed((): number => {
  if (timelineFilled.value) return 0
  const entries = timeline.value
  const boundary = timelineBoundary.value
  const start = boundary.length > 0 ? entries.findIndex((entry: TimelineEntry): boolean => entry.id == boundary) : -1
  return start >= 0 ? start : firstScreenTimelineStart(entries, props.paneWidth, props.paneHeight)
})
const visibleTimeline = computed((): TimelineEntry[] => timeline.value.slice(timelineStart.value))
const messagePresentations = computed((): MessagePresentation[] => {
  const messages = displayConversation.value?.messages ?? [] as ChatMessage[]
  if (timelineStart.value == 0) return presentConversationMessages(messages)
  const ids = new Set<string>()
  const turns = new Set<string>()
  visibleTimeline.value.forEach((entry: TimelineEntry) => { ids.add(entry.id); if (entry.turnId.length > 0) turns.add(entry.turnId) })
  // 仍检查可见回复同轮的提问，防止隐藏在首批之外的注释来源丢失。
  return presentConversationMessages(messages.filter((message: ChatMessage): boolean => ids.has(message.id) || (message.role == 'user' && turns.has(message.turnId))))
})
// 仅构造已挂载消息的 Markdown 与展示附加信息。完整时间线仍供历史和通知定位使用。
const renderedTimeline = computed((): TimelineEntry[] => {
  const entries = visibleTimeline.value
  const presentations = annotationPresentationsForTimeline(messagePresentations.value, entries.map((entry: TimelineEntry): string => entry.id))
  const byId = new Map<string, MessagePresentation>()
  presentations.forEach((message: MessagePresentation) => { byId.set(message.messageId, message) })
  return entries.map((entry: TimelineEntry): TimelineEntry => {
    const presentation = byId.get(entry.id)
    return presentation == null ? entry : { ...entry, text: presentation.text, annotations: presentation.annotations, attachments: presentation.attachments } as TimelineEntry
  })
})
const selectedAnnotations = computed((): MessageAnnotation[] => renderedTimeline.value.find((entry: TimelineEntry): boolean => entry.id == selectedAnnotationId.value)?.annotations ?? [] as MessageAnnotation[])
const expandedExecutionIds = ref<string[]>([])
const pendingPlanOutsideTimeline = computed((): boolean => pendingPlan.value != null && !visibleTimeline.value.some((entry: TimelineEntry): boolean => entry.id == pendingPlan.value!.id))
const selectedPlanId = ref('')
const selectedPlanSource = ref('')
// 待确认方案使用桌面给出的完整正文，避免消息窗口中的截取影响详情阅读。
function planSource(id: string, fallback: string): string {
  if (pendingPlan.value?.id == id) return pendingPlan.value!.text
  return displayConversation.value?.messages.find((message: ChatMessage): boolean => message.id == id)?.text ?? fallback
}
function closeActions() { actionsVisible.value = false }

// 自定义返回入口先收起键盘，系统返回仍保留框架行为及按会话保存的草稿。
function closeComposerMenu() { composerMenu.value = '' }

function dismissGoal() { if (!goalBusy.value && goalExpanded.value) { goalCloseRequest.value++; goalExpanded.value = false } }

// 详情位于页面根部，独立滚动且不改变聊天草稿和原时间线位置。
function openPlan(id: string, source: string) {
  closeActions(); closeComposerMenu(); dismissGoal(); uni.hideKeyboard(); pauseFollowing()
  selectedPlanSource.value = planSource(id, source); selectedPlanId.value = id
}
function closePlan() { selectedPlanId.value = ''; selectedPlanSource.value = '' }
onPaneHide(() => { closePlan() })
onUnmounted(() => { closePlan() })
watch((): string => [pageHostId.value, pageThreadId.value, connection.hostId, connection.activeThreadId].join(':'), () => { closePlan() })
const expandedQuestionIds = ref<string[]>([])
const handledApprovalIds = ref<string[]>([])
const submittedGroupIds = ref<string[]>([])
const draftHeight = ref(64)
const keyboardInset = ref(0)
const goalViewportHeight = ref(uni.getWindowInfo().windowHeight)
// 用户气泡保留左侧层级留白，正文使用两侧各 16px 以内的宽度。
const messageWindowWidth = ref(props.paneWidth)
const userBubbleWidth = computed((): number => Math.max(120, messageWindowWidth.value - 80))
// 长文件名单行显示时也要及时约束气泡，适配横竖屏与浏览器视口切换。
onPaneResize(() => { messageWindowWidth.value = props.paneWidth })
let baseWindowHeight = 0
let lastScrollTop = 0
let layoutUntil = 0
let touchingTimeline = false
let pageAlive = true
const activeTurnId = computed((): string => liveConversation.value?.activeTurnId ?? '')
const queuedMessages = computed((): QueuedMessage[] => connection.hostId == pageHostId.value && connection.snapshot?.threadId == pageThreadId.value ? connection.snapshot?.queuedMessages ?? [] as QueuedMessage[] : [] as QueuedMessage[])
const approvalCount = computed((): number => liveConversation.value?.approvals.length ?? 0)
// 展示副本不拥有桌面的题组和轮次编号，只能渲染锁定卡片。
function previewQuestionGroups(): QuestionGroup[] {
  return (previewConversation.value?.questionPreviews ?? []).map((group: QuestionPreview): QuestionGroup => ({
    id: group.id, kind: 'preview', turnId: '', state: 'pending',
    questions: group.questions.map((item: QuestionPreviewItem): Question => ({ ...item, answer: '' } as Question))
  } as QuestionGroup))
}
// 实时结果完整接管展示；已回答、失效或被移除的问题不能由旧缓存复活。
const pendingQuestionGroups = computed((): QuestionGroup[] => {
  const live = liveConversation.value
  return live != null ? live.questionGroups.filter((group: QuestionGroup): boolean => group.state == 'pending') : previewQuestionGroups()
})
const pendingQuestionCount = computed((): number => pendingQuestionGroups.value.length)
const currentTaskState = computed((): string => conversationTaskState(connection.snapshot, connection.connected && connection.computers.some((computer: Computer): boolean => computer.id == pageHostId.value && computer.online)))
const hostName = computed((): string => connection.computers.find((computer: Computer): boolean => computer.id == pageHostId.value)?.label ?? '电脑')
// 与列表页共用图标规则，始终读取本聊天所属电脑的配置。
const hostIcon = computed((): string => computerIcon(connection.computers.find((computer: Computer): boolean => computer.id == pageHostId.value) ?? null))
// 与标题共用当前电脑和会话的身份限制，加载期间不显示其他会话的项目。
const projectName = computed((): string => conversationProjectName(listProjectName.value, connection.hostId == pageHostId.value && connection.snapshot?.threadId == pageThreadId.value ? connection.snapshot?.cwd ?? '' : previewConversation.value?.cwd ?? ''))
// 后台历史只用于浏览，写操作须有原桌面的实时所有者和快照。
const readOnly = computed((): boolean => connection.snapshot?.readOnly == true)
const goalContentHeight = computed((): number => Math.max(60, Math.min(200, goalViewportHeight.value - keyboardInset.value - 360)))
const goalUnavailableReason = computed((): string => !connection.connected || !goalHostOnline.value ? '电脑连接已断开，恢复连接后可操作目标。' : readOnly.value ? '历史浏览期间只能查看目标。' : connection.snapshot?.supportsGoalControl != true ? '更新 Windows 电脑连接服务后可操作目标。' : connection.pendingCommandId.length > 0 && !goalBusy.value ? '操作正在提交，请稍候。' : '')
const conversationConnectionHint = computed((): string => {
  if (activating.value) return '正在同步聊天…'
  if (connection.pendingCommandId.length > 0) return '操作正在提交，请稍后从右上角菜单重新同步。'
  if (!connection.connected) return '连接恢复后可从右上角菜单重新同步，历史内容和草稿已保留。'
  return '当前为历史浏览；需要继续操作时，请从右上角菜单重新同步。'
})
const openingTitle = computed((): string => conversationOpeningTitle(connection.snapshot != null, detailError.value, connection.connected))
// 仅使用当前电脑和会话的快照名称；加载、断线或空名称均保留列表标题。
const displayTitle = computed((): string => conversationDisplayTitle(listTitle.value, connection.hostId == pageHostId.value && connection.snapshot?.threadId == pageThreadId.value ? connection.snapshot?.title ?? '' : previewConversation.value?.title ?? '', openingTitle.value))
const submittedRetryKey = ref('')
const displayFailureTurnId = computed((): string => latestFailureTurnId(displayConversation.value))
const pendingRetryCommand = computed((): string => connection.pendingCommands.find((entry: PendingCommand): boolean => entry.hostId == pageHostId.value && entry.threadId == pageThreadId.value && entry.method == 'turn.retry')?.id ?? '')
const retryTurnId = computed((): string => retryTarget(liveConversation.value))
const canWrite = computed((): boolean => !readOnly.value && !activating.value && subscriptionReady.value && goalHostOnline.value && !busy.value && connection.pendingCommandId.length == 0)

function isCurrentPage(): boolean { return props.target.cacheNamespace == (connection.cacheNamespace ?? '') && pageAlive && connection.hostId == pageHostId.value && connection.activeThreadId == pageThreadId.value }

function isReadingPage(): boolean { return isCurrentPage() }

function entryAnchor(entry: TimelineEntry): string { return 'message-' + entry.id.split(':').join('-') }
type ReadingAnchor = { id: string, offset: number }
type ReadingPosition = { anchors: ReadingAnchor[], top: number, gesture: number, height: number, bottom: number }
let readingPosition: ReadingPosition | null = null
let pendingReadingPosition: ReadingPosition | null = null
let readingCorrectionRevision = 0
let readingCorrectionPending = false
// 锚点定位可能先于 scroll 回调完成，保位必须读取容器当前距离，不能只信任上次事件。
function timelineScrollPosition(): number { return (uni.getElementById('conversation-timeline') as UniScrollViewElement | null)?.scrollTop ?? lastScrollTop }
// 以消息编号和视口偏移保存后续候选；首条被移除时顺延，全部失效则保留滚动距离。
function captureReadingPosition(entries: TimelineEntry[] = visibleTimeline.value): ReadingPosition | null {
  const viewport = uni.getElementById('conversation-timeline')?.getBoundingClientRect()
  if (viewport == null || viewport.height <= 0) return null
  const anchors = [] as ReadingAnchor[]
  let visible = false
  entries.forEach((entry: TimelineEntry) => {
    const rect = uni.getElementById(entryAnchor(entry))?.getBoundingClientRect()
    if (rect == null) return
    if (rect.bottom > viewport.top) visible = true
    if (visible) anchors.push({ id: entryAnchor(entry), offset: rect.top - viewport.top })
  })
  const bottom = uni.getElementById('timeline-message-end')?.getBoundingClientRect()
  return { anchors, top: timelineScrollPosition(), gesture: historyGesture, height: viewport.height, bottom: bottom == null ? 0 : bottom.bottom - viewport.top }
}
function rememberReadingPosition() { if (!readingCorrectionPending && !touchingTimeline) readingPosition = captureReadingPosition() }
function cancelReadingCorrection() { readingCorrectionRevision++; readingCorrectionPending = false; pendingReadingPosition = null; readingPosition = null }
// 普通布局测量只管理按钮；真实手势到达底部才恢复跟随，后台同步不会自动解锁。
function measureTimelinePosition(userScroll: boolean = false): boolean {
  const viewport = uni.getElementById('conversation-timeline')?.getBoundingClientRect()
  const bottom = uni.getElementById('timeline-message-end')?.getBoundingClientRect() ?? uni.getElementById('timeline-bottom')?.getBoundingClientRect()
  if (viewport == null || bottom == null || viewport.height <= 0) return false
  atTimelineBottom.value = bottom.bottom <= viewport.bottom + 36
  if (userScroll && bottom.bottom <= viewport.bottom + 2) hasUnseenBelow.value = false
  const scrollBottom = uni.getElementById('timeline-bottom')?.getBoundingClientRect() ?? bottom
  return userScroll && timelineUserScrolling && !touchingTimeline && !readingCorrectionPending && scrollBottom.bottom <= viewport.bottom + 2
}

// 预测只在当前实时会话的空草稿中展示，任何身份、轮次或连接变化立即失效。
const predictionAllowed = computed((): boolean => pageVisible.value && canWrite.value && goalHostOnline.value && connection.snapshot?.supportsComposerPrediction == true && (connection.snapshot?.predictionTurnId ?? '').length > 0 && activeTurnId.value.length == 0 && currentTaskState.value != 'running' && draft.value.length == 0 && draftImages.value.length == 0 && draftFiles.value.length == 0 && draftPlugins.value.length == 0 && draftMentions.value.length == 0 && !mentionOpen.value && pendingQuestionCount.value == 0 && approvalCount.value == 0)
const visiblePrediction = computed((): string => predictionAllowed.value ? predictionText.value : '')
function resetPrediction() { predictionRevision++; clearTimeout(predictionTimer); clearTimeout(predictionExpiryTimer); predictionText.value = ''; predictionDeadline = 0 }
// 按完成时间串行轮询；旧页面和旧轮次的迟到回执不会写回当前输入框。
function pollPrediction(revision: number) {
  if (!pageAlive || !predictionAllowed.value || revision != predictionRevision) return
  const threadId = pageThreadId.value
  const turnId = connection.snapshot?.predictionTurnId ?? ''
  bridge.request('thread.prediction.read', { threadId }).then((result: UTSJSONObject) => {
    if (!pageAlive || revision != predictionRevision || !predictionAllowed.value) return
    const prediction = result['prediction'] as UTSJSONObject | null
    predictionText.value = prediction?.getString('threadId') == threadId && prediction?.getString('sourceTurnId') == turnId ? prediction?.getString('text') ?? '' : ''
    predictionDeadline = Date.now() + 5000
    clearTimeout(predictionExpiryTimer)
    predictionExpiryTimer = setTimeout(() => { if (revision == predictionRevision) predictionText.value = '' }, 5000)
    predictionTimer = setTimeout(() => { if (revision == predictionRevision) pollPrediction(revision) }, 2500)
  }, (_: Error) => {
    if (!pageAlive || revision != predictionRevision) return
    predictionText.value = ''
    predictionTimer = setTimeout(() => { pollPrediction(revision) }, 5000)
  })
}
watch((): string => pageHostId.value + ':' + pageThreadId.value + ':' + connection.epoch + ':' + connection.subscriptionRevision + ':' + (connection.snapshot?.predictionTurnId ?? '') + ':' + predictionAllowed.value, () => { resetPrediction(); if (predictionAllowed.value) pollPrediction(predictionRevision) }, { flush: 'sync' })
// 采纳占位预测时只写入空草稿，保留原始空格和换行。
function acceptPrediction(focus: boolean = true) {
  if (!predictionAllowed.value || visiblePrediction.value.length == 0 || Date.now() > predictionDeadline) { resetPrediction(); return }
  const text = visiblePrediction.value
  resetPrediction()
  saveDraft(pageHostId.value, pageThreadId.value, text)
  if (focus) nextTick(() => { predictionFocus.value = true })
}
onUnmounted(() => { resetPrediction() })


function notify(message: string) { uni.showToast({ title: message, icon: 'none' }) }
// 原页面卸载后仍结算提交记录，但异步回执不再修改首页提示或重新同步。
function showActions() { dismissGoal(); closeComposerMenu(); actionsVisible.value = !actionsVisible.value; uni.hideKeyboard() }
function refresh() { operationError.value = '';  if (!connection.connected) bridge.resume(); else if (connection.activeThreadId.length > 0) bridge.watch(connection.activeThreadId) }
// 只有明确同步才加载桌面聊天；重复点击和迟到回执不能影响新的页面。
function retryDesktopOpen() {
  if (!isCurrentPage() || !pageVisible.value || activating.value || !connection.connected || !goalHostOnline.value || connection.pendingCommandId.length > 0) return
  const request = ++activationRequest
  activating.value = true; activationSource.value = 'desktop'; operationError.value = ''
  bridge.openThread(pageThreadId.value).then((_: UTSJSONObject) => {
    if (request != activationRequest || !isCurrentPage()) return
    activating.value = false; activationSource.value = ''
  }, (error: Error) => {
    if (request != activationRequest || !isCurrentPage()) return
    activating.value = false; activationSource.value = ''; operationError.value = error.message
  })
}
// 只标记用户点击的同步入口，回执交给现有会话订阅处理。
async function refreshButton(source: string) {
  if (refreshSource.value.length > 0) return
  if (!connection.connected) {
    refreshSource.value = source; reconnect()
    if (!reconnecting.value) refreshSource.value = ''
    return
  }
  const threadId = pageThreadId.value
  if (!isCurrentPage() || bridge.syncingThread == threadId) return
  const revision = ++refreshRevision
  refreshSource.value = source; operationError.value = ''
  try { await bridge.watch(threadId) } finally { if (revision == refreshRevision) refreshSource.value = '' }
}
watch((): string => [connection.hostId, connection.activeThreadId].join(':'), () => { refreshRevision++; refreshSource.value = '' })
watch((): boolean => reconnecting.value, (pending: boolean) => { if (!pending) refreshSource.value = '' })
// 菜单同步是显式桌面加载入口；断线恢复不排队重放导航意图。
function refreshFromMenu() {
  closeActions()
  if (!connection.connected) { bridge.resume(); notify('正在恢复连接，连接后请再次重新同步'); return }
  if (!goalHostOnline.value) { notify('电脑离线，请待电脑在线后重新同步'); return }
  if (connection.pendingCommandId.length > 0) { notify('操作正在提交，请稍后重新同步'); return }
  retryDesktopOpen()
}
// 取消只收起编辑区，重新进入时保留尚未发送的意见。
function editPlan() { if (!busy.value && canWrite.value) planEditing.value = true }
function cancelPlanFeedback() { if (!busy.value) planEditing.value = false }
function hidePlan() { hiddenPlanId.value = pendingPlan.value?.id ?? '' }
// 使用幂等写入通道；未知结果由命令状态核对，不自动重发。
function replyPlan(action: string) {
  if (!canWrite.value || busy.value || pendingPlan.value == null) return
  if (action != 'implement' && action != 'feedback') return
  if (action == 'feedback' && planFeedback.value.trim().length == 0) return
  const planId = pendingPlan.value!.id
  const hostId = pageHostId.value
  const threadId = pageThreadId.value
  busy.value = true; pendingAction.value = 'plan:' + action; operationError.value = ''
  bridge.request('turn.send', { threadId, planId, planAction: action, text: planFeedback.value.trim() }, true).then((_: UTSJSONObject) => {
    busy.value = false; pendingAction.value = ''
    if (isCurrentPage() && pageHostId.value == hostId && pageThreadId.value == threadId && pendingPlan.value?.id == planId) { hiddenPlanId.value = planId; planFeedback.value = ''; planEditing.value = false; notify(action == 'implement' ? '已提交实施计划' : '修改意见已发送'); refresh() }
  }, (error: Error) => { busy.value = false; pendingAction.value = ''; if (isCurrentPage() && pageHostId.value == hostId && pageThreadId.value == threadId) operationError.value = error.message })
}
function copyText(text: string) { uni.setClipboardData({ data: text, success: (_) => { notify('已复制') }, fail: (_) => { notify('复制失败，请长按选择文字') } }) }
function copyLatestReply() { closeActions(); const messages = displayConversation.value?.messages ?? []; for (let index = messages.length - 1; index >= 0; index--) { if (messages[index].role == 'assistant') { copyText(presentConversationMessages([messages[index]])[0].text); return } }; notify('还没有可复制的回复') }
function showConversationInfo() { closeActions(); uni.showModal({ title: '聊天信息', content: displayTitle.value + '\n\n电脑：' + hostName.value + '\n项目：' + (displayConversation.value?.cwd ?? '') + '\n连接：' + (showingPreview.value ? syncHint.value : connection.status), showCancel: false, confirmText: '知道了' }) }

// 永久删除必须完成两次独立确认；页面变化后旧确认立即失效。
let deletePromptOpen = false
let deletePromptRevision = 0
const deleteFinalVisible = ref(false)
const deleteFinalContent = ref('')
let deleteFinalAnswer: ((confirmed: boolean) => void) | null = null
// 第二次确认使用明确的左右按钮，关闭或返回始终只执行取消。
function showDeleteFinalModal(content: string, answer: (confirmed: boolean) => void) {
  uni.hideKeyboard(); deleteFinalContent.value = content; deleteFinalAnswer = answer; deleteFinalVisible.value = true
}
function answerDeleteFinal(confirmed: boolean) {
  const answer = deleteFinalAnswer; deleteFinalAnswer = null; deleteFinalVisible.value = false; deleteFinalContent.value = ''
  if (answer != null) answer(confirmed)
}
const pageDeleteTask = computed(() => deletionTask(pageHostId.value, pageThreadId.value))
function invalidateDeletePrompt() { deletePromptRevision++; deletePromptOpen = false; deleteFinalAnswer = null; deleteFinalVisible.value = false; deleteFinalContent.value = '' }
watch((): string => pageHostId.value + ':' + pageThreadId.value + ':' + connection.hostId + ':' + connection.activeThreadId + ':' + connection.connected, () => { invalidateDeletePrompt() }, { flush: 'sync' })
onPaneHide(() => { invalidateDeletePrompt() })
onUnmounted(() => { invalidateDeletePrompt() })

// 应用服务处理回执，详情页只关闭仍在眼前的删除目标。
const pageDeletionRevision = computed((): number => deletionTasks.revision)
watch(pageDeletionRevision, () => {
  if (!deletedThread(pageHostId.value, pageThreadId.value)) return
  const returnToList = pageVisible.value && isCurrentPage() && !removalReturnStarted.value
  historyRequest++; historyPage.value = null; historyError.value = ''; operationError.value = ''; invalidateDeletePrompt()
  if (returnToList) {
    removalReturnStarted.value = true
    emit('removed', 'delete')
  }
}, { flush: 'sync' })

let archivePromptOpen = false

function deleteFromMenu() {
  closeActions()
  if (!canWrite.value || deletePromptOpen || archivePromptOpen) return
  const hostId = pageHostId.value; const threadId = pageThreadId.value
  const revision = ++deletePromptRevision
  deletePromptOpen = true
  const current = (): boolean => revision == deletePromptRevision && pageVisible.value && isCurrentPage() && pageHostId.value == hostId && pageThreadId.value == threadId && connection.hostId == hostId && canWrite.value
  const finishPrompt = () => { if (revision == deletePromptRevision) deletePromptOpen = false }
  uni.showModal({ title: '永久删除聊天', content: '将永久删除该聊天及其子智能体聊天，无法恢复。', confirmText: '继续', confirmColor: '#bb3f44', cancelText: '取消', success: (first) => {
    if (!first.confirm || !current()) { finishPrompt(); return }
    showDeleteFinalModal('正在执行的任务会先停止。确认永久删除吗？', (confirmed: boolean) => {
      if (!confirmed || !current()) { finishPrompt(); return }
      finishPrompt(); operationError.value = ''
      try { if (startDeletion(hostId, threadId)) removalSubmissionId.value = deletionTask(hostId, threadId)?.commandId ?? '' }
      catch (error) { removalSubmissionId.value = ''; operationError.value = (error as Error).message; notify(operationError.value) }
    })
  }, fail: (_) => { finishPrompt() } })
}

// 未知结果只查询原命令状态，不重新提交删除或停止任务。
function checkDeleteOutcome() {
    const task = pageDeleteTask.value
  if (task != null) checkDeletion(task)
}

// 归档只在原生回执确认后移除列表项；草稿继续按原会话编号保留。
function acceptArchiveReceipt(hostId: string, receipt: UTSJSONObject | null, commandId: string = ''): boolean {
  if (props.target.cacheNamespace != connection.cacheNamespace || receipt?.getBoolean('archived') != true || receipt?.getString('threadId') != pageThreadId.value || connection.hostId != hostId) return false
  const threadId = pageThreadId.value
  const returnToList = isCurrentPage() && pageVisible.value && !removalReturnStarted.value
  if (commandId.length > 0) bridge.clearCommand(commandId, hostId)
  removeArchivedThread(hostId, threadId)
  clearFileReportCache(props.target.cacheNamespace, hostId, [threadId])
  connection.threads = connection.threads.filter((thread: ThreadSummary): boolean => thread.id != threadId)
  if (connection.activeThreadId == threadId) { connection.activeThreadId = ''; connection.snapshot = null; connection.preview = null; connection.epoch = ''; connection.sequence = 0 }
  operationError.value = ''
  // 列表页在显示时消费结果，详情页卸载及全局加载框清理不会移除列表页提示。
  if (returnToList) {
    removalReturnStarted.value = true
    queueArchiveSuccessNotice()
    emit('removed', 'archive')
  }
  return true
}
let archiveLoading = false
// 仅关闭本页发起的归档加载框，避免迟到回执关闭其他页面的提示。
function hideArchiveLoading() { if (!archiveLoading) return; archiveLoading = false; uni.hideLoading() }
// 确认框返回时重新核对页面和连接，避免切换会话后误归档。
function archiveFromMenu() {
  closeActions()
  if (!canWrite.value || archivePromptOpen) return
  if (connection.snapshot?.status != 'idle' || activeTurnId.value.length > 0 || approvalCount.value > 0) { notify('请先完成或停止当前任务，再归档聊天'); return }
  const hostId = pageHostId.value
  const threadId = pageThreadId.value
  archivePromptOpen = true
  uni.showModal({ title: '归档聊天', content: '归档后将从聊天列表移除，可在电脑端的归档记录中找回。', confirmText: '归档', confirmColor: '#bb3f44', cancelText: '取消', success: (choice) => {
    archivePromptOpen = false
    if (!choice.confirm || !isCurrentPage() || !pageVisible.value || connection.hostId != hostId || pageThreadId.value != threadId || !canWrite.value) return
    busy.value = true; pendingAction.value = 'archive'; operationError.value = ''
    archiveLoading = true; uni.showLoading({ title: '正在归档…', mask: true })
    const request = bridge.request('thread.archive', { threadId }, true)
    // 桥接在发送前保存编号，后续只由这个编号的持久化入队回执触发返回。
    removalSubmissionId.value = bridge.pendingCommand(hostId, threadId)
    request.then((result: UTSJSONObject) => {
      hideArchiveLoading(); busy.value = false; pendingAction.value = ''
      if (pageThreadId.value == threadId) acceptArchiveReceipt(hostId, result)
    }, (error: Error) => { hideArchiveLoading(); busy.value = false; pendingAction.value = ''; if (isCurrentPage()) { operationError.value = error.message; notify(error.message) } })
  }, fail: (_) => { archivePromptOpen = false } })
}
onUnmounted(() => { hideArchiveLoading() })

// 首次打开沿用自动定位；箭头与用户手动滑到底部均可恢复跟随。
function scrollLatest() {
  if (!following.value || touchingTimeline) return
  scrollTarget.value = ''
  const gesture = historyGesture
  nextTick(() => {
    if (!isReadingPage() || !following.value || touchingTimeline || gesture != historyGesture) return
    scrollTarget.value = 'timeline-bottom'
    // 原生滚动和 Web 锚点定位可能晚于 Vue 提交，完成后再测量按钮，迟到测量不能解锁跟随。
    setTimeout(() => { if (isReadingPage() && following.value && gesture == historyGesture) { measureTimelinePosition(); rememberReadingPosition() } }, 80)
  })
}
function resumeFollowing(explicit: boolean = false) {
  // 发送和重试回执只能延续原跟随意图，不能解除缓存浏览或手动阅读的暂停。
  if (!explicit) { if (following.value) scrollLatest(); return }
  historyGesture++; historyFollowRevision++; cancelReadingCorrection(); touchingTimeline = false; timelineUserScrolling = false; readingFloor.value = 0; hasUnseenBelow.value = false; following.value = true; scrollLatest()
}
// 面板不插入时间线，阅读期间暂停自动跟随；关闭时保持原来的消息位置和草稿。
function openAnnotations(messageId: string) {
  if (!messagePresentations.value.some((message: MessagePresentation): boolean => message.messageId == messageId && message.annotations.length > 0)) return
  closeActions(); closeComposerMenu(); dismissGoal(); uni.hideKeyboard()
  historyGesture++; pauseFollowing(); touchingTimeline = true; selectedAnnotationId.value = messageId
}
function closeAnnotations() { if (selectedAnnotationId.value.length == 0) return; selectedAnnotationId.value = ''; touchingTimeline = false }
onPaneHide(() => { closeAnnotations() })
onUnmounted(() => { closeAnnotations() })
watch((): string => [connection.hostId, connection.activeThreadId].join(':'), () => { closeAnnotations() })
watch((): boolean => selectedAnnotationId.value.length > 0 && !messagePresentations.value.some((message: MessagePresentation): boolean => message.messageId == selectedAnnotationId.value), (missing: boolean) => { if (missing) closeAnnotations() })
// 新手势先取消待执行的布局补偿，不能让迟到回调抢回滚动位置。
function beginTimelineTouch() { historyGesture++; touchingTimeline = true; cancelReadingCorrection(); pauseFollowing(); timelineUserScrolling = true; readingFloor.value = 0 }
// 只有真实滚动触底才恢复跟随。
function updateTimelinePosition(userScroll: boolean = false) {
  if (measureTimelinePosition(userScroll)) resumeFollowing(true)
}
function onTimelineWheel() {
  beginTimelineTouch(); touchingTimeline = false
  const gesture = historyGesture
  // 滚轮事件先于浏览器默认滚动；等本轮滚动完成后再判断是否真正触底。
  setTimeout(() => { if (isReadingPage() && gesture == historyGesture && !touchingTimeline) { rememberReadingPosition(); updateTimelinePosition(true) } }, 80)
}
// 布局前锁住当前有效滚动范围，防止内容缩短时浏览器先强制回弹。
function beforeMarkdownLayout(entries: TimelineEntry[] = visibleTimeline.value) {
  if (following.value || touchingTimeline || readingCorrectionPending) return
  pendingReadingPosition = captureReadingPosition(entries) ?? readingPosition
  if (pendingReadingPosition == null) return
  readingCorrectionPending = true
  readingFloor.value = Math.max(readingFloor.value, pendingReadingPosition!.top + pendingReadingPosition!.height)
}

// Web 计时器可能早于页面首帧执行。首条消息进入视口后，再留出一次绘制机会。
function waitForTimelinePaint(revision: number, visibleLastFrame: boolean) {
  // #ifdef WEB
  timelinePaintFrame = window.requestAnimationFrame(() => {
    if (revision != timelinePaintRevision) return
    timelinePaintFrame = 0
    if (!pageVisible.value || !isReadingPage()) return
    const entries = visibleTimeline.value
    if (entries.length == 0) return
    const viewport = uni.getElementById('conversation-timeline')?.getBoundingClientRect()
    const visible = viewport != null && viewport.height > 0 && entries.some((entry: TimelineEntry): boolean => {
      const rect = uni.getElementById(entryAnchor(entry))?.getBoundingClientRect()
      return rect != null && rect.height > 0 && rect.bottom > viewport!.top && rect.top < viewport!.bottom
    })
    if (!visible || !visibleLastFrame) { waitForTimelinePaint(revision, visible); return }
    timelinePainted = true
    scheduleTimelineFill()
  })
  // #endif
}

// 首屏进入视区后再补挂载其余消息，原生继续沿用布局与计时器。
function timelinePaintReady(): boolean {
  // #ifdef WEB
  if (typeof window != 'undefined' && !timelinePainted && visibleTimeline.value.length > 0) {
    if (timelinePaintFrame == 0) waitForTimelinePaint(timelinePaintRevision, false)
    return false
  }
  // #endif
  return true
}

function cancelTimelinePaintWait() {
  // #ifdef WEB
  timelinePaintRevision++
  if (timelinePaintFrame != 0) window.cancelAnimationFrame(timelinePaintFrame)
  timelinePaintFrame = 0
  // #endif
}


function localTimelineHasMore(): boolean { return timelineStart.value > 0 }
// 所有异步布局共用一条补偿链；布局完成后只保留维持原位置所需的最小尾部空间。
function afterMarkdownLayout() {
  // 首屏和后续更新使用同一条布局补偿链。
  if (!following.value && !touchingTimeline && !readingCorrectionPending && readingPosition != null) {
    pendingReadingPosition = readingPosition; readingCorrectionPending = true
  }
  const revision = ++readingCorrectionRevision
  nextTick(() => {
    if (!isReadingPage() || revision != readingCorrectionRevision) return
    if (following.value) { readingCorrectionPending = false; pendingReadingPosition = null; scrollLatest(); nextTick(() => { updateTimelinePosition(); rememberReadingPosition() }); return }
    const saved = pendingReadingPosition
    if (saved == null || touchingTimeline || saved.gesture != historyGesture) { readingCorrectionPending = false; return }
    const viewport = uni.getElementById('conversation-timeline')?.getBoundingClientRect()
    if (viewport == null) { readingCorrectionPending = false; return }
    const anchor = saved.anchors.find((item: ReadingAnchor): boolean => uni.getElementById(item.id) != null)
    const rect = anchor == null ? null : uni.getElementById(anchor.id)?.getBoundingClientRect()
    const actualTop = timelineScrollPosition()
    const target = Math.max(0, rect == null ? saved.top : actualTop + rect.top - viewport.top - anchor!.offset)
    readingFloor.value = target + viewport.height
    const bottom = uni.getElementById('timeline-message-end')?.getBoundingClientRect()
    const actualBottom = bottom == null ? saved.bottom : bottom.bottom - viewport.top - (target - actualTop)
    // 骨架与保位空间均位于真实内容之后，不计入新增内容。
    if (actualBottom > saved.bottom + 2 && bottom != null && bottom.bottom > viewport.bottom + 2) hasUnseenBelow.value = true
    layoutUntil = Date.now() + 350
    const finish = () => { if (!isReadingPage() || revision != readingCorrectionRevision || saved.gesture != historyGesture || touchingTimeline) return; readingCorrectionPending = false; pendingReadingPosition = null; updateTimelinePosition(); rememberReadingPosition() }
    if (Math.abs(target - actualTop) < 0.5) { lastScrollTop = actualTop; finish(); return }
    // 属性可能与上一次补偿相同，先写当前实际位置，不使用 -1 造成无意义的上下滚动。
    historyScrollTop.value = actualTop
    nextTick(() => { if (!isReadingPage() || revision != readingCorrectionRevision || touchingTimeline || saved.gesture != historyGesture) return; lastScrollTop = target; historyScrollTop.value = target; nextTick(finish) })
  })
}
// 代码和表格横向阅读期间暂停纵向跟随，结束后保留阅读位置。
function markdownReading(active: boolean) { if (active) beginTimelineTouch(); else { touchingTimeline = false; rememberReadingPosition() } }
// 历史只补充正文；响应时合并最新内容，不把请求期间的实时消息覆盖回旧快照。
function readOlderPage(request: number, preserveFollowing: boolean, remaining: number) {
  const base = displayConversation.value
  if (base == null || !isCurrentPage()) { loadingHistory.value = false; return }
  const followRevision = historyFollowRevision
  const cursor = historyPage.value?.cursor ?? ''
  const firstId = base.messages.length > 0 ? base.messages[0].id : ''
  bridge.request('thread.history', { threadId: pageThreadId.value, page: true, before: cursor, beforeMessageId: cursor.length == 0 ? firstId : '' }).then((result: UTSJSONObject) => {
    if (request != historyRequest || !isCurrentPage()) return
    const page = JSON.parse<HistoryPage>(JSON.stringify(result))
    if (page == null || page.messages == null || page.turns == null || (page.hasMore && (page.cursor.length == 0 || page.cursor == cursor))) { historyError.value = '历史游标未推进'; loadingHistory.value = false; return }
    const current = displayConversation.value ?? base
    const previousEntries = new Set<string>(timeline.value.map((entry: TimelineEntry): string => entry.id))
    beforeMarkdownLayout()
    const merged = conversationWithHistory(current, page)!
    historyPage.value = { messages: merged.messages, turns: merged.turns ?? [], cursor: page.cursor, hasMore: page.hasMore } as HistoryPage
    // 完成轮次的工具与说明会折叠进同一过程，只有更早的可见正文出现才结束本次加载。
    const added = timeline.value.some((entry: TimelineEntry): boolean => entry.role != 'process' && entry.role != 'execution' && !previousEntries.has(entry.id))
    if (!added && page.hasMore) {
      if (remaining > 1) { readOlderPage(request, preserveFollowing, remaining - 1); return }
      historyError.value = '本次历史读取已达上限'; loadingHistory.value = false; return
    }
    loadingHistory.value = false; layoutUntil = Date.now() + 350
    nextTick(() => {
      if (request != historyRequest || !isCurrentPage()) return
      if ((preserveFollowing && following.value) || followRevision != historyFollowRevision) { scrollLatest(); return }
      afterMarkdownLayout()
    })
  }, (error: Error) => { if (request == historyRequest && isCurrentPage()) { loadingHistory.value = false; historyError.value = error.message } })
}

// 一个手势或点击只发起一个读取链；连续跨过折叠过程页，保留边界和失败后的重试入口。
function loadOlder(preserveFollowing: boolean = false) {
  if (loadingHistory.value || !isCurrentPage() || !connection.connected || connection.snapshot?.supportsHistoryPages != true || historyPage.value?.hasMore == false || displayConversation.value == null) return
  if (!preserveFollowing) pauseFollowing()
  loadingHistory.value = true; historyError.value = ''
  readOlderPage(++historyRequest, preserveFollowing, 32)
}
// 首帧之后分批向前挂载。手势、锚点补偿和首屏定位未结束时让出一轮。
function scheduleTimelineFill() {
  if (timelineFillTimer != 0 || timelineFilled.value || !pageVisible.value || !isReadingPage()) return
  const entries = timeline.value
  const start = timelineStart.value
  if (entries.length == 0) return
  if (timelineBoundary.value.length == 0) timelineBoundary.value = entries[start].id
  if (start == 0) { timelineFilled.value = true; return }
  if (!timelinePaintReady()) return
  timelineFillTimer = setTimeout(() => {
    timelineFillTimer = 0
    if (!pageVisible.value || !isReadingPage()) return
    if (touchingTimeline || readingCorrectionPending) { scheduleTimelineFill(); return }
    const current = timeline.value
    const earlier = Math.max(0, timelineStart.value - 6)
    if (current.length == 0) return
    beforeMarkdownLayout()
    timelineBoundary.value = current[earlier].id
    timelineFilled.value = earlier == 0
    timelineFillStarted = true
    afterMarkdownLayout()
    nextTick(() => { scheduleTimelineFill() })
  }, timelineFillStarted ? 48 : 150)
}
function onHistoryTop() {
  if (lastHistoryGesture == historyGesture || (!touchingTimeline && following.value)) return
  if (localTimelineHasMore()) { scheduleTimelineFill(); return }
  const delay = layoutUntil - Date.now()
    if (delay > 0) { clearTimeout(historyTopTimer); historyTopTimer = setTimeout(() => { if (isCurrentPage() && pageVisible.value) onHistoryTop() }, delay + 16); return }
  lastHistoryGesture = historyGesture; loadOlder()
}
// 隐藏页面停止补挂载，返回时继续当前面板的阅读位置。
onPaneShow(() => { nextTick(() => { scheduleTimelineFill() }) })
onPaneHide(() => { clearTimeout(timelineFillTimer); timelineFillTimer = 0; cancelTimelinePaintWait() })
onUnmounted(() => { clearTimeout(timelineFillTimer); cancelTimelinePaintWait() })

// 只保留已读过的实时窗口；分页回执不能覆盖最新消息或执行权限。
watch(liveConversation, (current: Conversation | null, previous: Conversation | null) => {
  if (isCurrentPage()) historyPage.value = retainHistoryWindow(historyPage.value, previous, current)
}, { flush: 'sync' })

let readRequestKey = ''
// 正文挂载且实时订阅已确认后独立提交已读；不导航电脑，不发送草稿。
function confirmVisibleRead() {
  const snapshot = liveConversation.value
  if (!pageVisible.value || !isCurrentPage() || !subscriptionReady.value || snapshot?.supportsReadState != true) { readRequestKey = ''; return }
  if (snapshot!.hasUnreadTurn == false) { readRequestKey = ''; return }
  if (displayConversation.value == null) return
  const key = pageHostId.value + ':' + pageThreadId.value + ':' + (connection.subscriptionRevision ?? 0).toString() + ':' + (snapshot!.latestTurn?.turnId ?? '')
  if (readRequestKey == key) return
  readRequestKey = key
  nextTick(() => {
    if (!pageVisible.value || !isCurrentPage() || !subscriptionReady.value || readRequestKey != key) return
    bridge.request('thread.read', { threadId: pageThreadId.value }).then((result: UTSJSONObject) => {
      if (isCurrentPage() && readRequestKey == key && result.getString('threadId') == pageThreadId.value && result.getBoolean('read') == true && connection.snapshot != null) { readRequestKey = ''; connection.snapshot!.hasUnreadTurn = false }
    }, (_: Error) => { if (isCurrentPage() && readRequestKey == key) operationError.value = '已读状态同步失败，可从右上角菜单重新同步后重试' })
  })
}
watch((): string => [pageVisible.value.toString(), (connection.connected == true).toString(), (connection.subscriptionRevision ?? 0).toString(), (liveConversation.value?.hasUnreadTurn ?? false).toString(), (liveConversation.value?.supportsReadState ?? false).toString(), liveConversation.value?.latestTurn?.turnId ?? ''].join(':'), () => { confirmVisibleRead() }, { immediate: true })

onMounted(() => {
  baseWindowHeight = uni.getWindowInfo().windowHeight
  if (pageThreadId.value.length > 0 && props.active) bridge.watch(pageThreadId.value)
})
onUnmounted(() => { activationRequest++; pageAlive = false; cancelReadingCorrection(); settingsRequest++; clearTimeout(settingsRetryTimer); if (connection.hostId == pageHostId.value) bridge.cancelOpen(pageThreadId.value); historyRequest++; clearTimeout(historyTopTimer) })

function endTimelineTouch() { touchingTimeline = false; if (lastScrollTop <= 60 && !following.value) onHistoryTop(); rememberReadingPosition(); updateTimelinePosition(true); scheduleTimelineFill() }
// 内层列表结束触摸不恢复自动跟随，避免新输出打断阅读。
function beginExecutionTouch() { beginTimelineTouch() }
function endExecutionTouch() { touchingTimeline = false; rememberReadingPosition() }
function onTimelineScroll(event: UniScrollEvent) {
  const element = uni.getElementById('conversation-timeline') as UniScrollViewElement | null
  // 回到底部及保位空间释放都会产生滚动回调；旧事件不能被误判成新的上滑手势。
  const top = element?.scrollTop ?? event.detail.scrollTop
  const height = element?.getBoundingClientRect().height ?? 0
  const userScroll = height > 0 && timelineUserScrolling && Math.abs(top - lastScrollTop) > 0.5 && !readingCorrectionPending
  if (userScroll && following.value && top < lastScrollTop - 6) pauseFollowing()
  if (userScroll && !touchingTimeline && lastScrollTop > 60 && top <= 60 && Date.now() > layoutUntil) historyGesture++
  lastScrollTop = top
  updateTimelinePosition(userScroll)
  rememberReadingPosition()
  if (top <= 60 && !following.value) onHistoryTop()
}
// 在 Vue 更新 DOM 前记录旧消息几何；相同正文只做测量，不设置新增提示。
watch(displayConversation, (current: Conversation | null, previous: Conversation | null) => {
  if (!following.value && previous != null && current != null) {
    const oldEntries = reportTimeline(previous, expandedReportIds.value)
    // 预览中已可见的过程在轮次变为完成后继续展开，不让实时快照自动收起。
    reportTimeline(current, [] as string[]).forEach((entry: TimelineEntry) => {
      if (entry.role == 'process' && expandedReportIds.value.indexOf(entry.id) < 0 && !oldEntries.some((old: TimelineEntry): boolean => old.id == entry.id) && oldEntries.some((old: TimelineEntry): boolean => old.turnId == entry.turnId && old.role != 'user' && old.role != 'process' && current.messages.some((message: ChatMessage): boolean => message.id == old.id && message.phase == 'commentary'))) expandedReportIds.value.push(entry.id)
    })
  }
  beforeMarkdownLayout(previous == null ? timeline.value : reportTimeline(previous, expandedReportIds.value))
  if (!following.value && current != null && previous != null) {
    const oldIds = previous.messages.map((message: ChatMessage): string => message.id)
    const firstRetained = current.messages.findIndex((message: ChatMessage): boolean => oldIds.indexOf(message.id) >= 0)
    const increased = current.messages.filter((message: ChatMessage, index: number): boolean => {
      const old = previous.messages.find((item: ChatMessage): boolean => item.id == message.id)
      return old == null ? firstRetained >= 0 && index > firstRetained : message.text.length > old.text.length || (message.imageCount ?? 0) > (old.imageCount ?? 0)
    })
    if (increased.length > 0) { const gesture = historyGesture; nextTick(() => {
      if (!isReadingPage() || gesture != historyGesture || following.value) return
      const viewport = uni.getElementById('conversation-timeline')?.getBoundingClientRect()
      if (viewport != null && increased.some((message: ChatMessage): boolean => (uni.getElementById('message-' + message.id.split(':').join('-'))?.getBoundingClientRect().bottom ?? 0) > viewport.bottom + 2)) hasUnseenBelow.value = true
    }) }
  }
  afterMarkdownLayout()
}, { flush: 'pre' })
watch((): string => connection.activeThreadId, (_current: string, _previous: string) => { if (_current == pageThreadId.value) return; cancelReadingCorrection(); closeFileReport(); selectedExecutionId.value = ''; expandedReportIds.value = [] as string[]; expandedExecutionIds.value = [] as string[]; expandedQuestionIds.value = [] as string[]; handledApprovalIds.value = [] as string[]; submittedGroupIds.value = [] as string[] }, { flush: 'sync' })
// 快照替换与流式更新保持展开状态，滑动窗口移除记录时清理失效选择。
watch(timeline, (entries: TimelineEntry[]) => {
  nextTick(() => { updateTimelinePosition(); scheduleTimelineFill() })
  if (connection.snapshot == null) return
  // 过程收起时仅隐藏显示，保留其中命令组的手动展开状态。
  expandedExecutionIds.value = retainExpandedExecutions(executionTimeline(displayConversation.value?.messages ?? []), expandedExecutionIds.value)
  const retainedReports = expandedReportIds.value.filter((id: string): boolean => entries.some((entry: TimelineEntry): boolean => entry.role == 'process' && entry.id == id))
  if (retainedReports.length != expandedReportIds.value.length) expandedReportIds.value = retainedReports
  if (selectedExecutionId.value.length > 0 && selectedExecution.value == null) selectedExecutionId.value = ''
})
// 新问题自动展开；同步已有问题时保留手动收起，回答或失效后清理对应状态。
watch(pendingQuestionGroups, (groups: QuestionGroup[], previous: QuestionGroup[] | null) => {
  const previousGroups = previous ?? [] as QuestionGroup[]
  expandedQuestionIds.value = expandedQuestionIds.value.filter((id: string): boolean => groups.some((group: QuestionGroup): boolean => group.id == id))
  submittedGroupIds.value = submittedGroupIds.value.filter((id: string): boolean => groups.some((group: QuestionGroup): boolean => group.id == id))
  const added = groups.filter((group: QuestionGroup): boolean => !previousGroups.some((previous: QuestionGroup): boolean => previous.id == group.id))
  added.forEach((group: QuestionGroup) => { if (expandedQuestionIds.value.indexOf(group.id) < 0) expandedQuestionIds.value.push(group.id) })
  // 仅在跟随最新消息时随新问题滚动，阅读历史时由常驻入口提示。
  if (added.length > 0 && following.value && pageVisible.value) nextTick(() => { if (following.value && pageVisible.value) scrollLatest() })
}, { immediate: true })
// 模板通过页面方法调用模块，兼容 Android 对导入函数引用的编译限制。
function isExecutionExpanded(entry: TimelineEntry): boolean { return executionGroupExpanded(entry, expandedExecutionIds.value) }
function isProcessExpanded(entry: TimelineEntry): boolean { return expandedReportIds.value.indexOf(entry.id) >= 0 }
// 主动展开或收起时暂停跟随；后续同步不覆盖本轮的阅读选择。
function toggleProcess(entry: TimelineEntry) { pauseFollowing(); uni.hideKeyboard(); layoutUntil = Date.now() + 350; const index = expandedReportIds.value.indexOf(entry.id); if (index >= 0) expandedReportIds.value.splice(index, 1); else expandedReportIds.value.push(entry.id) }
function executionTitle(message: ChatMessage): string { return executionRecordTitle(message) }
// 展开列表前暂停跟随并收起键盘；布局变化不触发自动回到底部。
function toggleExecutions(entry: TimelineEntry) { pauseFollowing(); uni.hideKeyboard(); layoutUntil = Date.now() + 350; expandedExecutionIds.value = toggleExecutionGroup(entry, expandedExecutionIds.value) }
// 现有消息状态沿用所属轮次，不用于推断单条执行结果；辅助行仅说明详情入口。
// 详情独立于主时间线滚动，关闭面板不改变当前阅读位置。
function toggleExecution(id: string) { pauseFollowing(); uni.hideKeyboard(); selectedExecutionId.value = id }
function closeExecution() { selectedExecutionId.value = '' }
function toggleQuestion(id: string) { pauseFollowing(); layoutUntil = Date.now() + 350; const index = expandedQuestionIds.value.indexOf(id); if (index >= 0) expandedQuestionIds.value.splice(index, 1); else expandedQuestionIds.value.push(id) }
function jumpTo(anchor: string) {
  closeActions(); pauseFollowing(); layoutUntil = Date.now() + 350; scrollTarget.value = ''
  if (anchor.startsWith('message-') && !timelineFilled.value) {
    const index = timeline.value.findIndex((entry: TimelineEntry): boolean => entryAnchor(entry) == anchor)
    if (index >= 0 && index < timelineStart.value) {
      // 用户明确跳到暂未挂载的消息时，先挂载目标并取消旧的阅读锚点补偿。
      historyGesture++; cancelReadingCorrection(); timelineBoundary.value = timeline.value[index].id
    }
  }
  nextTick(() => { scrollTarget.value = anchor })
}
// 点击通知后等待目标快照和布局就绪；后续流式更新不重复抢走阅读位置。
function questionNoticeAnchor(id: string): string { return taskNoticeAnchor('question', id) }
function approvalNoticeAnchor(id: string): string { return taskNoticeAnchor('approval', id) }
let focusedNoticeRevision = 0
watch((): string => taskNotifications.focusRevision + ':' + pageVisible.value + ':' + connection.hostId + ':' + (connection.snapshot?.threadId ?? '') + ':' + connection.sequence + ':' + connection.subscriptionRevision, () => {
    const notice = taskNotifications.focus
  if (notice == null || focusedNoticeRevision == taskNotifications.focusRevision || !pageVisible.value || !isCurrentPage() || pageHostId.value != notice.hostId || pageThreadId.value != notice.threadId || connection.snapshot?.threadId != notice.threadId) return
  focusedNoticeRevision = taskNotifications.focusRevision
  closeActions(); closeComposerMenu(); closeAnnotations(); selectedExecutionId.value = ''; goalExpanded.value = false; uni.hideKeyboard()
  nextTick(() => {
    if (!pageVisible.value || !isCurrentPage()) return
    if (notice.kind == 'question') {
      const group = pendingQuestionGroups.value.find((item: QuestionGroup): boolean => item.id == notice.targetId)
      if (group != null) { if (expandedQuestionIds.value.indexOf(group.id) < 0) expandedQuestionIds.value.push(group.id); jumpTo(questionNoticeAnchor(group.id)); return }
    } else if (notice.kind == 'approval') {
      if (connection.snapshot?.approvals.some((item: Approval): boolean => item.id == notice.targetId) == true) { jumpTo(approvalNoticeAnchor(notice.targetId)); return }
    } else if (notice.kind == 'plan' && pendingPlan.value?.id == notice.targetId) {
      hiddenPlanId.value = ''; jumpTo('notice-plan'); return
    }
    const results = timeline.value.filter((entry: TimelineEntry): boolean => entry.turnId == notice.turnId && entry.role == 'assistant')
    jumpTo(results.length > 0 ? entryAnchor(results[results.length - 1]) : 'timeline-bottom')
  })
})
function showApprovals() { jumpTo('approvals-anchor') }
function showQuestions() { const groups = pendingQuestionGroups.value; if (groups.length > 0 && expandedQuestionIds.value.indexOf(groups[0].id) < 0) expandedQuestionIds.value.push(groups[0].id); jumpTo('questions-anchor') }
// 输入事件先保存正文，再捕获实际光标；选择器取消不改正文。
// 恢复同一聊天的编辑焦点；不会采纳预测或发送草稿。
function focusComposerInput() {
  const hostId = pageHostId.value, threadId = pageThreadId.value
  closeComposerMenu(); clearTimeout(composerBlurTimer)
  inputFocused.value = true; predictionFocus.value = false
  nextTick(() => {
    if (!isCurrentPage() || pageHostId.value != hostId || pageThreadId.value != threadId || readOnly.value) return
    predictionFocus.value = true
  })
}

// 回车先同步原生输入框的最新值，避免节流回调尚未到达时发送旧正文。
function syncComposerText(text: string) { if (canWrite.value && draft.value != text) { saveDraft(pageHostId.value, pageThreadId.value, text); mentionCursor.value = -1 } }
function threadMentionContext(): string { return [pageHostId.value, pageThreadId.value, connection.hostId, connection.configurationRevision.toString()].join(':') }

function updateDraft(event: UniInputEvent) {
  saveDraft(pageHostId.value, pageThreadId.value, event.detail.value)
  mentionCursor.value = -1
  if (!canWrite.value || connection.snapshot?.supportsThreadMentions != true || mentionOpen.value) return
  const trigger = findThreadMentionTrigger(event.detail.value, event.detail.cursor ?? -1)
  if (trigger == null) return
  mentionTrigger.value = trigger; mentionSourceRevision = mentionDraftRevision
  mentionContext = threadMentionContext(); mentionSelection = JSON.stringify(draftMentions.value)
  closeComposerMenu(); pluginOpen.value = false; predictionFocus.value = false; uni.hideKeyboard(); mentionOpen.value = true
}
function closeThreadMentions(restoreFocus: boolean = true) {
  const wasOpen = mentionOpen.value, trigger = mentionTrigger.value
  if (restoreFocus && trigger != null && draft.value == trigger.text && mentionSourceRevision == mentionDraftRevision) mentionCursor.value = trigger.end
  resetThreadMention()
  if (wasOpen && restoreFocus && pageVisible.value && mentionContext == threadMentionContext()) focusComposerInput()
}
// 选择期间任何异步草稿或目标变化都保留新输入，禁止按旧光标覆盖。
function selectThreadMentions(mentions: SelectedThreadMention[]) {
  const trigger = mentionTrigger.value
  if (!canWrite.value || connection.snapshot?.supportsThreadMentions != true || trigger == null || mentionContext != threadMentionContext() || mentionSourceRevision != mentionDraftRevision || mentionSelection != JSON.stringify(draftMentions.value)) { closeThreadMentions(false); notify('草稿已变化，请在当前位置重新引用聊天'); return }
  const replacement = replaceThreadMentionTrigger(draft.value, trigger)
  if (replacement == null) { closeThreadMentions(false); notify('草稿已变化，正文已保留'); return }
  saveDraftThreadMentions(pageHostId.value, pageThreadId.value, mentions)
  saveDraft(pageHostId.value, pageThreadId.value, replacement.text)
  mentionCursor.value = replacement.cursor; closeThreadMentions()
}
function removeThreadMention(id: string) { if (canWrite.value) saveDraftThreadMentions(pageHostId.value, pageThreadId.value, draftMentions.value.filter((mention: SelectedThreadMention): boolean => mention.id != id)) }
// 选图完成后写回发起选择的会话，页面切换不会把图片放入其他会话。
function chooseImages(source: string = 'album') {
  if (!canWrite.value || imageBusy.value) return
  if (connection.snapshot?.supportsImages != true) { notify('请先更新电脑连接服务以发送图片'); return }
  const hostId = pageHostId.value; const threadId = pageThreadId.value
  const remaining = MAX_COMPOSER_IMAGES - readDraftImages(hostId, threadId).length - readDraftFiles(hostId, threadId).length
  if (remaining <= 0) { notify('每次最多发送3张图片'); return }
  imageBusy.value = true
  // 获取原图后统一处理大小，避免系统预压缩与发送压缩叠加损伤文字。
  uni.chooseImage({ count: remaining, albumMode: 'system', sizeType: ['original'], sourceType: [source], success: (result) => {
    Promise.all(result.tempFilePaths.slice(0, remaining).map((path: string): Promise<string> => prepareImage(path))).then((sources: string[]) => {
      const images = readDraftImages(hostId, threadId).slice()
      sources.forEach((src: string, index: number) => { images.push({ id: Date.now().toString() + '-' + Math.random().toString(36).slice(2) + '-' + index, src } as DraftImage) })
      saveDraftImages(hostId, threadId, images.slice(0, MAX_COMPOSER_IMAGES - readDraftFiles(hostId, threadId).length)); imageBusy.value = false
    }, (error: Error) => { imageBusy.value = false; if (isCurrentPage()) notify(error.message) })
  }, fail: (error) => { imageBusy.value = false; if (error.errCode != 1101001 && !error.errMsg.toLowerCase().includes('cancel')) notify('未能选择图片，请重试') } })
}
// 粘贴仅添加附件，沿用选图压缩与发送流程，并始终写回发起粘贴的会话。
async function pasteImages(paths: string[]) {
  if (!pageVisible.value || !canWrite.value || imageBusy.value) return
  if (connection.snapshot?.supportsImages != true) { notify('请先更新电脑连接服务以发送图片'); return }
  if (!modelSupportsImages.value) { notify('当前模型不支持图片，请切换模型'); return }
  const hostId = pageHostId.value, threadId = pageThreadId.value
  const remaining = MAX_COMPOSER_IMAGES - readDraftImages(hostId, threadId).length - readDraftFiles(hostId, threadId).length
  if (remaining <= 0) { notify('每次最多添加3个附件'); return }
  if (paths.length > remaining) notify('每次最多添加3个附件，已保留可添加的图片')
  imageBusy.value = true
  try {
    const sources = await Promise.all(paths.slice(0, remaining).map((path: string): Promise<string> => prepareImage(path)))
    const images = readDraftImages(hostId, threadId).slice()
    sources.forEach((src: string, index: number) => { images.push({ id: Date.now().toString() + '-' + Math.random().toString(36).slice(2) + '-' + index, src } as DraftImage) })
    saveDraftImages(hostId, threadId, images.slice(0, MAX_COMPOSER_IMAGES - readDraftFiles(hostId, threadId).length))
  } catch (reason) { if (isCurrentPage()) notify((reason as Error).message) }
  finally { imageBusy.value = false }
}
// 文档级委托只匹配当前消息输入框，其他编辑框保留默认粘贴行为。
let unbindImagePaste: () => void = () => {}
onMounted(() => { unbindImagePaste = bindImagePaste('#' + composerInstanceId + ' .message-input', pasteImages, (): boolean => pageVisible.value) })
onUnmounted(() => { unbindImagePaste() })
function removeImage(id: string) { if (busy.value || imageBusy.value || connection.pendingCommandId.length > 0) return; saveDraftImages(pageHostId.value, pageThreadId.value, draftImages.value.filter((image: DraftImage): boolean => image.id != id)) }
function previewImage(src: string) { uni.previewImage({ urls: draftImages.value.map((image: DraftImage): string => image.src), current: src }) }
// 延后收起，让引起失焦的工具栏点击先完成，菜单或附件选择会继续保持展开。
function onDraftBlur() {
  predictionFocus.value = false
  clearTimeout(composerBlurTimer)
  composerBlurTimer = setTimeout(() => { if (pageAlive) inputFocused.value = false }, 160)
}
function onPermissionVisibility(value: boolean) { permissionMenuOpen.value = value }
function updateMenuHeight() {
  const windowHeight = uni.getWindowInfo().windowHeight
  const page = uni.getElementById('conversation-page')?.getBoundingClientRect()
  menuWidth.value = Math.min(330, props.paneWidth - 28)
  // 与权限菜单一致，从点击图标上沿留出 8px；加号靠左，模型入口靠右。
  const trigger = uni.getElementById(composerInstanceId + (composerMenu.value == 'add' ? '-add' : '-settings'))?.getBoundingClientRect()
  const position = composerMenuPosition(trigger?.left ?? props.paneLeft + 14, trigger?.right ?? props.paneLeft + props.paneWidth - 54, trigger?.top ?? windowHeight - keyboardInset.value - 60, page?.left ?? props.paneLeft, page?.top ?? 0, page?.bottom ?? windowHeight, props.paneWidth, menuWidth.value, composerMenu.value != 'add')
  menuLeft.value = position.left; menuBottom.value = position.bottom
  const available = position.height
  const model = models.value.find((item: ModelOption): boolean => item.id == settings.value?.model)
  // 附件菜单按六行按钮与分隔线计算高度，避免计划模式下方留下额外空白；提示超出时仍可滚动。
  const desired = composerMenu.value == 'add' ? 6 * 46 + 17 : composerMenu.value == 'models' ? models.value.length * 48 : composerMenu.value == 'speeds' ? (model?.speeds.length ?? 1) * 66 : (model?.efforts.length ?? 0) * 46 + 145
  menuHeight.value = Math.max(100, Math.min(desired, 470, available))
}
function changeComposerSection(section: string) { composerMenu.value = section; nextTick(() => { updateMenuHeight() }) }
// 电脑快照是当前设置的来源；切换电脑、会话或断线后使迟到响应失效。
function loadSettings() {
  // 只重试读取两次；定时器绑定当前请求，断线、离页和设置写入后不能重放。
  function settingsLoadFailed(message: string) {
    settingsLoading.value = false; settingsError.value = message
    if (settingsRetryCount >= 2) return
    const request = settingsRequest
    settingsRetryCount++
    settingsRetryTimer = setTimeout(() => {
      if (request == settingsRequest && isCurrentPage()) loadSettings()
    }, settingsRetryCount * 1000)
  }

  if (!isCurrentPage() || !connection.connected || readOnly.value || connection.snapshot?.supportsExecutionSettings != true || settingsBusy.value || settingsLoading.value) return
  clearTimeout(settingsRetryTimer)
  const request = ++settingsRequest
  const snapshotRevision = settingsSnapshotRevision
  settingsLoading.value = true; settingsError.value = ''
  bridge.request('thread.settings.read', { threadId: pageThreadId.value }).then((result: UTSJSONObject) => {
    if (request != settingsRequest || !isCurrentPage()) return
    const response = JSON.parse<SettingsResponse>(JSON.stringify(result))
    settingsLoading.value = false
    if (response == null || response.settings == null || response.models == null || response.models.length == 0) { settingsLoadFailed('电脑端设置暂不可用，请更新连接服务后重试'); return }
    const confirmed = resolveSettingsEffort(response.settings, response.models)
    if (confirmed.effort.length == 0) { settingsLoadFailed('尚未读取到电脑端的思考强度，请重新读取'); return }
    settings.value = mergeSettingsRead(settings.value, confirmed, connection.snapshot?.executionSettings ?? null, snapshotRevision != settingsSnapshotRevision)
    models.value = response.models
    settingsRetryCount = 0
    if (composerMenu.value.length > 0) updateMenuHeight()
  }, (error: Error) => { if (request == settingsRequest && isCurrentPage()) settingsLoadFailed(error.message) })
}


function openComposerMenu(section: string) {
  if (!canWrite.value) return
  actionsVisible.value = false
  if (composerMenu.value == section) { closeComposerMenu(); return }
  changeComposerSection(section)
  if ((settings.value == null || models.value.length == 0 || settingsError.value.length > 0) && connection.snapshot?.supportsExecutionSettings == true) { settingsRetryCount = 0; loadSettings() }
}

// 空闲选择只属于待发消息；运行中的选择沿用原生实时更新和回读。
function selectSetting(key: string, value: string): boolean {
  if (!canWrite.value || settings.value == null || settingsBusy.value) return false
  // 运行中的轮次不能切换计划模式；回调执行时再次读取快照，防止菜单打开后任务才启动。
  if (key == 'mode' && ((connection.snapshot?.activeTurnId ?? '').length > 0 || connection.snapshot?.status == 'active')) return false
  const choiceHostId = pageHostId.value, choiceThreadId = pageThreadId.value, choiceRevision = messageChoicesRevision(choiceHostId, choiceThreadId)
  const running = (connection.snapshot?.activeTurnId ?? '').length > 0 || connection.snapshot?.status == 'active'
  if (!running) {
    const selected = settingsWithMessageChoices(settings.value, readMessageChoices(choiceHostId, choiceThreadId))
    if (selected == null || !chooseMessageSetting(choiceHostId, choiceThreadId, key, value, selected, models.value)) return false
    settingsError.value = ''; closeComposerMenu()
    if (pageVisible.value) focusComposerInput()
    return true
  }
  const changes: UTSJSONObject = {}
  changes[key] = value
  if (
      // #ifdef WEB
      typeof supportsSubmissionTasks == 'function' &&
      // #endif
      supportsSubmissionTasks(pageHostId.value)) {
    const hostId = pageHostId.value, threadId = pageThreadId.value, namespace = connection.cacheNamespace, id = newSubmissionId()
    const request = ++settingsRequest
    settingsBusy.value = true; busy.value = true; settingChoice.value = key + ':' + value; settingsError.value = ''; pendingSetting.value = ''
    submitTask(hostId, id, 'command', { method: 'thread.settings.update', params: { threadId, changes } }).then((_: UTSJSONObject) => {
      if (request == settingsRequest && isCurrentPage()) { settingsBusy.value = false; busy.value = false; closeComposerMenu(); pendingSetting.value = '待执行：' + (key == 'effort' ? '思考强度 ' + effortLabel(value) : key == 'model' ? '模型 ' + value : key == 'mode' ? value == 'plan' ? '计划模式' : '默认模式' : '速度 ' + value) }
      awaitSubmissionResult(hostId, id, namespace).then((_: UTSJSONObject) => { if (request == settingsRequest && isCurrentPage() && pageHostId.value == hostId && pageThreadId.value == threadId) { settingsError.value = ''; pendingSetting.value = ''; settingChoice.value = ''; consumeRealtimeChoice(choiceHostId, choiceThreadId, key, choiceRevision); loadSettings() } }, (reason: Error) => { if (request == settingsRequest && isCurrentPage()) { pendingSetting.value = ''; settingChoice.value = ''; settingsError.value = reason.message } })
    }, (reason: Error) => { if (request == settingsRequest && isCurrentPage()) { settingsBusy.value = false; busy.value = false; settingChoice.value = ''; settingsError.value = reason.message } })
    return true
  }
  const request = ++settingsRequest
  const snapshotRevision = settingsSnapshotRevision
  settingChoice.value = key == 'mode' ? 'mode' : key + ':' + value; settingsBusy.value = true; busy.value = true; settingsLoading.value = false; settingsError.value = ''
  bridge.request('thread.settings.update', { threadId: pageThreadId.value, changes }, true).then((result: UTSJSONObject) => {
    busy.value = false; settingsBusy.value = false; settingChoice.value = ''
    if (request != settingsRequest || !isCurrentPage()) return
    const response = JSON.parse<SettingsResponse>(JSON.stringify(result))
    if (response == null || response.settings == null) { settingsError.value = '请刷新并核对电脑端设置'; return }
    if (snapshotRevision == settingsSnapshotRevision) settings.value = response.settings
    consumeRealtimeChoice(choiceHostId, choiceThreadId, key, choiceRevision)
    models.value = response.models
    closeComposerMenu()
    // 模型、强度、速度或计划模式确认后恢复编辑，隐藏页面或失败响应不争抢输入焦点。
    if (['model', 'effort', 'serviceTier', 'mode'].indexOf(key) >= 0 && pageVisible.value) focusComposerInput()
    refresh()
  }, (error: Error) => {
    busy.value = false; settingsBusy.value = false; settingChoice.value = ''
    if (request != settingsRequest || !isCurrentPage()) return
    settingsError.value = error.message
    // 设置失败后由用户查看同步结果，重连不会自动再次提交。
    // 保留失败原因，用户点击重新读取后再核对桌面设置。
  })
  return true
}
// 权限写入期间沿用详情页操作锁，防止首条消息抢在设置确认之前发送。
// 原生组件事件显式声明布尔类型，避免模板把载荷推断为 Any。
let permissionChoiceRevision = -1
function onPermissionBusy(value: boolean) { if (value) permissionChoiceRevision = messageChoicesRevision(pageHostId.value, pageThreadId.value); busy.value = value }
// 空闲权限先保存在本条消息，版本与确认标记随消息交给电脑核对。
function selectDraftPermission(mode: string, confirmed: boolean, revision: string) {
  if (!canWrite.value || settingsRunning.value || mode == 'full-access' && !confirmed) return
  const choices = { ...messageChoices.value } as MessageChoices
  choices.permissionMode = mode; choices.permissionRevision = revision; choices.confirmedFullAccess = mode == 'full-access' && confirmed
  saveMessageChoices(pageHostId.value, pageThreadId.value, choices)
  if (pageVisible.value) focusComposerInput()
}
// 权限已确认写入且当前页面仍可编辑时，才将光标交回同一聊天。
function onPermissionApplied(hostId: string, threadId: string) {
  consumeRealtimeChoice(hostId, threadId, 'permissionMode', permissionChoiceRevision)
  if (pageVisible.value && isCurrentPage() && pageHostId.value == hostId && pageThreadId.value == threadId && canWrite.value) focusComposerInput()
}
function togglePlan() { selectSetting('mode', planEnabled.value ? 'default' : 'plan') }
// 附件变更始终写回原电脑和会话，不将系统选择器的迟到结果放进其他草稿。
function updateFile(hostId: string, threadId: string, file: DraftFile) {
  const files = readDraftFiles(hostId, threadId).slice()
  const index = files.findIndex((item: DraftFile): boolean => item.id == file.id)
  if (index < 0) return
  files.splice(index, 1, file); saveDraftFiles(hostId, threadId, files)
}
function fileStillPresent(hostId: string, threadId: string, id: string): boolean {
  return readDraftFiles(hostId, threadId).some((file: DraftFile): boolean => file.id == id)
}
// 同一上传编号可恢复缺失分片；断线只暂停，不重放发送指令。
async function uploadFile(hostId: string, threadId: string, file: DraftFile) {
  try {
    if (file.data.length == 0) file.data = await readFileBase64(file.source)
    if (!fileStillPresent(hostId, threadId, file.id)) return
    file.status = 'uploading'; file.error = ''; updateFile(hostId, threadId, file)
    if (connection.hostId != hostId || connection.activeThreadId != threadId || !connection.connected) throw new Error('聊天或连接已变化，上传已暂停')
    const started = await bridge.request('attachment.begin', { threadId, uploadId: file.id, name: file.name, size: file.size })
    let index = started.getNumber('nextChunk') ?? 0
    const chunkLength = FILE_CHUNK_BYTES * 4 / 3
    while (index * chunkLength < file.data.length) {
      if (!fileStillPresent(hostId, threadId, file.id)) return
      if (connection.hostId != hostId || connection.activeThreadId != threadId || !connection.connected) throw new Error('聊天或连接已变化，上传已暂停')
      const result = await bridge.request('attachment.chunk', { threadId, uploadId: file.id, index, data: file.data.slice(index * chunkLength, (index + 1) * chunkLength) })
      index = result.getNumber('nextChunk') ?? index + 1
      file.progress = Math.min(99, Math.floor((result.getNumber('received') ?? 0) * 100 / file.size))
      updateFile(hostId, threadId, file)
    }
    if (!fileStillPresent(hostId, threadId, file.id)) return
    if (connection.hostId != hostId || connection.activeThreadId != threadId || !connection.connected) throw new Error('聊天或连接已变化，上传已暂停')
    await bridge.request('attachment.finish', { threadId, uploadId: file.id })
    file.status = 'ready'; file.progress = 100; updateFile(hostId, threadId, file)
  } catch (error) {
    file.status = connection.connected && connection.hostId == hostId && connection.activeThreadId == threadId ? 'error' : 'paused'
    file.error = (error as Error).message; updateFile(hostId, threadId, file)
  }
}
// 图片继续走压缩后的视觉输入，文档走独立的有界分片上传。
async function acceptFiles(hostId: string, threadId: string, selected: ChooseFileTempFile[]) {
  imageBusy.value = true
  for (const picked of selected) {
    if (readDraftImages(hostId, threadId).length + readDraftFiles(hostId, threadId).length >= 3) break
    try {
      const extension = picked.name.slice(picked.name.lastIndexOf('.') + 1).toLowerCase()
      if (extension == 'png' || extension == 'jpg' || extension == 'jpeg') {
        if (!modelSupportsImages.value) throw new Error('当前模型不支持图片，请切换模型')
        const src = await prepareImage(picked.path)
        const images = readDraftImages(hostId, threadId).slice()
        images.push({ id: Date.now().toString() + '-' + Math.random().toString(36).slice(2), src } as DraftImage)
        saveDraftImages(hostId, threadId, images)
      } else {
        validateFile(picked.name, picked.size)
        const file: DraftFile = { id: Date.now().toString() + '-' + Math.random().toString(36).slice(2) + '-' + Math.random().toString(36).slice(2), name: picked.name, size: picked.size, source: picked.path, data: '', status: 'uploading', progress: 0, error: '' }
        const files = readDraftFiles(hostId, threadId).slice(); files.push(file); saveDraftFiles(hostId, threadId, files)
        uploadFile(hostId, threadId, file)
      }
    } catch (error) { if (isCurrentPage()) notify((error as Error).message) }
  }
  imageBusy.value = false
}

function chooseFiles() {
  if (!canWrite.value || imageBusy.value || connection.snapshot?.supportsAttachments != true) return
  const remaining = 3 - draftImages.value.length - draftFiles.value.length
  if (remaining <= 0) { notify('每次最多发送3个附件'); return }
  const hostId = pageHostId.value; const threadId = pageThreadId.value
  uni.chooseFile({ count: remaining, type: 'all', success: (result) => { acceptFiles(hostId, threadId, result.tempFiles.slice(0, remaining)) }, fail: (error) => { if (error.errCode != 1101001 && !error.errMsg.toLowerCase().includes('cancel')) notify('未能选择文件，请重试') } })
}

function retryFile(id: string) {
  if (!canWrite.value) return
  const file = draftFiles.value.find((item: DraftFile): boolean => item.id == id)
  if (file == null || file.status == 'uploading') return
  file.status = 'uploading'; file.error = ''; updateFile(pageHostId.value, pageThreadId.value, file)
  if (retryingFileIds.value.indexOf(id) >= 0) return
  retryingFileIds.value.push(id)
  uploadFile(pageHostId.value, pageThreadId.value, file).finally(() => {
    retryingFileIds.value = retryingFileIds.value.filter((item: string): boolean => item != id)
  })
}
function removeFile(id: string) {
  if (busy.value || connection.pendingCommandId.length > 0) return
  saveDraftFiles(pageHostId.value, pageThreadId.value, draftFiles.value.filter((file: DraftFile): boolean => file.id != id))
  if (isCurrentPage() && connection.connected) bridge.request('attachment.abort', { threadId: pageThreadId.value, uploadId: id }).then((_: UTSJSONObject) => {}, (_: Error) => {})
}
function showGoal() {
  closeActions(); closeComposerMenu()
  if (connection.snapshot?.supportsGoals != true) { notify('请更新电脑端与连接服务以使用目标'); return }
  if (connection.snapshot?.goal == null && (!canWrite.value || !goalHostOnline.value || connection.snapshot?.supportsGoalControl != true)) { notify(goalUnavailableReason.value.length > 0 ? goalUnavailableReason.value : '当前暂不能新建目标'); return }
  uni.hideKeyboard(); goalOpenRequest.value++
}

function composerAction(action: string) {
  if (!canWrite.value) return
  if (action == 'plugin') { closeComposerMenu(); predictionFocus.value = false; uni.hideKeyboard(); pluginOpen.value = true; return }
  if (action == 'goal') { showGoal(); return }
  if (action == 'plan') { togglePlan(); return }
  closeComposerMenu()
  if (action == 'camera' || action == 'album') {
    if (modelSupportsImages.value) chooseImages(action); else notify('当前模型不支持图片，请切换模型')
  } else if (action == 'file') chooseFiles()
}
// 面板挂载期间固定会话归属，关闭页面或切换电脑后不保留旧面板。
function selectPlugins(plugins: SelectedPlugin[]) { if (!canWrite.value) return; saveDraftPlugins(pageHostId.value, pageThreadId.value, plugins); pluginOpen.value = false; focusComposerInput() }
function removePlugin(id: string) { if (canWrite.value) saveDraftPlugins(pageHostId.value, pageThreadId.value, draftPlugins.value.filter((plugin: SelectedPlugin): boolean => plugin.id != id)) }
function sizeLabel(size: number): string { return fileSizeLabel(size) }


// 桥接重启后，即使模型能力字段相同，也要在新快照到达后重新读取设置，清除抢先请求的错误。
watch((): string => connection.hostId + ':' + connection.activeThreadId + ':' + connection.subscriptionRevision.toString() + ':' + connection.connected.toString() + ':' + (connection.snapshot?.supportsExecutionSettings == true).toString() + ':' + (connection.snapshot?.readOnly == true).toString(), (_current: string, _previous: string) => {
  settingsRequest++; settingsLoading.value = false; clearTimeout(settingsRetryTimer); settingsRetryCount = 0; closeComposerMenu()
  if (!isCurrentPage() || !connection.connected || readOnly.value) { settings.value = null; models.value = [] as ModelOption[]; return }
  if (connection.snapshot?.supportsExecutionSettings == true) loadSettings()
})
watch((): string => JSON.stringify(connection.snapshot?.executionSettings ?? null), (_current: string, _previous: string) => {
  if (!isCurrentPage() || connection.snapshot?.threadId != pageThreadId.value || connection.snapshot?.executionSettings == null) return
  const snapshot = connection.snapshot!.executionSettings!
  settingsSnapshotRevision++; settings.value = mergeSettingsSnapshot(settings.value, snapshot)
  if (snapshot.effort.length == 0 && !settingsLoading.value && !settingsBusy.value) loadSettings()
})


// 布局稳定后更新菜单锚点；用户阅读历史时不强制滚到消息末尾。
function updateComposerGeometry() {
  nextTick(() => {
    if (!pageAlive) return
    if (composerMenu.value.length > 0) updateMenuHeight()
    if (following.value) scrollLatest()
    else updateTimelinePosition()
  })
}

// 占位预测使用独立测量值，原生空输入行高事件不能覆盖预测的实际高度。
function onDraftLineChange(event: UniTextareaLineChangeEvent) {
  if (draft.value.length > 0) draftHeight.value = Math.max(64, Math.min(144, event.detail.height))
  updateComposerGeometry()
}
const composerExpanded = computed((): boolean => shouldExpandComposer({ focused: inputFocused.value, draft: draft.value, prediction: visiblePrediction.value, imageCount: draftImages.value.length, fileCount: draftFiles.value.length, menuOpen: composerMenu.value.length > 0 || permissionMenuOpen.value || pluginOpen.value || mentionOpen.value || draftPlugins.value.length > 0 || draftMentions.value.length > 0, attachmentBusy: imageBusy.value }))
const composerHeight = computed((): number => composerInputHeight(composerExpanded.value, visiblePrediction.value, predictionHeight.value, draftHeight.value))
// 高度由一行工具栏及编辑空间组成，数值过渡期间两端按钮始终贴住底边。
const composerStageHeight = computed((): number => composerExpanded.value ? composerHeight.value + 58 : 44)
// 取消旧完成回调，200ms 过渡后额外留一帧，补测最后一次切换的几何位置。
function settleComposerAnimation() {
  clearTimeout(composerAnimationTimer)
  const revision = ++composerAnimationRevision
  composerAnimationTimer = setTimeout(() => {
    if (!pageAlive || revision != composerAnimationRevision) return
    updateComposerGeometry()
  }, 220)
}
// 按真实可用宽度测量自然折行，代次校验阻止旧会话或旧预测的测量写回。
function measureComposerPrediction() {
  const revision = ++composerMeasureRevision
  if (visiblePrediction.value.length == 0) { predictionHeight.value = 24; return }
  nextTick(() => {
    if (!pageAlive || revision != composerMeasureRevision) return
    const height = uni.getElementById(composerInstanceId + '-prediction')?.getBoundingClientRect().height ?? 0
    if (height > 0) predictionHeight.value = height
  })
}
watch((): string => pageHostId.value + ':' + pageThreadId.value + ':' + visiblePrediction.value + ':' + composerExpanded.value, () => { measureComposerPrediction(); updateComposerGeometry() }, { flush: 'post' })
watch((): number => composerStageHeight.value, () => { updateComposerGeometry(); settleComposerAnimation() }, { flush: 'post' })
watch((): string => draft.value, (text: string) => { if (text.length == 0) draftHeight.value = 64 })
watch((): string => pageHostId.value + ':' + pageThreadId.value, () => { clearTimeout(composerBlurTimer); clearTimeout(composerAnimationTimer); composerAnimationRevision++; inputFocused.value = false; predictionFocus.value = false; permissionMenuOpen.value = false; draftHeight.value = 64; measureComposerPrediction() }, { flush: 'sync' })
onPaneResize(() => { measureComposerPrediction(); updateComposerGeometry() })
onUnmounted(() => { clearTimeout(composerBlurTimer); clearTimeout(composerAnimationTimer); composerAnimationRevision++; composerMeasureRevision++ })
// 键盘由输入区处理，扣除系统已缩小的窗口高度，避免自定义顶栏被整体上推或重复留白。
function onKeyboardChange(event: UniInputKeyboardHeightChangeEvent) {
  const height = event.detail.height
  if (height > 0) composerKeyboardVisible = true
  else if (composerKeyboardVisible) { composerKeyboardVisible = false; onDraftBlur() }
  goalViewportHeight.value = uni.getWindowInfo().windowHeight
  const resized = Math.max(0, baseWindowHeight - uni.getWindowInfo().windowHeight)
  keyboardInset.value = height > 0 ? Math.max(0, height - resized) : 0
  if (composerMenu.value.length > 0) updateMenuHeight()
  if (following.value) scrollLatest()
}

// 成功响应先锁定本组，防止桌面状态尚未广播时再次点击；失败保留组件草稿。
function submitAnswers(questionGroupId: string, turnId: string, answers: QuestionAnswer[]) {
  if (!canWrite.value || submittedGroupIds.value.indexOf(questionGroupId) >= 0) return
  // 只能提交当前实时快照中仍有效的题组，缓存展示编号永远不能成为写入目标。
  if (!liveConversation.value?.questionGroups.some((group: QuestionGroup): boolean => group.id == questionGroupId && group.turnId == turnId && group.state == 'pending')) return
  const threadId = pageThreadId.value
  busy.value = true; pendingAction.value = 'question:' + questionGroupId
  bridge.request('question.reply', { threadId, questionGroupId, turnId, answers }, true).then((_: UTSJSONObject) => {
    busy.value = false; pendingAction.value = ''
    if (isCurrentPage()) { submittedGroupIds.value.push(questionGroupId); refresh() }
  }, (error: Error) => { busy.value = false; pendingAction.value = ''; if (isCurrentPage()) operationError.value = error.message })
}
// 两个重试入口共享轮次占位，成功回执到新轮次广播之间也不能重复点击。
function retrySubmitting(turnId: string): boolean { return submittedRetryKey.value == pageHostId.value + ':' + pageThreadId.value + ':' + turnId }
function canRetryTurn(turnId: string): boolean { return turnId.length > 0 && retryTurnId.value == turnId && canWrite.value && goalHostOnline.value && liveConversation.value?.supportsTurnRetry == true && !retrySubmitting(turnId) }

function retryTurn(turnId: string, fromComposer: boolean = false) {
  if (!canRetryTurn(turnId)) return
  const hostId = pageHostId.value, threadId = pageThreadId.value, key = hostId + ':' + threadId + ':' + turnId
  submittedRetryKey.value = key; operationError.value = ''; busy.value = true; pendingAction.value = fromComposer ? 'retry:composer' : 'retry:timeline'
  bridge.request('turn.retry', { threadId, expectedTurnId: turnId }, true).then((_: UTSJSONObject) => {
    busy.value = false; pendingAction.value = ''
    if (isCurrentPage() && pageHostId.value == hostId && pageThreadId.value == threadId) { resumeFollowing(); refresh() }
  }, (error: Error) => {
    if (bridge.pendingCommand(hostId, threadId).length == 0 && submittedRetryKey.value == key) submittedRetryKey.value = ''
    busy.value = false; pendingAction.value = ''
    if (isCurrentPage() && pageHostId.value == hostId && pageThreadId.value == threadId) { operationError.value = error.message; bridge.watch(threadId) }
  })
}
// 未知结果只核对原命令，不重新发送；接受后保留占位直到新状态到达。
function checkRetryOutcome() {
  if (!connection.connected || busy.value || pendingRetryCommand.value.length == 0) return
  const hostId = pageHostId.value, threadId = pageThreadId.value, commandId = pendingRetryCommand.value
  busy.value = true; pendingAction.value = 'check-retry'
  bridge.request('command.status', { commandId }).then((status: UTSJSONObject) => {
    busy.value = false; pendingAction.value = ''
    const error = status['error'] as UTSJSONObject | null
    const done = status.getString('state') == 'done' && error?.getBoolean('outcomeUnknown') != true
    if (done) { bridge.clearCommand(commandId, hostId); if (error != null) submittedRetryKey.value = '' }
    if (isCurrentPage() && pageHostId.value == hostId && pageThreadId.value == threadId) { operationError.value = done ? error?.getString('message') ?? '' : '重试结果仍待核对，请勿重复提交'; bridge.watch(threadId) }
  }, (error: Error) => { busy.value = false; pendingAction.value = ''; if (isCurrentPage() && pageHostId.value == hostId && pageThreadId.value == threadId) operationError.value = error.message })
}

// 仅在明确收到成功响应后清空草稿，未知结果保留并要求先核对。
function send() {
  const text = draft.value.trim()
  if ((text.length == 0 && draftImages.value.length == 0 && draftFiles.value.length == 0) || !canWrite.value || imageBusy.value || !filesReady.value) return
  if (draftImages.value.length > 0 && !modelSupportsImages.value) { notify('当前模型不支持图片，请切换模型'); return }
  if (draftImages.value.length > 0 && connection.snapshot?.supportsImages != true) { notify('请先更新电脑连接服务以发送图片'); return }
  if (draftMentions.value.length > 0 && connection.snapshot?.supportsThreadMentions != true) { notify('请更新电脑连接服务后引用聊天'); return }
  closeThreadMentions(false)
  operationError.value = ''
  busy.value = true; pendingAction.value = 'send'
  const hostId = pageHostId.value
  const threadId = pageThreadId.value
  // 偏好只作用于本次新消息；已排队消息继续使用原队列及手动追加入口。
  const running = activeTurnId.value.length > 0 || connection.snapshot?.status == 'active'
  const steer = messageSendingPreferences.behavior == 'steer' && running
  if (steer && activeTurnId.value.length == 0) { busy.value = false; pendingAction.value = ''; operationError.value = '当前任务状态正在同步，请稍后重新发送'; return }
  const method = steer ? 'turn.steer' : 'turn.send'
  const queue = messageSendingPreferences.behavior == 'queue' && connection.snapshot?.supportsMessageQueue == true
  if (!steer && !queue && running) { busy.value = false; pendingAction.value = ''; operationError.value = '请更新电脑连接服务后使用默认排队'; return }
  const choices = { ...readMessageChoices(hostId, threadId) } as MessageChoices
  if (hasMessageChoices(choices) && connection.snapshot?.supportsDirectMessageChoices != true) { busy.value = false; pendingAction.value = ''; operationError.value = '请更新电脑连接服务后发送所选设置，草稿已保留'; return }
  if (steer && choices.mode != null) { busy.value = false; pendingAction.value = ''; operationError.value = '此消息包含计划模式选择，请改为排队发送'; return }
  const params: UTSJSONObject = { threadId, text, images: draftImages.value.map((image: DraftImage): string => image.src), attachments: draftFiles.value.map((file: DraftFile): string => file.id) }
  if (draftMentions.value.length > 0) params['threadMentionIds'] = draftMentions.value.map((mention: SelectedThreadMention): string => mention.id)
  if (draftPlugins.value.length > 0) params['pluginIds'] = draftPlugins.value.map((plugin: SelectedPlugin): string => plugin.id)
  if (hasMessageChoices(choices)) params['choices'] = messageChoicesParams(choices)
  if (queue) params['queueAction'] = 'enqueue'
  if (steer) params['expectedTurnId'] = activeTurnId.value
  const request = bridge.request(method, params, true)
  const commandId = connection.pendingCommandId
  rememberSubmission(hostId, threadId, commandId, text)
  request.then((result: UTSJSONObject) => { settleSubmission(hostId, commandId, true); busy.value = false; pendingAction.value = ''; if (isCurrentPage()) { resumeFollowing(); notify(steer ? '已追加到当前任务' : result['queued'] == true ? '已加入消息队列' : '指令已发送') } }, (error: Error) => { if (bridge.pendingCommand(hostId, pageThreadId.value) != commandId) settleSubmission(hostId, commandId, false); busy.value = false; pendingAction.value = ''; if (isCurrentPage()) operationError.value = error.message })
}
// 状态来自守护进程入库任务，真实用户消息回显后由同编号正文替换占位。
function submittedMessageStatus(state: string): string {
  if (state == 'queued') return '已入库，等待发送'
  if (state == 'running') return '发送中'
  if (state == 'succeeded') return '已发送，正在同步'
  if (state == 'failed') return '发送失败，请查看执行记录'
  if (state == 'unknown' || state == 'waiting_resume') return '发送结果待核对，请查看执行记录'
  return '已入库'
}
// 回车先采纳占位预测；已有草稿才提交，空输入不会触发停止任务。
function applyComposerEnter() {
  if (!canWrite.value || imageBusy.value || !filesReady.value) return
  if (draft.value.length == 0 && visiblePrediction.value.length > 0) { acceptPrediction(false); return }
  if (draft.value.trim().length > 0 || draftImages.value.length > 0 || draftFiles.value.length > 0) send()
}

// 追加和取消都指向电脑保存的同一条消息，避免手机重传正文形成重复指令。
function operateQueuedMessage(id: string, action: string) {
  if (!canWrite.value || connection.snapshot?.supportsMessageQueue != true) return
  const hostId = pageHostId.value, threadId = pageThreadId.value
  busy.value = true; pendingAction.value = 'queue:' + action + ':' + id; operationError.value = ''
  bridge.request('turn.send', { threadId, queueAction: action, queueId: id, expectedTurnId: activeTurnId.value }, true).then((_: UTSJSONObject) => {
    busy.value = false; pendingAction.value = ''
    if (isCurrentPage() && pageHostId.value == hostId && pageThreadId.value == threadId) { notify(action == 'steer' ? '已追加到当前任务' : '已移除排队消息'); refresh() }
  }, (error: Error) => { busy.value = false; pendingAction.value = ''; if (isCurrentPage() && pageHostId.value == hostId && pageThreadId.value == threadId) operationError.value = error.message })
}
function steerQueuedMessage(id: string) { if (activeTurnId.value.length > 0) operateQueuedMessage(id, 'steer') }
function cancelQueuedMessage(id: string) { operateQueuedMessage(id, 'cancel') }
// 先撤回并恢复完整草稿，再确认清理撤回记录；失败时保留可继续读取的电脑端记录。
function editQueuedMessage(id: string) {
  if (!canWrite.value || imageBusy.value || connection.snapshot?.supportsQueueEditing != true) return
  const hostId = pageHostId.value, threadId = pageThreadId.value
  try { beginQueueEdit(hostId, threadId, draftPlugins.value.length > 0 || draftMentions.value.length > 0) } catch (error) { notify((error as Error).message); return }
  busy.value = true; pendingAction.value = 'queue:edit:' + id; operationError.value = ''
  bridge.request('turn.send', { threadId, queueAction: 'edit', queueId: id }, true).then((result: UTSJSONObject) => {
    try {
      const restored = JSON.parse<QueueEditDraft>(JSON.stringify(result['draft']))
      if (result.getBoolean('edited') != true || result.getString('queueId') != id || restored == null) throw new Error('撤回结果尚未确认，请重新同步后继续编辑')
      restoreQueuedDraft(hostId, threadId, id, restored, readDraftPlugins(hostId, threadId).length > 0 || readDraftThreadMentions(hostId, threadId).length > 0, (plugins: QueueEditPlugin[]) => { saveDraftPlugins(hostId, threadId, plugins.map((plugin: QueueEditPlugin): SelectedPlugin => ({ id: plugin.id, displayName: plugin.displayName } as SelectedPlugin))) }, (mentions: SelectedThreadMention[]) => { saveDraftThreadMentions(hostId, threadId, mentions) })
    } catch (error) {
      finishQueueEdit(hostId, threadId); busy.value = false; pendingAction.value = ''
      if (isCurrentPage() && pageHostId.value == hostId && pageThreadId.value == threadId) operationError.value = (error as Error).message
      return
    }
    // 草稿已恢复后才移除记录；清理回执丢失也不会重新发送或清空正在编辑的内容。
    const cleanup = connection.hostId == hostId ? bridge.request('turn.send', { threadId, queueAction: 'cancel', queueId: id }, true) : null
    finishQueueEdit(hostId, threadId); busy.value = false; pendingAction.value = ''
    if (pageVisible.value && isCurrentPage() && pageHostId.value == hostId && pageThreadId.value == threadId) { focusComposerInput(); notify('已撤回，编辑后可重新发送') }
    cleanup?.then((_: UTSJSONObject) => {}, (_: Error) => { if (isCurrentPage() && pageHostId.value == hostId && pageThreadId.value == threadId) operationError.value = '内容已恢复到输入框；撤回记录清理尚未确认，可同步后移除记录' })
  }, (error: Error) => {
    finishQueueEdit(hostId, threadId); busy.value = false; pendingAction.value = ''
    if (isCurrentPage() && pageHostId.value == hostId && pageThreadId.value == threadId) operationError.value = error.message
  })
}
let stopPromptOpen = false
// 所有停止入口共用确认框，确认时复核原会话及任务，避免误停后续任务。
function stop(fromComposer: boolean = true) {
  if (!canWrite.value || activeTurnId.value.length == 0 || stopPromptOpen) return
  const hostId = pageHostId.value
  const threadId = pageThreadId.value
  const turnId = activeTurnId.value
  stopPromptOpen = true
  uni.showModal({ title: '停止任务', content: '确定停止当前正在执行的任务吗？', confirmText: '停止', confirmColor: '#bb3f44', cancelText: '取消', success: (choice) => {
    stopPromptOpen = false
    if (!choice.confirm || !isCurrentPage() || !pageVisible.value || connection.hostId != hostId || pageThreadId.value != threadId || activeTurnId.value != turnId || !canWrite.value) return
    busy.value = true; pendingAction.value = fromComposer ? 'stop' : 'stop:menu'
    bridge.request('turn.stop', { threadId, expectedTurnId: turnId }, true).then((_: UTSJSONObject) => { busy.value = false; pendingAction.value = ''; if (isCurrentPage()) { notify('停止请求已提交'); refresh() } }, (error: Error) => { busy.value = false; pendingAction.value = ''; if (isCurrentPage()) operationError.value = error.message })
  }, fail: (_) => { stopPromptOpen = false } })
}
function reply(id: string, turnId: string, decision: string) {
  if (!canWrite.value || handledApprovalIds.value.indexOf(id) >= 0) return
  const hostId = pageHostId.value, threadId = pageThreadId.value
  busy.value = true; pendingAction.value = 'approval:' + decision + ':' + id
  bridge.request('approval.reply', { threadId, approvalId: id, turnId, decision }, true).then((_: UTSJSONObject) => { busy.value = false; pendingAction.value = ''; if (isCurrentPage() && pageHostId.value == hostId && pageThreadId.value == threadId) { handledApprovalIds.value.push(id); notify(decision == 'accept' ? '已允许本次操作' : '已拒绝本次操作'); refresh() } }, (error: Error) => { busy.value = false; pendingAction.value = ''; if (isCurrentPage() && pageHostId.value == hostId && pageThreadId.value == threadId) operationError.value = error.message })
}
// 目标表单与聊天草稿独立，提交仅使用编辑开始时捕获的目标版本。
function goalExpansion(value: boolean) { goalExpanded.value = value; if (value) closeComposerMenu() }
// 聚焦只展开编辑面板并收起目标表单，不采纳或发送预测。
function onComposerFocus() { clearTimeout(composerBlurTimer); inputFocused.value = true; dismissGoal() }
function goalKeyboard(height: number) { goalViewportHeight.value = uni.getWindowInfo().windowHeight; const resized = Math.max(0, baseWindowHeight - uni.getWindowInfo().windowHeight); keyboardInset.value = height > 0 ? Math.max(0, height - resized) : 0 }
function operateGoal(action: string, objective: string, revision: string) {
  if (!canWrite.value || !goalHostOnline.value || goalBusy.value || connection.snapshot?.supportsGoalControl != true) return
  busy.value = true; goalBusy.value = true; pendingAction.value = action; operationError.value = ''
  const hostId = pageHostId.value
  const threadId = pageThreadId.value
  const params: UTSJSONObject = { threadId, action, expectedRevision: revision }
  if (action == 'create' || action == 'edit') params['objective'] = objective
  bridge.request('thread.goal.update', params, true).then((result: UTSJSONObject) => {
    if (isCurrentPage() && pageHostId.value == hostId && pageThreadId.value == threadId && connection.snapshot != null) {
      connection.snapshot!.goal = result['goal'] == null ? null : JSON.parse<ThreadGoal>(JSON.stringify(result['goal']))
      connection.snapshot!.goalRevision = result.getString('goalRevision') ?? 'none'
    }
    busy.value = false; goalBusy.value = false; pendingAction.value = ''
    if (isCurrentPage() && pageHostId.value == hostId && pageThreadId.value == threadId) { notify(action == 'clear' ? '目标已清除' : '目标已同步'); refresh() }
  }, (error: Error) => { busy.value = false; goalBusy.value = false; pendingAction.value = ''; if (isCurrentPage() && pageHostId.value == hostId && pageThreadId.value == threadId) operationError.value = error.message })
}

// 主按钮随上下文切换：有草稿发送，空草稿运行中停止。
const primaryAvailable = computed((): boolean => canWrite.value && !imageBusy.value && filesReady.value && (draft.value.trim().length > 0 || draftImages.value.length > 0 || draftFiles.value.length > 0 || (draftMentions.value.length == 0 && (activeTurnId.value.length > 0 || canRetryTurn(retryTurnId.value)))))
function primaryAction() { if (!canWrite.value || imageBusy.value || !filesReady.value) return; if (draft.value.trim().length > 0 || draftImages.value.length > 0 || draftFiles.value.length > 0) send(); else if (draftMentions.value.length > 0) return; else if (activeTurnId.value.length > 0) stop(); else retryTurn(retryTurnId.value, true) }
function stopFromMenu() { if (!canWrite.value) return; closeActions(); stop(false) }
// 原生返回优先关闭当前浮层，再交给页面导航；不会丢失会话草稿。
function handleBack(): boolean {
  const handle = (): boolean => { if (mentionOpen.value) { closeThreadMentions(); return true }; if (deleteFinalVisible.value) { answerDeleteFinal(false); return true }; if (selectedPlanId.value.length > 0) { closePlan(); return true }; if (selectedFileReport.value != null) { closeFileReport(); return true }; if (selectedAnnotationId.value.length > 0) { closeAnnotations(); return true }; if (goalExpanded.value) { dismissGoal(); uni.hideKeyboard(); return true }; if (composerMenu.value.length > 0) { closeComposerMenu(); return true }; if (selectedExecutionId.value.length > 0) { closeExecution(); return true }; if (actionsVisible.value) { closeActions(); return true }; return false }
  return handle()
}

// 隐藏面板停掉预测和浮层；重新可见时恢复读取，不重放桌面导航。
function syncPaneVisibility(active: boolean) {
  (active ? paneShowCallbacks : paneHideCallbacks).forEach((callback: () => void) => { callback() })
  if (active && connection.hostId == pageHostId.value && connection.activeThreadId != pageThreadId.value) bridge.watch(pageThreadId.value)
  if (!active) { resetPrediction(); inputFocused.value = false; predictionFocus.value = false; closeActions(); closeComposerMenu(); dismissGoal() }
}
function goBack() { if (handleBack()) return; uni.hideKeyboard(); emit('close') }

defineExpose({ handleBack, goBack })
onMounted(() => { syncPaneVisibility(props.active) })
watch((): boolean => props.active, (active: boolean) => { syncPaneVisibility(active) })
// 视口已改变时 DOM 可能提前重排，必须使用最后一次稳定阅读锚点，不能重测为新位置。
function resizeConversationPane() {
  if (!following.value && !touchingTimeline && readingPosition != null) {
    pendingReadingPosition = readingPosition; readingCorrectionPending = true
    readingFloor.value = Math.max(readingFloor.value, readingPosition!.top + readingPosition!.height)
  } else beforeMarkdownLayout()
  nextTick(() => { paneResizeCallbacks.forEach((callback: () => void) => { callback() }); afterMarkdownLayout() })
}
watch((): string => props.paneWidth + ':' + props.paneHeight, () => { resizeConversationPane() })

// 换配对、实例或撤权时清除当前面板的旧历史，短暂断线保留阅读位置。
let pageGeneration = connection.computers.find((computer: Computer): boolean => computer.id == pageHostId.value)?.instanceGeneration ?? ''
watch((): string => connection.cacheNamespace + ':' + connection.connected + ':' + connection.computers.map((computer: Computer): string => computer.id + ':' + (computer.instanceGeneration ?? '')).join('|'), () => {
  const computer = connection.computers.find((item: Computer): boolean => item.id == pageHostId.value)
  const generation = computer?.instanceGeneration ?? ''
  if (props.target.cacheNamespace != connection.cacheNamespace || (connection.connected && computer == null) || (pageGeneration.length > 0 && generation.length > 0 && pageGeneration != generation)) {
    historyPage.value = null; historyRequest++; historyError.value = ''
    timelineBoundary.value = ''; timelineFilled.value = false; timelineFillStarted = false
    cancelReadingCorrection(); closeFileReport()
  }
  if (generation.length > 0) pageGeneration = generation
})
// 入队即释放页面操作锁；模型/桌面结果继续由应用级任务跟随。
if (typeof submissionTasks != 'undefined') watch((): number => submissionTasks.accepted.revision, () => {
  const accepted = submissionTasks.accepted
  if (accepted.hostId != pageHostId.value || accepted.threadId != pageThreadId.value) return
  if (!submissionHasMessageChoices(accepted.hostId, accepted.taskId)) settleSubmission(accepted.hostId, accepted.taskId, true)
  busy.value = false; goalBusy.value = false; pendingAction.value = ''
  // 只响应本详情发起的删除或归档；迟到入队回执不能关闭重新打开的聊天。
  if (accepted.taskId != removalSubmissionId.value || (accepted.method != 'thread.delete' && accepted.method != 'thread.archive')) return
  removalSubmissionId.value = ''
  if (removalReturnStarted.value || !pageVisible.value || !isCurrentPage()) return
  removalReturnStarted.value = true; hideArchiveLoading(); emit('close')
})
// 入队监听结束
</script>

