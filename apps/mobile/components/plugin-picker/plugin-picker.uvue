<template>
  <view class="plugin-overlay" @click="close">
    <view class="plugin-sheet" @click.stop>
      <view class="plugin-heading"><text class="plugin-title">选择插件</text><view class="plugin-close action-frame"><app-icon name="close" :size="20" /><button class="action-hitbox" aria-label="取消选择插件" @click="close"></button></view></view>
      <text class="plugin-hint">仅用于本次消息，最多20个；安装与授权请在电脑端完成</text>
      <input v-model="query" class="plugin-search" placeholder="搜索插件名称或简介" aria-label="搜索插件" :maxlength="100" />
      <scroll-view direction="vertical" class="plugin-list" :style="{ height: listHeight + 'px' }" :show-scrollbar="false">
        <view v-if="loading && !manualRetry" class="plugin-empty"><text class="plugin-note">正在读取电脑插件…</text></view>
        <view v-else-if="error.length > 0 || manualRetry" class="plugin-empty"><text class="plugin-error">{{ error }}</text><view class="plugin-retry inline-progress-button"><action-progress :busy="manualRetry" /><text class="inline-progress-caption" style="color: #536050; font-size: 13px;">重新读取</text><button class="inline-progress-hitbox" @click="retry" :disabled="manualRetry" :aria-label="(manualRetry) ? '正在重新读取' : '重新读取'"></button></view></view>
        <template v-else>
          <view v-for="plugin in missing" :key="plugin.id" class="plugin-row plugin-unavailable action-frame"><app-icon name="plugin" :size="22" tone="muted" /><view class="plugin-copy"><text class="plugin-name">{{ plugin.displayName }}</text><text class="plugin-description">已不可用，请取消选择</text></view><app-icon name="check" :size="20" tone="muted" /><button class="action-hitbox" :aria-label="'取消不可用插件 ' + plugin.displayName" @click="toggle(plugin)"></button></view>
          <view v-for="plugin in filtered" :key="plugin.id" class="plugin-row action-frame" :class="{ 'plugin-row-selected': isSelected(plugin.id) }"><app-icon name="plugin" :size="22" tone="muted" /><view class="plugin-copy"><text class="plugin-name">{{ plugin.displayName }}</text><text v-if="plugin.description.length > 0" class="plugin-description">{{ plugin.description }}</text></view><view class="plugin-check"><app-icon v-if="isSelected(plugin.id)" name="check" :size="20" /></view><button class="action-hitbox" role="checkbox" :aria-checked="isSelected(plugin.id)" :aria-label="(isSelected(plugin.id) ? '取消选择 ' : '选择插件 ') + plugin.displayName" @click="toggleOption(plugin)"></button></view>
          <view v-if="filtered.length == 0" class="plugin-empty"><text class="plugin-note">{{ query.trim().length > 0 ? '没有匹配的插件' : '当前电脑和项目暂无可用插件' }}</text></view>
        </template>
      </scroll-view>
      <view class="plugin-footer"><button class="plugin-clear" :disabled="selected.length == 0" @click="clear">清空选择</button><button class="plugin-confirm" :disabled="loading || error.length > 0 || missing.length > 0" @click="confirm">{{ selected.length > 0 ? '确认选择 · ' + selected.length : '确认' }}</button></view>
    </view>
  </view>
</template>
<script setup lang="uts">
import { computed, ref, watch, onUnmounted } from 'vue'
import AppIcon from '../app-icon/app-icon.uvue'
import { bridge, connection } from '../../services/bridge.uts'
import { PluginOption, SelectedPlugin, PluginsResponse, filterPlugins, copyPluginSelection } from '../../services/plugins.uts'
const props = defineProps<{ hostId: string, threadId: string, projectId: string, plugins: SelectedPlugin[] }>()
const emit = defineEmits<{ (event: 'confirm', plugins: SelectedPlugin[]): void; (event: 'close'): void }>()
const options = ref<PluginOption[]>([]), selected = ref<SelectedPlugin[]>([]), query = ref(''), loading = ref(false), error = ref('')
const listHeight = Math.max(120, Math.min(380, uni.getWindowInfo().windowHeight - 300))
const filtered = computed((): PluginOption[] => filterPlugins(options.value, query.value))
const missing = computed((): SelectedPlugin[] => selected.value.filter((plugin: SelectedPlugin): boolean => !options.value.some((option: PluginOption): boolean => option.id == plugin.id)))
let revision = 0, alive = true
const manualRetry = ref(false)
const context = computed((): string => connection.configurationRevision + ':' + props.hostId + ':' + props.threadId + ':' + props.projectId + ':' + connection.hostId + ':' + connection.connected)

// 固定读取目标和请求代次；切换电脑、项目、配对或关闭后拒绝迟到结果。
async function load() {
  const key = context.value, request = ++revision
  options.value = [] as PluginOption[]; error.value = ''; loading.value = true
  if (!connection.connected || connection.hostId != props.hostId) { loading.value = false; error.value = '请先连接所选电脑'; return }
  if (props.threadId.length == 0 && props.projectId.length == 0) { loading.value = false; error.value = '请先选择项目，再选择插件'; return }
  try {
    const result = await bridge.request(props.threadId.length > 0 ? 'thread.plugins.read' : 'thread.create.plugins', props.threadId.length > 0 ? { threadId: props.threadId } : { projectId: props.projectId })
    if (!alive || request != revision || key != context.value) return
    const response = JSON.parse<PluginsResponse>(JSON.stringify(result))
    if (response?.supportsPluginSelection != true) throw new Error('请更新电脑连接服务和中转后选择插件')
    options.value = response!.plugins
  } catch (reason) {
    if (!alive || request != revision || key != context.value) return
    const message = (reason as Error).message
    error.value = message.indexOf('接口') >= 0 || message.indexOf('允许') >= 0 ? '请更新电脑连接服务和中转后选择插件' : message
  }
  if (alive && request == revision && key == context.value) loading.value = false
}
// 用户点重试时保留原按钮，自动载入仍显示列表提示。
async function retry() {
  if (loading.value) return
  manualRetry.value = true
  const request = revision + 1
  try { await load() } finally { if (alive && request == revision) manualRetry.value = false }
}
function isSelected(id: string): boolean { return selected.value.some((plugin: SelectedPlugin): boolean => plugin.id == id) }
// 不可用的旧选择只允许取消，避免读取失败后重新加入失效插件。
function toggle(plugin: SelectedPlugin) {
  if (loading.value || error.value.length > 0) return
  if (isSelected(plugin.id)) selected.value = selected.value.filter((item: SelectedPlugin): boolean => item.id != plugin.id)
  else if (options.value.some((item: PluginOption): boolean => item.id == plugin.id)) {
    if (selected.value.length >= 20) { uni.showToast({ title: '每次最多选择20个插件', icon: 'none' }); return }
    selected.value.push({ id: plugin.id, displayName: plugin.displayName } as SelectedPlugin)
  }
}
// 目录记录和已选插件在 Android 上是不同类型。
function toggleOption(plugin: PluginOption) { toggle({ id: plugin.id, displayName: plugin.displayName } as SelectedPlugin) }
function clear() { selected.value = [] as SelectedPlugin[] }
function close() { revision++; emit('close') }
function confirm() { if (!loading.value && error.value.length == 0 && missing.value.length == 0) { revision++; emit('confirm', copyPluginSelection(selected.value)) } }
watch((): string => context.value, () => { manualRetry.value = false; selected.value = copyPluginSelection(props.plugins); query.value = ''; load() }, { immediate: true })
onUnmounted(() => { alive = false; revision++ })
</script>
<style>
.action-frame { position: relative; overflow: hidden; flex-shrink: 0; }
.action-hitbox { position: absolute; left: 0; top: 0; width: 100%; height: 100%; margin: 0; padding: 0; border-width: 0; border-radius: 0; background-color: transparent; font-size: 1px; line-height: 1px; }
.plugin-overlay { position: fixed; top: 0; bottom: 0; left: 0; right: 0; z-index: 90; background-color: rgba(0, 0, 0, 0.3); justify-content: flex-end; }
.plugin-sheet { width: 100%; border-top-left-radius: 24px; border-top-right-radius: 24px; background-color: #fbfcf9; padding: 18px 18px 24px; padding-bottom: calc(24px + env(safe-area-inset-bottom)); }
.plugin-heading { flex-direction: row; align-items: center; justify-content: space-between; }
.plugin-title { color: #26392d; font-size: 19px; font-weight: bold; }
.plugin-close { width: 36px; height: 36px; align-items: center; justify-content: center; }
.plugin-hint { color: #74806e; font-size: 12px; line-height: 20px; margin: 3px 0 14px; }
.plugin-search { background-color: #eef1e9; border-radius: 12px; height: 44px; padding: 0 12px; font-size: 14px; color: #26392d; margin-bottom: 10px; }
.plugin-list { width: 100%; }
.plugin-row { flex-direction: row; align-items: center; gap: 12px; padding: 13px 10px; border-radius: 12px; min-height: 66px; margin-bottom: 3px; }
.plugin-row-selected { background-color: #e9efe3; }
.plugin-copy { flex: 1; min-width: 0; }
.plugin-name { font-size: 15px; color: #26392d; line-height: 22px; }
.plugin-description { font-size: 12px; color: #74806e; line-height: 18px; margin-top: 3px; lines: 2; overflow: hidden; text-overflow: ellipsis; }
.plugin-check { width: 20px; height: 20px; flex-shrink: 0; }
.plugin-unavailable { background-color: #f8eee8; }
.plugin-empty { padding: 32px 12px; align-items: center; }
.plugin-note, .plugin-error { font-size: 14px; line-height: 22px; text-align: center; color: #74806e; }
.plugin-error { color: #a13830; }
.plugin-retry { font-size: 13px; line-height: 32px; padding: 0 16px; margin-top: 16px; border-radius: 10px; color: #536050; background-color: #eef1e9; }
.plugin-footer { flex-direction: row; gap: 12px; padding-top: 14px; }
.plugin-clear, .plugin-confirm { font-size: 14px; line-height: 44px; border-radius: 12px; margin: 0; padding: 0 16px; align-items: center; justify-content: center; }
.plugin-clear { color: #69766b; background-color: #eef1e9; }
.plugin-confirm { flex: 1; color: #fff; background-color: #536b49; }
.plugin-confirm[disabled], .plugin-clear[disabled] { opacity: 0.45; }
/* #ifdef WEB */
.plugin-sheet { box-sizing: border-box; }
.plugin-description { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.plugin-confirm::after, .plugin-clear::after, .plugin-retry::after { border: none; }
.action-hitbox::after { border: none; }
/* #endif */
</style>
