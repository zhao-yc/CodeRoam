<template>
  <view class="permission-control">
    <!-- 常规权限入口与加号、清空图标共用深色，完全访问保留警示色。 -->
    <view :id="triggerId" class="permission-trigger" :style="{ opacity: disabled || !available || busy || loading ? 0.45 : 1 }"><app-icon :name="permissionIcon(mode)" :size="22" :tone="mode == 'full-access' ? 'warning' : 'dark'" /><button class="permission-trigger-hit" :disabled="disabled || !available || busy" :aria-label="'选择权限，当前' + label" @click.stop="openMenu"></button></view>
    <view v-if="opened" class="permission-overlay" :style="{ left: paneLeft + 'px', right: paneWidth > 0 ? 'auto' : '0px', width: paneWidth > 0 ? paneWidth + 'px' : 'auto' }" @click="closeMenu">
      <view class="permission-panel" :style="{ left: panelLeft + 'px', bottom: panelBottom + 'px', width: panelWidth + 'px' }" @click.stop>
        <view class="permission-heading"><text class="permission-title">{{ label }}</text><view class="permission-close"><app-icon name="close" :size="20" /><button class="permission-close-hit" :disabled="busy" aria-label="关闭权限选择" @click="closeMenu"></button></view></view>
        <scroll-view direction="vertical" :style="{ height: panelHeight + 'px' }">
          <text v-if="loading && !manualRetry" class="permission-note">正在读取电脑权限…</text>
          <template v-else><view v-for="option in state?.options ?? []" :key="option.id" class="permission-row" :style="{ opacity: option.enabled ? 1 : 0.45 }"><view class="permission-symbol"><app-icon :name="permissionIcon(option.id)" :size="24" :tone="option.id == 'full-access' ? 'warning' : 'dark'" /></view><view class="permission-copy"><text class="permission-name">{{ option.label }}</text><text class="permission-description">{{ option.enabled ? option.description : option.disabledReason }}</text></view><loading v-if="pendingMode == option.id && !pendingQueued" class="permission-spinner" /><text v-else-if="pendingMode == option.id && pendingQueued" class="permission-queued">待执行</text><view v-else-if="mode == option.id" class="permission-check"><app-icon name="check" :size="22" /></view><button class="permission-hit" :disabled="busy || disabled || !option.enabled" :aria-label="pendingMode == option.id ? '正在同步' + option.label : '选择' + option.label" @click="choose(option.id)"></button></view></template>
          <text v-if="threadId.length > 0 && activeTurn" class="permission-note">沙箱权限用于下一轮；当前轮次审批方式按电脑能力同步。</text>
          <text v-if="pendingQueued" class="permission-note">权限修改已入队，当前显示电脑已确认的权限。</text><text v-if="busy && pendingMode.length == 0" class="permission-note">正在同步电脑权限…</text>
          <text v-if="error.length > 0" class="permission-error">{{ error }}</text><view v-if="error.length > 0 || manualRetry" class="permission-retry inline-progress-button"><action-progress :busy="manualRetry" /><text class="inline-progress-caption" style="font-size: 13px; color: #4546bd;">重新读取</text><button class="inline-progress-hitbox" :disabled="busy || loading || manualRetry" :aria-label="manualRetry ? '正在重新读取权限' : '重新读取'" @click="retry"></button></view>
        </scroll-view>
      </view>
    </view>
  </view>
</template>
<script setup lang="uts">
import { ref, computed, watch, onUnmounted } from 'vue'
import AppIcon from '../app-icon/app-icon.uvue'
import { bridge, connection } from '../../services/bridge.uts'
import { PermissionState, permissionLabel } from '../../services/permissions.uts'
import { submissionTasks } from '../../services/submission-task-state.uts'
const props = withDefaults(defineProps<{ threadId?: string, projectId?: string, selectedMode?: string, deferChanges?: boolean, disabled?: boolean, active?: boolean, draftId?: string, nativeDraft?: boolean, nativeState?: PermissionState | null, nativeStatus?: string, nativeBusy?: boolean, paneLeft?: number, paneWidth?: number }>(), { threadId: '', projectId: '', selectedMode: '', deferChanges: false, disabled: false, active: true, draftId: '', nativeDraft: false, nativeState: null, nativeStatus: '', nativeBusy: false, paneLeft: 0, paneWidth: 0 })
const emit = defineEmits<{ select: [mode: string, confirmed: boolean, revision: string], busy: [value: boolean], visibility: [value: boolean], applied: [hostId: string, threadId: string], refresh: [] }>()
const manualRetry = ref(false), pendingMode = ref('')
const pendingPermissionCommand = ref(''), pendingQueued = ref(false)
const opened = ref(false), loading = ref(false), busy = ref(false), error = ref(''), state = ref<PermissionState | null>(null)
const panelLeft = ref(14), panelBottom = ref(100), panelWidth = ref(330), panelHeight = ref(360)
let alive = true, request = 0
// 新建权限不依赖已有会话订阅；展开、联网及电脑在线状态均参与请求失效判断。
const isNative = computed((): boolean => props.nativeDraft == true || (props.draftId ?? '').length > 0 || props.nativeState != null)
const available = computed((): boolean => props.active && connection.connected && connection.computers.some((computer): boolean => computer.id == connection.hostId && computer.online) && (isNative.value ? (props.draftId ?? '').length > 0 && props.nativeState != null && props.nativeStatus == 'ready' : props.threadId.length > 0 ? connection.snapshot?.threadId == props.threadId && connection.snapshot?.readOnly != true && connection.snapshot?.supportsPermissionSettings == true : props.projectId.length > 0))

const context = computed((): string => connection.hostId + ':' + props.threadId + ':' + props.projectId + ':' + props.draftId + ':' + props.nativeStatus + ':' + (props.nativeState?.revision ?? '') + ':' + (props.threadId.length > 0 ? connection.subscriptionRevision.toString() : '') + ':' + connection.connected.toString() + ':' + props.active.toString() + ':' + available.value.toString())
// 入队只释放控件及父级操作锁，只有最终确认成功才发送 applied 事件。
if (typeof submissionTasks != 'undefined') watch((): number => submissionTasks.accepted.revision, () => {
  const accepted = submissionTasks.accepted
  if (accepted.method != 'thread.permissions.update' || accepted.hostId != connection.hostId || accepted.threadId != props.threadId || accepted.taskId != pendingPermissionCommand.value) return
  pendingQueued.value = true; busy.value = false; opened.value = false; emit('busy', false)
})
const triggerId = computed((): string => 'permissions-' + (props.threadId.length > 0 ? props.threadId : (props.draftId ?? '').length > 0 ? props.draftId! : 'new'))
const mode = computed((): string => isNative.value ? props.nativeState?.mode ?? 'unknown' : props.threadId.length > 0 ? props.deferChanges && props.selectedMode.length > 0 ? props.selectedMode : connection.snapshot?.permissionSettings?.mode ?? 'unknown' : props.selectedMode.length > 0 ? props.selectedMode : state.value?.mode ?? 'unknown')
const label = computed((): string => loading.value ? '正在读取电脑权限…' : permissionLabel(mode.value))
const activeTurn = computed((): boolean => (connection.snapshot?.activeTurnId ?? '').length > 0 || connection.snapshot?.status == 'active')
// 权限图标统一使用随包线性 PNG，不依赖系统字体或表情渲染。
function permissionIcon(value: string): string { if (value == 'auto-review') return 'shield-check'; if (value == 'read-only') return 'lock'; if (value == 'full-access') return 'alert-triangle'; return 'hand-stop' }
// 所有异步响应绑定电脑、项目或会话；切换目标后立即作废。
function current(key: string, id: number): boolean { return alive && available.value && context.value == key && request == id }
// 同一目标只允许一次在途读取；默认值只用于展示，不作为用户的权限选择写入草稿。
async function load(manual: boolean = false) {
  if (!available.value || busy.value || loading.value) return
  // 原生草稿由父组件统一 read；即使尚无编号，也绝不降级为 CLI 创建权限。
  if (isNative.value) { state.value = props.nativeState; emit('refresh'); return }
  const key = context.value, id = ++request
  loading.value = true; manualRetry.value = manual; error.value = ''; state.value = null
  try {
    const result = await bridge.request(props.threadId.length > 0 ? 'thread.permissions.read' : 'thread.create.permissions', props.threadId.length > 0 ? { threadId: props.threadId } : { projectId: props.projectId })
    if (!current(key, id)) return
    const value = JSON.parse<PermissionState>(JSON.stringify(result))
    if (value == null || value.options == null) throw new Error('电脑权限暂不可用，请更新连接服务')
    state.value = value
  } catch (reason) { if (current(key, id)) error.value = (reason as Error).message }
  finally { if (current(key, id)) { loading.value = false; manualRetry.value = false } }
}
// 菜单重试只在原按钮显示进度，自动读取继续使用面板提示。
function retry() { load(true) }
function openMenu() {
  if (props.disabled || props.nativeBusy || !available.value) return
  const info = uni.getWindowInfo(), rect = uni.getElementById(triggerId.value)?.getBoundingClientRect()
  const width = props.paneWidth > 0 ? props.paneWidth : info.windowWidth
  panelWidth.value = Math.min(340, width - 28)
  panelLeft.value = Math.max(14, Math.min((rect?.left ?? props.paneLeft + 14) - props.paneLeft, width - panelWidth.value - 14))
  panelBottom.value = Math.max(12, info.windowHeight - (rect?.top ?? info.windowHeight - 110) + 8)
  panelHeight.value = Math.max(100, Math.min(390, info.windowHeight - panelBottom.value - 100))
  opened.value = true
  // 新建菜单复用自动加载的结果；已有会话仍在打开菜单时刷新权限版本。
  if (isNative.value) state.value = props.nativeState
  else if (props.threadId.length > 0 || (state.value == null && error.value.length == 0)) load()
}
function closeMenu() { if (!busy.value) opened.value = false }
// 每次切入完整访问都先确认；确认弹窗返回后再次检查目标和权限版本。
async function choose(value: string) {
  if (props.disabled || props.nativeBusy || busy.value || loading.value || state.value == null || !available.value || !(state.value!.options ?? []).some((option): boolean => option.id == value && option.enabled)) return
  if (value == mode.value) { closeMenu(); return }
  const key = context.value, id = request, revision = state.value!.revision
  if (value == 'full-access') {
    const confirmed = await new Promise<boolean>((resolve) => { uni.showModal({ title: '启用完整访问权限', content: '将允许 Codex 访问电脑文件和网络，沙箱限制将解除。是否为此聊天启用？', confirmText: '确认启用', cancelText: '取消', success: (answer) => { resolve(answer.confirm) }, fail: (_) => { resolve(false) } }) })
    if (!confirmed || !current(key, id) || props.disabled || props.nativeBusy || !available.value || state.value?.revision != revision) return
  }
  if (isNative.value || props.threadId.length == 0 || props.deferChanges) { emit('select', value, value == 'full-access', revision); closeMenu(); return }
  let applied = false
  pendingMode.value = value; pendingQueued.value = false; busy.value = true; emit('busy', true); error.value = ''
  let commandId = ''
  try {
    const operation = bridge.request('thread.permissions.update', { threadId: props.threadId, mode: value, expectedRevision: revision, confirmedFullAccess: value == 'full-access' }, true)
    commandId =
      // #ifdef WEB
      typeof bridge.pendingCommand == 'function' ?
      // #endif
      bridge.pendingCommand(connection.hostId, props.threadId)
      // #ifdef WEB
      : ''
      // #endif
    pendingPermissionCommand.value = commandId
    const result = await operation
    if (current(key, id) && pendingPermissionCommand.value == commandId) { state.value = JSON.parse<PermissionState>(JSON.stringify(result)); opened.value = false; applied = true }
  } catch (reason) { if (current(key, id) && pendingPermissionCommand.value == commandId) error.value = (reason as Error).message }
  // 成功事件在父级操作锁释放后发出，仅当前电脑与聊天可以恢复编辑焦点。
  finally { if (alive && context.value == key && pendingPermissionCommand.value == commandId) { busy.value = false; pendingMode.value = ''; pendingQueued.value = false; pendingPermissionCommand.value = ''; emit('busy', false); if (applied) emit('applied', connection.hostId, props.threadId) } }
}
// 菜单打开时保持父级输入区展开，避免键盘失焦卸载菜单。
// 面板尺寸变化时关闭旧坐标的菜单，避免旋转后遮住另一栏。
watch((): string => props.paneLeft + ':' + props.paneWidth, () => { opened.value = false })
watch(opened, (value: boolean) => { emit('visibility', value) })
// 同步失效旧请求，避免快速收起再展开或切回原目标后，旧结果重新变为有效。
watch(context, () => {
  request++; state.value = null; error.value = ''; opened.value = false; loading.value = false; manualRetry.value = false; pendingMode.value = ''; pendingQueued.value = false; pendingPermissionCommand.value = ''
  if (busy.value) emit('busy', false)
  busy.value = false
  if (isNative.value) state.value = props.nativeState
  else if (props.threadId.length == 0 && available.value) load()
}, { immediate: true, flush: 'sync' })
onUnmounted(() => { emit('visibility', false); alive = false; request++; if (busy.value) emit('busy', false) })
</script>
<style>
/* 工具栏权限入口与加号、模型入口保持相同高度，图标居中。 */
.permission-control { width: 38px; height: 44px; flex-shrink: 0; }
.permission-trigger { position: relative; width: 38px; height: 44px; padding: 0; margin: 0; background-color: transparent; align-items: center; justify-content: center; }
.permission-trigger-hit { position: absolute; top: 0; bottom: 0; left: 0; right: 0; margin: 0; padding: 0; background-color: transparent; }
.permission-overlay { position: fixed; top: 0; bottom: 0; left: 0; right: 0; z-index: 250; background-color: rgba(0,0,0,0.12); }
.permission-panel { position: absolute; border-radius: 22px; padding: 8px; background-color: #ffffff; border-width: 1px; border-color: #e5e8f1; }
.permission-heading { height: 42px; flex-direction: row; align-items: center; padding-left: 12px; }
.permission-title { flex: 1; font-size: 14px; color: #596479; }
.permission-close { position: relative; width: 38px; height: 38px; align-items: center; justify-content: center; }
.permission-close-hit { position: absolute; top: 0; bottom: 0; left: 0; right: 0; padding: 0; margin: 0; background-color: transparent; }
.permission-row { position: relative; min-height: 76px; flex-direction: row; align-items: center; padding: 10px 8px; }
.permission-symbol { width: 36px; height: 32px; flex-shrink: 0; justify-content: center; }
.permission-copy { flex: 1; }
.permission-name { font-size: 17px; color: #1a2135; line-height: 26px; }
.permission-description { font-size: 13px; line-height: 21px; color: #596479; }
.permission-queued { font-size: 12px; color: #4546bd; margin-left: 8px; }
.permission-spinner { width: 16px; height: 16px; border-color: #4546bd; }
.permission-check { width: 24px; height: 28px; flex-shrink: 0; align-items: center; justify-content: center; }
.permission-hit { position: absolute; top: 0; bottom: 0; left: 0; right: 0; margin: 0; padding: 0; background-color: transparent; }
.permission-note, .permission-error { padding: 10px 12px; font-size: 12px; line-height: 20px; color: #596479; }
.permission-error { color: #9b493a; }
.permission-retry { margin: 4px 12px; font-size: 14px; color: #4546bd; background-color: #e7e9fd; }
/* #ifdef WEB */
.permission-trigger-hit::after, .permission-hit::after, .permission-close-hit::after { border: 0; }
/* #endif */
</style>
