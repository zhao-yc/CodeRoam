<template>
  <view class="options-panel" :style="{ width: width + 'px' }" @click.stop>
    <view v-if="section != 'add'" class="options-heading">
      <view v-if="section == 'models' || section == 'speeds'" class="back-action"><app-icon name="back" :size="18" /><button class="option-hitbox" aria-label="返回推理设置" @click="emit('section', 'settings')"></button></view>
      <text class="options-title">{{ section == 'models' ? '模型' : section == 'speeds' ? '速度' : '推理强度' }}</text>
      <view class="close-action"><app-icon name="close" :size="18" tone="muted" /><button class="option-hitbox" aria-label="关闭输入选项" @click="emit('dismiss')"></button></view>
    </view>
    <scroll-view direction="vertical" class="options-scroll" :style="{ height: scrollHeight + 'px' }">
      <template v-if="section == 'add'">
        <view class="option-row"><app-icon name="camera" :size="21" /><text class="option-label">拍照</text><button class="option-hitbox" :disabled="!imagesEnabled" aria-label="拍照" @click="emit('action', 'camera')"></button></view>
        <view class="option-row"><app-icon name="photo" :size="21" /><text class="option-label">上传照片</text><button class="option-hitbox" :disabled="!imagesEnabled" aria-label="上传照片" @click="emit('action', 'album')"></button></view>
        <view class="option-row"><app-icon name="file" :size="21" /><text class="option-label">上传文件</text><button class="option-hitbox" :disabled="!filesEnabled" aria-label="上传文件" @click="emit('action', 'file')"></button></view>
        <view class="option-separator"></view>
        <view class="option-row"><app-icon name="plugin" :size="21" /><text class="option-label">插件</text><button class="option-hitbox" :disabled="busy" aria-label="插件" @click="emit('action', 'plugin')"></button></view>
        <view class="option-row" :class="{ 'option-disabled': planDisabled || !settingsEnabled || busy }"><app-icon name="plan" :size="21" /><text class="option-label">计划模式</text><loading v-if="pendingChoice == 'mode'" class="option-spinner" /><app-icon v-else-if="settings?.mode == 'plan'" name="check" :size="20" /><button class="option-hitbox" :disabled="planDisabled || !settingsEnabled || busy" :aria-label="pendingChoice == 'mode' ? '正在同步计划模式' : '切换计划模式'" @click="emit('action', 'plan')"></button></view>
        <view class="option-row"><app-icon name="target" :size="21" /><text class="option-label">追求目标</text><button class="option-hitbox" :disabled="busy" aria-label="追求目标" @click="emit('action', 'goal')"></button></view>
        <text v-if="!filesEnabled || !settingsEnabled" class="option-note">{{ note }}</text>
      </template>
      <template v-else-if="loading && !manualRetry"><text class="option-note">正在读取电脑端设置…</text></template>
      <template v-else-if="error.length > 0 || manualRetry"><text class="option-error">{{ error }}</text><view class="retry-option inline-progress-button"><action-progress :busy="manualRetry" /><text class="inline-progress-caption" style="color: #4546bd; font-size: 14px;">重新读取</text><button class="inline-progress-hitbox" @click="retrySettings" :disabled="manualRetry" :aria-label="(manualRetry) ? '正在重新读取' : '重新读取'"></button></view></template>
      <template v-else-if="section == 'models'">
        <view v-for="model in models" :key="model.id" class="option-row model-row"><text class="model-label">{{ model.label }}</text><loading v-if="pendingChoice == 'model:' + model.id" class="option-spinner" /><app-icon v-else-if="model.id == settings?.model" name="check" :size="20" /><button class="option-hitbox" :disabled="busy" :aria-label="(pendingChoice == 'model:' + model.id) ? '正在同步模型' : '选择模型 ' + model.label" @click="emit('select', 'model', model.id)"></button></view>
      </template>
      <template v-else-if="section == 'speeds'">
        <view v-for="speed in selectedModel?.speeds ?? []" :key="speed.id" class="option-row speed-row"><view class="option-copy"><text class="speed-label">{{ speed.label }}</text><text v-if="speed.description.length > 0" class="option-detail">{{ speed.description }}</text></view><loading v-if="pendingChoice == 'serviceTier:' + speed.id" class="option-spinner" /><app-icon v-else-if="speed.id == settings?.serviceTier" name="check" :size="20" /><button class="option-hitbox" :disabled="busy" :aria-label="(pendingChoice == 'serviceTier:' + speed.id) ? '正在同步速度' : '选择速度 ' + speed.label" @click="emit('select', 'serviceTier', speed.id)"></button></view>
      </template>
      <template v-else>
        <view v-for="effort in selectedModel?.efforts ?? []" :key="effort" class="option-row effort-row"><text class="model-label">{{ labelForEffort(effort) }}</text><loading v-if="pendingChoice == 'effort:' + effort" class="option-spinner" /><app-icon v-else-if="effort == settings?.effort" name="check" :size="20" /><button class="option-hitbox" :disabled="busy" :aria-label="(pendingChoice == 'effort:' + effort) ? '正在同步推理强度' : '选择推理强度 ' + labelForEffort(effort)" @click="emit('select', 'effort', effort)"></button></view>
        <view class="option-separator"></view>
        <view class="option-row speed-row"><view class="option-copy"><text class="speed-label">模型</text><text class="option-detail">{{ selectedModel?.label ?? settings?.model ?? '跟随电脑端' }}</text></view><app-icon name="chevron-right" :size="18" /><button class="option-hitbox" :disabled="busy" aria-label="选择模型" @click="emit('section', 'models')"></button></view>
        <view class="option-row speed-row"><view class="option-copy"><text class="speed-label">速度</text><view class="current-speed"><app-icon v-if="settings?.serviceTier == 'priority'" class="fast-speed-icon" name="bolt" :size="12" tone="muted" /><text class="option-detail">{{ currentSpeed }}</text></view></view><app-icon name="chevron-right" :size="18" /><button class="option-hitbox" :disabled="busy" aria-label="选择速度" @click="emit('section', 'speeds')"></button></view>
      </template>
      <text v-if="busy && (pendingChoice ?? '').length == 0 && !manualRetry" class="option-note">正在同步电脑端…</text>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import { computed, nextTick, ref, watch } from 'vue'
import AppIcon from '../app-icon/app-icon.uvue'
import { ExecutionSettings, ModelOption, SpeedOption, effortLabel } from '../../services/execution-settings.uts'
const props = defineProps<{ section: string, settings: ExecutionSettings | null, models: ModelOption[], loading: boolean, busy: boolean, pendingChoice?: string, error: string, width: number, height: number, imagesEnabled: boolean, filesEnabled: boolean, settingsEnabled: boolean, planDisabled: boolean, note: string }>()
const emit = defineEmits<{ section: [value: string], action: [value: string], select: [key: string, value: string], dismiss: [], retry: [] }>()
const manualRetry = ref(false)
// 重试复用父级真实读取状态，无请求的早退不会把按钮留在加载态。
function retrySettings() {
  if (props.loading || props.busy || manualRetry.value) return
  manualRetry.value = true; emit('retry')
  nextTick(() => { if (!props.loading && !props.busy) manualRetry.value = false })
}
watch((): boolean => props.loading || props.busy, (pending: boolean) => { if (!pending) manualRetry.value = false })
// 新建与已有会话共用紧凑附件菜单，仅为实际显示的说明和同步提示预留高度；小屏继续滚动。
const scrollHeight = computed((): number => props.section == 'add' ? Math.min(props.height, 6 * 46 + 17 + ((!props.filesEnabled || !props.settingsEnabled) ? 60 : 0) + (props.busy ? 40 : 0)) : props.height)
const selectedModel = computed((): ModelOption | null => props.models.find((model: ModelOption): boolean => model.id == props.settings?.model) ?? null)
const currentSpeed = computed((): string => selectedModel.value?.speeds.find((speed: SpeedOption): boolean => speed.id == props.settings?.serviceTier)?.label ?? (props.settings?.serviceTier == '' ? '常速' : props.settings?.serviceTier ?? '常速'))
// 模板使用页面方法转发，兼容原生端对导入函数的引用限制。
function labelForEffort(effort: string): string { return effortLabel(effort) }
</script>

<style>
.options-panel { border-radius: 22px; padding: 8px 10px; background-color: #ffffff; border-width: 1px; border-style: solid; border-color: #e5e8f1; overflow: hidden; }
.options-heading { flex-direction: row; align-items: center; height: 38px; padding-left: 12px; }
.options-title { flex: 1; color: #596479; font-size: 13px; }
.options-scroll { flex-shrink: 1; }
.back-action, .close-action { position: relative; width: 34px; height: 34px; align-items: center; justify-content: center; }
.option-row { position: relative; min-height: 46px; flex-direction: row; align-items: center; padding: 8px 14px; }
/* 禁用态作用于整行，原生按钮负责阻止触发，图标和文字一起变灰。 */
.option-disabled { opacity: 0.4; }
.option-hitbox { position: absolute; left: 0; right: 0; top: 0; bottom: 0; padding: 0; margin: 0; border-radius: 12px; background-color: transparent; }
.option-label { flex: 1; margin-left: 14px; font-size: 16px; color: #1a2135; }
.option-spinner { width: 16px; height: 16px; border-color: #4546bd; }
.option-separator { height: 1px; background-color: #e5e8f1; margin: 8px 14px; }
.model-label { flex: 1; min-width: 0; lines: 1; text-overflow: ellipsis; font-size: 16px; color: #1a2135; margin-right: 8px; }
.model-row { min-height: 48px; }
.option-copy { flex: 1; min-width: 0; }
.speed-row { min-height: 62px; }
.speed-label { font-size: 16px; color: #1a2135; line-height: 24px; }
.current-speed { flex-direction: row; align-items: center; }
.fast-speed-icon { flex-shrink: 0; margin-right: 4px; }
.option-detail { font-size: 12px; color: #596479; line-height: 20px; lines: 2; text-overflow: ellipsis; }
.option-note { padding: 10px 14px; font-size: 12px; line-height: 20px; color: #596479; }
.option-error { padding: 12px 14px; font-size: 13px; line-height: 21px; color: #9b493a; }
.retry-option { font-size: 14px; color: #4546bd; background-color: #e7e9fd; margin: 4px 14px 10px; }
/* #ifdef WEB */
.option-hitbox::after { border: 0; }
/* Web 默认禁用底色会遮住底层图标和文字，灰态由整行统一表达。 */
.option-hitbox[disabled] { background-color: transparent; }
.model-label { white-space: nowrap; overflow: hidden; }
/* #endif */
</style>
