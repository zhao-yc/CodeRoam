<template>
  <view :class="['loading-skeleton', 'skeleton-' + kind]" :style="{ opacity: opacity }" :aria-label="label">
    <view v-if="kind == 'list'" aria-hidden="true">
      <view class="skeleton-block skeleton-group"></view>
      <view v-for="row in rows" :key="row" class="skeleton-row">
        <view class="skeleton-heading"><view class="skeleton-title-space"><view class="skeleton-block skeleton-title" :style="{ width: row % 3 == 0 ? '82%' : row % 3 == 1 ? '64%' : '92%' }"></view></view><view class="skeleton-block skeleton-time"></view></view>
        <view class="skeleton-meta"><view class="skeleton-block skeleton-project" :style="{ width: row % 2 == 0 ? '46%' : '34%' }"></view></view>
      </view>
    </view>
    <view v-else-if="kind == 'conversation'" aria-hidden="true">
      <view v-for="turn in turns" :key="turn" class="skeleton-turn">
        <view class="skeleton-user"><view class="skeleton-block skeleton-user-line"></view><view class="skeleton-block skeleton-user-short"></view></view>
        <view class="skeleton-reply"><view class="skeleton-block skeleton-line"></view><view class="skeleton-block skeleton-line skeleton-line-medium"></view><view class="skeleton-block skeleton-line skeleton-line-short"></view></view>
      </view>
    </view>
    <view v-else-if="kind == 'image'" class="skeleton-image-group" aria-hidden="true">
      <view v-for="slot in imageSlots" :key="slot" :class="['skeleton-block', 'skeleton-image-tile', imageSlots.length == 1 ? 'skeleton-image-single' : '', props.large == true ? 'skeleton-image-large' : '']">
        <view class="skeleton-image-symbol"><view class="skeleton-image-sun"></view><view class="skeleton-image-mountain"></view><view class="skeleton-image-hill"></view></view>
      </view>
    </view>
    <view v-else class="skeleton-history-lines" aria-hidden="true"><view class="skeleton-block skeleton-history-line skeleton-history-medium"></view><view class="skeleton-block skeleton-history-line"></view><view class="skeleton-block skeleton-history-line skeleton-history-short"></view></view>
  </view>
</template>

<script setup lang="uts">
import { computed, ref, watch, onUnmounted } from 'vue'
const props = defineProps<{ kind: string, visible: boolean, count?: number, large?: boolean }>()
const rows = [0, 1, 2, 3, 4, 5]
const turns = [0, 1]
const opacity = ref(1)
let pulseTimer = 0
const label = computed((): string => props.kind == 'list' ? '正在加载聊天列表' : props.kind == 'conversation' ? '正在加载聊天' : props.kind == 'sync' ? '正在同步聊天内容' : props.kind == 'image' ? '正在加载图片' : '正在读取更早的聊天')
// 按消息中的图片数量保留缩略图位置，最多三张，与图片读取上限一致。
const imageSlots = computed((): number[] => {
  const slots: number[] = []
  for (let index = 0; index < Math.min(Math.max(props.count ?? 1, 1), 3); index++) slots.push(index)
  return slots
})

// 每个骨架只使用一个时钟，由跨端透明度过渡完成约 1.6 秒一轮的呼吸。
function stopPulse() { clearInterval(pulseTimer); pulseTimer = 0; opacity.value = 1 }
function updatePulse(visible: boolean) {
  stopPulse()
  if (!visible) return
  pulseTimer = setInterval(() => { opacity.value = opacity.value == 1 ? 0.55 : 1 }, 800)
}
// 页面被隐藏时停止时钟；条件渲染移除组件后释放剩余资源。
watch((): boolean => props.visible, (visible: boolean) => { updatePulse(visible) }, { immediate: true })
onUnmounted(() => { stopPulse() })
</script>

<style>
.loading-skeleton { flex-shrink: 0; transition-property: opacity; transition-duration: 800ms; transition-timing-function: ease-in-out; }
.skeleton-block { background-color: #dfe5da; border-radius: 5px; flex-shrink: 0; }
.skeleton-list { padding-top: 8px; }
.skeleton-group { width: 64px; height: 10px; margin-bottom: 14px; }
.skeleton-row { padding: 9px 10px; border-style: solid; border-width: 0; border-bottom-width: 1px; border-bottom-color: #e3e5dc; }
.skeleton-heading { height: 24px; flex-direction: row; align-items: center; }
.skeleton-title-space { flex: 1; min-width: 0; margin-right: 22px; }
.skeleton-title { height: 14px; }
.skeleton-time { width: 36px; height: 10px; background-color: #e7ebe2; }
.skeleton-meta { height: 20px; margin-top: 4px; justify-content: center; }
.skeleton-project { height: 10px; background-color: #e7ebe2; }
.skeleton-conversation { padding: 12px 16px 24px; }
.skeleton-user { width: 68%; align-self: flex-end; padding: 12px; border-radius: 12px; background-color: #edf1e9; }
.skeleton-user-line { height: 12px; width: 92%; }
.skeleton-user-short { height: 12px; width: 58%; margin-top: 10px; }
.skeleton-reply { padding: 22px 0 24px; }
.skeleton-line { height: 12px; width: 96%; margin-bottom: 12px; }
.skeleton-line-medium { width: 82%; }
.skeleton-line-short { width: 52%; }
.skeleton-sync { width: 100%; height: 36px; justify-content: center; }
.skeleton-history { width: 100%; height: 36px; justify-content: center; }
.skeleton-history-line { height: 6px; width: 92%; margin: 3px 0; background-color: #e1e7dc; }
.skeleton-history-medium { width: 72%; }
.skeleton-history-short { width: 48%; }
.skeleton-image { max-width: 100%; }
.skeleton-image-tile { width: 96px; height: 96px; border-radius: 8px; background-color: #e0e7df; align-items: center; justify-content: center; }
.skeleton-image-single { width: 128px; height: 128px; }
.skeleton-image-large { width: 260px; max-width: 100%; height: 180px; }
.skeleton-image-group { flex-direction: row; flex-wrap: wrap; gap: 8px; max-width: 100%; }
.skeleton-image-symbol { width: 40px; height: 32px; border: 2px solid #c6d1c4; border-radius: 5px; overflow: hidden; }
.skeleton-image-sun { position: absolute; left: 7px; top: 6px; width: 6px; height: 6px; border-radius: 3px; background-color: #c6d1c4; }
.skeleton-image-mountain { position: absolute; left: 4px; top: 19px; width: 23px; height: 23px; border-radius: 3px; background-color: #c6d1c4; transform: rotate(45deg); }
.skeleton-image-hill { position: absolute; left: 23px; top: 22px; width: 17px; height: 17px; border-radius: 3px; background-color: #c6d1c4; transform: rotate(45deg); }
</style>
