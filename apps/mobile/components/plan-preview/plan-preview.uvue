<template>
  <view class="plan-preview action-frame">
    <view class="plan-heading"><app-icon name="plan" :size="18" tone="muted" /><text class="plan-label">实施方案</text></view>
    <text class="plan-title">{{ presentation.title }}</text>
    <text v-if="presentation.excerpt.length > 0" class="plan-excerpt">{{ presentation.excerpt }}</text>
    <view class="plan-detail-entry"><text class="plan-detail-label">查看方案详情</text><app-icon name="chevron-right" :size="18" tone="muted" /></view>
    <button class="action-hitbox" hover-class="action-pressed" aria-label="查看方案详情" aria-haspopup="dialog" @click="emit('open')"></button>
  </view>
</template>
<script setup lang="uts">
import { computed } from 'vue'
import { planPresentation } from '../../services/plan-presentation.uts'
import AppIcon from '../app-icon/app-icon.uvue'
const props = defineProps<{ source: string }>()
const emit = defineEmits<{ (event: 'open'): void }>()
// 快照更新时仅重算当前卡片预览，不将完整正文插回聊天时间线。
const presentation = computed(() => planPresentation(props.source))
</script>
<style>
.plan-preview { padding: 16px 16px 0; border-width: 1px; border-style: solid; border-color: #e5e8f1; border-radius: 18px; background-color: #ffffff; }
