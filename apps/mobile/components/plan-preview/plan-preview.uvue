.plan-label { font-size: 13px; line-height: 20px; color: #596479; margin-left: 7px; }
.plan-title { font-size: 18px; line-height: 27px; font-weight: bold; color: #1a2135; lines: 2; text-overflow: ellipsis; }
.plan-excerpt { margin-top: 10px; font-size: 15px; line-height: 24px; color: #1a2135; lines: 4; text-overflow: ellipsis; max-height: 96px; overflow: hidden; }
.plan-detail-entry { min-height: 48px; margin-top: 14px; flex-direction: row; align-items: center; justify-content: space-between; border-width: 0; border-top-width: 1px; border-style: solid; border-top-color: #e5e8f1; }
.plan-detail-label { font-size: 14px; line-height: 22px; color: #4546bd; font-weight: 500; }
.action-frame { position: relative; overflow: hidden; flex-shrink: 0; }
.action-hitbox { position: absolute; left: 0; top: 0; width: 100%; height: 100%; margin: 0; padding: 0; border-width: 0; border-radius: 18px; background-color: transparent; font-size: 1px; line-height: 1px; }
.action-pressed { background-color: rgba(69, 70, 189, 0.04); }
/* #ifdef WEB */
/* Web 与原生均限制预览行数；详情继续读取未裁切的原始正文。 */
.plan-title, .plan-excerpt { display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: anywhere; white-space: normal; }
.plan-title { -webkit-line-clamp: 2; }
.plan-excerpt { -webkit-line-clamp: 4; }
.action-hitbox::after { border: none; }
/* #endif */
</style>
