<template>
  <view v-if="messages.length > 0" class="queue-panel">
    <text class="queue-heading">排队消息 · {{ messages.length }}</text>
    <view v-for="message in messages" :key="message.id" class="queue-row">
      <text class="queue-state">{{ statusLabel(message.state) }}</text>
      <text v-if="message.source == 'desktop'" class="queue-source">电脑同步</text>
      <text v-if="message.source == 'mobile'" class="queue-source">手机排队</text>
      <text v-if="message.source == 'legacy'" class="queue-source">旧版排队</text>
      <text v-if="message.text.length > 0" class="queue-text" selectable>{{ threadMentionMessageText(message.text) }}</text>
      <thread-mention-chips :mentions="message.threadMentions ?? []" :readonly="true" />
      <text v-if="message.imageCount + message.attachmentCount > 0" class="queue-caption">{{ message.imageCount > 0 ? message.imageCount + ' 张图片 ' : '' }}{{ message.attachmentCount > 0 ? message.attachmentCount + ' 个附件' : '' }}</text>
      <text v-for="plugin in message.plugins ?? []" :key="plugin.id" class="queue-caption">插件 · {{ plugin.displayName }}</text>
      <text v-if="message.error.length > 0" class="queue-error">{{ message.error }}</text>
      <view class="queue-actions">
        <!-- 能力只有显式 false 才隐藏；编辑仍服从全局开关，追加仍要求任务运行中。 -->
        <view v-if="editable && (message.state == 'queued' || message.state == 'editing') && message.canEdit != false" class="queue-edit inline-progress-button"><action-progress class="queue-action-progress" :busy="pendingAction == 'queue:edit:' + message.id" /><text class="inline-progress-caption" style="color: #4546bd; font-size: 12px;">编辑</text><button class="inline-progress-hitbox" :disabled="disabled || (pendingAction == 'queue:edit:' + message.id)" @click="edit(message.id)" :aria-label="(pendingAction == 'queue:edit:' + message.id) ? '正在撤回排队消息' : '编辑'"></button></view>
        <view v-if="message.state == 'queued' && message.canSteer != false" class="queue-steer inline-progress-button"><action-progress class="queue-action-progress" :busy="pendingAction == 'queue:steer:' + message.id" /><text class="inline-progress-caption" style="color: #4546bd; font-size: 12px;">追加到当前任务</text><button class="inline-progress-hitbox" :disabled="disabled || !running || (pendingAction == 'queue:steer:' + message.id)" @click="steer(message.id)" :aria-label="(pendingAction == 'queue:steer:' + message.id) ? '正在追加消息' : '追加到当前任务'"></button></view>
        <view v-if="message.canCancel != false" class="queue-cancel inline-progress-button"><action-progress class="queue-action-progress" :busy="pendingAction == 'queue:cancel:' + message.id" /><text class="inline-progress-caption" style="color: #596479; font-size: 12px;">{{ message.state == 'unknown' || message.state == 'dispatched' ? '移除记录' : '取消排队' }}</text><button class="inline-progress-hitbox" :disabled="disabled || message.state == 'sending' || (pendingAction == 'queue:cancel:' + message.id)" @click="cancel(message.id)" :aria-label="(pendingAction == 'queue:cancel:' + message.id) ? '正在取消排队' : (message.state == 'unknown' || message.state == 'dispatched' ? '移除记录' : '取消排队')"></button></view>
      </view>
    </view>
  </view>
</template>
<script setup lang="uts">
import ThreadMentionChips from '../thread-mention-chips/thread-mention-chips.uvue'
import { threadMentionMessageText as mentionDisplayText } from '../../services/thread-mentions.uts'
import { QueuedMessage, queuedMessageLabel } from '../../services/message-queue.uts'
// 保持模板仅调用组件方法，兼容 Android 函数绑定。
function threadMentionMessageText(text: string): string { return mentionDisplayText(text) }
const props = defineProps<{ messages: QueuedMessage[], disabled: boolean, running: boolean, editable: boolean, pendingAction?: string }>()
const emit = defineEmits<{ (event: 'steer', id: string): void; (event: 'cancel', id: string): void; (event: 'edit', id: string): void }>()
function statusLabel(state: string): string { return queuedMessageLabel(state) }
// 操作仅发出消息编号，原正文、图片与附件由电脑保存和复用。
function steer(id: string) { if (!props.disabled && props.running) emit('steer', id) }
function cancel(id: string) { if (!props.disabled) emit('cancel', id) }
// 编辑先由电脑撤回；组件不自行复制正文或把已发送消息伪装成草稿。
function edit(id: string) { if (!props.disabled && props.editable) emit('edit', id) }
</script>
<style>
/* 与聊天正文保持相同的左右留白，卡片内边距独立计算，窄屏操作仍可换行。 */
.queue-panel { margin: 16px 16px 0; border-radius: 16px; border-width: 1px; border-color: #e5e8f1; background-color: #f6f7fb; padding: 16px; }
.queue-heading { color: #596479; font-size: 13px; font-weight: bold; }
.queue-row { margin-top: 10px; padding-top: 10px; border-top-width: 1px; border-top-color: #e5e8f1; }
.queue-state { color: #596479; font-size: 12px; margin-bottom: 8px; }
.queue-source { align-self: flex-start; color: #596479; font-size: 11px; background-color: #e7e9fd; border-radius: 6px; padding: 2px 6px; margin-bottom: 6px; }
.queue-text { color: #1a2135; font-size: 15px; line-height: 24px; }
.queue-caption { color: #596479; font-size: 12px; margin-top: 6px; }
.queue-error { color: #a13830; font-size: 12px; line-height: 18px; margin-top: 6px; }
.queue-actions { flex-direction: row; align-items: center; gap: 10px; margin-top: 16px; flex-wrap: wrap; }
.queue-steer, .queue-cancel, .queue-edit { margin: 0; padding: 4px 18px; min-height: 36px; font-size: 12px; line-height: 28px; border-radius: 10px; }
/* 加载位置使用按钮两侧现有留白，文字居中且等待回执时不改变宽度。 */
.queue-action-progress { position: absolute; left: 4px; top: 50%; margin-top: -7px; }
.queue-actions .inline-progress-caption { margin-right: 0; flex-shrink: 0; }
.queue-steer { color: #4546bd; background-color: #e7e9fd; }
.queue-cancel { color: #596479; background-color: #f6f7fb; }
.queue-edit { color: #4546bd; background-color: #e7e9fd; }
/* #ifdef WEB */
.queue-steer::after, .queue-cancel::after, .queue-edit::after { border: none; }
/* #endif */
</style>
