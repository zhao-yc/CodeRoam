<template>
  <view v-if="messages.length > 0" class="queue-panel">
    <text class="queue-heading">排队消息 · {{ messages.length }}</text>
    <view v-for="message in messages" :key="message.id" class="queue-row">
      <text class="queue-state">{{ statusLabel(message.state) }}</text>
      <text v-if="message.text.length > 0" class="queue-text" selectable>{{ message.text }}</text>
      <text v-if="message.imageCount + message.attachmentCount > 0" class="queue-caption">{{ message.imageCount > 0 ? message.imageCount + ' 张图片 ' : '' }}{{ message.attachmentCount > 0 ? message.attachmentCount + ' 个附件' : '' }}</text>
      <text v-for="plugin in message.plugins ?? []" :key="plugin.id" class="queue-caption">插件 · {{ plugin.displayName }}</text>
      <text v-if="message.error.length > 0" class="queue-error">{{ message.error }}</text>
      <view class="queue-actions">
        <button v-if="message.state == 'queued'" class="queue-steer" :disabled="disabled || !running" @click="steer(message.id)">追加到当前任务</button>
        <button class="queue-cancel" :disabled="disabled || message.state == 'sending'" @click="cancel(message.id)">{{ message.state == 'unknown' || message.state == 'dispatched' ? '移除记录' : '取消排队' }}</button>
      </view>
    </view>
  </view>
</template>
<script setup lang="uts">
import { QueuedMessage, queuedMessageLabel } from '../../services/message-queue.uts'
const props = defineProps<{ messages: QueuedMessage[], disabled: boolean, running: boolean }>()
const emit = defineEmits<{ (event: 'steer', id: string): void; (event: 'cancel', id: string): void }>()
function statusLabel(state: string): string { return queuedMessageLabel(state) }
// 操作仅发出消息编号，原正文、图片与附件由电脑保存和复用。
function steer(id: string) { if (!props.disabled && props.running) emit('steer', id) }
function cancel(id: string) { if (!props.disabled) emit('cancel', id) }
</script>
<style>
.queue-panel { margin-top: 14px; border-radius: 16px; border-width: 1px; border-color: #dce2d8; background-color: #f1f4ee; padding: 12px; }
.queue-heading { color: #56665b; font-size: 13px; font-weight: bold; }
.queue-row { margin-top: 10px; padding-top: 10px; border-top-width: 1px; border-top-color: #dce2d8; }
.queue-state { color: #69766b; font-size: 12px; margin-bottom: 6px; }
.queue-text { color: #26392d; font-size: 15px; line-height: 22px; }
.queue-caption { color: #69766b; font-size: 12px; margin-top: 6px; }
.queue-error { color: #a13830; font-size: 12px; line-height: 18px; margin-top: 6px; }
.queue-actions { flex-direction: row; align-items: center; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
.queue-steer, .queue-cancel { margin: 0; padding: 4px 10px; min-height: 36px; font-size: 12px; line-height: 28px; border-radius: 10px; }
.queue-steer { color: #285c49; background-color: #e0e9df; }
.queue-cancel { color: #69766b; background-color: #e9ede5; }
/* #ifdef WEB */
.queue-steer::after, .queue-cancel::after { border: none; }
/* #endif */
</style>
