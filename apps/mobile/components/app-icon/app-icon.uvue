<template><image :src="'/static/icons/' + name + '-' + tone + '.png'" :style="{ width: size + 'px', height: size + 'px' }" mode="aspectFit" /></template>
<script setup lang="uts">
// 图标使用随包提供的 PNG，原生与 Web 不依赖远程字体或 SVG 渲染能力。
withDefaults(defineProps<{ name: string, size?: number, tone?: string }>(), { size: 22, tone: 'dark' })
</script>
