<template>
  <view class="question-card">
    <text v-if="group.state != 'pending'" class="card-title">{{ group.state == 'answered' ? '已回答' : '问题已失效' }}</text>
    <view v-for="(item, index) in drafts" :key="item.question.id" :class="['question', index > 0 ? 'question-following' : '']">
      <text v-if="item.question.header.length > 0" class="header">{{ item.question.header }}</text>
      <text class="title">{{ item.question.title }}</text>
      <text v-if="item.question.answer.length > 0" class="answer">{{ item.question.isSecret ? '已填写' : item.question.answer }}</text>
      <template v-else-if="group.state == 'pending'">
        <view v-for="option in item.question.options" :key="option.label" :class="['option', !item.custom && item.text == option.label ? 'selected' : '']" @click="choose(item.question.id, option.label)">
          <view :class="['option-indicator', !item.custom && item.text == option.label ? 'indicator-selected' : '']"><AppIcon v-if="!item.custom && item.text == option.label" name="check" :size="14" tone="light" /></view>
          <view class="option-content">
            <text class="option-label">{{ option.label }}</text>
            <text v-if="option.description.length > 0" class="description">{{ option.description }}</text>
          </view>
        </view>
        <view v-if="item.question.isOther && item.question.options.length > 0" :class="['option', item.custom ? 'selected' : '']" @click="chooseOther(item.question.id)">
          <view :class="['option-indicator', item.custom ? 'indicator-selected' : '']"><AppIcon v-if="item.custom" name="check" :size="14" tone="light" /></view>
          <view class="option-content"><text class="option-label">其他答案</text></view>
        </view>
        <input v-if="item.question.isSecret && (item.custom || item.question.options.length == 0)" v-model="item.text" class="custom-input secret-input" password :maxlength="32000" :disabled="locked" placeholder="请输入答案" />
        <textarea v-else-if="item.custom || item.question.options.length == 0" v-model="item.text" class="custom-input" :maxlength="32000" :disabled="locked" placeholder="填写你的答案…"></textarea>
      </template>
    </view>
    <view v-if="group.state == 'pending'" class="submit inline-progress-button" :class="locked || !complete ? 'submit-disabled' : ''"><text class="inline-progress-caption" style="color: #ffffff; font-size: 15px;">提交回答</text><button class="inline-progress-hitbox" :disabled="locked || !complete" @click="submit" aria-label="提交回答"></button></view>
  </view>
</template>

<script setup lang="uts">
import { computed, ref, watch } from 'vue'
import { QuestionGroup, QuestionAnswer, Question } from '../../services/bridge.uts'
import AppIcon from '../app-icon/app-icon.uvue'
type AnswerDraft = { question: Question, text: string, custom: boolean }
const props = defineProps<{ group: QuestionGroup, disabled: boolean }>()
const emit = defineEmits(['submit'])
const drafts = ref<AnswerDraft[]>([])
const locked = computed((): boolean => props.disabled || props.group.state != 'pending')
const complete = computed((): boolean => drafts.value.length == props.group.questions.length && drafts.value.every((draft: AnswerDraft): boolean => draft.text.trim().length > 0))
// 快照与增量更新保留当前草稿，仅以桌面已确认的答案覆盖对应子题。
watch((): QuestionGroup => props.group, (group: QuestionGroup) => {
  drafts.value = group.questions.map((question): AnswerDraft => {
    const previous = drafts.value.find((draft: AnswerDraft): boolean => draft.question.id == question.id)
    return { question, text: question.answer.length > 0 ? question.answer : previous?.text ?? '', custom: previous?.custom ?? (question.options.length == 0) } as AnswerDraft
  })
}, { immediate: true })
function choose(id: string, label: string) { if (locked.value) return; const draft = drafts.value.find((item: AnswerDraft): boolean => item.question.id == id); if (draft != null) { draft.text = label; draft.custom = false } }
function chooseOther(id: string) { if (locked.value) return; const draft = drafts.value.find((item: AnswerDraft): boolean => item.question.id == id); if (draft != null && !draft.custom) { draft.text = ''; draft.custom = true } }
// 多题作为一个写操作提交，按钮点击本身不会自动代选默认答案。
function submit() {
  if (locked.value || !complete.value) return
  const answers = drafts.value.map((draft: AnswerDraft): QuestionAnswer => ({ questionId: draft.question.id, text: draft.text.trim() } as QuestionAnswer))
  emit('submit', props.group.id, props.group.turnId, answers)
}
</script>

<style>
/* 暖白底与灰绿选择态延续页面配色，独立操作区保留正常阅读间距。 */
.question-card { padding: 20px 16px 18px; background-color: #ffffff; }
.card-title { color: #596479; font-size: 13px; line-height: 20px; margin-bottom: 12px; }
.question-following { margin-top: 24px; }
.header { color: #596479; font-size: 12px; line-height: 18px; margin-bottom: 6px; }
.title { color: #1a2135; font-size: 18px; line-height: 28px; margin-bottom: 4px; font-weight: 500; }
.option { flex-direction: row; align-items: flex-start; min-height: 56px; border-style: solid; border-width: 1px; border-color: #e5e8f1; border-radius: 13px; background-color: #ffffff; padding: 14px 12px; margin-top: 10px; }
.selected { border-color: #a6a8e5; background-color: #e7e9fd; }
.option-indicator { width: 20px; height: 20px; flex-shrink: 0; align-items: center; justify-content: center; margin-right: 10px; margin-top: 2px; border-width: 1px; border-style: solid; border-color: #c7cede; border-radius: 10px; background-color: #ffffff; }
.indicator-selected { border-color: #4546bd; background-color: #4546bd; }
.option-content { flex: 1; }
.option-label { color: #1a2135; font-size: 14px; line-height: 24px; }
.description { color: #596479; font-size: 13px; line-height: 20px; margin-top: 3px; }
/* 答案输入框占满卡片内容宽度，覆盖 textarea 默认宽度并与提交按钮对齐。 */
.custom-input { width: 100%; box-sizing: border-box; height: 88px; margin-top: 12px; padding: 12px; border-radius: 12px; border-width: 1px; border-style: solid; border-color: #e5e8f1; background-color: #ffffff; color: #1a2135; font-size: 16px; line-height: 24px; }
.secret-input { height: 48px; }
.answer { color: #1a2135; font-size: 15px; line-height: 25px; }
.submit { margin: 18px 0px 0px; height: 48px; line-height: 48px; padding: 0px 18px; border-radius: 13px; background-color: #4546bd; color: #ffffff; font-size: 15px; font-weight: 500; align-items: center; justify-content: center; }
.submit-disabled { background-color: #e5e8f1; color: #596479; }
</style>
