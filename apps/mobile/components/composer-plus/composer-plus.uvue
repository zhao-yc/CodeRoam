<template>
  <!-- 用两条等长线段固定视觉中心，避免加号字形的基线与字体留白造成偏移。 -->
  <view class="composer-plus"><view class="plus-horizontal" :class="{ 'plus-light': light }"></view><view class="plus-vertical" :class="{ 'plus-light': light }"></view></view>
</template>

<script setup lang="uts">
// 靛蓝按钮使用白色加号，其他入口使用正文色。
withDefaults(defineProps<{ light?: boolean }>(), { light: false })
</script>

<style>
.composer-plus { position: relative; width: 22px; height: 22px; flex-shrink: 0; }
.plus-horizontal { position: absolute; left: 3px; top: 10px; width: 16px; height: 2px; background-color: #1a2135; }
.plus-vertical { position: absolute; left: 10px; top: 3px; width: 2px; height: 16px; background-color: #1a2135; }
.plus-light { background-color: #ffffff; }
</style>
