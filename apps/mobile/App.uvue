.chat-workspace.workspace-wide .computer-tab-selected, .chat-workspace.workspace-wide .computer-tab-selected:hover { background-color: var(--desk-selected); }
.chat-workspace.workspace-wide .computer-tab-selected .tab-label { color: var(--desk-accent); font-weight: 600; }
.chat-workspace.workspace-wide .computer-spinner { border-color: var(--desk-accent); }
.chat-workspace.workspace-wide .computer-unread-dot { background-color: var(--desk-accent); }
.chat-workspace.workspace-wide #home-page .list-content { padding: 0 13px; }
.chat-workspace.workspace-wide .thread-group { margin-top: 13px; }
.chat-workspace.workspace-wide .group-title { margin: 0 8px 5px; font-size: 11px; font-weight: 600; color: var(--desk-muted); }
.chat-workspace.workspace-wide #home-page .thread {
  position: relative; margin-bottom: 3px; padding: 7px 9px; border: 0; border-radius: 8px;
  contain-intrinsic-block-size: auto 40px;
}
.chat-workspace.workspace-wide #home-page .thread:hover { background-color: var(--desk-hover); }
.chat-workspace.workspace-wide #home-page .thread-selected, .chat-workspace.workspace-wide #home-page .thread-selected:hover { background-color: var(--desk-selected); }
.chat-workspace.workspace-wide .thread-selected::before {
  content: ''; position: absolute; left: 0; top: 12px; bottom: 12px;
  width: 2px; border-radius: 2px; background-color: var(--desk-accent);
}
.chat-workspace.workspace-wide #home-page .thread-title { color: var(--desk-text); font-size: 13px; line-height: 20px; font-weight: 600; }
.chat-workspace.workspace-wide #home-page .thread-meta { margin-top: 3px; }
.chat-workspace.workspace-wide #home-page .thread-meta-icon { max-width: 12px; max-height: 12px; }
.chat-workspace.workspace-wide .thread-computer-meta { margin-right: 5px; }
