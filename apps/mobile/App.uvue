}
.chat-workspace.workspace-wide .desktop-process-icon { margin-right: 6px; flex-shrink: 0; }
.chat-workspace.workspace-wide #conversation-page .process-label { color: var(--desk-muted); font-size: 12px; }
.chat-workspace.workspace-wide #conversation-page .jump-latest { background-color: var(--desk-surface); border-color: var(--desk-line); }
.chat-workspace.workspace-wide #composer-dock, .chat-workspace.workspace-wide .workspace-new .new-dock {
