<script lang="uts">
import { bridge } from './services/bridge.uts'
import { startConversationPrefetch, resumeConversationPrefetch, backgroundConversationPrefetch } from './services/conversation-prefetch.uts'
import { startConversationCacheLifecycle } from './services/conversation-cache-lifecycle.uts'
import { startTaskNotifications, resetTaskNotifications } from './services/task-notifications.uts'
import { startDeletionTasks, resumeDeletionTasks, backgroundDeletionTasks } from './services/delete-tasks.uts'
// #ifdef WEB
import { startTaskBrowserNotifications } from './services/task-browser-notifications.uts'
// #endif
export default {
  onLaunch() {
    startConversationCacheLifecycle(); startTaskNotifications(); startDeletionTasks(); startConversationPrefetch()
    // #ifdef WEB
    startTaskBrowserNotifications()
    // #endif
    bridge.restore()
  },
  onShow() { resumeDeletionTasks(); bridge.resume(); resumeConversationPrefetch() },
  onHide() { backgroundConversationPrefetch(); backgroundDeletionTasks(); if (!bridge.backgroundNotificationsEnabled) resetTaskNotifications(); bridge.background() }
}
</script>

<style>
.page { background-color: #f8f8f3; }
.inline-progress-button { position: relative; min-height: 28px; flex-direction: row; align-items: center; justify-content: center; }
.inline-progress-caption { flex-shrink: 1; text-align: center; }
.inline-progress-hitbox { position: absolute; left: 0; top: 0; width: 100%; height: 100%; margin: 0; padding: 0; border-width: 0; background-color: transparent; }
/* #ifdef WEB */
.inline-progress-hitbox::after { border: 0; }
.inline-progress-hitbox[disabled] { background-color: transparent; }
/* #endif */
.button-primary, .button-secondary, .button-danger { font-size: 15px; border-radius: 14px; }
.button-primary { background-color: #285c49; color: #ffffff; }
.button-secondary { background-color: #e8eee6; color: #202c28; }
.button-danger { background-color: #fff0ee; color: #a13830; }
.button-primary, .button-secondary, .button-danger { align-items: center; justify-content: center; }
/* #ifdef WEB */
/* Web 显式使用系统无衬线字体，避免中文回落到浏览器的宋体默认值。 */
body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", sans-serif; }
button { display: flex; }
button::after { border: none; }
/* 禁用态仍由外层表达；覆盖 Web 默认禁用底色，避免加载时遮住权限图标或给加号加上方块。 */
.page .action-hitbox[disabled], .page .add-image[disabled], .page .permission-trigger-hit[disabled], .page .permission-hit[disabled], .page .permission-close-hit[disabled] { background-color: transparent; }
/* #endif */
</style>
