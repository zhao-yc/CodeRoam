<script lang="uts">
import { bridge } from './services/bridge.uts'
import { startConversationPrefetch, resumeConversationPrefetch, backgroundConversationPrefetch } from './services/conversation-prefetch.uts'
import { startConversationCacheLifecycle } from './services/conversation-cache-lifecycle.uts'
import { startThreadListCache } from './services/thread-list.uts'
import { startTaskNotifications, resetTaskNotifications } from './services/task-notifications.uts'
import { startDeletionTasks, resumeDeletionTasks, backgroundDeletionTasks } from './services/delete-tasks.uts'
// #ifdef WEB
import { startTaskBrowserNotifications } from './services/task-browser-notifications.uts'
// #endif
export default {
  onLaunch() {
    startConversationCacheLifecycle(); startThreadListCache(); startTaskNotifications(); startDeletionTasks(); startConversationPrefetch()
    // #ifdef WEB
    startTaskBrowserNotifications()
    // #endif
    bridge.restore()
  },
  onShow() { resumeDeletionTasks(); bridge.resume(); resumeConversationPrefetch() },
  onHide() { backgroundConversationPrefetch(); backgroundDeletionTasks(); if (!bridge.backgroundNotificationsEnabled) resetTaskNotifications(); bridge.background() }
}
</script>

<style>
.page { background-color: #f8f8f3; }
.inline-progress-button { position: relative; min-height: 28px; flex-direction: row; align-items: center; justify-content: center; }
.inline-progress-caption { flex-shrink: 1; text-align: center; }
.inline-progress-hitbox { position: absolute; left: 0; top: 0; width: 100%; height: 100%; margin: 0; padding: 0; border-width: 0; background-color: transparent; }
/* #ifdef WEB */
.inline-progress-hitbox::after { border: 0; }
.inline-progress-hitbox[disabled] { background-color: transparent; }
/* #endif */
.button-primary, .button-secondary, .button-danger { font-size: 15px; border-radius: 14px; }
.button-primary { background-color: #285c49; color: #ffffff; }
.button-secondary { background-color: #e8eee6; color: #202c28; }
.button-danger { background-color: #fff0ee; color: #a13830; }
.button-primary, .button-secondary, .button-danger { align-items: center; justify-content: center; }
/* #ifdef WEB */
/* Web 显式使用系统无衬线字体，避免中文回落到浏览器的宋体默认值。 */
body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", sans-serif; }
button { display: flex; }
button::after { border: none; }
/* 禁用态仍由外层表达；覆盖 Web 默认禁用底色，避免加载时遮住权限图标或给加号加上方块。 */
.page .action-hitbox[disabled], .page .add-image[disabled], .page .permission-trigger-hit[disabled], .page .permission-hit[disabled], .page .permission-close-hit[disabled] { background-color: transparent; }

/* 仅在宽屏 Web 双栏应用设计稿的圆角，窄屏和原生端由组件样式管理。 */
.chat-workspace.workspace-wide .computer-tab { border-radius: 6px; }
.chat-workspace.workspace-wide .header-button,
.chat-workspace.workspace-wide .round-button { border-radius: 7px; }
.chat-workspace.workspace-wide .search-field,
.chat-workspace.workspace-wide .thread-selected,
.chat-workspace.workspace-wide .list-new-button,
.chat-workspace.workspace-wide .process-toggle,
.chat-workspace.workspace-wide .composer-panel .primary-action { border-radius: 8px; }
.chat-workspace.workspace-wide .composer-panel { border-radius: 13px; }
.chat-workspace.workspace-wide .message-user { border-radius: 13px 13px 4px 13px; }

/* 聊天列表的靛蓝配色仅作用于宽屏侧栏。 */
.chat-workspace.workspace-wide #home-page {
  --list-ink: #1a2135;
  --list-muted: #596479;
  --list-line: #e5e8f1;
  --list-accent: #4546bd;
  --list-selection: #e7e9fd;
  background-color: #f6f7fb;
}
.chat-workspace.workspace-wide #home-page :is(.list-title-text, .thread-title, .search-input, .empty-title) { color: var(--list-ink); }
.chat-workspace.workspace-wide #home-page :is(.tab-label, .group-title, .thread-computer, .thread-project, .thread-time, .description) { color: var(--list-muted); }
.chat-workspace.workspace-wide #home-page .search-field { background-color: #ffffff; border-color: var(--list-line); }
.chat-workspace.workspace-wide #home-page .thread { border-bottom-width: 0; }
.chat-workspace.workspace-wide #home-page .thread-selected { background-color: var(--list-selection); }
.chat-workspace.workspace-wide #home-page :is(.computer-tab-selected, .button-secondary, .thread-question) { background-color: var(--list-selection); }
.chat-workspace.workspace-wide #home-page :is(.computer-tab-selected .tab-label, .thread-question) { color: var(--list-accent); }
.chat-workspace.workspace-wide #home-page :is(.list-new-button, .button-primary, .computer-unread-dot, .thread-status .unread-dot) { background-color: var(--list-accent); }
.chat-workspace.workspace-wide #home-page :is(.computer-spinner, .thread-status .spinner) { border-color: var(--list-accent); }
.chat-workspace.workspace-wide #home-page .list-new-button-label { color: #ffffff; }
.chat-workspace.workspace-wide #home-page .list-new-button :is(.plus-horizontal, .plus-vertical) { background-color: #ffffff; }
.chat-workspace.workspace-wide #home-page .action-pressed { background-color: rgba(69, 70, 189, 0.07); }

/* 宽屏聊天详情只替换配色，尺寸和间距由原组件管理。 */
.chat-workspace.workspace-wide #conversation-page {
  --detail-ink: #1a2135;
  --detail-muted: #596479;
  --detail-line: #e5e8f1;
  --detail-accent: #4546bd;
  --detail-tint: #eff0fe;
  --detail-soft: #f6f7fb;
  background-color: #ffffff;
}
.chat-workspace.workspace-wide #conversation-page :is(.thread-title, .message-text, .inline-text, .code-text, .message-input, .empty-title) { color: var(--detail-ink); }
.chat-workspace.workspace-wide #conversation-page :is(.meta-host, .meta-project, .history-note, .process-label, .execution-label, .execution-summary, .composer-caption, .connection-note, .empty-detail) { color: var(--detail-muted); }
.chat-workspace.workspace-wide #conversation-page :is(.conversation-header, .process-toggle) { border-bottom-color: var(--detail-line); }
.chat-workspace.workspace-wide #conversation-page :is(.composer-panel, .jump-latest, .table-cell) { border-color: var(--detail-line); }
.chat-workspace.workspace-wide #conversation-page :is(.jump-latest, .menu-panel) { background-color: #ffffff; }
.chat-workspace.workspace-wide #conversation-page :is(.message-user, .button-secondary, .draft-file) { background-color: var(--detail-tint); }
.chat-workspace.workspace-wide #conversation-page :is(.detail-cache-indicator, .md-code, .run-code, .table-heading) { background-color: var(--detail-soft); }
.chat-workspace.workspace-wide #conversation-page :is(.primary-action, .button-primary) { background-color: var(--detail-accent); }
.chat-workspace.workspace-wide #conversation-page :is(.run-link, .code-copy) { color: var(--detail-accent); }
.chat-workspace.workspace-wide #conversation-page .action-pressed { background-color: rgba(69, 70, 189, 0.07); }
/* #endif */
</style>
