  color: var(--desk-muted); font-size: 11px; line-height: 18px;
}
.chat-workspace.workspace-wide .desktop-connection-dot { width: 6px; height: 6px; border-radius: 50%; background-color: var(--desk-muted); }
.chat-workspace.workspace-wide .desktop-connection-online { background-color: #18765d; }
.chat-workspace.workspace-wide .list-new-button {
  height: 40px; margin: 4px 13px 14px; border-radius: 8px; background-color: var(--desk-accent);
}
.chat-workspace.workspace-wide .list-new-button-label { color: white; font-size: 13px; }
.chat-workspace.workspace-wide .desktop-new-plus { color: white; font-size: 22px; line-height: 22px; }
.chat-workspace.workspace-wide .list-new-button:hover { background-color: #393aa7; }
.chat-workspace.workspace-wide #home-page .button-primary { background-color: var(--desk-accent); }
.chat-workspace.workspace-wide #home-page .button-secondary { background-color: var(--desk-selected); }
.chat-workspace.workspace-wide .workspace-empty-title, .chat-workspace.workspace-wide .workspace-new-title { color: var(--desk-text); }
.chat-workspace.workspace-wide .workspace-empty-note { color: var(--desk-muted); }

/* 保留时间线完整宽度用于滚动、定位及分页，只有正文与编辑器收进阅读列。 */
.chat-workspace.workspace-wide #conversation-page { background-color: var(--desk-surface); }
.chat-workspace.workspace-wide #conversation-header, .chat-workspace.workspace-wide .workspace-new-header {
  height: 68px; padding: 10px 20px; border-bottom: 1px solid var(--desk-line);
}
.chat-workspace.workspace-wide #conversation-header .thread-title { color: var(--desk-text); font-size: 16px; line-height: 23px; }
.chat-workspace.workspace-wide #conversation-header .meta-project, .chat-workspace.workspace-wide #conversation-header .meta-host { color: var(--desk-muted); }
.chat-workspace.workspace-wide #timeline-content {
