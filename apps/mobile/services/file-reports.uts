export type ChangedFile = { id: string, path: string, kind: string, additions: number, deletions: number, binary: boolean }
export type FileReport = { reportId: string, revision: string, fileCount: number, additions: number, deletions: number, files: ChangedFile[] }
export type FileReportDetail = { id: string, path: string, kind: string, additions: number, deletions: number, binary: boolean, diffs: string[] }
export type DiffRow = { id: string, kind: string, oldLine: string, newLine: string, text: string }

// 路径仅用于显示；网络请求始终使用电脑签发的文件编号，不把路径作为读取参数。
export function changedFileName(path: string): string { const parts = path.replace(/\\/g, '/').split('/'); return parts[parts.length - 1] }

// 只解析差异行的展示位置；增删行数完全使用 PC 原生返回值。
export function fileDiffRows(diffs: string[]): DiffRow[] {
  const result = [] as DiffRow[]
  diffs.forEach((diff: string, patchIndex: number) => {
    let oldLine = 0
    let newLine = 0
    let inHunk = false
    diff.split('\n').forEach((line: string, index: number) => {
      const id = patchIndex.toString() + ':' + index.toString()
      const match = /^@@ -(\d+)(?:,\d+)? \+(\d+)(?:,\d+)? @@/.exec(line)
      if (match != null) {
        oldLine = parseInt(match[1] ?? ''); newLine = parseInt(match[2] ?? ''); inHunk = true
        result.push({ id, kind: 'hunk', oldLine: '', newLine: '', text: (diffs.length > 1 ? '修改 ' + (patchIndex + 1) + ' · ' : '') + line })
      } else if (inHunk && line.startsWith('+')) {
        result.push({ id, kind: 'add', oldLine: '', newLine: newLine.toString(), text: line.slice(1) }); newLine++
      } else if (inHunk && line.startsWith('-')) {
        result.push({ id, kind: 'delete', oldLine: oldLine.toString(), newLine: '', text: line.slice(1) }); oldLine++
      } else if (inHunk && line.startsWith(' ')) {
        result.push({ id, kind: 'context', oldLine: oldLine.toString(), newLine: newLine.toString(), text: line.slice(1) }); oldLine++; newLine++
      } else if (inHunk && line.startsWith('\\')) {
        result.push({ id, kind: 'note', oldLine: '', newLine: '', text: line })
      }
    })
  })
  return result
}
