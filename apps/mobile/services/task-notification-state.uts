import type { ThreadSummary, NotificationAction } from './bridge.uts'

export type TaskNotice = { key: string, hostId: string, generation: string, threadId: string, threadTitle: string, turnId: string, kind: string, targetId: string }
type NoticeHost = { hostId: string, generation: string, threads: ThreadSummary[] }

// 纯状态机只保存运行期身份；页面和连接切换不能各自创建计时器或重复通知。
export class TaskNotificationCenter {
  hosts = [] as NoticeHost[]
  seen = new Set<string>()
  queue = [] as TaskNotice[]
  current: TaskNotice | null = null
  phase = 'idle'
  deadline = 0
  durationMs = 5000
  visibleHostId = ''
  visibleThreadId = ''
  canPresentNotices = true
  detected = [] as TaskNotice[]

  // 后台只识别事件，不积压页面卡片；恢复前台也不重放已送达的事件。
  setPresentationActive(active: boolean) {
    this.canPresentNotices = active
    if (!active) { this.queue = [] as TaskNotice[]; this.current = null; this.phase = 'idle'; this.deadline = 0 }
  }

  // 连接代次结束时清空事件，保留仍在前台的页面身份，恢复后重新建立基线。
  reset() { this.hosts = [] as NoticeHost[]; this.seen.clear(); this.queue = [] as TaskNotice[]; this.current = null; this.phase = 'idle'; this.deadline = 0 }

  // 进入聊天即移除该窗口已显示和排队的通知，其他电脑的同号聊天继续提醒。
  setVisibleThread(hostId: string, threadId: string, now: number) {
    this.visibleHostId = hostId; this.visibleThreadId = threadId
    this.queue = this.queue.filter((notice: TaskNotice): boolean => !this.isVisibleThread(notice.hostId, notice.threadId))
    if (this.current != null && this.isVisibleThread(this.current!.hostId, this.current!.threadId)) { this.current = null; this.phase = 'idle'; this.deadline = 0 }
    this.tick(now)
  }

  // 前台页面独立于连接当前订阅；首页保留的旧订阅不能被当成正在阅读。
  private isVisibleThread(hostId: string, threadId: string): boolean { return hostId.length > 0 && threadId.length > 0 && this.visibleHostId == hostId && this.visibleThreadId == threadId }

  // 授权撤回或实例换代后，旧通知不可继续打开其他实例的同号会话。
  retainHosts(keys: string[]) {
    this.hosts = this.hosts.filter((host: NoticeHost): boolean => keys.indexOf(JSON.stringify([host.hostId, host.generation])) >= 0)
    this.queue = this.queue.filter((notice: TaskNotice): boolean => this.valid(notice))
    if (this.current != null && !this.valid(this.current!)) { this.current = null; this.phase = 'idle'; this.deadline = 0 }
  }

  // 首份完整列表只补待交互；随后按事项编号和轮次终态识别新事件。
  observe(hostId: string, generation: string, threads: ThreadSummary[], now: number): TaskNotice[] {
    this.detected = [] as TaskNotice[]
    const previous = this.hosts.find((host: NoticeHost): boolean => host.hostId == hostId && host.generation == generation)
    const baseline = previous == null
    const oldThreads = previous?.threads ?? [] as ThreadSummary[]
    this.hosts = this.hosts.filter((host: NoticeHost): boolean => host.hostId != hostId)
    this.hosts.push({ hostId, generation, threads } as NoticeHost)
    threads.forEach((thread: ThreadSummary) => {
      const state = thread.notificationState
      if (state == null) return
      state.pending.forEach((action: NotificationAction) => { this.add(hostId, generation, thread, action.kind, action.turnId, action.id) })
      const oldRow = oldThreads.find((row: ThreadSummary): boolean => row.id == thread.id)
      const old = oldRow?.notificationState
      const terminal = ['completed', 'failed', 'reviewStopped'].indexOf(state.latestTurnStatus) >= 0
      const changed = old?.latestTurnId != state.latestTurnId || old?.latestTurnStatus != state.latestTurnStatus
      const needsInteraction = state.pending.some((action: NotificationAction): boolean => action.turnId == state.latestTurnId)
      if (!baseline && thread.notificationBaseline != true && (oldRow == null || old != null && old.latestTurnId.length > 0) && changed && terminal && state.latestTurnId.length > 0 && (state.latestTurnStatus == 'failed' || !needsInteraction)) this.add(hostId, generation, thread, state.latestTurnStatus, state.latestTurnId, '')
    })
    this.queue = this.queue.filter((notice: TaskNotice): boolean => this.valid(notice))
    this.tick(now)
    return this.detected
  }

  // 去重身份包含电脑及实例代次，不按会话标题或待办数量猜测。
  private add(hostId: string, generation: string, thread: ThreadSummary, kind: string, turnId: string, targetId: string) {
    if (['question', 'approval', 'plan', 'completed', 'failed', 'reviewStopped'].indexOf(kind) < 0) return
    const key = JSON.stringify([hostId, generation, thread.id, kind, turnId, targetId])
    if (this.seen.has(key)) return
    this.seen.add(key)
    const notice = { key, hostId, generation, threadId: thread.id, threadTitle: thread.title, turnId, kind, targetId } as TaskNotice
    this.detected.push(notice)
    // 已在聊天内看到的事件也记为已读，离开页面后不补发同一事项。
    if (!this.canPresentNotices || this.isVisibleThread(hostId, thread.id)) return
    this.queue.push(notice)
  }

  // 排队中已回答的问题、已处理的审批和已归档的会话不再展示。
  valid(notice: TaskNotice): boolean {
    const row = this.hosts.find((host: NoticeHost): boolean => host.hostId == notice.hostId && host.generation == notice.generation)?.threads.find((thread: ThreadSummary): boolean => thread.id == notice.threadId)
    if (row == null) return false
    if (['completed', 'failed', 'reviewStopped'].indexOf(notice.kind) >= 0) return true
    return row.notificationState?.pending.some((action: NotificationAction): boolean => action.kind == notice.kind && action.id == notice.targetId && action.turnId == notice.turnId) == true
  }

  // 设置变更立即作用于当前卡片；重复选择不延长计时，离场动画不受影响。
  setDuration(durationMs: number, now: number) {
    if (this.durationMs == durationMs) return
    this.durationMs = durationMs
    if (this.phase == 'visible') this.deadline = durationMs == 0 ? 0 : now + durationMs
  }

  // 先挂载一帧，再做 200ms 进入动画；时长为零时仅由点击或上滑关闭。
  tick(now: number) {
    if (this.phase == 'visible' && this.deadline == 0) return
    if (this.phase != 'idle' && now < this.deadline) return
    if (this.phase == 'enter') { this.phase = 'visible'; this.deadline = this.durationMs == 0 ? 0 : now + 200 + this.durationMs; return }
    if (this.phase == 'visible') { this.phase = 'leave'; this.deadline = now + 200; return }
    if (this.phase == 'leave' || this.phase == 'swipe') { this.current = null; this.phase = 'idle' }
    while (this.queue.length > 0) {
      const next = this.queue.shift()!
      if (!this.valid(next)) continue
      this.current = next; this.phase = 'enter'; this.deadline = now + 16; return
    }
    this.deadline = 0
  }

  // 点击只结束当前卡片，下一条继续沿用同一队列。
  dismiss(now: number) { this.current = null; this.phase = 'idle'; this.deadline = 0; this.tick(now) }

  // 上滑只关闭手势开始时的卡片，保留 200ms 离场动画，不能误关随后出现的通知。
  swipeDismiss(key: string, now: number): boolean {
    if (this.current?.key != key || this.phase != 'visible') return false
    this.phase = 'swipe'; this.deadline = now + 200
    return true
  }
}

// 标题只表达结构化事件类型，详情名称单独展示。
export function taskNoticeTitle(kind: string): string {
  if (kind == 'completed') return 'Codex 任务已完成'
  if (kind == 'reviewStopped') return 'Codex 操作已被自动审查终止'
  if (kind == 'failed') return 'Codex 任务失败'
  if (kind == 'question') return 'Codex 需要你回答'
  if (kind == 'approval') return 'Codex 等待审批'
  return 'Codex 计划待确认'
}

// 原生与 Web 的滚动锚点仅使用安全字符，兼容含冒号及引号的请求编号。
export function taskNoticeAnchor(kind: string, id: string): string { return 'notice-' + kind + '-' + id.split('').map((part: string): string => part.charCodeAt(0).toString(16)).join('-') }
