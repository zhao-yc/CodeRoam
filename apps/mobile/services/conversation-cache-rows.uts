import type { CachedConversation } from './conversation-cache.uts'
import type { ChatMessage, ConversationTurn, LatestTurn } from './bridge.uts'

export type CacheRow = { key: string, value: string }
export type CacheRowChanges = { put: CacheRow[], remove: string[], clear: boolean }
type CacheRowRead = { revision: string, rows: CacheRow[] }
export type CacheHeader = { hostId: string, threadId: string, title: string, cwd: string, savedAt: number, accessedAt: number, bytes?: number, contentRevision?: string, latestTurn?: LatestTurn, turns: ConversationTurn[], olderTurns: ConversationTurn[], recent: string[], older: string[] }
export type CacheRead = { revision: string, headers: Map<string, CacheHeader>, rows: Map<string, string> }

// 会话和消息都用稳定身份寻址。消息从最近窗口移入历史时复用原记录。
export function cacheEntryKey(hostId: string, threadId: string): string { return JSON.stringify([hostId, threadId]) }
function cacheMessageKey(entryKey: string, messageId: string): string { return 'm:' + JSON.stringify([entryKey, messageId]) }
export function cacheHeaderKey(entryKey: string): string { return 'h:' + entryKey }

export function cacheHeader(entry: CachedConversation): CacheHeader {
  return { hostId: entry.hostId, threadId: entry.threadId, title: entry.title, cwd: entry.cwd, savedAt: entry.savedAt, accessedAt: entry.accessedAt, contentRevision: entry.contentRevision, latestTurn: entry.latestTurn, turns: entry.turns, olderTurns: entry.olderTurns, recent: entry.messages.map((message: ChatMessage): string => message.id), older: entry.olderMessages.map((message: ChatMessage): string => message.id) } as CacheHeader
}

// 预览取最近完整消息，已经分页加载的历史由同一会话的后台读取补齐。
export function cacheBodyKeys(key: string, header: CacheHeader, preview: boolean): string[] {
  const ids = preview ? header.older.concat(header.recent).slice(-8) : header.older.concat(header.recent)
  return ids.map((id: string): string => cacheMessageKey(key, id))
}

export function appendCacheRemoval(changes: CacheRowChanges, key: string, header: CacheHeader) {
  changes.remove.push(cacheHeaderKey(key))
  cacheBodyKeys(key, header, false).forEach((row: string) => { changes.remove.push(row) })
}

function sameCacheMessage(a: ChatMessage, b: ChatMessage): boolean {
  return a === b || (a.id == b.id && a.role == b.role && a.kind == b.kind && a.summary == b.summary && a.phase == b.phase && a.imageCount == b.imageCount && a.text == b.text && a.turnId == b.turnId && a.status == b.status)
}

// 只把变化的消息序列化。顺序、轮次和版本与消息在同一事务更新。
export function appendCacheChanges(changes: CacheRowChanges, key: string, before: CachedConversation | null, after: CachedConversation | null, bytes: number = 0) {
  const previous = new Map<string, ChatMessage>()
  if (before != null) before.olderMessages.concat(before.messages).forEach((message: ChatMessage) => { previous.set(message.id, message) })
  if (after == null) {
    if (before != null) changes.remove.push(cacheHeaderKey(key))
  } else {
    const header = cacheHeader(after)
    if (before == null || JSON.stringify(header) != JSON.stringify(cacheHeader(before))) {
      header.bytes = bytes
      changes.put.push({ key: cacheHeaderKey(key), value: JSON.stringify(header) } as CacheRow)
    }
    after.olderMessages.concat(after.messages).forEach((message: ChatMessage) => {
      const old = previous.get(message.id)
      if (old == null || !sameCacheMessage(old, message)) changes.put.push({ key: cacheMessageKey(key, message.id), value: JSON.stringify(message) } as CacheRow)
      previous.delete(message.id)
    })
  }
  previous.forEach((_message: ChatMessage, id: string) => { changes.remove.push(cacheMessageKey(key, id)) })
}

function readCacheMessages(rows: Map<string, string>, key: string, ids: string[], known: Map<string, ChatMessage>): ChatMessage[] | null {
  const result = [] as ChatMessage[]
  for (let index = 0; index < ids.length; index++) {
    const id = ids[index]
    const cached = known.get(id)
    if (cached != null) { result.push(cached); continue }
    const value = rows.get(cacheMessageKey(key, id))
    if (typeof id != 'string' || value == null) return null
    const message = JSON.parse<ChatMessage>(value)
    if (message == null || message.id != id) return null
    result.push(message)
  }
  return result
}

// 启动只解析会话索引。正文的缺行校验在打开对应会话时进行。
export function decodeCacheRows(raw: string): CacheRead {
  const data = JSON.parse<CacheRowRead>(raw)
  if (data == null || typeof data.revision != 'string' || !Array.isArray(data.rows)) throw new Error('聊天缓存回执无效')
  const rows = new Map<string, string>()
  data.rows.forEach((row: CacheRow) => { if (row != null && typeof row.key == 'string' && typeof row.value == 'string') rows.set(row.key, row.value) })
  const headers = new Map<string, CacheHeader>()
  rows.forEach((value: string, rowKey: string) => {
    if (!rowKey.startsWith('h:')) return
    try {
      const header = JSON.parse<CacheHeader>(value)
      if (header == null || typeof header.hostId != 'string' || typeof header.threadId != 'string' || typeof header.title != 'string' || typeof header.cwd != 'string' || typeof header.savedAt != 'number' || typeof header.accessedAt != 'number' || !Array.isArray(header.turns) || !Array.isArray(header.olderTurns) || !Array.isArray(header.recent) || !Array.isArray(header.older)) return
      const key = cacheEntryKey(header.hostId, header.threadId)
      if (rowKey != cacheHeaderKey(key)) return
      headers.set(key, header)
    } catch (_) {}
  })
  return { revision: data.revision, headers, rows } as CacheRead
}

// 预览不带完整窗口版本或分页历史，不能用于持久化覆盖和增量续接。
export function cacheEntryFromRows(rows: Map<string, string>, key: string, header: CacheHeader, preview: boolean, firstPage: CachedConversation | null = null): CachedConversation | null {
  try {
    const known = new Map<string, ChatMessage>()
    firstPage?.messages.forEach((message: ChatMessage) => { known.set(message.id, message) })
    const messages = readCacheMessages(rows, key, preview ? header.older.concat(header.recent).slice(-8) : header.recent, known)
    const olderMessages = preview ? [] as ChatMessage[] : readCacheMessages(rows, key, header.older, known)
    if (messages == null || olderMessages == null) return null
    return { hostId: header.hostId, threadId: header.threadId, title: header.title, cwd: header.cwd, savedAt: header.savedAt, accessedAt: header.accessedAt, contentRevision: preview ? undefined : header.contentRevision, latestTurn: header.latestTurn, turns: preview ? header.olderTurns.concat(header.turns) : header.turns, olderTurns: preview ? [] as ConversationTurn[] : header.olderTurns, messages, olderMessages } as CachedConversation
  } catch (_) { return null }
}
