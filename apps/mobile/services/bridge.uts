import { reactive } from 'vue'
// 能力标志随完整及增量快照传递；旧连接不提供聊天引用入口。
import { applyNativeDraftSnapshot } from './native-draft.uts'
import type { QueuedMessage } from './message-queue.uts'
import type { ThreadGoal } from './goals.uts'
import type { PermissionState } from './permissions.uts'
import type { ExecutionSettings } from './execution-settings.uts'

export type Computer = { id: string, label: string, online: boolean, icon?: string, hostname?: string, connectionType?: string, lastConnectedAt?: number, profileRevision?: number, parentHostId?: string, instanceGeneration?: string, unavailableReason?: string }
// 图标只允许随包资源，旧中转或未知值继续显示笔记本。
export function computerIcon(computer: Computer | null): string { const icon = computer?.icon ?? ''; return ['code', 'terminal', 'laptop', 'desktop'].indexOf(icon) >= 0 ? icon : 'laptop' }
export type NotificationAction = { kind: string, id: string, turnId: string }
export type NotificationSnapshot = { latestTurnId: string, latestTurnStatus: string, pending: NotificationAction[] }
export type LatestTurn = { turnId: string, status: string }
export type ThreadSummary = { contentRevision?: string, latestTurn?: LatestTurn, notificationState?: NotificationSnapshot, id: string, title: string, cwd: string, updatedAt: number, hasUnreadTurn?: boolean, activeFlags?: string[], status?: string, activeTurnId?: string, approvalCount?: number, pendingQuestionCount?: number, unansweredQuestionCount?: number }
export type ChatMessage = { id: string, role: string, kind?: string, summary?: string, phase?: string, imageCount?: number, text: string, turnId: string, status: string }
export type ConversationTurn = { turnId: string, status: string, durationMs?: number, errorMessage?: string }
export type Approval = { id: string, kind: string, turnId: string, title: string, detail: string, cwd: string }
export type QuestionOption = { label: string, description: string }
export type Question = { id: string, title: string, header: string, options: QuestionOption[], isOther: boolean, isSecret: boolean, answer: string }
export type QuestionGroup = { id: string, kind: string, turnId: string, state: string, questions: Question[] }
export type QuestionAnswer = { questionId: string, text: string }
export type PendingPlan = { id: string, turnId: string, text: string }
export type Conversation = { latestTurn?: LatestTurn, supportsTurnRetry?: boolean, supportsQueueEditing?: boolean, supportsThreadMentions?: boolean, supportsMessageQueue?: boolean, queuedMessages?: QueuedMessage[], notificationState?: NotificationSnapshot, pendingPlan?: PendingPlan | null, supportsPlanImplementation?: boolean, supportsFileReports?: boolean, hasUnreadTurn?: boolean, activeFlags?: string[], goal?: ThreadGoal | null, goalRevision?: string, supportsGoals?: boolean, supportsGoalControl?: boolean, supportsComposerPrediction?: boolean, predictionTurnId?: string, executionSettings?: ExecutionSettings | null, supportsPlanReset?: boolean, supportsPermissionSettings?: boolean, permissionSettings?: PermissionState, supportsExecutionSettings?: boolean, supportsAttachments?: boolean, threadId: string, title: string, cwd: string, status: string, activeTurnId: string, activity?: string, messages: ChatMessage[], turns?: ConversationTurn[], approvals: Approval[], questionGroups: QuestionGroup[], updatedAt: number, readOnly?: boolean, supportsImages?: boolean, supportsHistoryPages?: boolean }
// 连接与任务分开判断：离线不展示过期旋转；需要用户操作时优先显示等待原因。
export function taskState(status: string, activeTurnId: string, approvalCount: number, questionCount: number, online: boolean, activeFlags: string[] = [], latestTurnStatus: string = ''): string {
  if (!online) return 'offline'
  if (activeFlags.indexOf('waitingOnUserInput') >= 0 || questionCount > 0) return 'question'
  if (activeFlags.indexOf('waitingOnApproval') >= 0 || approvalCount > 0) return 'approval'
  if (status == 'active' || activeTurnId.length > 0) return 'running'
  if (latestTurnStatus == 'failed') return 'failed'
  return status == 'idle' ? 'idle' : 'unknown'
}
// 异步问答允许任务继续运行，不能因历史待回答问题而隐藏运行指示。
export function conversationTaskState(snapshot: Conversation | null, online: boolean): string {
  if (snapshot == null) return online ? 'unknown' : 'offline'
  if (snapshot.readOnly == true) return online ? 'unknown' : 'offline'
  const running = snapshot.status == 'active' || snapshot.activeTurnId.length > 0
  const questions = snapshot.questionGroups.filter((group: QuestionGroup): boolean => group.state == 'pending' && (group.kind == 'native' || !running)).length
  return taskState(snapshot.status, snapshot.activeTurnId, snapshot.approvals.length, questions, online, snapshot.activeFlags ?? [], snapshot.latestTurn?.status ?? snapshot.notificationState?.latestTurnStatus ?? '')
}
// 未读是独立桌面事实，仅用于列表，不把会话标题的空闲状态改成已完成。
export function threadIndicator(state: string, hasUnreadTurn: boolean | null = null): string { return (state == 'idle' || state == 'unknown') && hasUnreadTurn == true ? 'unread' : state }

type TextAppend = { id: string, text: string, status: string }
type ConversationDelta = { latestTurn?: LatestTurn, supportsTurnRetry?: boolean, supportsQueueEditing?: boolean, supportsThreadMentions?: boolean, supportsMessageQueue?: boolean, queuedMessages?: QueuedMessage[], notificationState?: NotificationSnapshot, pendingPlan?: PendingPlan | null, supportsPlanImplementation?: boolean, supportsFileReports?: boolean, hasUnreadTurn?: boolean, activeFlags?: string[], goal?: ThreadGoal | null, goalRevision?: string, supportsGoals?: boolean, supportsGoalControl?: boolean, supportsComposerPrediction?: boolean, predictionTurnId?: string, executionSettings?: ExecutionSettings | null, supportsPlanReset?: boolean, supportsPermissionSettings?: boolean, permissionSettings?: PermissionState, supportsExecutionSettings?: boolean, supportsAttachments?: boolean, threadId: string, title: string, cwd: string, status: string, activeTurnId: string, activity?: string, turns?: ConversationTurn[], approvals: Approval[], questionGroups: QuestionGroup[], updatedAt: number, order: string[], upserts: ChatMessage[], appends: TextAppend[], readOnly?: boolean, supportsImages?: boolean, supportsHistoryPages?: boolean }
type ConnectionConfig = { relayUrl: string, token: string, hostId: string, cacheNamespace?: string }
type SessionTicket = { ticket: string }
type PendingReply = { resolve: (value: UTSJSONObject) => void, reject: (reason: Error) => void, timer: number, write: boolean, hostId: string, threadId: string, method?: string }
export type PendingCommand = { id: string, hostId: string, threadId: string, method?: string, namespace?: string }
type ConnectionState = { cacheNamespace: string, supportsHostProfiles: boolean, subscriptionRevision: number, subscribedHostId: string, subscribedThreadId: string, configurationRevision: number, desktopNavigationError: string, status: string, connected: boolean, configured: boolean, error: string, conversationError: string, hostId: string, computers: Computer[], threads: ThreadSummary[], threadsLoading: boolean, threadsLoadedHostId: string, snapshot: Conversation | null, activeThreadId: string, epoch: string, sequence: number, pendingCommandId: string, pendingCommands: PendingCommand[] }

export type ThreadListUpdate = { hostId: string, threads: ThreadSummary[], revision: number }
type LiveThreadListsState = { updates: ThreadListUpdate[] }
export const liveThreadLists = reactive<LiveThreadListsState>({ updates: [] as ThreadListUpdate[] })

export const connection = reactive<ConnectionState>({
  cacheNamespace: '', supportsHostProfiles: false, configurationRevision: 0, desktopNavigationError: '', status: '尚未配置', connected: false, configured: false, error: '', conversationError: '', hostId: '',
  computers: [] as Computer[], threads: [] as ThreadSummary[], threadsLoading: false, threadsLoadedHostId: '', snapshot: null as Conversation | null,
  subscriptionRevision: 0, subscribedHostId: '', subscribedThreadId: '', activeThreadId: '', epoch: '', sequence: 0, pendingCommandId: '', pendingCommands: [] as PendingCommand[]
})

// 所有页面共用一个 SocketTask，防止全局 WebSocket 回调相互覆盖。
class MobileBridge {
  config: ConnectionConfig | null = null
  socket: SocketTask | null = null
  pending = new Map<string, PendingReply>()
  foreground = true
  backgroundNotifications = false

  // 仅 Web 通知服务就绪并获得授权后允许后台保持传输；原生默认仍随前后台断开。
  shouldMaintainConnection(): boolean { return this.foreground || this.backgroundNotifications }
  setBackgroundNotifications(allowed: boolean) {
    if (this.backgroundNotifications == allowed) return
    this.backgroundNotifications = allowed
    if (!this.foreground) { if (allowed) this.connect(); else { this.disconnect(); connection.status = '返回后恢复连接' } }
  }
  connecting = false
  generation = 0
  attempts = 0
  reconnectTimer: number = 0
  heartbeatTimer: number = 0
  handshakeTimer: number = 0
  networkInstalled = false
  openingRevision = 0
  subscriptionRequestRevision = 0
  syncingThread = ''
  listingHost = ''
  listingRevision = 0
  conversationUpdateRevision = 0
  migrateDeleteCommands = false

  restore() {
    // 浏览器禁用存储或缓存损坏时仍可打开应用，不把原始配置写入错误信息。
    try {
      const saved = uni.getStorageSync('codex-mobile-connection')
      if (typeof saved == 'string' && saved.length > 0) this.configure(saved, false)
    } catch (_) { connection.error = '保存的连接配置无法读取，请重新导入' }
    if (!this.networkInstalled) {
      this.networkInstalled = true
      uni.onNetworkStatusChange((event) => {
        if (!event.isConnected) { this.disconnect(); connection.status = '网络不可用' }
        else if (this.shouldMaintainConnection()) { this.disconnect(); this.connect() }
      })
    }
  }

  // 连接配置来自自己的电脑；长期令牌不会写入 URL 或调试日志。
  configure(serialized: string, persist: boolean = true) {
    const parsed = JSON.parse<ConnectionConfig>(serialized)
    if (parsed == null || parsed.token.length < 32 || parsed.hostId.length == 0 || !parsed.relayUrl.endsWith('/ws')) throw new Error('连接配置不完整')
    if (!parsed.relayUrl.startsWith('wss://') && !parsed.relayUrl.startsWith('ws://127.0.0.1:') && !parsed.relayUrl.startsWith('ws://localhost:')) throw new Error('连接地址必须使用 WSS')
    if (parsed.relayUrl.indexOf('?') >= 0 || parsed.relayUrl.indexOf('#') >= 0 || parsed.relayUrl.indexOf('@') >= 0) throw new Error('连接地址不能包含凭据或查询参数')
    // 各端统一保存必要字段；保存失败不覆盖当前连接，刷新后按原配置自动恢复。
    // 明确导入生成新配对命名空间；启动恢复时沿用，不使用令牌作缓存键。
    const restoredNamespace = parsed.cacheNamespace ?? ''
    parsed.cacheNamespace = !persist && restoredNamespace.length > 0 ? restoredNamespace : Date.now().toString(36) + '-' + Math.random().toString(36).slice(2)
    if (persist || restoredNamespace.length == 0) {
      try { uni.setStorageSync('codex-mobile-connection', JSON.stringify({ relayUrl: parsed.relayUrl, token: parsed.token, hostId: parsed.hostId, cacheNamespace: parsed.cacheNamespace })) }
      catch (_) { if (persist) throw new Error('无法保存连接配置，请检查浏览器存储权限'); parsed.cacheNamespace = '' }
    }
    this.disconnect()
    liveThreadLists.updates = [] as ThreadListUpdate[]
    connection.configurationRevision++
    this.config = parsed
    this.migrateDeleteCommands = !persist
    connection.pendingCommands = [] as PendingCommand[]
    connection.cacheNamespace = parsed.cacheNamespace ?? ''
    connection.configured = true
    connection.hostId = parsed.hostId
    connection.error = ''; connection.desktopNavigationError = ''
    connection.threads = [] as ThreadSummary[]
    connection.threadsLoadedHostId = ''
    connection.snapshot = null
    connection.activeThreadId = ''
    connection.conversationError = ''
    this.clearLegacyCommands(parsed.hostId)
    if (this.shouldMaintainConnection()) this.connect()
  }

  // 只清除当前应用的连接配置；正在提交时等待请求结束，其他存储继续保留。
  forgetConfiguration() {
    if (this.hasPendingCommands()) throw new Error('操作正在提交，请稍后再更换连接')
    try { uni.removeStorageSync('codex-mobile-connection') }
    catch (_) { throw new Error('无法清除本地连接，请检查浏览器存储权限') }
    this.disconnect()
    connection.configurationRevision++
    this.config = null
    connection.cacheNamespace = ''
    this.attempts = 0
    this.listingHost = ''
    connection.configured = false
    connection.hostId = ''
    connection.computers = [] as Computer[]
    connection.threads = [] as ThreadSummary[]
    connection.threadsLoadedHostId = ''
    connection.snapshot = null
    connection.activeThreadId = ''
    connection.epoch = ''
    connection.sequence = 0
    connection.error = ''
    connection.status = '尚未配置'
  }

  resume() { this.foreground = true; if (this.config != null && !connection.connected) this.connect() }
  background() { this.foreground = false; if (!this.backgroundNotifications) { this.disconnect(); connection.status = '返回后恢复连接' } }

  connect() {
    const config = this.config
    if (config == null || !this.shouldMaintainConnection() || this.connecting || connection.connected) return
    clearTimeout(this.reconnectTimer)
    this.connecting = true
    const generation = ++this.generation
    connection.status = this.attempts == 0 ? '正在连接' : '正在重新连接'
    const sessionUrl = config.relayUrl.slice(0, -3).replace('wss://', 'https://').replace('ws://', 'http://') + '/session'
    let sessionTicket = ''
    // 原生握手失败可能只有 onError，没有 onClose；主动完成失败状态，不能等关闭回调重试。
    const failed = (detail: string) => {
      if (generation != this.generation) return
      let safeDetail = detail.split(config.token).join('[已隐藏]')
      if (sessionTicket.length > 0) safeDetail = safeDetail.split(sessionTicket).join('[已隐藏]')
      this.disconnect()
      connection.error = '连接失败：' + safeDetail.slice(0, 300)
      this.scheduleReconnect()
    }
    // 一次性票据兼容原生 App 与浏览器，长期令牌仅出现在 HTTPS 请求头。
    uni.request<SessionTicket>({
      url: sessionUrl, method: 'POST', header: { 'Authorization': 'Bearer ' + config.token }, timeout: 8000,
      success: (response) => {
        if (generation != this.generation) return
        if (response.statusCode != 200 || response.data == null) {
          this.connecting = false
          if (response.statusCode == 401) { connection.status = '需要重新配对'; connection.error = '连接配置已失效，请从电脑重新导入'; return }
          failed('获取连接票据失败（HTTP ' + response.statusCode.toString() + '）'); return
        }
        const ticket = response.data!.ticket
        sessionTicket = ticket
        if (ticket.length < 32) { failed('中转返回的连接票据无效'); return }
        // Web 运行时未传回调会将返回值包装为 Promise，显式回调才能取得 SocketTask。
        const socket = uni.connectSocket({ url: config.relayUrl, protocols: ['codex-mobile-v1', 'ticket.' + ticket], success: (_) => {}, fail: (result) => { failed(result.errMsg) } })
        if (generation != this.generation) { socket.close({}); return }
        this.socket = socket
        this.handshakeTimer = setTimeout(() => { if (!connection.connected) failed('等待中转连接确认超时') }, 8000)
        // 超时持续到 welcome，避免握手成功但应用会话未就绪时永久卡住。
        socket.onMessage((event) => {
          if (generation != this.generation || typeof event.data != 'string') return
          try { const envelope = JSON.parse<UTSJSONObject>(event.data as string); if (envelope != null) this.receive(envelope) }
          catch (_) { connection.error = '收到无法识别的聊天数据，请重新连接' }
        })
        socket.onClose((_) => { failed('连接已关闭，正在恢复') })
        socket.onError((result) => { failed(result.errMsg) })
      },
      fail: (result) => { failed(result.errMsg) }
    })
  }

  scheduleReconnect() {
    if (!this.shouldMaintainConnection() || this.config == null) return
    clearTimeout(this.reconnectTimer)
    connection.connected = false
    connection.status = '等待重连'
    this.attempts++
    const delay = Math.min(15000, 500 * Math.pow(2, Math.min(this.attempts, 5)))
    this.reconnectTimer = setTimeout(() => this.connect(), delay)
  }

  disconnect() {
    this.clearConversationSubscription()
    this.openingRevision++
    this.generation++
    clearTimeout(this.reconnectTimer)
    clearTimeout(this.heartbeatTimer)
    clearTimeout(this.handshakeTimer)
    this.socket?.close({})
    this.socket = null
    this.connecting = false
    this.syncingThread = ''
    this.listingHost = ''
    this.listingRevision++
    connection.threadsLoading = false
    connection.connected = false
    this.rejectPending()
  }

  rejectPending() {
    this.pending.forEach((entry: PendingReply, id: string) => {
      clearTimeout(entry.timer)
      if (entry.write && entry.method != 'thread.delete' && entry.method != 'turn.retry' && !(entry.method ?? '').startsWith('thread.draft.')) this.clearCommand(id, entry.hostId)
      entry.reject(new Error(entry.method == 'turn.retry' ? '重试结果需要核对，请勿重复提交' : entry.method == 'thread.delete' ? '永久删除结果需要核对，恢复连接后请核对原操作，勿重复提交' : entry.write ? '连接已中断，恢复后请查看聊天，按需重新发送' : '连接已中断'))
    })
    this.pending.clear()
  }

  // 普通消息不恢复旧操作锁，永久删除单独保存原编号供只读核对。
  clearLegacyCommands(hostId: string) {
    try { uni.removeStorageSync('codex-mobile-pending-v2-' + hostId) } catch (_) {}
    try { uni.removeStorageSync('codex-mobile-pending-' + hostId) } catch (_) {}
    // 删除请求与普通消息分开保存，重连和刷新页面不能解除未知删除的保护。
    this.restoreDeletionCommands(hostId)
    // 重试独立保存身份，刷新和重连只允许核对，不自动重新提交。
    try {
      const saved = JSON.parse<PendingCommand[]>(uni.getStorageSync('codex-mobile-retry-pending-v1-' + hostId) as string) ?? [] as PendingCommand[]
      saved.forEach((entry: PendingCommand) => { if (entry.method == 'turn.retry' && entry.hostId == hostId && entry.id.length >= 16 && entry.threadId.length > 0 && this.pendingCommand(hostId, entry.threadId).length == 0) connection.pendingCommands.push(entry) })
    } catch (_) {}
    this.syncPendingCommand()
  }

  // 普通写请求仅在提交中锁定；永久删除的未知结果继续保护相同电脑和会话。
  pendingCommand(hostId: string, threadId: string): string {
    const scope = threadId.length > 0 ? threadId : '@new'
    return connection.pendingCommands.find((entry: PendingCommand): boolean => entry.hostId == hostId && entry.threadId == scope)?.id ?? ''
  }
  syncPendingCommand() { connection.pendingCommandId = this.pendingCommand(connection.hostId, connection.activeThreadId) }
  hasPendingCommands(): boolean { return connection.pendingCommands.length > 0 }

  // 删除核对按配对隔离；只有启动恢复允许迁移旧版未分命名空间的记录。
  private deletionStorageKey(hostId: string): string { return 'codex-mobile-delete-pending-v1-' + hostId + (connection.cacheNamespace.length > 0 ? ':' + connection.cacheNamespace : '') }
  restoreDeletionCommands(hostId: string) {
    try {
      const key = this.deletionStorageKey(hostId)
      let raw = uni.getStorageSync(key) as string
      const legacyKey = 'codex-mobile-delete-pending-v1-' + hostId
      const legacy = (raw == null || raw.length == 0) && key != legacyKey && this.migrateDeleteCommands
      if (legacy) raw = uni.getStorageSync(legacyKey) as string
      const saved = raw != null && raw.length > 0 ? JSON.parse<PendingCommand[]>(raw) ?? [] as PendingCommand[] : [] as PendingCommand[]
      const valid = saved.filter((entry: PendingCommand): boolean => entry.method == 'thread.delete' && entry.hostId == hostId && entry.id.length >= 16 && entry.threadId.length > 0 && ((entry.namespace ?? connection.cacheNamespace) == connection.cacheNamespace))
      if (legacy && valid.length > 0) { uni.setStorageSync(key, JSON.stringify(valid)); uni.removeStorageSync(legacyKey) }
      valid.forEach((entry: PendingCommand) => { if (this.pendingCommand(hostId, entry.threadId).length == 0) connection.pendingCommands.push({ id: entry.id, hostId, threadId: entry.threadId, method: 'thread.delete', namespace: connection.cacheNamespace } as PendingCommand) })
      this.syncPendingCommand()
    } catch (_) { connection.error = '无法读取删除核对信息，请检查本地存储' }
  }

  // 普通请求编号仅保存在运行期，永久删除额外持久化，防止刷新后重复提交。
  rememberCommand(id: string, hostId: string = connection.hostId, threadId: string = connection.activeThreadId, method: string = '') {
    const scope = threadId.length > 0 ? threadId : '@new'
    const previous = this.pendingCommand(hostId, scope)
    if (previous.length > 0 && previous != id) throw new Error('此聊天正在提交，请稍后再试')
    const records = connection.pendingCommands.filter((entry: PendingCommand): boolean => !(entry.hostId == hostId && entry.threadId == scope)).concat([{ id, hostId, threadId: scope, method, namespace: connection.cacheNamespace } as PendingCommand])
    if (method == 'turn.retry') uni.setStorageSync('codex-mobile-retry-pending-v1-' + hostId, JSON.stringify(records.filter((entry: PendingCommand): boolean => entry.hostId == hostId && entry.method == 'turn.retry')))
    if (method == 'thread.delete') uni.setStorageSync(this.deletionStorageKey(hostId), JSON.stringify(records.filter((entry: PendingCommand): boolean => entry.hostId == hostId && entry.method == 'thread.delete')))
    connection.pendingCommands = records
    this.syncPendingCommand()
  }
  // 按原电脑和编号释放提交状态，迟到响应不能解除其他请求的保护。
  clearCommand(id: string, hostId: string = connection.hostId) {
    const records = connection.pendingCommands.filter((entry: PendingCommand): boolean => !(entry.hostId == hostId && entry.id == id))
    if (records.length == connection.pendingCommands.length) return
    if (connection.pendingCommands.some((entry: PendingCommand): boolean => entry.hostId == hostId && entry.id == id && entry.method == 'thread.delete')) {
      try { uni.setStorageSync(this.deletionStorageKey(hostId), JSON.stringify(records.filter((entry: PendingCommand): boolean => entry.hostId == hostId && entry.method == 'thread.delete'))) } catch (_) { return }
    }
    if (connection.pendingCommands.some((entry: PendingCommand): boolean => entry.hostId == hostId && entry.id == id && entry.method == 'turn.retry')) {
      try { uni.setStorageSync('codex-mobile-retry-pending-v1-' + hostId, JSON.stringify(records.filter((entry: PendingCommand): boolean => entry.hostId == hostId && entry.method == 'turn.retry'))) } catch (_) { return }
    }
    connection.pendingCommands = records
    this.syncPendingCommand()
  }

  receive(envelope: UTSJSONObject) {
    const type = envelope.getString('type') ?? ''
    if (type == 'thread.draft.changed') {
      const hostId = envelope.getString('hostId') ?? ''
      if (hostId != connection.hostId) return
      const source = connection.computers.find((computer: Computer): boolean => computer.id == hostId)
      if (source == null || !source.online || ((source.instanceGeneration ?? '').length > 0 && source.instanceGeneration != envelope.getString('generation'))) return
      const snapshot = envelope['snapshot'] as UTSJSONObject | null
      if (snapshot != null) applyNativeDraftSnapshot(snapshot, hostId)
    } else if (type == 'threads.event') {
      const hostId = envelope.getString('hostId') ?? ''
      if (!connection.computers.some((computer: Computer): boolean => computer.id == hostId)) return
      const source = connection.computers.find((computer: Computer): boolean => computer.id == hostId)
      if ((source?.instanceGeneration ?? '').length > 0 && source?.instanceGeneration != envelope.getString('generation')) return
      const update = { hostId, threads: JSON.parse<ThreadSummary[]>(JSON.stringify(envelope['threads'])) ?? [] as ThreadSummary[], revision: envelope.getNumber('revision') ?? 0 } as ThreadListUpdate
      const existing = liveThreadLists.updates.findIndex((item: ThreadListUpdate): boolean => item.hostId == hostId)
      if (existing >= 0) { if (liveThreadLists.updates[existing].revision >= update.revision) return; liveThreadLists.updates.splice(existing, 1, update) }
      else liveThreadLists.updates.push(update)
      if (hostId == connection.hostId) connection.threads = update.threads
    } else if (type == 'welcome') {
      clearTimeout(this.handshakeTimer)
      this.connecting = false; this.attempts = 0; connection.connected = true; connection.status = '已连接'; connection.error = ''
      this.heartbeat()
      const capabilities = envelope['capabilities'] as UTSJSONObject | null
      connection.supportsHostProfiles = capabilities?.getBoolean('hostProfiles') == true
      connection.computers = JSON.parse<Computer[]>(JSON.stringify(envelope['hosts'])) ?? []
      liveThreadLists.updates = [] as ThreadListUpdate[]
      if (connection.activeThreadId.length > 0) this.watch(connection.activeThreadId)
    } else if (type == 'hosts') {
      const previousComputers = connection.computers
      const wasOnline = connection.computers.some((computer: Computer): boolean => computer.id == connection.hostId && computer.online)
      connection.computers = JSON.parse<Computer[]>(JSON.stringify(envelope['hosts'])) ?? []
      liveThreadLists.updates = liveThreadLists.updates.filter((item: ThreadListUpdate): boolean => connection.computers.some((computer: Computer): boolean => computer.id == item.hostId && computer.online && (computer.instanceGeneration ?? '') == (previousComputers.find((previous: Computer): boolean => previous.id == item.hostId)?.instanceGeneration ?? '')) && previousComputers.some((computer: Computer): boolean => computer.id == item.hostId && computer.online))
      const online = connection.computers.some((computer: Computer): boolean => computer.id == connection.hostId && computer.online)
      const previousGeneration = previousComputers.find((computer: Computer): boolean => computer.id == connection.hostId)?.instanceGeneration ?? ''
      const currentGeneration = connection.computers.find((computer: Computer): boolean => computer.id == connection.hostId)?.instanceGeneration ?? ''
      const replaced = previousGeneration.length > 0 && currentGeneration.length > 0 && previousGeneration != currentGeneration
      if (!online || replaced) this.clearConversationSubscription()
      // 实例换代立即废弃旧快照；只恢复只读订阅，不重放导航和写操作。
      if (replaced) { this.openingRevision++; connection.snapshot = null; connection.epoch = ''; connection.sequence = 0; connection.desktopNavigationError = ''; this.syncingThread = '' }
      if ((!wasOnline || replaced) && online) { liveThreadLists.updates = liveThreadLists.updates.filter((item: ThreadListUpdate): boolean => item.hostId != connection.hostId); if (connection.activeThreadId.length > 0) this.watch(connection.activeThreadId) }
    } else if (type == 'response') {
      const id = envelope.getString('requestId') ?? ''
      const entry = this.pending.get(id)
      if (entry == null) return
      clearTimeout(entry.timer); this.pending.delete(id)
      const error = envelope['error'] as UTSJSONObject | null
      if (error != null) {
        if (entry.write && !((entry.method == 'thread.delete' || entry.method == 'turn.retry' || (entry.method ?? '').startsWith('thread.draft.')) && error.getBoolean('outcomeUnknown') == true)) this.clearCommand(id, entry.hostId)
        entry.reject(new Error(entry.method == 'turn.retry' && error.getBoolean('outcomeUnknown') == true ? '重试结果需要核对，请勿重复提交' : entry.method == 'thread.delete' && error.getBoolean('outcomeUnknown') == true ? '永久删除结果需要核对，请核对原操作，勿重复提交' : error.getBoolean('outcomeUnknown') == true ? '未收到明确结果，请查看聊天，按需重新操作' : error.getString('message') ?? '操作失败'))
      } else {
        const result = envelope['result'] as UTSJSONObject
        if (entry.method == 'thread.delete') {
          let valid = false
          try { const ids = JSON.parse<string[]>(JSON.stringify(result?.['deletedThreadIds'])) ?? [] as string[]; valid = result?.getBoolean('deleted') == true && result?.getString('threadId') == entry.threadId && ids.indexOf(entry.threadId) >= 0 } catch (_) {}
          if (!valid) { entry.reject(new Error('永久删除回执需要核对，请勿重复提交')); return }
        }
        if (entry.method == 'turn.retry' && (result?.getBoolean('ok') != true || result?.getString('threadId') != entry.threadId)) { entry.reject(new Error('重试回执需要核对，请勿重复提交')); return }
        // 删除由应用级任务在缓存和草稿清理完成后释放保护。
        if (entry.write && entry.method != 'thread.delete') this.clearCommand(id, entry.hostId); entry.resolve(result)
      }
    } else if (type == 'event') {
      if (envelope.getString('hostId') != connection.hostId || envelope.getString('threadId') != connection.activeThreadId) return
      const source = connection.computers.find((computer: Computer): boolean => computer.id == connection.hostId)
      if ((source?.instanceGeneration ?? '').length > 0 && source?.instanceGeneration != envelope.getString('generation')) return
      const epoch = envelope.getString('epoch') ?? ''
      const sequence = envelope.getNumber('seq') ?? 0
      if (epoch == connection.epoch && sequence <= connection.sequence) return
      const raw = envelope['snapshot']
      if (raw != null) {
        const snapshot = JSON.parse<Conversation>(JSON.stringify(raw))
        if (snapshot == null || snapshot.threadId != connection.activeThreadId) return
        connection.snapshot = snapshot; connection.epoch = epoch; connection.sequence = sequence
      }
      else if (envelope.getString('kind') == 'delta') {
        if (epoch != connection.epoch || envelope.getNumber('baseSeq') != connection.sequence || connection.snapshot == null) { this.watch(connection.activeThreadId); return }
        const update = JSON.parse<ConversationDelta>(JSON.stringify(envelope['update']))
        if (update == null || update.threadId != connection.activeThreadId) return
        const messages = new Map<string, ChatMessage>()
        connection.snapshot!.messages.forEach((message: ChatMessage) => { messages.set(message.id, message) })
        update.upserts.forEach((message: ChatMessage) => { messages.set(message.id, message) })
        update.appends.forEach((append: TextAppend) => { const message = messages.get(append.id); if (message != null) { message.text += append.text; message.status = append.status } })
        const ordered = [] as ChatMessage[]
        update.order.forEach((id: string) => { const message = messages.get(id); if (message != null) ordered.push(message) })
        connection.snapshot = { threadId: update.threadId, latestTurn: update.latestTurn, supportsTurnRetry: update.supportsTurnRetry == true, supportsQueueEditing: update.supportsQueueEditing == true, supportsThreadMentions: update.supportsThreadMentions == true, supportsMessageQueue: update.supportsMessageQueue == true, queuedMessages: update.queuedMessages ?? [] as QueuedMessage[], notificationState: update.notificationState, pendingPlan: update.pendingPlan ?? null, supportsPlanImplementation: update.supportsPlanImplementation == true, supportsFileReports: update.supportsFileReports == true, hasUnreadTurn: update.hasUnreadTurn, activeFlags: update.activeFlags, goal: update.goal ?? null, goalRevision: update.goalRevision ?? 'none', supportsGoals: update.supportsGoals == true, supportsGoalControl: update.supportsGoalControl == true, supportsComposerPrediction: update.supportsComposerPrediction == true, predictionTurnId: update.predictionTurnId,  executionSettings: update.executionSettings, supportsPlanReset: update.supportsPlanReset == true, supportsPermissionSettings: update.supportsPermissionSettings == true, permissionSettings: update.permissionSettings, supportsExecutionSettings: update.supportsExecutionSettings == true, supportsAttachments: update.supportsAttachments == true, title: update.title, cwd: update.cwd, status: update.status, activeTurnId: update.activeTurnId, activity: update.activity ?? '', turns: update.turns, approvals: update.approvals, questionGroups: update.questionGroups ?? [], updatedAt: update.updatedAt, messages: ordered, readOnly: update.readOnly == true, supportsImages: update.supportsImages == true, supportsHistoryPages: update.supportsHistoryPages == true } as Conversation
        connection.sequence = sequence
      } else return
      this.confirmConversationRead()
    }
  }

  // 应用层探活兼容原生与 Web；发现半开连接后仅恢复读取，不重发操作。
  heartbeat() {
    clearTimeout(this.heartbeatTimer)
    this.heartbeatTimer = setTimeout(() => {
      if (!connection.connected || !this.shouldMaintainConnection()) return
      this.request('ping', {}).then((_: UTSJSONObject) => { this.heartbeat() }, (_: Error) => { this.disconnect(); this.scheduleReconnect() })
    }, 15000)
  }

  // 跨电脑列表读取只开放既有只读方法，不改变当前执行电脑与提交状态。
  readComputerThreads(hostId: string): Promise<UTSJSONObject> {
    if (!connection.computers.some((computer: Computer): boolean => computer.id == hostId)) return new Promise<UTSJSONObject>((_resolve, reject) => { reject(new Error('这台电脑不在当前授权范围内')) })
    return this.requestForComputer(hostId, 'threads.watch', {}, false)
  }

  request(method: string, params: UTSJSONObject, write: boolean = false): Promise<UTSJSONObject> {
    return this.requestForComputer(connection.hostId, method, params, write)
  }

  // 聊天候选只允许读取已授权且在线的电脑，固定接口且不开放通用跨电脑请求。
  readThreadMentions(hostId: string, params: UTSJSONObject): Promise<UTSJSONObject> {
    if (!connection.computers.some((computer: Computer): boolean => computer.id == hostId && computer.online)) return new Promise<UTSJSONObject>((_resolve, reject) => { reject(new Error('电脑离线或已取消授权')) })
    return this.requestForComputer(hostId, 'threads.mentions', params, false)
  }

  // 静默预加载只读指定电脑，不改变当前电脑、聊天、订阅或已读状态。
  prefetchConversation(hostId: string, threadId: string): Promise<UTSJSONObject> {
    if (!connection.computers.some((computer: Computer): boolean => computer.id == hostId && computer.online)) return new Promise<UTSJSONObject>((_resolve, reject) => { reject(new Error('电脑离线或已取消授权')) })
    return this.requestForComputer(hostId, 'thread.history', { threadId, view: 'prefetch' }, false)
  }

  // 应用级任务先持久化原编号，再发送一次删除；请求参数仍只有 threadId。
  submitDeletion(threadId: string, commandId: string): Promise<UTSJSONObject> { return this.requestForComputer(connection.hostId, 'thread.delete', { threadId }, true, commandId) }
  readCommandStatus(hostId: string, commandId: string): Promise<UTSJSONObject> {
    if (!connection.computers.some((computer: Computer): boolean => computer.id == hostId && computer.online)) return new Promise<UTSJSONObject>((_resolve, reject) => { reject(new Error('电脑离线或已取消授权')) })
    return this.requestForComputer(hostId, 'command.status', { commandId }, false)
  }

  // 菜单查询不切换执行电脑，仅向已授权电脑读取归档列表与账户用量。
  readComputerMenu(hostId: string, params: UTSJSONObject): Promise<UTSJSONObject> {
    if (!connection.computers.some((computer: Computer): boolean => computer.id == hostId && computer.online)) return new Promise<UTSJSONObject>((_resolve, reject) => { reject(new Error('电脑离线或已取消授权')) })
    return this.requestForComputer(hostId, 'threads.list', params, false)
  }

  // 编辑外观不切换执行电脑、不占用会话写锁，服务端再次检查目标电脑授权。
  updateComputerProfile(hostId: string, displayName: string, icon: string, expectedRevision: number): Promise<UTSJSONObject> {
    if (!connection.supportsHostProfiles) return new Promise<UTSJSONObject>((_resolve, reject) => { reject(new Error('请更新中转服务后再编辑连接')) })
    if (!connection.computers.some((computer: Computer): boolean => computer.id == hostId)) return new Promise<UTSJSONObject>((_resolve, reject) => { reject(new Error('这台电脑不在当前授权范围内')) })
    return this.requestForComputer(hostId, 'host.profile.update', { displayName, icon, expectedRevision }, false)
  }

  // 通道内部复用回执和超时处理；写请求始终由当前电脑入口发出。
  private requestForComputer(hostId: string, method: string, params: UTSJSONObject, write: boolean, commandId: string = ''): Promise<UTSJSONObject> {
    return new Promise<UTSJSONObject>((resolve, reject) => {
      // 历史浏览不能承载执行、停止或审批；后端也会重新核对真实所有者。
      if (write && connection.snapshot?.readOnly == true && params['threadId'] == connection.snapshot?.threadId) { reject(new Error('这条聊天当前仅支持历史浏览，暂不支持发送、停止或审批')); return }
      const threadId = typeof params['threadId'] == 'string' ? params['threadId'] as string : ''
      const pendingId = this.pendingCommand(hostId, threadId)
      if (params['activate'] == true && pendingId.length > 0) { reject(new Error('操作正在提交，请稍后再连接此聊天')); return }
      // 只锁定相同电脑、相同会话，其他会话可以正常发送、停止及审批。
      if (write && pendingId.length > 0) { reject(new Error('操作正在提交，请稍后再试')); return }
      const socket = this.socket
      if (!connection.connected || socket == null) { reject(new Error('尚未连接电脑')); return }
      const id = commandId.length > 0 ? commandId : Date.now().toString() + '-' + Math.random().toString(36).slice(2) + '-' + Math.random().toString(36).slice(2)
      const timer = setTimeout(() => {
        this.pending.delete(id)
        if (write && method != 'thread.delete' && method != 'turn.retry' && !method.startsWith('thread.draft.')) this.clearCommand(id, hostId)
        reject(new Error(method == 'turn.retry' ? '重试结果需要核对，请勿重复提交' : method == 'thread.delete' ? '永久删除结果需要核对，请核对原操作，勿重复提交' : write ? '操作响应超时，请查看聊天，按需重新操作' : '读取超时，请重试'))
      }, method == 'thread.delete' || method == 'thread.draft.send' ? 65000 : method == 'thread.goal.update' || method == 'thread.draft.open' ? 30000 : 20000)
      if (write) {
        try { this.rememberCommand(id, hostId, threadId, method) }
        catch (_) { clearTimeout(timer); reject(new Error(method == 'thread.delete' ? '无法保存删除核对信息，请检查本地存储后重试' : '操作正在提交，请稍后再试')); return }
      }
      this.pending.set(id, { resolve, reject, timer, write, hostId, threadId, method })
      socket.send({ data: JSON.stringify({ v: 1, type: 'request', requestId: id, hostId, method, params }), fail: (_) => {
        const entry = this.pending.get(id)
        if (entry == null) return
        clearTimeout(entry.timer); this.pending.delete(id)
        if (write && method != 'thread.delete' && method != 'turn.retry' && !method.startsWith('thread.draft.')) this.clearCommand(id, hostId)
        reject(new Error(method == 'turn.retry' ? '重试结果需要核对，请勿重复提交' : method == 'thread.delete' ? '永久删除结果需要核对，恢复连接后请核对原操作' : write ? '未收到发送结果，请查看聊天，按需重新发送' : '发送失败，请重新连接'))
      } })
    })
  }

  // 首次列表读取与已确认空结果分开记录，旧请求不得结束新电脑或新连接的加载状态。
  refreshThreads() {
    if (this.listingHost == connection.hostId) return
    const hostId = connection.hostId
    const revision = ++this.listingRevision
    this.listingHost = hostId
    connection.threadsLoading = true
    this.request('threads.list', {}).then((result: UTSJSONObject) => {
      if (revision != this.listingRevision || connection.hostId != hostId) return
      this.listingHost = ''
      connection.threadsLoading = false
      connection.threads = JSON.parse<ThreadSummary[]>(JSON.stringify(result['threads'])) ?? []
      connection.threadsLoadedHostId = hostId
    }, (error: Error) => {
      if (revision != this.listingRevision || connection.hostId != hostId) return
      this.listingHost = ''
      connection.threadsLoading = false
      connection.error = error.message
    })
  }

  // 电脑切换共用订阅清理与提交状态，任何入口都不能自动重放写请求。
  selectComputer(id: string) {
    if (connection.hostId == id) return
    if (!connection.computers.some((computer: Computer): boolean => computer.id == id)) throw new Error('这台电脑不在当前授权范围内')
    // 先保存已授权的所选实例，刷新详情时沿用同一电脑；失败则保留原会话和订阅。
    const config = this.config
    if (config == null) throw new Error('请先连接电脑')
    try { uni.setStorageSync('codex-mobile-connection', JSON.stringify({ relayUrl: config.relayUrl, token: config.token, hostId: id, cacheNamespace: config.cacheNamespace })) }
    catch (_) { throw new Error('无法保存所选电脑，请检查浏览器存储权限') }
    config.hostId = id
    this.clearConversationSubscription()
    const previous = connection.activeThreadId
    if (previous.length > 0 && connection.connected) this.request('thread.unwatch', { threadId: previous }).then((_: UTSJSONObject) => {}, (_: Error) => {})
    this.openingRevision++; connection.desktopNavigationError = ''
    connection.snapshot = null; connection.activeThreadId = ''; connection.conversationError = ''; connection.epoch = ''; connection.sequence = 0
    this.syncingThread = ''; this.listingRevision++; this.listingHost = ''
    connection.hostId = id; connection.threads = [] as ThreadSummary[]; connection.threadsLoadedHostId = ''; connection.error = ''
    this.clearLegacyCommands(id)
    if (connection.connected) this.refreshThreads(); else this.resume()
  }

  // 只有用户点击调用此入口；刷新和重连仍走只读 watch，不重放导航。
  openThread(threadId: string): Promise<UTSJSONObject> {
    if (!connection.connected) return new Promise<UTSJSONObject>((_resolve, reject) => { reject(new Error('请先恢复连接')) })
    const pendingId = this.pendingCommand(connection.hostId, threadId)
    const hostId = connection.hostId; const revision = ++this.openingRevision
    const previous = connection.activeThreadId
    if (previous != threadId) this.clearConversationSubscription()
    const subscriptionRequest = ++this.subscriptionRequestRevision
    if (previous.length > 0 && previous != threadId) this.request('thread.unwatch', { threadId: previous }).then((_: UTSJSONObject) => {}, (_: Error) => {})
    connection.activeThreadId = threadId
    this.syncPendingCommand()
    if (previous != threadId) { connection.snapshot = null; connection.epoch = ''; connection.sequence = 0 }
    connection.desktopNavigationError = ''; connection.conversationError = ''; this.syncingThread = threadId
    // 提交中的会话仍可读取，请求结束前不自动切换电脑或重放导航。
    const params: UTSJSONObject = { threadId }
    if (pendingId.length == 0) params['activate'] = true
    const opened = this.request('thread.watch', params).then((result: UTSJSONObject): UTSJSONObject => {
      if (revision != this.openingRevision || subscriptionRequest != this.subscriptionRequestRevision || connection.hostId != hostId || connection.activeThreadId != threadId) throw new Error('聊天已切换，已忽略旧的电脑导航响应')
      if (pendingId.length == 0 && result['desktopActivated'] != true) throw new Error('请更新电脑连接服务后使用同步切换聊天')
      this.applySnapshot(result, hostId, threadId)
      return result
    })
    return opened.then((result: UTSJSONObject): UTSJSONObject => { if (revision == this.openingRevision && subscriptionRequest == this.subscriptionRequestRevision && connection.hostId == hostId) this.syncingThread = ''; return result }, (reason: Error): UTSJSONObject => {
      if (revision == this.openingRevision && subscriptionRequest == this.subscriptionRequestRevision && connection.hostId == hostId && connection.activeThreadId == threadId) { this.syncingThread = ''; connection.desktopNavigationError = reason.message; this.watch(threadId) }
      throw reason
    })
  }

  // 新会话先切换订阅归属，再等待原桌面接管，成功之后才能上传和发送。
  openCreatedThread(threadId: string): Promise<UTSJSONObject> {
    this.clearConversationSubscription()
    const previous = connection.activeThreadId
    if (previous.length > 0 && previous != threadId && connection.connected) this.request('thread.unwatch', { threadId: previous }).then((_: UTSJSONObject) => {}, (_: Error) => {})
    connection.activeThreadId = threadId; connection.snapshot = null; connection.epoch = ''; connection.sequence = 0
    this.syncPendingCommand()
    this.syncingThread = ''
    return this.activate(threadId)
  }

  // 点击继续只请求桌面加载并读取快照；成功后仍需用户主动发送消息。
  activate(threadId: string): Promise<UTSJSONObject> {
    const hostId = connection.hostId
    const subscriptionRequest = ++this.subscriptionRequestRevision
    return this.request('thread.watch', { threadId, activate: true }).then((result: UTSJSONObject): UTSJSONObject => {
      // 保持既有继续接口的结算方式；过期回执不应用，也不能确认图片订阅。
      if (subscriptionRequest != this.subscriptionRequestRevision || connection.hostId != hostId || connection.activeThreadId != threadId) return result
      const snapshot = JSON.parse<Conversation>(JSON.stringify(result['snapshot']))
      if (snapshot == null || snapshot.readOnly == true) throw new Error('电脑连接服务尚未完成加载，请稍后重试或更新电脑连接服务')
      this.applySnapshot(result, hostId, threadId)
      return result
    })
  }

  cancelOpen(threadId: string) { if (connection.activeThreadId == threadId) { this.clearConversationSubscription(); this.openingRevision++; this.syncingThread = ''; connection.activeThreadId = ''; connection.conversationError = ''; this.syncPendingCommand(); connection.snapshot = null; connection.epoch = ''; connection.sequence = 0; this.request('thread.unwatch', { threadId }).then((_: UTSJSONObject) => {}, (_: Error) => {}) } }

  // 订阅和主动加载共用游标、电脑及会话归属检查，忽略迟到的旧响应。
  applySnapshot(result: UTSJSONObject, hostId: string, threadId: string) {
    if (connection.hostId != hostId || connection.activeThreadId != threadId) return
    const snapshot = JSON.parse<Conversation>(JSON.stringify(result['snapshot']))
    if (snapshot == null || snapshot.threadId != threadId) return
    this.confirmConversationRead()
    // 订阅回执独立于消息流和持久化 epoch，重连恢复后通知设置区域重新读取。
    connection.subscriptionRevision++
    const epoch = result.getString('epoch') ?? ''
    const seq = result.getNumber('seq') ?? 0
    if (epoch == connection.epoch && seq < connection.sequence && connection.snapshot?.threadId == threadId) return
    connection.snapshot = snapshot
    connection.epoch = epoch; connection.sequence = seq
  }

  // 当前会话的新内容或有效订阅回执证明读取已恢复；写操作结果仍需单独核对。
  confirmConversationRead() {
    this.conversationUpdateRevision++
    connection.subscribedHostId = connection.hostId
    connection.subscribedThreadId = connection.activeThreadId
    connection.conversationError = ''
  }

  // Socket 已连接不代表聊天已订阅；缓存和旧快照不能恢复这个瞬时状态。
  clearConversationSubscription() { this.subscriptionRequestRevision++; connection.subscribedHostId = ''; connection.subscribedThreadId = '' }

  watch(threadId: string) {
    const hostId = connection.hostId
    if (this.syncingThread == threadId) return
    this.syncingThread = threadId
    const previous = connection.activeThreadId
    if (previous != threadId) this.clearConversationSubscription()
    const subscriptionRequest = ++this.subscriptionRequestRevision
    if (previous.length > 0 && previous != threadId && connection.connected) this.request('thread.unwatch', { threadId: previous }).then((_: UTSJSONObject) => {}, (_: Error) => {})
    connection.activeThreadId = threadId
    this.syncPendingCommand()
    if (previous != threadId) { connection.snapshot = null; connection.epoch = ''; connection.sequence = 0 }
    // 会话读取错误不污染列表页的连接与列表错误。
    connection.conversationError = ''
    const updateRevision = this.conversationUpdateRevision
    this.request('thread.watch', { threadId, epoch: connection.epoch, afterSeq: connection.sequence }).then((result: UTSJSONObject) => {
      // 不同电脑可能出现同名会话编号，旧响应不能覆盖当前会话或清除新同步锁。
      if (subscriptionRequest != this.subscriptionRequestRevision || connection.hostId != hostId || connection.activeThreadId != threadId) return
      if (this.syncingThread == threadId) this.syncingThread = ''
      this.applySnapshot(result, hostId, threadId)
    }, (error: Error) => {
      if (subscriptionRequest != this.subscriptionRequestRevision || connection.hostId != hostId || connection.activeThreadId != threadId) return
      if (this.syncingThread == threadId) this.syncingThread = ''
      // 等待回执期间已收到当前内容时，迟到的超时不能重新显示旧读取错误。
      if (this.conversationUpdateRevision != updateRevision) return
      connection.conversationError = error.message
    })
  }

}

export const bridge = new MobileBridge()
