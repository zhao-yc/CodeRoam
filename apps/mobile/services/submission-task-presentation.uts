import type { SubmissionTask } from './submission-task-state.uts'
import { submissionStageDetail } from './submission-task-state.uts'

// 各实例历史合并后仍按实际完成时间倒序；没有完成时间的待核对记录排在后面。
export function submissionHistoryOrder(a: SubmissionTask, b: SubmissionTask): number {
  const aTime = a.completedAt > 0 ? a.completedAt : 0
  const bTime = b.completedAt > 0 ? b.completedAt : 0
  // 显式判断排序差值，兼容 UTS 的布尔条件约束。
  const completedOrder = bTime - aTime
  return completedOrder != 0 ? completedOrder : b.position - a.position
}

// 首页只展示一条进度说明；失败原因另占一行，完整步骤留在执行记录。
export function submissionCardMeta(task: SubmissionTask, isPausedBlocker: boolean): string {
  if (task.localOnly == true) return '入队待核对'
  if (isPausedBlocker) {
    if (task.state == 'failed') return '失败 · 队列已暂停'
    if (task.state == 'unknown') return '待核对 · 队列已暂停'
    if (task.state == 'waiting_resume') return '等待继续 · 队列已暂停'
    return '队列已暂停'
  }
  const sequence = '#' + task.position
  if (task.state == 'running') {
    const detail = submissionStageDetail(task).trim()
    if (detail.length > 0) return sequence + ' · ' + detail
  }
  return sequence
}

// 单行摘要不改写原错误；点击后仍可读取原文及历史步骤。
export function submissionCardError(task: SubmissionTask): string { return task.error.trim().replace(/\s+/g, ' ') }

// 汇总所选实例的当前任务；异常优先，关闭异常卡后也不能把暂停队列显示为空闲。
export function submissionFloatingState(tasks: SubmissionTask[], paused: boolean): string {
  if (tasks.some((task: SubmissionTask): boolean => task.state == 'unknown' || task.state == 'failed')) return 'unknown'
  if (paused || tasks.some((task: SubmissionTask): boolean => task.state == 'waiting_resume')) return 'waiting_resume'
  if (tasks.some((task: SubmissionTask): boolean => task.state == 'running')) return 'running'
  if (tasks.some((task: SubmissionTask): boolean => task.state == 'queued')) return 'queued'
  return tasks.length > 0 ? 'succeeded' : 'idle'
}

// 胶囊只显示状态与总数，具体电脑、真实阶段及管理操作放在展开的浮窗中。
export function submissionFloatingLabel(state: string, count: number): string {
  if (state == 'idle') return '执行记录'
  const label = state == 'unknown' ? '需处理' : state == 'waiting_resume' ? '队列已暂停' : state == 'running' ? '执行中' : state == 'queued' ? '等待执行' : '已完成'
  return count > 0 ? label + ' · ' + count : label
}

// 按实际显示的卡片去重，折叠到三项之外的暂停源仍须保留恢复入口。
export function submissionNeedsPauseNotice(paused: boolean, blockerId: string, shownTaskIds: string[]): boolean {
  return paused && (blockerId.length == 0 || shownTaskIds.indexOf(blockerId) < 0)
}

// 新队列接管该实例的删除展示，旧服务沿用列表行与独立提示的原有规则。
export function legacyDeletionVisible(state: string, isThreadVisible: boolean, supportsTaskQueue: boolean): boolean {
  return !supportsTaskQueue && (state != 'running' || !isThreadVisible)
}
