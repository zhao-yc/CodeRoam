import { reactive } from 'vue'

export type QuestionSubmissionDraft = { questionId: string, text: string, custom: boolean }

export type InteractionSubmission = {
  scope: string
  kind: string
  id: string
  turnId: string
  action: string
  commandId: string
  state: string
  checking: boolean
  questionDrafts?: QuestionSubmissionDraft[]
}

// 仅在内存中保留原操作和非保密答案的展示副本，支持切走后恢复只读卡片；不写入存储或日志。
// 保密题只保留自定义选择状态，答案原文始终留在请求和当前表单内。
export const interactionSubmissions = reactive<InteractionSubmission[]>([])

// 计划操作结束后收起提示，仍保留原记录，防止延迟快照重新开放提交入口。
export function interactionStatusVisible(entry: InteractionSubmission): boolean {
  return entry.kind != 'plan' || entry.state == 'sending' || entry.state == 'unknown'
}

export function interactionStatusLabel(entry: InteractionSubmission): string {
  if (entry.state == 'unknown') return '结果待核对'
  if (entry.state == 'resolved') return '已同步，原操作已结束'
  const sending = entry.state == 'sending'
  if (entry.kind == 'question') return sending ? '正在提交回答' : '回答已提交'
  if (entry.kind == 'approval') {
    if (entry.action == 'accept') return sending ? '正在提交本次允许' : '已允许本次操作'
    return sending ? '正在提交拒绝' : '已拒绝本次操作'
  }
  if (entry.action == 'feedback') return sending ? '正在发送修改意见' : '修改意见已发送'
  return sending ? '正在提交实施' : '已提交实施计划'
}
