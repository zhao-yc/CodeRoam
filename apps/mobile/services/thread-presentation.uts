import type { ComputerThread } from './thread-list.uts'
import { taskState, threadIndicator } from './bridge.uts'

export type ThreadGroup = { key: string, title: string, threads: ComputerThread[] }
export type ListPreferences = { sort: string, recentFirst: boolean }
export type RecentThread = { key: string, viewedAt: number }

// 首批按现有分组顺序取可见行，保留分组键以便绘制后接续挂载。
export function limitThreadGroups(groups: ThreadGroup[], limit: number): ThreadGroup[] {
  if (limit < 0) return groups
  const result = [] as ThreadGroup[]
  let remaining = limit
  for (let index = 0; index < groups.length && remaining > 0; index++) {
    const group = groups[index]
    result.push(group.threads.length <= remaining ? group : { key: group.key, title: group.title, threads: group.threads.slice(0, remaining) } as ThreadGroup)
    remaining -= group.threads.length
  }
  return result
}

// 未设置偏好或存储内容无效时，统一按项目排列。
export function normalizeListPreferences(value: ListPreferences | null): ListPreferences {
  return { sort: value != null && ['priority', 'project', 'time'].indexOf(value.sort) >= 0 ? value.sort : 'project', recentFirst: value?.recentFirst == true } as ListPreferences
}

// 只有真实查看动作才记为最近；仅保存电脑与会话标识，不保存标题和消息。
export function rememberRecentThread(entries: RecentThread[], key: string, now: number): RecentThread[] {
  return [{ key, viewedAt: now } as RecentThread].concat(entries.filter((entry: RecentThread): boolean => entry.key != key)).slice(0, 30)
}

// 待用户处理优先于运行和未读，离线状态不冒充正在运行。
function priority(thread: ComputerThread): number {
  if (thread.online && (thread.unansweredQuestionCount ?? 0) > 0) return 0
  const state = threadIndicator(taskState(thread.status ?? '', thread.activeTurnId ?? '', thread.approvalCount ?? 0, thread.pendingQuestionCount ?? 0, thread.online, thread.activeFlags ?? [], thread.latestTurn?.status ?? ''), thread.hasUnreadTurn ?? null)
  return state == 'question' || state == 'approval' ? 0 : state == 'running' ? 1 : state == 'unread' ? 2 : 3
}

type ThreadProject = { key: string, path: string, name: string }

type RunningOrder = { turnId: string, startedAt: number }
const runningOrder = new Map<string, RunningOrder>()

// 同一轮执行只记录一次排序时间，等待交互或短暂离线不重置；新轮次重新记录。
function rememberRunningOrder(thread: ComputerThread) {
  const activeTurnId = thread.activeTurnId ?? ''
  const turnId = activeTurnId.length > 0 ? activeTurnId : thread.latestTurn?.turnId ?? ''
  const previous = runningOrder.get(thread.key)
  if (!thread.online) return
  const rank = priority(thread)
  if (rank > 1) { runningOrder.delete(thread.key); return }
  if (previous != null && (turnId.length == 0 || previous.turnId.length == 0 || previous.turnId == turnId)) {
    if (turnId.length > 0) previous.turnId = turnId
    return
  }
  // 旧桌面协议没有轮次开始时间，使用首次收到执行状态时的索引时间并冻结。
  runningOrder.set(thread.key, { turnId, startedAt: thread.updatedAt } as RunningOrder)
}

// 每个项目路径只归一化一次，用末级名称索引查找跨电脑、跨路径重名。
function threadProject(thread: ComputerThread): ThreadProject {
  let path = thread.cwd.split('\\').join('/')
  while (path.endsWith('/') && path.length > 1) path = path.slice(0, -1)
  const name = path.split('/').pop() ?? ''
  return { key: 'project:' + JSON.stringify([thread.hostId, path]), path, name } as ThreadProject
}

// 保留完整规范路径作分组键；末级名称相同的不同路径、不同电脑不会误合并。
export function groupThreads(rows: ComputerThread[], sort: string, recentFirst: boolean, recent: RecentThread[], dayStart: number): ThreadGroup[] {
  rows.forEach((thread: ComputerThread) => { rememberRunningOrder(thread) })
  const threads = rows.slice().sort((left: ComputerThread, right: ComputerThread): number => {
    const timeOrder = right.updatedAt - left.updatedAt
    // UTS 的逻辑条件需要布尔值，同一时间的聊天按原键排序。
    if (timeOrder < 0 || timeOrder > 0) return timeOrder
    return left.key < right.key ? -1 : left.key > right.key ? 1 : 0
  })
  const result = [] as ThreadGroup[]
  const byKey = new Map<string, ComputerThread>()
  const projects = new Map<string, ThreadProject>()
  const firstProjectByName = new Map<string, string>()
  const duplicateProjects = new Set<string>()
  threads.forEach((thread: ComputerThread) => {
    if (recentFirst) byKey.set(thread.key, thread)
    if (sort != 'project') return
    const project = threadProject(thread)
    projects.set(thread.key, project)
    if (project.name.length == 0) return
    const first = firstProjectByName.get(project.name)
    if (first == null) firstProjectByName.set(project.name, project.key)
    else if (first != project.key) duplicateProjects.add(project.name)
  })
  const recentRows = [] as ComputerThread[]
  const recentKeys = new Set<string>()
  if (recentFirst) recent.forEach((entry: RecentThread) => {
    const thread = byKey.get(entry.key)
    if (thread != null) { recentRows.push(thread); recentKeys.add(thread.key) }
  })
  if (recentRows.length > 0) result.push({ key: 'recent', title: '最近', threads: recentRows } as ThreadGroup)
  const groups = new Map<string, ThreadGroup>()
  threads.forEach((thread: ComputerThread) => {
    if (recentKeys.has(thread.key)) return
    let key = '', title = ''
    if (sort == 'project') {
      const project = projects.get(thread.key)!
      key = project.key
      title = project.path.length > 0 ? project.name : '未指定项目'
      // 同名项目使用电脑名和完整路径区分，普通项目保留简洁名称。
      if (duplicateProjects.has(project.name)) title += ' · ' + thread.hostLabel + ' · ' + project.path
    } else if (sort == 'priority') {
      const rank = priority(thread)
      key = 'priority:' + rank.toString()
      title = ['待处理', '执行中', '未读', '其他聊天'][rank]
    } else {
      key = thread.updatedAt >= dayStart ? 'today' : thread.updatedAt >= dayStart - 86400000 ? 'yesterday' : 'older'
      title = key == 'today' ? '今天' : key == 'yesterday' ? '昨天' : '更早'
    }
    let group = groups.get(key)
    if (group == null) { group = { key, title, threads: [] as ComputerThread[] } as ThreadGroup; groups.set(key, group); result.push(group) }
    group.threads.push(thread)
  })
  if (sort == 'priority') {
    // 执行中按开始顺序排列，正文和索引更新时间变化不再改变位置。
    result.forEach((group: ThreadGroup) => {
      if (group.key != 'priority:1') return
      group.threads.sort((left: ComputerThread, right: ComputerThread): number => {
        const difference = (runningOrder.get(left.key)?.startedAt ?? left.updatedAt) - (runningOrder.get(right.key)?.startedAt ?? right.updatedAt)
        return difference != 0 ? difference : left.key < right.key ? -1 : left.key > right.key ? 1 : 0
      })
    })
    result.sort((left: ThreadGroup, right: ThreadGroup): number => left.key == 'recent' ? -1 : right.key == 'recent' ? 1 : left.key < right.key ? -1 : left.key > right.key ? 1 : 0)
  }
  return result
}
