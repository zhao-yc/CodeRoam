import { purgeConversationCacheBodies } from '@/uni_modules/codex-conversation-db'

let retired = false
let pending: Promise<void> | null = null

// 异步等待兼容原生 Promise，并在存储失败后释放本次重试锁。
async function purgeRetiredBodies(): Promise<void> {
  try {
    await purgeConversationCacheBodies()
    uni.removeStorageSync('codex-mobile-conversation-cache-v1')
    retired = true
  } catch (_) {
    // 下次启动或返回前台时重试。
  } finally {
    pending = null
  }
}

// 升级时清理旧正文。清理失败留待下次前台重试，连接和列表加载继续进行。
export function retireConversationCacheBodies(): Promise<void> {
  if (retired) return Promise.resolve()
  if (pending != null) return pending!
  pending = purgeRetiredBodies()
  return pending!
}
