import type { SelectedPlugin } from './plugins.uts'
export type QueuedMessage = { id: string, text: string, imageCount: number, attachmentCount: number, state: string, error: string, plugins?: SelectedPlugin[] }

// 排队和已执行消息分开展示，不能把成功入队误报成已经送达模型。
export function queuedMessageLabel(state: string): string {
  if (state == 'sending') return '正在发送…'
  if (state == 'dispatched') return '正在确认任务开始…'
  if (state == 'unknown') return '结果待核对'
  if (state == 'failed') return '发送失败'
  return '等待当前任务完成'
}
