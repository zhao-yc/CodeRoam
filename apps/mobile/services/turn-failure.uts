import type { Conversation, ConversationTurn, QuestionGroup } from './bridge.uts'
import type { TimelineEntry } from './executions.uts'

// 只使用桌面明确标记的最新轮次；历史窗口中最后一条消息不能证明当前状态。
export function latestFailureTurnId(snapshot: Conversation | null): string {
  if (snapshot == null) return ''
  const latest = snapshot.latestTurn
  if (latest != null) return latest.status == 'failed' ? latest.turnId : ''
  const notification = snapshot.notificationState
  return notification?.latestTurnStatus == 'failed' ? notification.latestTurnId : ''
}

// 仅最新的审查终止轮次可继续，历史提示不能成为发送目标。
export function latestReviewStoppedTurnId(snapshot: Conversation | null): string {
  if (snapshot == null) return ''
  const latest = snapshot.latestTurn
  if (latest != null) return latest.status == 'reviewStopped' ? latest.turnId : ''
  const notification = snapshot.notificationState
  return notification?.latestTurnStatus == 'reviewStopped' ? notification.latestTurnId : ''
}

// 发送前必须已有实时空闲状态；审批、问题和计划待确认时先保留原交互入口。
export function reviewContinueTarget(snapshot: Conversation | null): string {
  if (snapshot == null || snapshot.readOnly == true || snapshot.status == 'active' || snapshot.activeTurnId.length > 0) return ''
  if (snapshot.approvals.length > 0 || snapshot.questionGroups.some((group: QuestionGroup): boolean => group.state == 'pending') || snapshot.pendingPlan != null || (snapshot.activeFlags ?? []).length > 0) return ''
  return latestReviewStoppedTurnId(snapshot)
}

// 失败与中断均在对应轮次末尾展示；中断卡片独立于失败重试目标。
export function failureTimeline(snapshot: Conversation | null, entries: TimelineEntry[]): TimelineEntry[] {
  if (snapshot == null) return entries
  const result = entries.slice()
  const turns = snapshot.turns ?? [] as ConversationTurn[]
  turns.forEach((turn: ConversationTurn, turnIndex: number) => {
    if (['failed', 'reviewStopped', 'interrupted'].indexOf(turn.status) < 0 || turn.turnId.length == 0) return
    let insertion = -1
    result.forEach((entry: TimelineEntry, index: number) => { if (entry.turnId == turn.turnId) insertion = index + 1 })
    if (insertion < 0) {
      insertion = result.findIndex((entry: TimelineEntry): boolean => turns.slice(turnIndex + 1).some((next: ConversationTurn): boolean => next.turnId == entry.turnId))
      if (insertion < 0) insertion = result.length
    }
    let label = '任务失败'
    let fallback = '任务执行失败，未提供具体原因'
    if (turn.status == 'reviewStopped') { label = '自动审查终止'; fallback = '本轮操作已被自动审查终止' }
    if (turn.status == 'interrupted') { label = '任务已中断'; fallback = '本轮操作已中断' }
    result.splice(insertion, 0, {
      id: 'failure:' + turn.turnId, role: turn.status == 'failed' ? 'failure' : 'interruption', kind: turn.status,
      text: (turn.errorMessage ?? '').trim().length > 0 ? turn.errorMessage! : fallback,
      turnId: turn.turnId, executions: [], label
    } as TimelineEntry)
  })
  return result
}

// 可重试性与草稿独立；历史、缓存和待交互状态都不能启动空轮次。
export function retryTarget(snapshot: Conversation | null): string {
  if (snapshot == null || snapshot.readOnly == true || snapshot.status == 'active' || snapshot.activeTurnId.length > 0) return ''
  if (snapshot.approvals.length > 0 || snapshot.questionGroups.some((group: QuestionGroup): boolean => group.state == 'pending') || snapshot.pendingPlan != null) return ''
  if ((snapshot.activeFlags ?? []).length > 0) return ''
  return latestFailureTurnId(snapshot)
}
