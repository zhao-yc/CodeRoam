import type { ChatMessage } from './bridge.uts'
import { MessagePresentation, MessageAttachment, presentAnnotatedMessages, codeRanges, CodeRange } from './annotations.uts'
import { AttachmentPresentation, parseMessageAttachments } from './message-attachments.uts'

// 只转换完整的自动任务协议；代码示例、未知格式及已结束的损坏包装保留原文。
export function heartbeatMessageText(source: string, role: string, streaming: boolean = false): string {
  if (role != 'user' && role != 'assistant') return source
  const text = source.trim()
  if (!text.startsWith('<heartbeat>')) return source
  const opening = source.indexOf('<heartbeat>')
  if (codeRanges(source).some((range: CodeRange): boolean => range.start <= opening && opening < range.end)) return source
  if (role == 'user') {
    const input = /^<heartbeat>\s*<automation_id>([^<>\r\n]+)<\/automation_id>\s*<current_time_iso>([^<>\r\n]+)<\/current_time_iso>\s*<instructions>([\s\S]*?)<\/instructions>\s*<\/heartbeat>$/.exec(text)
    if (input == null || (input[1] ?? '').trim().length == 0 || (input[3] ?? '').trim().length == 0) return source
    return (input[3] ?? '').trim()
  }
  const output = /^<heartbeat>\s*<automation_id>([^<>\r\n]+)<\/automation_id>\s*<decision>(NOTIFY|SKIP)<\/decision>\s*<message>([\s\S]*?)<\/message>\s*<\/heartbeat>$/.exec(text)
  if (output != null && (output[1] ?? '').trim().length > 0) {
    const message = (output[3] ?? '').trim()
    if ((output[2] ?? '') == 'SKIP' || message.length > 0) return message
  }
  // 流式协议等完整包装到齐再显示，防止任务编号和未闭合标签闪现在聊天中。
  if (streaming && /^<heartbeat>\s*<automation_id>[^<>\r\n]+<\/automation_id>\s*(?:<decision>(?:NOTIFY|SKIP)<\/decision>\s*(?:<message>[\s\S]*)?)?$/.test(text)) return ''
  return source
}

// 在展示副本上处理执行确认、自动任务、附件和注释；历史合并与发送仍使用原消息。
export function presentConversationMessages(messages: ChatMessage[]): MessagePresentation[] {
  const attachments = messages.map((message: ChatMessage): AttachmentPresentation => {
    const text = heartbeatMessageText(message.text, message.role, ['inProgress', 'in_progress', 'active', 'running'].indexOf(message.status) >= 0)
    if (message.role != 'user') return { text, attachments: [] as MessageAttachment[] }
    const presentation = parseMessageAttachments(text)
    if (presentation.attachments.length == 0 && (message.imageCount ?? 0) == 0 && (
      message.kind == 'planImplementationRequest' ||
      ((message.kind == null || message.kind == 'userMessage') && /^PLEASE IMPLEMENT THIS PLAN:[ \t]*\r?\n\s*\S/.test(message.text))
    )) presentation.text = '是的，执行此计划'
    return presentation
  })
  const prepared = messages.map((message: ChatMessage, index: number): ChatMessage => ({ id: message.id, role: message.role, kind: message.kind, summary: message.summary, phase: message.phase, workedMs: message.workedMs, imageCount: message.imageCount, text: attachments[index].text, turnId: message.turnId, status: message.status }))
  const result = presentAnnotatedMessages(prepared)
  result.forEach((presentation: MessagePresentation, index: number) => {
    if (messages[index].role != 'user') return
    let imageIndex = 0
    // 有真实缩略图的图片不重复显示文件名；缺少原图的附件仍保留名称。
    presentation.attachments = attachments[index].attachments.filter((attachment: MessageAttachment): boolean => {
      if (attachment.kind != 'image') return true
      imageIndex++
      return imageIndex > (messages[index].imageCount ?? 0)
    })
  })
  return result
}
