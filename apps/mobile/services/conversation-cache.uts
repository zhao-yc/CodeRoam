import { reactive } from 'vue'
import { readConversationCacheRows, writeConversationCacheRows } from '@/uni_modules/codex-conversation-db'
import { clearFileReportCache } from './file-report-cache.uts'
import { cacheEntryKey, cacheHeaderKey, cacheHeader, cacheBodyKeys, cacheEntryFromRows, appendCacheRemoval, appendCacheChanges, decodeCacheRows, CacheHeader, CacheRead, CacheRow, CacheRowChanges } from './conversation-cache-rows.uts'
import type { ChatMessage, Conversation, ConversationTurn, LatestTurn } from './bridge.uts'
import type { HistoryPage } from './history.uts'

export type CachedConversation = { contentRevision?: string, latestTurn?: LatestTurn, hostId: string, threadId: string, title: string, cwd: string, messages: ChatMessage[], turns: ConversationTurn[], olderMessages: ChatMessage[], olderTurns: ConversationTurn[], savedAt: number, accessedAt: number }
type CacheStore = { version: number, namespace: string, entries: CachedConversation[] }
type CacheState = { namespace: string, index: Map<string, CachedConversation>, headers: Map<string, CacheHeader>, loaded: Set<string>, previews: Map<string, CachedConversation>, bodyReads: Map<string, Promise<CachedConversation | null>>, sizes: Map<string, number>, committed: Map<string, CachedConversation>, dirty: Map<string, number>, bodyChanges: Set<string>, preserveOlder: Set<string>, blockedHosts: Set<string>, allowedHosts: string[] | null, revision: string, serial: number, legacyRaw: string, timer: number, ready: boolean, retired: boolean, loading: Promise<void> | null, writing: Promise<void> | null }
const CACHE_KEY = 'codex-mobile-conversation-cache-v1'
const ENTRY_BYTES = 512 * 1024
const TOTAL_BYTES = 3 * 1024 * 1024

let invalidationRevision = 0
let activeCache: CacheState | null = null
const retiredCacheNamespaces = new Set<string>()
export const conversationCacheChanges = reactive({ revision: 0, members: 0 })

function markDirty(state: CacheState, key: string) { state.dirty.set(key, ++state.serial) }
function cacheBytes(entry: CachedConversation): number { return JSON.stringify(entry).length * 2 }
function allowedCacheHost(state: CacheState, hostId: string): boolean { return !state.blockedHosts.has(hostId) && (state.allowedHosts == null || state.allowedHosts!.indexOf(hostId) >= 0) }
function copyCacheIndex(state: CacheState): Map<string, CachedConversation> {
  const copy = new Map<string, CachedConversation>()
  state.index.forEach((entry: CachedConversation, key: string) => { copy.set(key, entry) })
  return copy
}

function removeMemoryEntry(state: CacheState, key: string) {
  state.index.delete(key); state.loaded.delete(key); state.sizes.delete(key); state.previews.delete(key); state.preserveOlder.delete(key); state.bodyChanges.delete(key)
  markDirty(state, key)
}

// 容量核对只计算新增或变更会话，避免每次扫描、序列化整份缓存。
function boundCache(state: CacheState, preferred: string = '') {
  let total = 0
  state.sizes.forEach((size: number) => { total += size })
  if (state.index.size <= 20 && total <= TOTAL_BYTES) return
  const ranked = [] as CachedConversation[]
  state.index.forEach((entry: CachedConversation) => { ranked.push(entry) })
  ranked.sort((left: CachedConversation, right: CachedConversation): number => left.accessedAt - right.accessedAt)
  for (let index = 0; index < ranked.length && (state.index.size > 20 || total > TOTAL_BYTES); index++) {
    const entry = ranked[index]
    const key = cacheEntryKey(entry.hostId, entry.threadId)
    if (key == preferred) continue
    total -= state.sizes.get(key) ?? 0
    removeMemoryEntry(state, key)
  }
}

// 清理代次使所有在途预加载失效，即使目标聊天此前还没有缓存也不能迟到写回。
export function conversationCacheRevision(): number { return invalidationRevision }

// 应用恢复配对后异步建立内存索引，包括尚未建立网络连接的情况。
export function primeConversationCache(namespace: string): Promise<void> {
  if (namespace.length == 0) return Promise.resolve()
  const state = cacheState(namespace)
  return state == null ? Promise.resolve() : hydrateCache(state)
}

export function conversationCacheIndexPending(namespace: string): boolean { return cacheState(namespace)?.loading != null }

// 调度检查不冒充用户访问，也不为了读取版本而同步改写存储。
export function peekConversationCache(namespace: string, hostId: string, threadId: string): CachedConversation | null {
  if (namespace.length == 0) return null
  const state = cacheState(namespace)
  const key = cacheEntryKey(hostId, threadId)
  return state != null && state.loaded.has(key) ? state.index.get(key) ?? null : null
}

// 索引中的版本可用于订阅协商。收到增量后仍须按需读取完整基线才能应用。
export function peekConversationCacheRevision(namespace: string, hostId: string, threadId: string): string | null {
  const state = cacheState(namespace)
  const entry = state?.index.get(cacheEntryKey(hostId, threadId))
  return entry == null ? null : entry.contentRevision ?? ''
}

export function peekConversationPreview(namespace: string, hostId: string, threadId: string): CachedConversation | null {
  return peekConversationCache(namespace, hostId, threadId) ?? cacheState(namespace)?.previews.get(cacheEntryKey(hostId, threadId)) ?? null
}

// 校验已经落过盘的目标，最近列表截断时也能识别原电脑确认移除的聊天。
export function cachedConversationThreadIds(namespace: string, hostId: string): string[] {
  if (namespace.length == 0) return [] as string[]
  const result = [] as string[]
  cacheState(namespace)?.index.forEach((entry: CachedConversation) => { if (entry.hostId == hostId) result.push(entry.threadId) })
  return result
}

// 只保存显示正文所需字段，图片数据、协议游标、审批及能力信息均不落入缓存。
function cacheMessages(messages: ChatMessage[]): ChatMessage[] {
  return messages.map((message: ChatMessage): ChatMessage => ({ id: message.id, role: message.role, kind: message.kind, summary: message.summary, phase: message.phase, imageCount: message.imageCount, text: message.text, turnId: message.turnId, status: message.status }))
}

function cacheTurns(turns: ConversationTurn[]): ConversationTurn[] {
  return turns.map((turn: ConversationTurn): ConversationTurn => ({ turnId: turn.turnId, status: turn.status, durationMs: turn.durationMs, errorMessage: turn.errorMessage }))
}

export function validCachedMessages(messages: ChatMessage[]): boolean {
  return Array.isArray(messages) && messages.every((message: ChatMessage): boolean => message != null && typeof message.id == 'string' && typeof message.role == 'string' && typeof message.text == 'string' && typeof message.turnId == 'string' && typeof message.status == 'string')
}

function validEntry(entry: CachedConversation): boolean {
  return entry != null && typeof entry.hostId == 'string' && typeof entry.threadId == 'string' && typeof entry.title == 'string' && typeof entry.cwd == 'string' && typeof entry.savedAt == 'number' && typeof entry.accessedAt == 'number' && validCachedMessages(entry.messages) && validCachedMessages(entry.olderMessages) && Array.isArray(entry.turns) && Array.isArray(entry.olderTurns) && entry.turns.concat(entry.olderTurns).every((turn: ConversationTurn): boolean => turn != null && typeof turn.turnId == 'string' && typeof turn.status == 'string' && (turn.errorMessage == null || typeof turn.errorMessage == 'string')) && (entry.latestTurn == null || (typeof entry.latestTurn!.turnId == 'string' && typeof entry.latestTurn!.status == 'string'))
}

// 迁移期间先用已验证的旧数据显示。数据库可用后仅以持久提交为准清理旧键。
function cacheState(namespace: string): CacheState | null {
  if (namespace.length == 0 || retiredCacheNamespaces.has(namespace)) return null
  if (activeCache != null) return activeCache!.namespace == namespace ? activeCache : null
  const state = { namespace, index: new Map<string, CachedConversation>(), headers: new Map<string, CacheHeader>(), loaded: new Set<string>(), previews: new Map<string, CachedConversation>(), bodyReads: new Map<string, Promise<CachedConversation | null>>(), sizes: new Map<string, number>(), committed: new Map<string, CachedConversation>(), dirty: new Map<string, number>(), bodyChanges: new Set<string>(), preserveOlder: new Set<string>(), blockedHosts: new Set<string>(), allowedHosts: null, revision: '', serial: 0, legacyRaw: '', timer: 0, ready: false, retired: false, loading: null, writing: null } as CacheState
  try {
    const raw = uni.getStorageSync(CACHE_KEY)
    if (typeof raw == 'string' && raw.length > 0 && raw.length * 2 <= TOTAL_BYTES) {
      const loaded = JSON.parse<CacheStore>(raw)
      if (loaded != null && loaded.version == 1 && loaded.namespace == namespace && Array.isArray(loaded.entries)) {
        state.legacyRaw = raw
        loaded.entries.forEach((entry: CachedConversation) => {
          if (!validEntry(entry)) return
          // 迁移也经过展示白名单，旧结构中的附加字段不能进入数据库。
          const latestTurn = entry.latestTurn
          const clean = { hostId: entry.hostId, threadId: entry.threadId, title: entry.title, cwd: entry.cwd, savedAt: entry.savedAt, accessedAt: entry.accessedAt, contentRevision: entry.contentRevision, latestTurn: latestTurn == null ? undefined : { turnId: latestTurn.turnId, status: latestTurn.status } as LatestTurn, messages: cacheMessages(entry.messages), turns: cacheTurns(entry.turns), olderMessages: cacheMessages(entry.olderMessages), olderTurns: cacheTurns(entry.olderTurns) } as CachedConversation
          const key = cacheEntryKey(clean.hostId, clean.threadId)
          const size = cacheBytes(clean)
          if (size <= ENTRY_BYTES) { state.index.set(key, clean); state.sizes.set(key, size); state.loaded.add(key) }
        })
        boundCache(state)
      }
    }
  } catch (_) {}
  activeCache = state
  hydrateCache(state)
  return state
}

function notifyCache(state: CacheState, previous: Map<string, CachedConversation>) {
  if (activeCache !== state || state.retired) return
  conversationCacheChanges.revision++
  let membersChanged = previous.size != state.index.size
  if (!membersChanged) state.index.forEach((_entry: CachedConversation, key: string) => { if (!previous.has(key)) membersChanged = true })
  if (membersChanged) conversationCacheChanges.members++
}

function removeLegacyAfterCommit(state: CacheState) {
  if (state.legacyRaw.length == 0) return
  try {
    if (uni.getStorageSync(CACHE_KEY) == state.legacyRaw) uni.removeStorageSync(CACHE_KEY)
    state.legacyRaw = ''
  } catch (_) {}
}

function sameCacheHeader(a: CacheHeader | null, b: CacheHeader | null): boolean {
  if (a == null || b == null) return a == b
  // 最近访问时间不改变正文基线。保存时间和窗口标识共同区分无内容版本的旧记录。
  return a.savedAt == b.savedAt && a.contentRevision == b.contentRevision && a.title == b.title && a.cwd == b.cwd && JSON.stringify(a.recent) == JSON.stringify(b.recent) && JSON.stringify(a.older) == JSON.stringify(b.older) && JSON.stringify(a.turns) == JSON.stringify(b.turns) && JSON.stringify(a.olderTurns) == JSON.stringify(b.olderTurns)
}

function indexOnlyEntry(header: CacheHeader): CachedConversation {
  return { hostId: header.hostId, threadId: header.threadId, title: header.title, cwd: header.cwd, savedAt: header.savedAt, accessedAt: header.accessedAt, contentRevision: header.contentRevision, messages: [] as ChatMessage[], olderMessages: [] as ChatMessage[], turns: [] as ConversationTurn[], olderTurns: [] as ConversationTurn[] } as CachedConversation
}

// 冷启动和写入冲突都只读取会话索引。保留版本仍相同的完整内存窗口。
function adoptCacheHeaders(state: CacheState, data: CacheRead, initial: boolean) {
  const previous = state.index
  if (data.revision.startsWith('retired-')) {
    // 其他标签页清除配对后，此命名空间的晚到请求不能重新创建数据。
    state.index = new Map<string, CachedConversation>(); state.sizes.clear(); state.dirty.clear(); state.loaded.clear(); state.previews.clear()
    notifyCache(state, previous)
    state.retired = true; retiredCacheNamespaces.add(state.namespace)
    if (activeCache === state) activeCache = null
    return
  }
  if (initial && data.revision.length == 0 && state.legacyRaw.length > 0) previous.forEach((_entry: CachedConversation, key: string) => { if (!state.dirty.has(key)) markDirty(state, key) })
  const merged = new Map<string, CachedConversation>()
  const loaded = new Set<string>()
  const sizes = new Map<string, number>()
  const committed = new Map<string, CachedConversation>()
  const previews = new Map<string, CachedConversation>()
  data.headers.forEach((header: CacheHeader, key: string) => {
    if (!allowedCacheHost(state, header.hostId)) { markDirty(state, key); return }
    if (sameCacheHeader(state.headers.get(key) ?? null, header)) {
      const base = state.committed.get(key)
      if (base != null) committed.set(key, base)
      const entry = previous.get(key)
      if (entry != null && state.loaded.has(key) && !state.dirty.has(key)) {
        merged.set(key, entry); loaded.add(key); sizes.set(key, state.sizes.get(key) ?? cacheBytes(entry)); return
      }
      const preview = state.previews.get(key)
      if (preview != null) previews.set(key, preview)
    }
    merged.set(key, indexOnlyEntry(header))
    const bytes = header.bytes
    if (bytes != null && bytes > 0 && bytes <= ENTRY_BYTES) sizes.set(key, bytes)
  })
  const conflicts = [] as string[]
  state.dirty.forEach((_serial: number, key: string) => {
    const entry = previous.get(key)
    if (entry == null || !allowedCacheHost(state, entry.hostId)) { merged.delete(key); sizes.delete(key); previews.delete(key); return }
    if (!initial && !sameCacheHeader(state.headers.get(key) ?? null, data.headers.get(key) ?? null)) { conflicts.push(key); return }
    if (state.loaded.has(key)) { merged.set(key, entry); loaded.add(key); sizes.set(key, state.sizes.get(key) ?? cacheBytes(entry)); previews.delete(key) }
  })
  conflicts.forEach((key: string) => { state.dirty.delete(key); state.bodyChanges.delete(key); state.preserveOlder.delete(key) })
  state.index = merged; state.headers = data.headers; state.loaded = loaded; state.sizes = sizes; state.committed = committed; state.previews = previews; state.revision = data.revision
  boundCache(state); notifyCache(state, previous)
}

// 同一配对共用一次启动读取。读取失败时仍可展示内存和尚未迁移的旧数据。
function hydrateCache(state: CacheState): Promise<void> {
  if (state.ready || state.retired) return Promise.resolve()
  if (state.loading != null) return state.loading!
  const loading = readConversationCacheRows(state.namespace, 'headers').then((raw: string) => {
    if (state.retired) return
    const data = decodeCacheRows(raw)
    adoptCacheHeaders(state, data, true)
    state.ready = true
    if (!state.retired && (state.legacyRaw.length > 0 || state.dirty.size > 0)) scheduleCacheStorage(state)
  }).catch((_error: Error) => {}).finally(() => { state.loading = null })
  state.loading = loading
  return loading
}

// 目标版本或授权变化时废弃旧正文。全量与预览各自合并同一聊天的并发查询。
async function loadCacheBody(state: CacheState, key: string, preview: boolean): Promise<CachedConversation | null> {
  await hydrateCache(state)
  for (let attempt = 0; attempt < 2 && !state.retired; attempt++) {
    if (state.loaded.has(key)) return state.index.get(key) ?? null
    const header = state.headers.get(key)
    if (header == null || !state.index.has(key) || !allowedCacheHost(state, header.hostId)) return null
    const firstPage = preview ? null : state.previews.get(key) ?? null
    const previewKeys = firstPage == null ? [] as string[] : cacheBodyKeys(key, header, true)
    const keys = cacheBodyKeys(key, header, preview).filter((row: string): boolean => previewKeys.indexOf(row) < 0)
    keys.unshift(cacheHeaderKey(key))
    const data = decodeCacheRows(await readConversationCacheRows(state.namespace, JSON.stringify(keys)))
    if (state.retired || !state.index.has(key) || !allowedCacheHost(state, header.hostId)) return null
    if (state.loaded.has(key)) return state.index.get(key) ?? null
    const current = data.headers.get(key)
    if (!sameCacheHeader(header, current ?? null) || state.headers.get(key) !== header) {
      // 另一页面改了索引。串行写入期间由 CAS 负责重核，防止读取推进旧事务的版本。
      if (state.writing != null) return null
      const latest = decodeCacheRows(await readConversationCacheRows(state.namespace, 'headers'))
      if (state.retired || state.writing != null) return null
      adoptCacheHeaders(state, latest, false)
      continue
    }
    if (current == null) return null
    const entry = cacheEntryFromRows(data.rows, key, current, preview, firstPage)
    if (entry == null || !validEntry(entry)) return null
    const bytes = cacheBytes(entry)
    if (bytes > ENTRY_BYTES) return null
    if (preview) state.previews.set(key, entry)
    else { state.index.set(key, entry); state.loaded.add(key); state.committed.set(key, entry); state.sizes.set(key, bytes); state.previews.delete(key) }
    conversationCacheChanges.revision++
    return entry
  }
  return null
}

function requestCacheBody(namespace: string, hostId: string, threadId: string, preview: boolean): Promise<CachedConversation | null> {
  const state = cacheState(namespace)
  if (state == null) return Promise.resolve(null)
  const key = cacheEntryKey(hostId, threadId)
  const ready = state.loaded.has(key) ? state.index.get(key) : preview ? state.previews.get(key) : null
  if (ready != null) return Promise.resolve(ready)
  const readKey = (preview ? 'preview:' : 'full:') + key
  const pending = state.bodyReads.get(readKey)
  if (pending != null) return pending
  const reading = loadCacheBody(state, key, preview).catch((_error: Error): CachedConversation | null => null).finally(() => { state.bodyReads.delete(readKey) })
  state.bodyReads.set(readKey, reading)
  return reading
}

export function primeConversationPreview(namespace: string, hostId: string, threadId: string): Promise<void> {
  return requestCacheBody(namespace, hostId, threadId, true).then((_entry: CachedConversation | null) => {})
}

export function primeConversationEntry(namespace: string, hostId: string, threadId: string): Promise<CachedConversation | null> {
  return requestCacheBody(namespace, hostId, threadId, false)
}

function nextCacheRevision(): string { return Date.now().toString(36) + '-' + Math.random().toString(36).slice(2) }

// 增量对比只加载有写入的旧窗口。旧格式缺少容量值时，仅在可能越界的内容更新中补算。
async function resolveWriteBases(state: CacheState): Promise<boolean> {
  const targets = new Set<string>()
  state.dirty.forEach((_serial: number, key: string) => {
    if (state.index.has(key) && state.headers.has(key) && !state.committed.has(key)) targets.add(key)
  })
  let possibleBytes = 0
  state.index.forEach((_entry: CachedConversation, key: string) => { possibleBytes += state.sizes.get(key) ?? ENTRY_BYTES })
  if (state.bodyChanges.size > 0 && possibleBytes > TOTAL_BYTES) state.index.forEach((_entry: CachedConversation, key: string) => {
    if (!state.sizes.has(key) && state.headers.has(key)) targets.add(key)
  })
  if (targets.size == 0) return true
  const keys = new Set<string>()
  targets.forEach((key: string) => {
    const header = state.headers.get(key)
    if (header != null) cacheBodyKeys(key, header, false).forEach((row: string) => { keys.add(row) })
  })
  const selected = [] as string[]
  keys.forEach((key: string) => { selected.push(key) })
  const data = decodeCacheRows(await readConversationCacheRows(state.namespace, JSON.stringify(selected)))
  if (state.retired) return false
  if (data.revision != state.revision) {
    const latest = decodeCacheRows(await readConversationCacheRows(state.namespace, 'headers'))
    if (!state.retired) adoptCacheHeaders(state, latest, false)
    return false
  }
  targets.forEach((key: string) => {
    const header = state.headers.get(key)
    if (header == null) return
    const base = cacheEntryFromRows(data.rows, key, header, false)
    if (base == null || !validEntry(base)) return
    if (state.dirty.has(key)) state.committed.set(key, base)
    if (state.index.has(key) && !state.sizes.has(key)) state.sizes.set(key, cacheBytes(base))
  })
  return true
}

// 一批数据只提交变化的记录。较新内存写入不随旧回执一起清除。
async function persistCache(state: CacheState) {
  await hydrateCache(state)
  for (let attempt = 0; attempt < 3 && state.ready && !state.retired; attempt++) {
    const started = state.serial
    if (!await resolveWriteBases(state) || state.retired || state.serial != started) continue
    const previous = copyCacheIndex(state)
    // 实时快照可能先于本地历史到达。合并原有分页后才替换持久窗口。
    let restoredHistory = false
    state.preserveOlder.forEach((key: string) => {
      const entry = state.index.get(key), base = state.committed.get(key)
      if (entry == null || base == null || entry.olderMessages.length > 0 || base.olderMessages.length == 0) return
      const olderMessages = base.olderMessages.filter((message: ChatMessage): boolean => !entry.messages.some((current: ChatMessage): boolean => current.id == message.id))
      const merged = { ...entry, olderMessages, olderTurns: base.olderTurns } as CachedConversation
      const bytes = trimCacheEntry(merged)
      if (bytes > 0) { state.index.set(key, merged); state.sizes.set(key, bytes); restoredHistory = true }
    })
    boundCache(state)
    if (restoredHistory || previous.size != state.index.size) notifyCache(state, previous)
    const changes = { put: [] as CacheRow[], remove: [] as string[], clear: false } as CacheRowChanges
    const batch = new Map<string, CachedConversation | null>()
    const serial = state.serial
    state.dirty.forEach((_value: number, key: string) => {
      const entry = state.index.get(key) ?? null
      const before = state.committed.get(key) ?? null
      const header = state.headers.get(key)
      if (before == null && header != null) appendCacheRemoval(changes, key, header)
      appendCacheChanges(changes, key, before, entry, state.sizes.get(key) ?? 0)
      batch.set(key, entry)
    })
    if (changes.put.length > 0 || changes.remove.length > 0 || (state.revision.length == 0 && state.legacyRaw.length > 0)) {
      const next = nextCacheRevision()
      const applied = await writeConversationCacheRows(state.namespace, state.revision, next, JSON.stringify(changes))
      if (state.retired) return
      if (!applied) {
        const data = decodeCacheRows(await readConversationCacheRows(state.namespace, 'headers'))
        if (state.retired) return
        adoptCacheHeaders(state, data, false)
        continue
      }
      state.revision = next
    }
    batch.forEach((entry: CachedConversation | null, key: string) => {
      if (entry == null) { state.committed.delete(key); state.headers.delete(key) }
      else {
        state.committed.set(key, entry)
        const header = cacheHeader(entry); header.bytes = cacheBytes(entry); state.headers.set(key, header)
      }
      if ((state.dirty.get(key) ?? 0) <= serial) { state.dirty.delete(key); state.bodyChanges.delete(key); state.preserveOlder.delete(key) }
    })
    if (state.revision.length > 0) removeLegacyAfterCommit(state)
    if (state.serial == serial || state.dirty.size == 0) return
  }
}

// 访问时间低优先级合并落盘，详情打开不等待数据库事务。
function scheduleCacheStorage(state: CacheState) {
  if (!state.retired && state.timer == 0) state.timer = setTimeout(() => { flushCacheState(state) }, 500)
}

function flushCacheState(state: CacheState): Promise<void> {
  clearTimeout(state.timer); state.timer = 0
  if (state.writing != null) return state.writing!
  const serial = state.serial
  const writing = persistCache(state).catch((_error: Error) => {}).finally(() => {
    state.writing = null
    if (state.serial > serial && state.dirty.size > 0) scheduleCacheStorage(state)
  })
  state.writing = writing
  return writing
}

async function drainCacheState(state: CacheState) {
  await flushCacheState(state)
  if (!state.retired && state.dirty.size > 0) await flushCacheState(state)
}

export function flushConversationCacheStorage(): Promise<void> {
  const state = activeCache
  return state == null ? Promise.resolve() : drainCacheState(state)
}

// 同一电脑的同号会话才可命中；本地只恢复展示，不恢复任何实时连接状态。
export function readConversationCache(namespace: string, hostId: string, threadId: string): CachedConversation | null {
  if (namespace.length == 0 || hostId.length == 0 || threadId.length == 0) return null
  const state = cacheState(namespace)
  const key = cacheEntryKey(hostId, threadId)
  const entry = state?.index.get(key)
  if (state == null || entry == null || !state.loaded.has(key)) return null
  const visited = { ...entry, accessedAt: Date.now() } as CachedConversation
  state.index.set(key, visited); markDirty(state, key); scheduleCacheStorage(state)
  return visited
}

// 剔除最早完整消息和无引用轮次，不截断正文。
function trimCacheEntry(entry: CachedConversation): number {
  let size = cacheBytes(entry)
  while (size > ENTRY_BYTES) {
    if (entry.olderMessages.length > 0) entry.olderMessages.shift()
    else if (entry.messages.length > 0) { entry.messages.shift(); entry.contentRevision = undefined }
    else return 0
    entry.olderTurns = entry.olderTurns.filter((turn: ConversationTurn): boolean => entry.olderMessages.some((message: ChatMessage): boolean => message.turnId == turn.turnId))
    if (entry.contentRevision == null) entry.turns = entry.turns.filter((turn: ConversationTurn): boolean => (turn.status == 'failed' && turn.turnId == entry.latestTurn?.turnId) || entry.messages.some((message: ChatMessage): boolean => message.turnId == turn.turnId))
    size = cacheBytes(entry)
  }
  return size
}

// 按最新快照拆分历史补充，旧最近窗口不会混进 PC 返回的新快照。
export function saveConversationCache(namespace: string, hostId: string, snapshot: Conversation, history: HistoryPage | null, contentRevision: string = '', deferred: boolean = false): boolean {
  if (namespace.length == 0 || hostId.length == 0 || snapshot.threadId.length == 0) return false
  const state = cacheState(namespace)
  if (state == null || !allowedCacheHost(state, hostId)) return false
  const now = Date.now()
  const key = cacheEntryKey(hostId, snapshot.threadId)
  const prior = state.loaded.has(key) ? state.index.get(key) : null
  const messages = cacheMessages(snapshot.messages)
  const turns = cacheTurns(snapshot.turns ?? [] as ConversationTurn[])
  const olderMessages = cacheMessages((history?.messages ?? prior?.olderMessages ?? [] as ChatMessage[]).filter((message: ChatMessage): boolean => !messages.some((current: ChatMessage): boolean => current.id == message.id)))
  const latestTurn = snapshot.latestTurn
  const entry = { latestTurn: latestTurn == null ? undefined : { turnId: latestTurn.turnId, status: latestTurn.status } as LatestTurn, hostId, threadId: snapshot.threadId, title: snapshot.title, cwd: snapshot.cwd, messages, turns, olderMessages, olderTurns: cacheTurns(history?.turns ?? prior?.olderTurns ?? [] as ConversationTurn[]), savedAt: now, accessedAt: now } as CachedConversation
  if (contentRevision.length > 0) entry.contentRevision = contentRevision
  const size = trimCacheEntry(entry)
  if (size == 0) return false
  const previous = copyCacheIndex(state)
  const previousSize = state.sizes.get(key)
  // 同大小的实时确认或访问时间变化不会触发旧缓存的容量补算。
  if (previousSize == null || size > previousSize) state.bodyChanges.add(key)
  state.index.set(key, entry); state.sizes.set(key, size); state.loaded.add(key); state.previews.delete(key); markDirty(state, key)
  if (history == null && (prior == null || state.preserveOlder.has(key))) state.preserveOlder.add(key)
  else state.preserveOlder.delete(key)
  boundCache(state, key); notifyCache(state, previous)
  if (deferred) scheduleCacheStorage(state)
  else flushCacheState(state)
  return true
}

// 将缓存转换为纯展示快照；永远不能写入 connection.snapshot。
export function cachedConversationSnapshot(entry: CachedConversation): Conversation {
  return { latestTurn: entry.latestTurn, threadId: entry.threadId, title: entry.title, cwd: entry.cwd, messages: entry.messages, turns: entry.turns, updatedAt: entry.savedAt, status: 'unknown', activeTurnId: '', approvals: [], questionGroups: [], readOnly: true } as Conversation
}

// 明确清理时也清理旧格式副本，避免迁移失败后在离线重启时恢复被撤回的内容。
function removeLegacyScope(namespace: string, hostId: string, threadIds: string[] | null) {
  try {
    const raw = uni.getStorageSync(CACHE_KEY)
    if (typeof raw != 'string' || raw.length == 0) return
    const store = JSON.parse<CacheStore>(raw)
    if (store == null || store.namespace != namespace || !Array.isArray(store.entries)) return
    if (hostId.length == 0) { uni.removeStorageSync(CACHE_KEY); return }
    store.entries = store.entries.filter((entry: CachedConversation): boolean => entry.hostId != hostId || (threadIds != null && threadIds.indexOf(entry.threadId) < 0))
    if (store.entries.length == 0) uni.removeStorageSync(CACHE_KEY)
    else uni.setStorageSync(CACHE_KEY, JSON.stringify(store))
  } catch (_) {}
}

// 旧配对使用独立事务清理，不能清空新配对的内存或数据库记录。
async function purgeCacheScope(namespace: string, hostId: string, threadIds: string[] | null) {
  try {
    for (let attempt = 0; attempt < 3; attempt++) {
      const data = decodeCacheRows(await readConversationCacheRows(namespace, hostId.length == 0 ? '[]' : 'headers'))
      const changes = { put: [] as CacheRow[], remove: [] as string[], clear: hostId.length == 0 } as CacheRowChanges
      if (!changes.clear) data.headers.forEach((header: CacheHeader, key: string) => {
        if (header.hostId == hostId && (threadIds == null || threadIds.indexOf(header.threadId) >= 0)) appendCacheRemoval(changes, key, header)
      })
      const revision = (changes.clear || data.revision.startsWith('retired-') ? 'retired-' : '') + nextCacheRevision()
      if (await writeConversationCacheRows(namespace, data.revision, revision, JSON.stringify(changes))) return
    }
  } catch (_) {}
}

export function clearConversationCache(namespace: string, hostId: string = '', threadIds: string[] | null = null): Promise<void> {
  invalidationRevision++
  clearFileReportCache(namespace, hostId, threadIds)
  if (namespace.length == 0) return Promise.resolve()
  const state = activeCache?.namespace == namespace ? activeCache : null
  if (hostId.length == 0) {
    retiredCacheNamespaces.add(namespace)
    if (state != null) {
      state.retired = true; clearTimeout(state.timer); activeCache = null
      conversationCacheChanges.revision++; conversationCacheChanges.members++
    }
    removeLegacyScope(namespace, hostId, threadIds)
    return purgeCacheScope(namespace, hostId, threadIds)
  }
  removeLegacyScope(namespace, hostId, threadIds)
  if (state == null) return purgeCacheScope(namespace, hostId, threadIds)
  if (state.legacyRaw.length > 0) {
    try { const raw = uni.getStorageSync(CACHE_KEY); state.legacyRaw = typeof raw == 'string' ? raw : '' } catch (_) {}
  }
  const previous = copyCacheIndex(state)
  if (threadIds == null) {
    state.blockedHosts.add(hostId)
    previous.forEach((entry: CachedConversation, key: string) => {
      if (entry.hostId == hostId) removeMemoryEntry(state, key)
    })
  } else threadIds.forEach((id: string) => {
    const key = cacheEntryKey(hostId, id)
    removeMemoryEntry(state, key)
  })
  notifyCache(state, previous)
  return drainCacheState(state)
}

// 中转给出完整授权电脑列表后，移除已经撤回授权的电脑内容。
export function retainConversationCacheHosts(namespace: string, hostIds: string[]) {
  if (namespace.length == 0) return
  const state = cacheState(namespace)
  if (state == null) return
  const previous = copyCacheIndex(state)
  state.allowedHosts = hostIds.slice()
  previous.forEach((entry: CachedConversation, key: string) => {
    if (!allowedCacheHost(state, entry.hostId)) {
      removeMemoryEntry(state, key)
      if (state.legacyRaw.length > 0) removeLegacyScope(namespace, entry.hostId, null)
    }
  })
  if (state.legacyRaw.length > 0 && previous.size != state.index.size) {
    try { const raw = uni.getStorageSync(CACHE_KEY); state.legacyRaw = typeof raw == 'string' ? raw : '' } catch (_) {}
  }
  if (previous.size != state.index.size) { invalidationRevision++; notifyCache(state, previous); flushCacheState(state) }
}
