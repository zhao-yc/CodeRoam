{
  "name": "codex-mobile-desktop-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "掌上 Codex 电脑连接服务管理客户端",
  "author": { "name": "zhao-yc", "email": "zhao-yc@users.noreply.github.com" },
  "license": "MIT",
  "main": "electron/main.mjs",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "build": "vite build",
    "start": "npm run build && electron .",
    "pack:win": "npm run build && node scripts/prepare-runtime.mjs && electron-builder --win --x64 --dir",
    "dist:win": "npm run build && node scripts/prepare-runtime.mjs && electron-builder --win zip --x64"
  },
  "dependencies": { "vue": "3.5.44" },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "com.codexmobile.manager",
    "productName": "Codex Mobile Manager",
    "asar": true,
    "directories": { "output": "out" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "extraResources": [{ "from": ".runtime", "to": "bridge-runtime" }],
    "win": { "target": "zip", "signAndEditExecutable": false },
    "artifactName": "codex-mobile-manager-${version}-${os}-${arch}.${ext}"
  }
}
