{
  "name": "coderoam-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CodeRoam：使用 uni-app x 连接自己 Codex 桌面会话的非官方手机客户端",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "diagnose": "node scripts/diagnose.mjs",
    "test": "node --test tests/*.test.mjs",
    "relay": "node apps/relay/cli.mjs",
    "bridge": "npm run desktop:start --",
    "desktop:build": "npm --prefix apps/desktop-manager run build",
    "desktop:start": "npm --prefix apps/desktop-manager start",
    "desktop:pack:win": "npm --prefix apps/desktop-manager run pack:win",
    "desktop:pack:mac": "npm --prefix apps/desktop-manager run pack:mac",
    "provision": "node scripts/provision.mjs",
    "check:privacy": "node scripts/check-public-files.mjs",
    "setup:hooks": "node scripts/install-privacy-hooks.mjs",
    "check:privacy:staged": "node scripts/check-public-files.mjs --staged",
    "check:privacy:history": "node scripts/check-public-files.mjs --history"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "license": "MIT"
}
